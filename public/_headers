# Cloudflare Pages security headers (applied to every response).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdn.plot.ly https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co https://cdn.jsdelivr.net https://cdn.plot.ly; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; form-action 'self'
# NOTE: the CSP above is REPORT-ONLY on purpose — it reports violations to the browser
# console without blocking anything, so it can't break the CDN-loaded editor (Pyodide/
# Plotly on jsDelivr + cdn.plot.ly), Turnstile, Supabase, or WASM. Exercise the site
# (editor plot cells, subscribe, paywall unlock) with devtools open, confirm there are no
# unexpected CSP violations, then flip the header name to `Content-Security-Policy` to
# enforce. Pyodide may additionally require `'unsafe-eval'` in script-src when enforcing.
