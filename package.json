{
  "name": "areyoustillreading",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=areyoustillreading",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=areyoustillreading --branch=preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@supabase/supabase-js": "^2.110.8",
    "@terrastruct/d2": "^0.1.33",
    "astro": "^7.1.3",
    "astro-og-canvas": "^0.13.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "rehype-mermaid": "^3.0.0",
