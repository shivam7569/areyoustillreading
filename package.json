{
  "name": "areyoustillreading",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "node scripts/apply-sql.mjs",
    "backfill": "node scripts/backfill-content.mjs",
    "verify:content": "node scripts/verify-content-bytediff.mjs",
    "loadtest:seed": "node scripts/loadtest/seed.mjs",
    "loadtest:probe": "node scripts/loadtest/probe.mjs",
    "loadtest:teardown": "node scripts/loadtest/teardown.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=areyoustillreading",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=areyoustillreading --branch=preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@supabase/supabase-js": "^2.110.8",
    "@terrastruct/d2": "^0.1.33",
    "astro": "^7.1.3",
    "astro-og-canvas": "^0.13.0",
    "katex": "^0.18.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "pagefind": "^1.5.2",
    "pg": "^8.13.1",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
