---
/**
 * BaseHead.astro
 * ---------------------------------------------------------------------------
 * WHAT THIS FILE IS
 *   The single, reusable set of `<head>` elements shared by every page on the
 *   site. It emits the core HTML metadata: charset, viewport, <title>,
 *   description, canonical URL, favicon, and the OpenGraph + Twitter Card tags
 *   that control how links look when shared on social platforms / chat apps.
 *
 * SINGLE RESPONSIBILITY
 *   Produce correct, per-page head metadata from three inputs (title,
 *   description, optional image). It does NOT render <html>, <head>, <body>,
 *   analytics, fonts, or KaTeX/Shiki assets — those belong to the layout(s)
 *   that include this component. Keeping this file narrow means every page
 *   gets consistent SEO/social metadata from one place.
 *
 * HOW IT FITS THE ARCHITECTURE
 *   This is a build-time Astro component (frontmatter runs during the static
 *   build; the output is plain HTML, save for ONE tiny inline script that sets
 *   manual scroll restoration so reloads open at the top, not a mis-restored
 *   position — a universal head concern, hence it lives here). Layouts
 *   (e.g. the base/blog-post layouts) render `<BaseHead .../>` inside their
 *   own `<head>`. Because this ships to every crawler and social scraper, the
 *   values here directly drive Google/Bing indexing and OG previews.
 *
 * DEPENDS ON
 *   - Astro.props ....... title/description/image passed by the including page.
 *   - Astro.site ........ the site's absolute base URL, configured in
 *                         astro.config.* (`site:`). REQUIRED: if `site` is
 *                         unset, `new URL(path, Astro.site)` throws at build
 *                         time — this component is the tripwire that surfaces a
 *                         missing `site` config.
 *   - Astro.url ......... the current page's URL (used for the canonical path).
 *   - Astro.generator ... Astro's version string for the <meta generator> tag.
 *
 * DEPENDED ON BY
 *   Every page, transitively, via the site layouts. A change here changes the
 *   head of the entire site, so treat edits as site-wide.
 *
 * SECURITY / SAFETY NOTES
 *   - No secrets, tokens, or auth here. This file has NO relationship to
 *     Supabase RLS, Pages Functions, paywall entitlements, Turnstile, or
 *     Dodo webhooks — it is pure static presentation metadata and safe to ship
 *     to anonymous visitors and bots.
 *   - INJECTION SURFACE: `title`/`description`/`image` are interpolated into
 *     meta attributes. Astro auto-escapes expression values in attributes, so
 *     these are safe against HTML/attribute injection — but callers should
 *     still pass trusted, human-authored copy (post frontmatter), not raw
 *     user-generated content, to avoid misleading OG previews.
 *   - All URLs are resolved to ABSOLUTE via `new URL(..., Astro.site)`.
 *     OpenGraph/Twitter and canonical tags require absolute URLs; relative
 *     ones are silently ignored by scrapers, so this normalization is
 *     load-bearing, not cosmetic.
 */

/**
 * Props contract for this component.
 * @property title       Page title -> <title> + og:title + twitter:title.
 * @property description Meta description -> description + og/twitter description.
 * @property image       OPTIONAL absolute-or-root-relative path to a social
 *                        share image. When omitted we fall back to the favicon
 *                        (see `ogImage` below) so previews always have an image.
 */
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Canonical URL for THIS page: combine the current pathname with the site's
// base URL to get a stable absolute URL. Prevents duplicate-content SEO
// penalties (e.g. trailing-slash / query-string variants all point here).
const canonical = new URL(Astro.url.pathname, Astro.site);

// Absolute URL for the social-share image. WHY the `?? '/favicon.svg'`
// fallback: og:image / twitter:image must always be present and absolute for a
// card to render; if a page supplies no image we degrade gracefully to the
// site favicon rather than emitting a broken/empty image tag.
const ogImage = new URL(image ?? '/favicon.svg', Astro.site);
---

{/*
  TEMPLATE: emits the raw <head> children. No wrapping element — the including
  layout provides the surrounding <head>. Every {expression} below is
  auto-escaped by Astro when placed in an attribute value.
*/}

{/* Core document metadata. charset MUST come first (within the head's first
    bytes) so the browser parses the rest of the head with the right encoding.
    viewport enables responsive layout on mobile. */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* Own the scroll position on load. The browser's default 'auto' restoration fights our
    async-rendered content (the feed, comments, highlights render AFTER first paint, changing page
    height): it restores against a page that is still short, so it lands wrong — which is why
    reloads were opening near the bottom. We take over and restore deliberately instead:

      reload / fresh navigation -> top
      back / forward            -> exactly where the reader was

    Native #hash deep-links and in-page anchor scrolls are unaffected (fragment navigation is
    independent of scrollRestoration). Inline + early in <head> so it runs before the browser
    would have attempted its own restore. */}
<script is:inline>
  (function () {
    try {
      if (!('scrollRestoration' in history)) return;
      history.scrollRestoration = 'manual';

      var key = 'ays:y:' + location.pathname + location.search;
      var save = function () {
        try {
          sessionStorage.setItem(key, Math.round(window.scrollY) + ':' + document.documentElement.scrollHeight);
        } catch (e) {}
      };
      addEventListener('pagehide', save);
      addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') save();
      });

      var nav = (performance.getEntriesByType('navigation') || [])[0];
      if (!nav || nav.type !== 'back_forward') return; // reload / fresh nav stay at the top

      var y = 0, h = 0;
      try {
        var parts = (sessionStorage.getItem(key) || '').split(':');
        y = parseInt(parts[0], 10) || 0;
        h = parseInt(parts[1], 10) || 0;
      } catch (e) {}
      if (y <= 0) return;

      // Restore WITHOUT the jump. The saved offset is unreachable at first paint (the feed and
      // comments render later), so waiting for the content would show the top first and then
      // lurch down. Instead reserve the page's previous height up front, which makes the offset
      // immediately valid — we land at the right place and the content fills in around us, so
      // the viewport never moves. The reservation is released once the real content is tall
      // enough to hold the position on its own (so removing it can't cause a jump either).
      var filler = document.createElement('style');
      filler.textContent = 'html{min-height:' + Math.max(h, y + 2000) + 'px}';
      document.head.appendChild(filler);

      var live = true;
      var drop = function () { if (filler.parentNode) filler.parentNode.removeChild(filler); };
      var stop = function () { live = false; drop(); }; // reader took over: never fight them
      addEventListener('wheel', stop, { passive: true, once: true });
      addEventListener('touchstart', stop, { passive: true, once: true });
      addEventListener('keydown', stop, { once: true });

      var land = function () { if (live) window.scrollTo({ top: y, behavior: 'instant' }); };
      if (document.readyState === 'loading') addEventListener('DOMContentLoaded', land);
      else land();

      // Hold the reservation until the real content can carry the offset, then let it go.
      var tries = 0;
      (function release() {
        if (!live) return;
        var real = document.body ? document.body.getBoundingClientRect().height : 0;
        if (real >= y + window.innerHeight || ++tries > 60) { drop(); land(); return; }
        setTimeout(release, 50);
      })();
    } catch (e) { /* private mode / no sessionStorage — fall back to opening at the top */ }
  })();
</script>
{/* Astro.generator resolves to a string like "Astro vX.Y.Z". This intentionally
    discloses the framework + version (Astro's default). Harmless here, but if
    version fingerprinting ever becomes a concern, this single line is the tag to
    drop. */}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
{/* Canonical + favicon. `.toString()` turns the URL object into the string the
    attribute expects. The favicon is referenced by a fixed root-relative path
    (not the resolved `ogImage`) because the browser resolves it against the
    page origin and it is always this exact asset. */}
<link rel="canonical" href={canonical.toString()} />
{/* Favicon. The SVG is the preferred icon and is theme-aware: it carries a
    `prefers-color-scheme` media query, so the mark follows the OS-themed browser
    chrome (plum ground/cream rules in light, bronze ground/dark rules in dark) —
    the same accent↔on-accent pairing the site uses. The PNGs are the static
    fallback for browsers without SVG-icon support; .ico serves legacy
    /favicon.ico requests; apple-touch-icon is the iOS home-screen tile. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{/* theme-color tints the mobile browser UI to match the site's paper per scheme. */}
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf7f1" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#181510" />
{/* Preload the editorial serifs used for the LCP heading + first body text, so the
    font fetch runs in parallel with CSS instead of after it (cuts the swap window). */}
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/SourceSerif4-Variable.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/CharisSIL-Regular.woff2" />

{/* OpenGraph tags: consumed by Facebook/LinkedIn/Slack/Discord/iMessage etc.
    og:url mirrors the canonical URL; og:image MUST be absolute (see frontmatter
    `ogImage`). og:site_name is a fixed brand string. */}
<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage.toString()} />
<meta property="og:site_name" content="areyoustillreading" />

{/* Twitter/X Card tags. `summary_large_image` renders the big-image card
    style; it reuses the same absolute title/description/image as OpenGraph so
    both networks show a consistent preview. */}
<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />
