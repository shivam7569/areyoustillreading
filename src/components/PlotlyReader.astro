---
/**
 * PlotlyReader.astro — hydrates published Plotly figures on reader pages.
 * Included once in BlogPost. Finds every `.plotly-figure` (emitted by
 * src/lib/rehype-plotly.mjs), and when it scrolls near the viewport, loads
 * plotly.js from cdn.plot.ly (already in the CSP allowlist) and renders the
 * figure JSON interactively — 3D plots rotate/zoom, exactly like the editor.
 * Pyodide never runs here; only the pre-computed figure JSON does. If there are
 * no figures on the page, nothing loads.
 */
---
<script is:inline>
  (function () {
    // Demo chrome: the Code/Output segmented toggle + Copy button (design .fig.demo).
    // Wired independently of the plot so it works even before/without a live figure.
    document.querySelectorAll('.py-plot').forEach(function (demo) {
      var segs = demo.querySelectorAll('.seg button');
      var panes = demo.querySelectorAll('.pane');
      segs.forEach(function (b) {
        b.addEventListener('click', function () {
          var want = b.getAttribute('data-pane'); // 'code' | 'out'
          segs.forEach(function (x) { x.classList.toggle('on', x === b); });
          panes.forEach(function (p) {
            var isOut = p.classList.contains('py-pane-out');
            p.classList.toggle('on', want === 'out' ? isOut : !isOut);
          });
          // The output pane was display:none, so Plotly must re-measure on reveal.
          if (want === 'out') { var h = demo.querySelector('.plotly-holder'); if (h && window.Plotly) window.Plotly.Plots.resize(h); }
        });
      });
      var cpy = demo.querySelector('[data-cpy]');
      if (cpy) cpy.addEventListener('click', function () {
        var code = demo.querySelector('.py-pane-code code') || demo.querySelector('.py-pane-code pre');
        var text = code ? code.innerText.replace(/^\s*\d+\t?/gm, '') : '';
        if (navigator.clipboard && text) navigator.clipboard.writeText(text).catch(function () {});
        cpy.textContent = 'Copied'; setTimeout(function () { cpy.textContent = 'Copy'; }, 1600);
      });
    });

    var figs = document.querySelectorAll('.plotly-figure');
    if (!figs.length) return;
    var PLOTLY_JS = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
    var loading = null;
    function loadPlotly() {
      if (window.Plotly) return Promise.resolve(window.Plotly);
      if (!loading) {
        loading = new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = PLOTLY_JS;
          s.onload = function () { resolve(window.Plotly); };
          s.onerror = function () { reject(new Error('plotly.js failed to load')); };
          document.head.appendChild(s);
        });
      }
      return loading;
    }
    function render(fig) {
      if (fig.__done) return;
      fig.__done = true;
      var dataEl = fig.querySelector('script.plotly-json');
      if (!dataEl) return;
      var figure;
      try { figure = JSON.parse(dataEl.textContent); } catch (e) { return; }
      var holder = document.createElement('div');
      holder.className = 'plotly-holder';
      fig.appendChild(holder);
      // Fit the plot to the column: drop any hard-coded width/height, autosize.
      var layout = Object.assign({}, figure.layout || {});
      delete layout.width;
      delete layout.height;
      layout.autosize = true;
      // The plot now sits on the always-dark .plotwrap (design .fig.demo), so force
      // Plotly's backgrounds transparent AND paint the axes/font in light-on-dark
      // values — the figure's own colours may be tuned for a light mat and would
      // otherwise vanish on the dark surface. Consistent in both page themes.
      layout.paper_bgcolor = 'rgba(0,0,0,0)';
      layout.plot_bgcolor = 'rgba(0,0,0,0)';
      var AX = { gridcolor: '#3b3327', zerolinecolor: '#4b4133', linecolor: '#4b4133', color: '#b3a793' };
      layout.font = Object.assign({}, layout.font || {}, { color: '#b3a793' });
      if (layout.scene) {
        layout.scene = Object.assign({}, layout.scene, {
          bgcolor: 'rgba(0,0,0,0)',
          xaxis: Object.assign({}, layout.scene.xaxis || {}, AX),
          yaxis: Object.assign({}, layout.scene.yaxis || {}, AX),
          zaxis: Object.assign({}, layout.scene.zaxis || {}, AX),
        });
      } else {
        layout.xaxis = Object.assign({}, layout.xaxis || {}, AX);
        layout.yaxis = Object.assign({}, layout.yaxis || {}, AX);
      }
      loadPlotly().then(function (P) {
        P.newPlot(holder, figure.data || [], layout, { responsive: true, displaylogo: false });
      }).catch(function () {
        holder.textContent = 'Could not load the interactive plot.';
      });
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { render(e.target); io.unobserve(e.target); }
        });
      }, { rootMargin: '250px' });
      figs.forEach(function (f) { io.observe(f); });
    } else {
      figs.forEach(render);
    }
  })();
</script>
