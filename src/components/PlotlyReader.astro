---
/**
 * PlotlyReader.astro — hydrates published Plotly figures on reader pages.
 * Included once in BlogPost. Finds every `.plotly-figure` (emitted by
 * src/lib/rehype-plotly.mjs), and when it scrolls near the viewport, loads
 * plotly.js from cdn.plot.ly (already in the CSP allowlist) and renders the
 * figure JSON interactively — 3D plots rotate/zoom, exactly like the editor.
 * Pyodide never runs here; only the pre-computed figure JSON does. If there are
 * no figures on the page, nothing loads.
 */
---
<script is:inline>
  (function () {
    var figs = document.querySelectorAll('.plotly-figure');
    if (!figs.length) return;
    var PLOTLY_JS = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
    var loading = null;
    function loadPlotly() {
      if (window.Plotly) return Promise.resolve(window.Plotly);
      if (!loading) {
        loading = new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = PLOTLY_JS;
          s.onload = function () { resolve(window.Plotly); };
          s.onerror = function () { reject(new Error('plotly.js failed to load')); };
          document.head.appendChild(s);
        });
      }
      return loading;
    }
    function render(fig) {
      if (fig.__done) return;
      fig.__done = true;
      var dataEl = fig.querySelector('script.plotly-json');
      if (!dataEl) return;
      var figure;
      try { figure = JSON.parse(dataEl.textContent); } catch (e) { return; }
      var holder = document.createElement('div');
      holder.className = 'plotly-holder';
      fig.appendChild(holder);
      // Fit the plot to the column: drop any hard-coded width/height, autosize.
      var layout = Object.assign({}, figure.layout || {});
      delete layout.width;
      delete layout.height;
      layout.autosize = true;
      loadPlotly().then(function (P) {
        P.newPlot(holder, figure.data || [], layout, { responsive: true, displaylogo: false });
      }).catch(function () {
        holder.textContent = 'Could not load the interactive plot.';
      });
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { render(e.target); io.unobserve(e.target); }
        });
      }, { rootMargin: '250px' });
      figs.forEach(function (f) { io.observe(f); });
    } else {
      figs.forEach(render);
    }
  })();
</script>
