---
/**
 * Comments.astro — per-post comment thread, built to the Claude Design's
 * `.comments` UI (sec-head + count, a .cbox composer with an avatar, a threaded
 * .clist with avatars / an "Author" badge / Reply + Link, nested .reply).
 *
 * Backend unchanged in spirit: the `comments` table over PostgREST (RLS is the
 * only guard). db/comments-threads.sql adds `parent_id` (one-level replies) +
 * `author_is_admin` (set server-side by trigger for the honest Author badge);
 * flat comments still work without it. Bodies render through a SAFE tiny-Markdown
 * (escape first, then a whitelist of bold/italic/code/links) so "Markdown works"
 * without any XSS surface.
 *
 * SECURITY: RLS enforces auth (user_id = auth.uid()) on insert; the client
 * user_id/author_name are display-only. Comment text is HTML-escaped before any
 * formatting, and links are restricted to http(s)/relative — no raw HTML runs.
 */
interface Props { postId: string; }
const { postId } = Astro.props;
---

<section class="comments" data-post-id={postId}>
  <div class="sec-head"><h2 id="cc-count">Comments</h2><span class="meta-caps">Sign in to join in</span></div>
  <div id="cc-compose"></div>
  <div class="clist" id="cc-list"><p class="cc-muted">Loading comments…</p></div>
</section>

{/* Global because the thread is injected at runtime (scoped styles never reach
    runtime DOM). All selectors are namespaced under .comments so nothing leaks. */}
<style is:global>
  .comments { margin: clamp(34px, 5vw, 52px) 0 0; padding-top: 30px; border-top: 1px solid var(--rule); }
  .comments .cc-muted { color: var(--ink-faint); font-family: var(--sans); font-size: 14px; }
  .comments .avatar { width: 36px; height: 36px; flex: none; border-radius: 999px; display: grid; place-items: center; font-family: var(--serif-display); font-size: 16px; line-height: 1; background: radial-gradient(120% 120% at 30% 20%, var(--accent-soft), var(--accent)); color: var(--on-accent); user-select: none; }
  .comments .avatar.q { background: var(--paper-2); color: var(--ink-faint); border: 1px solid var(--rule); }

  .cbox { display: flex; gap: 14px; margin: 22px 0 32px; }
  .cbox .avatar { background: var(--paper-2); color: var(--ink-faint); border: 1px solid var(--rule); }
  .cbox .f { flex: 1; min-width: 0; }
  .cbox textarea { width: 100%; box-sizing: border-box; min-height: 82px; resize: vertical; font-family: var(--serif-body); font-size: 16px; line-height: 1.6; padding: 12px 14px; border: 1px solid var(--rule); border-radius: 4px; background: var(--card); color: var(--ink); }
  .cbox textarea::placeholder { color: var(--ink-faint); }
  .cbox textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .cbox .foot { display: flex; align-items: center; gap: 12px; margin-top: 10px; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); flex-wrap: wrap; }
  .cbox .foot .btn { margin-left: auto; }
  .comments .signin { font-family: var(--sans); font-size: 14px; color: var(--ink-faint); margin: 22px 0 32px; }
  .comments .signin a { color: var(--accent); }

  .clist { display: flex; flex-direction: column; gap: 26px; }
  .comment { display: flex; gap: 14px; }
  .comment .b { flex: 1; min-width: 0; }
  .comment .hd { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-family: var(--sans); font-size: 13px; margin-bottom: 6px; }
  .comment .hd b { color: var(--ink); font-weight: 600; }
  .comment .hd .when { color: var(--ink-faint); font-size: 12px; }
  .comment .hd .badge { font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--rule)); border-radius: 2px; padding: 2px 6px; }
  .comment > .b > p { margin: 0; font-size: 16.5px; line-height: 1.65; color: var(--ink-soft); overflow-wrap: anywhere; }
  .comment > .b > p code.inl { font-family: var(--mono); font-size: .82em; background: var(--paper-2); border: 1px solid var(--rule); border-radius: 4px; padding: .1em .4em; color: var(--accent); }
  .comment > .b > p a { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  .comment .acts { display: flex; gap: 16px; margin-top: 9px; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); }
  .comment .acts button { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; }
  .comment .acts button:hover { color: var(--accent); }
  .comment .reply { margin-top: 20px; padding-left: 22px; border-left: 1px solid var(--rule); display: flex; flex-direction: column; gap: 20px; }
  .comment .reply-slot .cbox { margin: 16px 0 0; }
  .comment .reply-slot .cbox textarea { min-height: 60px; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const root = document.querySelector('.comments') as HTMLElement | null;
  if (root) initComments(root);

  function initComments(root: HTMLElement) {
    const postId = root.getAttribute('data-post-id') || '';
    const list = document.getElementById('cc-list')!;
    const compose = document.getElementById('cc-compose')!;
    const countEl = document.getElementById('cc-count')!;

    const authorNameOf = (u: any) => { const m = u.user_metadata || {}; return m.user_name || m.name || (u.email ? u.email.split('@')[0] : 'Reader'); };
    const esc = (s: any) => String(s).replace(/[&<>]/g, (c: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as any)[c]);

    // SAFE tiny-Markdown: escape first (so no raw HTML survives), then apply a
    // whitelist. Links limited to http(s)/relative so no javascript: urls.
    function md(s: string) {
      let e = esc(s);
      // Protect math ($$…$$ display, $…$ inline) from the Markdown pass so _ ^ * { }
      // inside equations are never mangled into <em>/<strong>; KaTeX renders them
      // after (renderMath). Stash the ESCAPED spans, restore verbatim.
      const math: string[] = [];
      const stash = (m: string) => { math.push(m); return '@@KMATH' + (math.length - 1) + 'X@@'; };
      e = e.replace(/\$\$([\s\S]+?)\$\$/g, (m) => stash(m));
      e = e.replace(/\$([^$\n]+?)\$/g, (m) => stash(m));
      e = e.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]*)\)/g, (_m, t, u) => '<a href="' + u.replace(/"/g, '%22') + '" rel="nofollow noopener" target="_blank">' + t + '</a>');
      e = e.replace(/`([^`]+)`/g, '<code class="inl">$1</code>');
      e = e.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      e = e.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
      e = e.replace(/(^|[^\w])_([^_\n]+)_/g, '$1<em>$2</em>');
      e = e.replace(/\n/g, '<br>');
      e = e.replace(/@@KMATH([0-9]+)X@@/g, (_m, i) => math[+i]); // restore raw math for KaTeX
      return e;
    }

    // Lazy KaTeX: render $…$ / $$…$$ in each comment body. The KaTeX CSS already
    // ships on post pages (BlogPost imports it); the JS loads only when comments do.
    // throwOnError:false + default trust:false keep author LaTeX inert + safe.
    let renderMathInElement: any = null;
    async function renderMath() {
      const nodes = list.querySelectorAll('.comment > .b > p');
      if (!nodes.length) return;
      try {
        if (!renderMathInElement) { const mod: any = await import('katex/contrib/auto-render'); renderMathInElement = mod.default || mod; }
        nodes.forEach((n) => renderMathInElement(n, { delimiters: [{ left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false }], throwOnError: false }));
      } catch (e) {}
    }
    function timeAgo(iso: string) {
      const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
      if (s < 60) return 'just now';
      const m = s / 60; if (m < 60) return Math.floor(m) + (m < 2 ? ' minute ago' : ' minutes ago');
      const h = m / 60; if (h < 24) return Math.floor(h) + (h < 2 ? ' hour ago' : ' hours ago');
      const d = h / 24; if (d < 7) return Math.floor(d) + (d < 2 ? ' day ago' : ' days ago');
      if (d < 30) { const w = Math.floor(d / 7); return w + (w < 2 ? ' week ago' : ' weeks ago'); }
      return new Date(iso).toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
    }

    function renderComment(r: any, kidsOf: Record<string, any[]>): string {
      const who = r.author_name || 'Reader';
      const kids = (kidsOf[r.id] || []).map((c) => renderComment(c, kidsOf)).join('');
      return '<div class="comment" id="comment-' + r.id + '" data-id="' + r.id + '">'
        + '<div class="avatar' + (r.author_is_admin ? '' : ' q') + '" aria-hidden="true">' + esc((who[0] || '?')) + '</div>'
        + '<div class="b"><div class="hd"><b>' + esc(who) + '</b>' + (r.author_is_admin ? '<span class="badge">Author</span>' : '') + '<span class="when">' + esc(timeAgo(r.created_at)) + '</span></div>'
        + '<p>' + md(r.body) + '</p>'
        + '<div class="acts"><button type="button" data-reply>Reply</button><button type="button" data-link>Link</button></div>'
        + (kids ? '<div class="reply">' + kids + '</div>' : '')
        + '<div class="reply-slot"></div></div></div>';
    }

    async function load() {
      let res = await supabase.from('comments').select('id,author_name,body,created_at,parent_id,author_is_admin').eq('post_id', postId).order('created_at', { ascending: true });
      if (res.error) { res = await supabase.from('comments').select('id,author_name,body,created_at').eq('post_id', postId).order('created_at', { ascending: true }); }
      if (res.error) { list.innerHTML = '<p class="cc-muted">Could not load comments.</p>'; return; }
      const rows = (res.data || []) as any[];
      countEl.textContent = rows.length ? rows.length + (rows.length === 1 ? ' comment' : ' comments') : 'Comments';
      const kidsOf: Record<string, any[]> = {};
      rows.forEach((r) => { if (r.parent_id) (kidsOf[r.parent_id] = kidsOf[r.parent_id] || []).push(r); });
      const top = rows.filter((r) => !r.parent_id);
      list.innerHTML = top.length ? top.map((r) => renderComment(r, kidsOf)).join('') : '<p class="cc-muted">No comments yet. Be the first.</p>';
    }

    async function post(ta: HTMLTextAreaElement, parentId: string | null, btn: HTMLButtonElement) {
      const body = (ta.value || '').trim(); if (!body) { ta.focus(); return; }
      const s = await supabase.auth.getSession(); const user = s.data.session ? s.data.session.user : null;
      if (!user) return;
      btn.disabled = true;
      const payload: any = { post_id: postId, user_id: user.id, author_name: authorNameOf(user), body }; if (parentId) payload.parent_id = parentId;
      const res = await supabase.from('comments').insert(payload);
      if (res.error) { btn.disabled = false; const foot = btn.closest('.foot'); if (foot) { let em = foot.querySelector('.cc-err') as HTMLElement | null; if (!em) { em = document.createElement('span'); em.className = 'cc-err'; em.style.color = '#b4453a'; foot.insertBefore(em, btn); } em.textContent = res.error.message || 'Could not post.'; } return; }
      ta.value = ''; load();
    }

    function composerHTML(name: string, small: boolean) {
      return '<div class="cbox"><div class="avatar" aria-hidden="true">' + esc((name[0] || '?').toLowerCase()) + '</div>'
        + '<div class="f"><textarea placeholder="' + (small ? 'Reply…' : 'Say something worth reading.') + '"></textarea>'
        + '<div class="foot"><span>Signed in as ' + esc(name) + ' — Markdown works</span><button class="btn btn-primary btn-sm" type="button" data-post>' + (small ? 'Reply' : 'Post comment') + '</button></div></div></div>';
    }

    async function renderCompose() {
      const s = await supabase.auth.getSession(); const user = s.data.session ? s.data.session.user : null;
      if (!user) { compose.className = 'signin'; compose.innerHTML = '<a href="/login">Sign in</a> to join the conversation.'; return; }
      const name = authorNameOf(user);
      compose.className = ''; compose.innerHTML = composerHTML(name, false);
      const btn = compose.querySelector('[data-post]') as HTMLButtonElement;
      btn.addEventListener('click', () => post(compose.querySelector('textarea') as HTMLTextAreaElement, null, btn));
    }

    // Reply / Link delegation on the thread.
    list.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-link]')) {
        const c = t.closest('.comment') as HTMLElement; if (!c) return;
        const url = location.origin + location.pathname + '#comment-' + c.dataset.id;
        if (navigator.clipboard) navigator.clipboard.writeText(url).catch(() => {});
        const b = t.closest('[data-link]') as HTMLElement; const o = b.textContent; b.textContent = 'Copied'; setTimeout(() => { b.textContent = o; }, 1400);
        return;
      }
      if (t.closest('[data-reply]')) {
        const b = (t.closest('[data-reply]')!.closest('.acts')!.parentNode) as HTMLElement; // the .b
        const slot = b.querySelector(':scope > .reply-slot') as HTMLElement; if (!slot) return;
        if (slot.firstChild) { slot.innerHTML = ''; return; } // toggle off
        const s = await supabase.auth.getSession(); const user = s.data.session ? s.data.session.user : null;
        if (!user) { slot.innerHTML = '<p class="cc-muted" style="margin:12px 0 0"><a href="/login" style="color:var(--accent)">Sign in</a> to reply.</p>'; return; }
        slot.innerHTML = composerHTML(authorNameOf(user), true);
        const cid = (b.closest('.comment') as HTMLElement).dataset.id!;
        const rbtn = slot.querySelector('[data-post]') as HTMLButtonElement;
        const rta = slot.querySelector('textarea') as HTMLTextAreaElement;
        rta.focus();
        rbtn.addEventListener('click', () => post(rta, cid, rbtn));
      }
    });

    supabase.auth.onAuthStateChange(() => renderCompose());
    load();
    renderCompose();
  }
</script>
