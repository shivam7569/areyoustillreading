---
/**
 * Highlights.astro — reader highlights + per-passage discussion, built to the
 * Claude Design's highlight system (selection toolbar, mark.hl variants, the
 * floating count pill, the slide-in drawer, discussion threads) but persisted to
 * SUPABASE, not the design mock's localStorage.
 *
 * Bridge: the design engine anchors on {blockIndex, s, e}; the backend stores the
 * `quote` TEXT (durable across re-render/theme/reflow). On load we re-anchor each
 * saved quote to its block + char offsets, then the design's split-and-wrap
 * paint()/render() engine runs verbatim. `mark.hl[data-id]` = the Supabase row id.
 *
 * Tables (unchanged): `highlights` (id, post_id, user_id, author_name, quote,
 * note?, created_at) + `highlight_comments` (id, highlight_id, user_id,
 * author_name, body, author_is_admin?, created_at); `is_admin()` RPC. The `note`
 * column + `author_is_admin` + owner-UPDATE policy come from db/highlights-notes.sql
 * (basic highlighting works without it; notes + the Author badge need it applied).
 *
 * SECURITY: RLS is the only guard (browser is untrusted). All user text is written
 * via textContent / esc()-then-DOM, never raw innerHTML of user content.
 */
interface Props {
  postId: string;
  author?: string;
  title?: string;
}
const { postId, author = '', title = '' } = Astro.props;
---

{/* Selection toolbar — appears above a text selection inside the article. Also
    carries postId/author/title to the client script via data-attrs. */}
<div class="seltool" id="seltool" role="toolbar" aria-label="Selection actions" data-post-id={postId} data-author={author} data-title={title}>
  <button data-act="hl" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L20 8l-4-4L4 16Z"></path><path d="M14 6l4 4"></path></svg>Highlight</button>
  <button data-act="note" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v10l-4 4H4Z"></path><path d="M8 9h8M8 13h5"></path></svg>Note</button>
  <span class="sep"></span>
  <button data-act="copy" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>Copy</button>
  <button data-act="quote" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h4v5a4 4 0 0 1-4 4"></path><path d="M15 7h4v5a4 4 0 0 1-4 4"></path></svg>Quote</button>
</div>

{/* Floating count pill — opens the drawer. Shown only once a signed-in reader's
    highlights are loaded (init reveals it). */}
<button class="hlpill" id="hlpill" type="button" aria-label="Open your highlights">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L20 8l-4-4L4 16Z"></path><path d="M14 6l4 4"></path></svg>
  <span id="hllabel"><b id="hlcount">0</b> highlights</span>
</button>

{/* Scrim + slide-in drawer. #hldbody is filled by the client script. */}
<div class="hlscrim" id="hlscrim"></div>
<aside class="hldraw" id="hldraw" aria-label="Your highlights">
  <div class="hld-top">
    <h3>Your highlights</h3><span class="n" id="hldn">none yet</span>
    <button class="x" id="hlx" type="button" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"></path></svg></button>
  </div>
  <div class="hld-body" id="hldbody"></div>
  <div class="hld-foot"><button id="hlcopyall" type="button">Copy all</button><span>Saved to your account — on every device.</span></div>
</aside>

{/* Global because mark.hl / .pip are injected at runtime (scoped styles wouldn't
    reach them), and the drawer/toolbar names are all hl/hld/sel/rep-prefixed so
    there is no collision with site CSS. Verbatim from the design. */}
<style is:global>
  mark.hl { background: color-mix(in srgb, var(--accent) 17%, transparent); color: inherit; padding: .06em 0; border-radius: 1px; box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--accent) 45%, transparent); cursor: pointer; transition: background .18s; }
  mark.hl:hover { background: color-mix(in srgb, var(--accent) 26%, transparent); }
  mark.hl.note { box-shadow: inset 0 -2px 0 var(--accent); }
  mark.hl.flash { background: color-mix(in srgb, var(--accent) 38%, transparent); }
  mark.hl:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; } /* deep-link target focus */
  .pop { position: relative; border-bottom: 2px dotted color-mix(in srgb, var(--accent) 50%, transparent); cursor: help; }
  .pop::after { content: "Many readers marked this one"; position: absolute; left: 50%; bottom: calc(100% + 9px); transform: translateX(-50%); white-space: nowrap; font-family: var(--sans); font-size: 11px; letter-spacing: .05em; color: var(--on-accent); background: var(--accent); padding: 4px 9px; border-radius: 3px; opacity: 0; pointer-events: none; transition: opacity .18s; z-index: 5; }
  .pop:hover::after { opacity: 1; }
  mark.hl.talk, .pop.talk { padding-right: 2px; }
  .pip { display: inline-flex; align-items: center; justify-content: center; min-width: 17px; height: 17px; padding: 0 4px; margin-left: 4px; vertical-align: .32em; border: 0; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-family: var(--sans); font-size: 10px; font-weight: 600; line-height: 1; letter-spacing: .02em; cursor: pointer; font-variant-numeric: tabular-nums; transition: transform .18s; }
  .pip:hover { transform: scale(1.14); }

  /* the key / legend inside the drawer */
  .hlkey { margin: 6px 0 4px; border: 1px solid var(--rule); border-radius: 5px; background: var(--card); overflow: hidden; }
  .hlkey > summary { list-style: none; cursor: pointer; padding: 11px 14px; font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); display: flex; align-items: center; gap: 9px; }
  .hlkey > summary::-webkit-details-marker { display: none; }
  .hlkey > summary:hover { color: var(--accent); }
  .hlkey > summary .cv { width: 11px; height: 11px; transition: transform .2s; color: var(--accent); }
  .hlkey[open] > summary .cv { transform: rotate(90deg); }
  .krow { display: flex; align-items: baseline; gap: 12px; padding: 9px 14px; border-top: 1px solid var(--rule-soft); font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); }
  .krow .s { flex: none; width: 74px; font-family: var(--serif-body); font-size: 14.5px; color: var(--ink); text-align: center; }
  .krow .s.w { background: color-mix(in srgb, var(--accent) 17%, transparent); box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 1px; }
  .krow .s.n { background: color-mix(in srgb, var(--accent) 17%, transparent); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 1px; }
  .krow .s.d { border-bottom: 2px dotted color-mix(in srgb, var(--accent) 50%, transparent); }
  .krow .s.t { background: color-mix(in srgb, var(--accent) 17%, transparent); box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 1px; }
  .krow .s.t i { display: inline-flex; align-items: center; justify-content: center; min-width: 15px; height: 15px; margin-left: 3px; vertical-align: .3em; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-family: var(--sans); font-style: normal; font-size: 9px; font-weight: 600; }

  /* discussion thread inside the drawer */
  .thv .back { background: none; border: 0; padding: 0; margin: 14px 0 16px; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); cursor: pointer; }
  .thv .back:hover { color: var(--accent); }
  .thv > q { display: block; font-family: var(--serif-display); font-size: 16.5px; line-height: 1.5; color: var(--ink); quotes: none; border-left: 2px solid var(--accent); padding-left: 13px; margin-bottom: 20px; }
  .rep { display: flex; gap: 11px; padding: 14px 0; border-top: 1px solid var(--rule-soft); }
  .rep .av { width: 29px; height: 29px; flex: none; border-radius: 999px; background: var(--paper-2); border: 1px solid var(--rule); display: grid; place-items: center; font-family: var(--serif-display); font-size: 13px; color: var(--ink-soft); }
  .rep.auth .av { background: radial-gradient(120% 120% at 30% 20%, var(--accent-soft), var(--accent)); border-color: transparent; color: var(--on-accent); }
  .rep .hd { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-family: var(--sans); font-size: 12px; margin-bottom: 4px; }
  .rep .hd b { color: var(--ink); font-weight: 600; }
  .rep .hd .w { color: var(--ink-faint); font-size: 11px; }
  .rep .hd .bg { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--rule)); border-radius: 2px; padding: 1px 5px; }
  .rep p { margin: 0; font-family: var(--serif-body); font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
  .repbox { margin-top: 16px; }
  .repbox textarea { width: 100%; min-height: 66px; resize: none; overflow: hidden; font-family: var(--serif-body); font-size: 14.5px; line-height: 1.6; color: var(--ink); background: var(--card); border: 1px solid var(--rule); border-radius: 4px; padding: 10px 12px; box-sizing: border-box; }
  .rep .rep-acts { margin-top: 7px; }
  .rep .rep-acts .up { display: inline-flex; align-items: center; gap: 4px; background: none; border: 0; padding: 0; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); cursor: pointer; font-variant-numeric: tabular-nums; }
  .rep .rep-acts .up .uparrow { font-size: 10px; line-height: 1; }
  .rep .rep-acts .up:hover, .rep .rep-acts .up.on { color: var(--accent); }
  .rep .rep-acts .repdel { margin-left: 14px; background: none; border: 0; padding: 0; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); cursor: pointer; }
  .rep .rep-acts .repdel:hover { color: #b4453a; }
  .repbox textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .repbox .r { display: flex; align-items: center; gap: 10px; margin-top: 9px; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); flex-wrap: wrap; }
  .repbox .r .btn { margin-left: auto; }

  /* the selection toolbar */
  .seltool { position: fixed; z-index: 80; display: none; align-items: center; gap: 1px; background: var(--ink); border-radius: 5px; padding: 4px; box-shadow: 0 10px 28px rgba(0, 0, 0, .3); }
  .seltool.on { display: flex; }
  .seltool button { background: none; border: 0; color: var(--paper); font-family: var(--sans); font-size: 12px; display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border-radius: 3px; cursor: pointer; opacity: .82; white-space: nowrap; }
  .seltool button:hover { background: color-mix(in srgb, var(--paper) 15%, transparent); opacity: 1; }
  .seltool svg { width: 14px; height: 14px; flex: none; }
  .seltool .sep { width: 1px; height: 20px; background: color-mix(in srgb, var(--paper) 20%, transparent); margin: 0 4px; }

  /* count pill + drawer */
  .hlpill { position: fixed; right: 20px; bottom: 20px; z-index: 70; display: none; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--rule); border-radius: 999px; padding: 10px 16px; box-shadow: var(--shadow); font-family: var(--sans); font-size: 12.5px; color: var(--ink); cursor: pointer; }
  .hlpill.on { display: flex; }
  .hlpill svg { width: 14px; height: 14px; color: var(--accent); }
  .hlpill b { color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .hlscrim { position: fixed; inset: 0; z-index: 85; background: rgba(0, 0, 0, .28); opacity: 0; pointer-events: none; transition: opacity .28s; }
  .hlscrim.on { opacity: 1; pointer-events: auto; }
  .hldraw { position: fixed; top: 0; right: 0; bottom: 0; width: min(390px, 92vw); z-index: 90; background: var(--paper); border-left: 1px solid var(--rule); box-shadow: -20px 0 44px rgba(0, 0, 0, .2); transform: translateX(101%); transition: transform .28s cubic-bezier(.4, 0, .2, 1); display: flex; flex-direction: column; }
  .hldraw.on { transform: none; }
  .hld-top { display: flex; align-items: baseline; gap: 12px; padding: 20px 22px 16px; border-bottom: 1px solid var(--rule); }
  .hld-top h3 { font-family: var(--serif-display); font-weight: 600; font-size: 21px; margin: 0; letter-spacing: -.01em; }
  .hld-top .n { font-family: var(--sans); font-size: 12px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .hld-top .x { margin-left: auto; background: none; border: 0; color: var(--ink-faint); cursor: pointer; padding: 2px; line-height: 1; }
  .hld-top .x:hover { color: var(--accent); }
  .hld-body { flex: 1; overflow-y: auto; padding: 4px 22px 22px; }
  .hld-empty { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: var(--ink-faint); padding: 28px 0; }
  .hitem { padding: 18px 0; border-bottom: 1px solid var(--rule-soft); }
  .hitem q { display: block; font-family: var(--serif-display); font-size: 16.5px; line-height: 1.5; color: var(--ink); quotes: none; border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); padding-left: 13px; cursor: pointer; }
  .hitem q:hover { color: var(--accent); }
  .hitem textarea { width: 100%; margin-top: 11px; min-height: 38px; resize: none; overflow: hidden; font-family: var(--sans); font-size: 13px; line-height: 1.55; color: var(--ink-soft); background: var(--card); border: 1px solid var(--rule); border-radius: 4px; padding: 8px 10px; box-sizing: border-box; }
  .hitem textarea::placeholder { color: var(--ink-faint); }
  .hitem textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .hitem .acts { display: flex; gap: 15px; margin-top: 10px; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); flex-wrap: wrap; }
  .hitem .acts button { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; }
  .hitem .acts button:hover { color: var(--accent); }
  .hitem .acts .del:hover { color: #b4453a; }
  .hld-foot { padding: 14px 22px; border-top: 1px solid var(--rule); display: flex; align-items: center; gap: 12px; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); flex-wrap: wrap; }
  .hld-foot button { background: none; border: 1px solid var(--rule); border-radius: 3px; font: inherit; color: var(--ink-soft); padding: 6px 11px; cursor: pointer; flex: none; white-space: nowrap; }
  .hld-foot button:hover { border-color: var(--accent); color: var(--accent); }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const tool = document.getElementById('seltool');
  if (tool) initHighlights(tool as HTMLElement);

  function initHighlights(tool: HTMLElement) {
    const postId = tool.getAttribute('data-post-id') || '';
    const AUTHOR = tool.getAttribute('data-author') || 'the author';
    const TITLE = tool.getAttribute('data-title') || document.title;
    const body = (document.querySelector('article.post-body') || document.querySelector('article')) as HTMLElement | null;
    const pill = document.getElementById('hlpill')!;
    const draw = document.getElementById('hldraw')!;
    const scrim = document.getElementById('hlscrim')!;
    const dbody = document.getElementById('hldbody')!;
    const dn = document.getElementById('hldn')!;
    const cnt = document.getElementById('hlcount')!;
    const plabel = document.getElementById('hllabel')!;
    if (!body) return;

    let currentUser: any = null;
    let isAdmin = false;
    let lastUid: string | null | undefined = undefined;
    let blocks: HTMLElement[] = [];
    let store: Record<number, any[]> = {};
    let noteTimer: number | undefined;

    const authorNameOf = (u: any) => { const m = u.user_metadata || {}; return m.user_name || m.name || (u.email ? u.email.split('@')[0] : 'Reader'); };
    const esc = (s: any) => String(s).replace(/[<&]/g, (c: string) => (c === '<' ? '&lt;' : '&amp;'));
    const grow = (ta: HTMLTextAreaElement) => { ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px'; };
    // Upvotes for discussion replies (kind 'hlcomment' in the shared `votes` table).
    async function paintReplyVotes(ids: string[]) {
      if (!ids.length) return;
      const res = await supabase.from('votes').select('target_id,user_id').eq('kind', 'hlcomment').in('target_id', ids);
      if (res.error) return;
      const counts: Record<string, { n: number; mine: boolean }> = {};
      (res.data || []).forEach((v: any) => { const t = (counts[v.target_id] = counts[v.target_id] || { n: 0, mine: false }); t.n++; if (currentUser && v.user_id === currentUser.id) t.mine = true; });
      dbody.querySelectorAll('.rep[data-cid]').forEach((rep) => {
        const up = rep.querySelector('.up') as HTMLElement | null; if (!up) return;
        const c = counts[(rep as HTMLElement).dataset.cid!] || { n: 0, mine: false };
        (up.querySelector('.upn') as HTMLElement).textContent = String(c.n); up.classList.toggle('on', c.mine);
      });
    }
    async function toggleHlVote(id: string, btn: HTMLElement) {
      if (!currentUser) return;
      const on = btn.classList.contains('on'); const upn = btn.querySelector('.upn') as HTMLElement; const n = parseInt(upn.textContent || '0', 10) || 0;
      btn.classList.toggle('on', !on); upn.textContent = String(on ? Math.max(0, n - 1) : n + 1);
      const res = on
        ? await supabase.from('votes').delete().eq('user_id', currentUser.id).eq('kind', 'hlcomment').eq('target_id', id)
        : await supabase.from('votes').insert({ user_id: currentUser.id, kind: 'hlcomment', target_id: id });
      if (res.error) { btn.classList.toggle('on', on); upn.textContent = String(n); }
    }
    const findHl = (id: string) => { let f: any = null; Object.keys(store).forEach((k) => (store[+k] || []).forEach((h) => { if (h.id === id) f = h; })); return f; };
    const blockOf = (id: string) => { let bi = -1; Object.keys(store).forEach((k) => { if ((store[+k] || []).some((x) => x.id === id)) bi = +k; }); return bi; };

    // Popular passages (design .pop) — a privacy-safe RPC returns ONLY the text of
    // quotes >= N distinct readers marked (no counts, no identity). Public: shown to
    // everyone. Best-effort wrap of the first single-text-node match into a dotted
    // `.pop` whose hover tooltip reads "Many readers marked this one".
    async function paintPopular() {
      try {
        const res = await supabase.rpc('highlight_popular', { p_post_id: postId });
        if (res.error || !res.data) return;
        (res.data as any[]).forEach((row) => wrapPop(row.quote));
      } catch (e) {}
    }
    function wrapPop(quote: string) {
      if (!quote || quote.length < 6) return;
      const w = document.createTreeWalker(body!, NodeFilter.SHOW_TEXT, { acceptNode: (n) => ((n.parentNode as HTMLElement).closest('pre,.ln,mark,.pop,a,button') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT) } as any);
      let n: any;
      while ((n = w.nextNode())) {
        const idx = n.nodeValue.indexOf(quote);
        if (idx !== -1) {
          try { const range = document.createRange(); range.setStart(n, idx); range.setEnd(n, idx + quote.length); const span = document.createElement('span'); span.className = 'pop'; range.surroundContents(span); } catch (e) {}
          return;
        }
      }
    }

    // A small floating action menu on a highlight mark — Discuss / Note / Remove
    // (the direct delete affordance, alongside the drawer's Remove).
    let markMenu: HTMLElement | null = null;
    function onMarkAway(e: Event) { if (markMenu && !markMenu.contains(e.target as Node)) closeMarkMenu(); }
    function closeMarkMenu() { if (markMenu) { markMenu.remove(); markMenu = null; document.removeEventListener('mousedown', onMarkAway, true); } }
    function openMarkMenu(mark: HTMLElement, id: string) {
      closeMarkMenu();
      const el = document.createElement('div'); el.className = 'seltool on'; el.style.position = 'fixed'; el.style.zIndex = '82';
      el.innerHTML =
        '<button type="button" data-mm="discuss"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-9 8.3 8.5 8.5 0 0 1-3.9-.9L3 20l1.1-5.1A8.38 8.38 0 0 1 3.7 11 8.5 8.5 0 0 1 12 3a8.38 8.38 0 0 1 8.3 8.5Z"/></svg>Discuss</button>'
        + '<button type="button" data-mm="note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v10l-4 4H4Z"/><path d="M8 9h8"/></svg>Note</button>'
        + '<span class="sep"></span>'
        + '<button type="button" data-mm="remove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5h6v2M7 7l1 13h8l1-13"/></svg>Remove</button>';
      document.body.appendChild(el);
      const r = mark.getBoundingClientRect(), w = el.offsetWidth, h = el.offsetHeight;
      el.style.left = Math.min(Math.max(10, r.left + r.width / 2 - w / 2), innerWidth - w - 10) + 'px';
      const top = r.top - h - 9; el.style.top = (top < 8 ? r.bottom + 9 : top) + 'px';
      markMenu = el;
      el.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('[data-mm]') as HTMLElement | null; if (!b) return;
        const act = b.dataset.mm; const hh = findHl(id); closeMarkMenu();
        if (act === 'remove') { const bi = blockOf(id); if (bi >= 0) remove(bi, id); }
        else if (act === 'discuss' && hh) openThread(id, hh.text);
        else if (act === 'note' && hh) { open(); const it = dbody.querySelector('.hitem[data-id="' + id + '"] textarea') as HTMLElement | null; if (it) it.focus(); }
      });
      setTimeout(() => document.addEventListener('mousedown', onMarkAway, true), 0);
    }

    // ---- design engine: block set + text walker + paint/render (pure DOM) ----
    function indexBlocks() {
      blocks = ([].slice.call(body!.querySelectorAll('p,h2,h3,.mnote,li')) as HTMLElement[]).filter(
        (b) => !b.closest('.paywall,figure,pre') && b.textContent!.trim().length > 40,
      );
      blocks.forEach((b: any, i) => { b.dataset.hb = i; if (b._orig == null) b._orig = b.innerHTML; });
    }
    function walker(b: Node) {
      return document.createTreeWalker(b, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) => ((n.parentNode as HTMLElement).closest('pre,.ln') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
      } as any);
    }
    function all() {
      const out: any[] = [];
      Object.keys(store).forEach((k) => (store[+k] || []).forEach((h) => out.push([+k, h])));
      return out.sort((a, b) => a[0] - b[0] || a[1].s - b[1].s);
    }
    function paint(b: HTMLElement, h: any) {
      let t = 0; const hits: any[] = []; const w = walker(b); let n: any;
      while ((n = w.nextNode())) { const len = n.nodeValue.length, s = Math.max(h.s, t), e = Math.min(h.e, t + len); if (e > s) hits.push([n, s - t, e - t]); t += len; }
      hits.reverse().forEach((p) => {
        let node = p[0]; const a = p[1], z = p[2];
        if (z < node.nodeValue.length) node.splitText(z);
        if (a > 0) node = node.splitText(a);
        const m = document.createElement('mark'); m.className = 'hl' + (h.note ? ' note' : ''); m.dataset.id = h.id;
        node.parentNode.insertBefore(m, node); m.appendChild(node);
      });
    }
    function render(i: number) {
      const b: any = blocks[i]; if (!b) return; b.innerHTML = b._orig;
      (store[i] || []).slice().sort((a, c) => c.s - a.s).forEach((h) => paint(b, h));
    }
    function offsets(b: HTMLElement, range: Range) {
      let t = 0, s: number | null = null, e: number | null = null; const w = walker(b); let n: any;
      while ((n = w.nextNode())) { if (n === range.startContainer) s = t + range.startOffset; if (n === range.endContainer) e = t + range.endOffset; t += n.nodeValue.length; }
      if (s === null) s = 0; if (e === null) e = t;
      return [Math.max(0, Math.min(s, e)), Math.min(t, Math.max(s, e))];
    }
    function trim(b: HTMLElement, r: number[]) { const txt = b.textContent!; let s = r[0], e = r[1]; while (s < e && /\s/.test(txt[s])) s++; while (e > s && /\s/.test(txt[e - 1])) e--; return [s, e]; }

    // ---- Supabase data layer (replaces the design's localStorage) ----
    async function loadStore() {
      store = {};
      const res = await supabase.from('highlights').select('id,quote,note,user_id,created_at').eq('post_id', postId).order('created_at', { ascending: true });
      if (res.error) return;
      (res.data || []).forEach((row: any) => {
        for (let i = 0; i < blocks.length; i++) {
          const idx = blocks[i].textContent!.indexOf(row.quote);
          if (idx !== -1) { (store[i] = store[i] || []).push({ id: row.id, s: idx, e: idx + row.quote.length, text: row.quote, note: row.note || '' }); break; }
        }
      });
      Object.keys(store).forEach((k) => render(+k));
      sync();
    }
    async function paintPips() {
      const ids: string[] = []; Object.keys(store).forEach((k) => store[+k].forEach((h) => ids.push(h.id)));
      if (!ids.length) return;
      const res = await supabase.from('highlight_comments').select('highlight_id').in('highlight_id', ids);
      if (res.error) return;
      const counts: Record<string, number> = {};
      (res.data || []).forEach((r: any) => { counts[r.highlight_id] = (counts[r.highlight_id] || 0) + 1; });
      Object.keys(counts).forEach((hid) => addPip(hid, counts[hid]));
    }
    function addPip(hid: string, n?: number) {
      const m = body!.querySelector('mark.hl[data-id="' + hid + '"]') as HTMLElement | null; if (!m) return;
      const next = m.nextElementSibling as HTMLElement | null;
      if (next && next.classList.contains('pip')) { if (n != null) next.textContent = String(n); return; }
      m.classList.add('talk');
      const pip = document.createElement('button'); pip.className = 'pip'; pip.type = 'button'; pip.dataset.id = hid; pip.textContent = n != null ? String(n) : '…';
      m.parentNode!.insertBefore(pip, m.nextSibling);
    }

    async function add(withNote: boolean) {
      const sel = getSelection(); if (!sel || !sel.rangeCount || sel.isCollapsed || !currentUser) return;
      const range = sel.getRangeAt(0); const ops: number[][] = [];
      blocks.forEach((b, i) => { if (!range.intersectsNode(b)) return; const r = trim(b, offsets(b, range)); if (r[1] - r[0] < 3) return; ops.push([i, r[0], r[1]]); });
      if (!ops.length) return;
      sel.removeAllRanges(); hide();
      const touched: number[] = []; let last: string | null = null;
      for (let k = 0; k < ops.length; k++) {
        const i = ops[k][0], b = blocks[i]; let s = ops[k][1], e = ops[k][2], note = ''; const mergedIds: string[] = [];
        const arr = (store[i] || []).filter((h) => { if (h.e < s || h.s > e) return true; s = Math.min(s, h.s); e = Math.max(e, h.e); if (h.note) note = h.note; mergedIds.push(h.id); return false; });
        const text = b.textContent!.slice(s, e);
        for (let mi = 0; mi < mergedIds.length; mi++) await supabase.from('highlights').delete().eq('id', mergedIds[mi]);
        const ins = await supabase.from('highlights').insert({ post_id: postId, user_id: currentUser.id, author_name: authorNameOf(currentUser), quote: text }).select('id').single();
        if (ins.error || !ins.data) continue;
        const id = (ins.data as any).id;
        if (note) { try { await supabase.from('highlights').update({ note }).eq('id', id); } catch (e) {} }
        arr.push({ id, s, e, text, note }); store[i] = arr; touched.push(i); last = id;
      }
      touched.forEach(render); sync();
      if (withNote && last) { open(); const it = dbody.querySelector('.hitem[data-id="' + last + '"] textarea') as HTMLElement | null; if (it) it.focus(); }
    }
    async function remove(i: number, id: string) {
      const res = await supabase.from('highlights').delete().eq('id', id);
      if (res.error) return;
      store[i] = (store[i] || []).filter((h) => h.id !== id); if (!store[i].length) delete store[i];
      render(i); sync();
    }

    // ---- drawer list (design sync(), minus the localStorage-only bits) ----
    const KEYHTML = '<details class="hlkey" open><summary><svg class="cv" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="m9 6 6 6-6 6"/></svg>What the marks mean</summary>'
      + '<div class="krow"><span class="s w">passage</span><span>Yours — highlighted by you</span></div>'
      + '<div class="krow"><span class="s n">passage</span><span>Carries a private note</span></div>'
      + '<div class="krow"><span class="s t">passage<i>3</i></span><span>Open discussion — tap the number</span></div></details>';
    function sync() {
      const list = all(); cnt.textContent = String(list.length); pill.classList.add('on');
      plabel.innerHTML = list.length ? '<b>' + list.length + '</b> highlighted' : 'Highlights';
      dn.textContent = list.length ? list.length + (list.length === 1 ? ' passage' : ' passages') : 'none yet';
      dbody.innerHTML = KEYHTML + (list.length
        ? list.map((p) => {
            const h = p[1];
            return '<div class="hitem" data-b="' + p[0] + '" data-id="' + h.id + '">'
              + '<q>' + esc(h.text) + '</q>'
              + '<textarea placeholder="Add a note…">' + esc(h.note || '') + '</textarea>'
              + '<div class="acts"><button data-go type="button">Jump to it</button><button data-cp type="button">Copy</button>'
              + '<button data-dis type="button">Discussion</button>'
              + '<button class="del" data-rm type="button">Remove</button></div></div>';
          }).join('')
        : '<div class="hld-empty">Select any passage in the essay to highlight it. Add a note and it stays attached to the sentence that prompted it — or open it up and discuss it with the author.</div>');
      dbody.querySelectorAll('.hitem textarea').forEach((ta) => grow(ta as HTMLTextAreaElement));
    }

    // ---- discussion thread (design .thv view, wired to highlight_comments) ----
    async function openThread(hid: string, quote: string) {
      open();
      dbody.dataset.hid = hid;
      dbody.innerHTML = '<div class="thv"><button class="back" data-back type="button">← All highlights</button><q>' + esc(quote) + '</q>'
        + '<div class="rep-list hld-empty" style="padding:14px 0">Loading…</div>'
        + '<div class="repbox"><textarea placeholder="Add to the discussion…"></textarea>'
        + '<div class="r"><span>Private — between you and the author</span><button class="btn btn-primary btn-sm" type="button" data-reply>Post reply</button></div></div></div>';
      const listEl = dbody.querySelector('.rep-list') as HTMLElement;
      const res = await supabase.from('highlight_comments').select('id,user_id,author_name,body,created_at,author_is_admin').eq('highlight_id', hid).order('created_at', { ascending: true });
      if (res.error) { listEl.textContent = 'Could not load the discussion.'; return; }
      const rows = (res.data || []) as any[];
      if (rows.length) {
        listEl.className = 'rep-list';
        listEl.innerHTML = rows.map((r) => {
          const who = r.author_name || 'Reader';
          const when = new Date(r.created_at).toLocaleDateString();
          return '<div class="rep' + (r.author_is_admin ? ' auth' : '') + '" data-cid="' + r.id + '"><div class="av">' + esc((who[0] || '?')) + '</div>'
            + '<div><div class="hd"><b>' + esc(who) + '</b>' + (r.author_is_admin ? '<span class="bg">Author</span>' : '')
            + '<span class="w">' + esc(when) + '</span></div><p>' + esc(r.body) + '</p>'
            + '<div class="rep-acts"><button type="button" class="up" data-up aria-label="Upvote"><span class="uparrow">▲</span> <span class="upn">0</span></button>'
            + ((currentUser && (r.user_id === currentUser.id || isAdmin)) ? '<button type="button" class="repdel" data-repdel>Delete</button>' : '')
            + '</div></div></div>';
        }).join('');
        paintReplyVotes(rows.map((r) => r.id));
        addPip(hid, rows.length);
      } else {
        listEl.textContent = 'No replies yet. Say the first thing.';
      }
    }

    // ---- toolbar positioning + drawer open/close (design, verbatim) ----
    function place() {
      const sel = getSelection(); if (!currentUser || !sel || !sel.rangeCount || sel.isCollapsed) return hide();
      const r = sel.getRangeAt(0); if (!body!.contains(r.commonAncestorContainer)) return hide();
      if (r.toString().trim().length < 3) return hide();
      tool.classList.add('on');
      const box = r.getBoundingClientRect(), w = tool.offsetWidth, h = tool.offsetHeight;
      tool.style.left = Math.min(Math.max(10, box.left + box.width / 2 - w / 2), innerWidth - w - 10) + 'px';
      const top = box.top - h - 9; tool.style.top = (top < 8 ? box.bottom + 9 : top) + 'px';
    }
    function hide() {
      tool.classList.remove('on');
      [].forEach.call(tool.querySelectorAll('button'), (b: any) => { if (b._t) { b.innerHTML = b._t; b._t = null; } });
    }
    function open() { draw.classList.add('on'); scrim.classList.add('on'); }
    function close() { draw.classList.remove('on'); scrim.classList.remove('on'); }

    // ---- listeners ----
    document.addEventListener('mouseup', (e) => { if ((e.target as HTMLElement).closest('.seltool')) return; setTimeout(place, 10); });
    document.addEventListener('mousedown', (e) => { if (!(e.target as HTMLElement).closest('.seltool')) hide(); });
    addEventListener('scroll', hide, { passive: true });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { hide(); close(); return; }
      if ((e.key === 'h' || e.key === 'H') && !e.metaKey && !e.ctrlKey && !/input|textarea/i.test(document.activeElement!.tagName)) {
        const s = getSelection(); if (s && !s.isCollapsed) { e.preventDefault(); add(false); }
      }
    });

    tool.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button') as any; if (!b) return; const act = b.dataset.act;
      const sel = getSelection(), txt = sel ? sel.toString().trim() : '';
      if (act === 'hl') return add(false);
      if (act === 'note') return add(true);
      const out = act === 'quote' ? '“' + txt + '” — ' + AUTHOR + (TITLE ? ', ' + TITLE : '') + '\n' + location.href : txt;
      if (navigator.clipboard) navigator.clipboard.writeText(out);
      b._t = b.innerHTML; b.innerHTML = 'Copied'; setTimeout(hide, 800);
    });

    // clicks on inline marks / pips in the article body
    body.addEventListener('click', (e) => {
      const pipEl = (e.target as HTMLElement).closest('.pip') as HTMLElement | null;
      if (pipEl) { const id = pipEl.dataset.id!; const h = findHl(id); if (h) openThread(id, h.text); return; }
      const m = (e.target as HTMLElement).closest('mark.hl') as HTMLElement | null; if (!m) return;
      openMarkMenu(m, m.dataset.id!);
    });

    // drawer delegation
    dbody.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const upEl = t.closest('[data-up]') as HTMLElement | null;
      if (upEl) { const rep = upEl.closest('.rep') as HTMLElement | null; if (rep && rep.dataset.cid) toggleHlVote(rep.dataset.cid, upEl); return; }
      const repdel = t.closest('[data-repdel]') as HTMLElement | null;
      if (repdel) {
        const rep = repdel.closest('.rep') as HTMLElement | null; if (!rep || !rep.dataset.cid) return;
        if (!confirm('Delete this reply? This can’t be undone.')) return;
        const hid = dbody.dataset.hid || ''; const qel = dbody.querySelector('.thv > q'); const q = qel ? qel.textContent! : '';
        supabase.from('highlight_comments').delete().eq('id', rep.dataset.cid).then((r) => {
          if (r.error) { alert('Could not delete: ' + r.error.message); return; }
          openThread(hid, q); // reload the thread (also re-counts the mark's pip)
        });
        return;
      }
      if (t.closest('[data-back]')) return sync();
      if (t.closest('[data-reply]')) {
        const hid = dbody.dataset.hid || ''; const ta = dbody.querySelector('.repbox textarea') as HTMLTextAreaElement | null;
        const txt = ta ? (ta.value || '').trim() : '';
        if (!hid || !txt || !currentUser) { if (ta) ta.focus(); return; }
        const qel = dbody.querySelector('.thv > q'); const q = qel ? qel.textContent! : '';
        const btn = t.closest('[data-reply]') as HTMLButtonElement; btn.disabled = true;
        supabase.from('highlight_comments').insert({ highlight_id: hid, user_id: currentUser.id, author_name: authorNameOf(currentUser), body: txt }).then((r) => {
          if (r.error) { btn.disabled = false; return; }
          openThread(hid, q);
        });
        return;
      }
      const it = t.closest('.hitem') as HTMLElement | null; if (!it) return;
      const i = +it.dataset.b!, id = it.dataset.id!;
      if (t.closest('[data-rm]')) return remove(i, id);
      if (t.closest('[data-dis]')) { const h = findHl(id); if (h) openThread(id, h.text); return; }
      const cp = t.closest('[data-cp]') as HTMLElement | null;
      if (cp) { if (navigator.clipboard) navigator.clipboard.writeText(it.querySelector('q')!.textContent!); cp.textContent = 'Copied'; setTimeout(() => { cp.textContent = 'Copy'; }, 1400); return; }
      if (t.closest('[data-go]') || t.closest('q')) {
        const mk = body!.querySelector('mark.hl[data-id="' + id + '"]') as HTMLElement | null; if (!mk) return; close();
        scrollTo({ top: mk.getBoundingClientRect().top + scrollY - 140, behavior: 'smooth' });
        mk.classList.add('flash'); setTimeout(() => mk.classList.remove('flash'), 1500);
      }
    });

    // live note editing (debounced write; needs the note column migration)
    dbody.addEventListener('input', (e) => {
      const ta = e.target as HTMLTextAreaElement; if (ta.tagName !== 'TEXTAREA') return;
      grow(ta);
      const it = ta.closest('.hitem') as HTMLElement | null; if (!it) return;
      const i = +it.dataset.b!, id = it.dataset.id!, val = (ta as HTMLTextAreaElement).value;
      (store[i] || []).forEach((h) => { if (h.id === id) h.note = val; });
      const m = body!.querySelector('mark.hl[data-id="' + id + '"]') as HTMLElement | null; if (m) m.classList.toggle('note', !!val);
      clearTimeout(noteTimer);
      noteTimer = window.setTimeout(() => { supabase.from('highlights').update({ note: val || null }).eq('id', id).then(() => {}); }, 500);
    });

    // pill + drawer chrome
    pill.addEventListener('click', open);
    document.getElementById('hlx')!.addEventListener('click', close);
    scrim.addEventListener('click', close);
    document.getElementById('hlcopyall')!.addEventListener('click', function (this: HTMLButtonElement) {
      const b = this;
      const txt = all().map((p) => '“' + p[1].text + '”' + (p[1].note ? '\n  — ' + p[1].note : '')).join('\n\n');
      if (navigator.clipboard) navigator.clipboard.writeText(txt);
      b.textContent = 'Copied'; setTimeout(() => { b.textContent = 'Copy all'; }, 1500);
    });

    // ---- auth gate + load. onAuthStateChange fires often (refocus) — only act on
    // an actual user change (never a page reload). ----
    async function refresh() {
      const s = await supabase.auth.getSession();
      const u = s.data.session ? s.data.session.user : null;
      const uid = u ? u.id : null;
      if (uid === lastUid) return;
      lastUid = uid; currentUser = u;
      if (!currentUser) { pill.classList.remove('on'); close(); store = {}; blocks.forEach((_, i) => render(i)); return; }
      try { const adm = await supabase.rpc('is_admin'); isAdmin = adm.data === true; } catch (e) { isAdmin = false; }
      await popReady;   // ensure .pop spans exist before indexBlocks caches _orig
      indexBlocks();
      await loadStore();
      await paintPips();
      jumpToHash();     // deep-link from /account ("Open") → scroll to & flash the passage
    }

    // If the URL carries #hl-<id> (a link from the reader's account "Notes &
    // highlights"), scroll that exact highlight into view, move focus to it, and flash
    // it — mirroring the drawer's "Jump to it". If the passage no longer anchors (the
    // essay's prose was edited since), fall back to opening the highlights drawer so
    // the reader still lands on their list rather than silently at the top. Honors
    // prefers-reduced-motion. Runs once, after the marks are painted.
    function jumpToHash() {
      const m = /^#hl-(.+)$/.exec(location.hash || '');
      if (!m) return;
      let id = m[1]; try { id = decodeURIComponent(id); } catch (e) {}
      const sel = (window.CSS && CSS.escape) ? CSS.escape(id) : id.replace(/["\\]/g, '\\$&');
      const mk = body!.querySelector('mark.hl[data-id="' + sel + '"]') as HTMLElement | null;
      if (!mk) { if (all().length) open(); return; } // exact passage gone → show their highlights
      const reduce = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
      requestAnimationFrame(() => {
        scrollTo({ top: mk.getBoundingClientRect().top + scrollY - 140, behavior: reduce ? 'auto' : 'smooth' });
        mk.setAttribute('tabindex', '-1'); // make the <mark> focusable so keyboard/SR land on it
        try { mk.focus({ preventScroll: true }); } catch (e) { mk.focus(); }
        if (!reduce) { mk.classList.add('flash'); setTimeout(() => mk.classList.remove('flash'), 1800); }
      });
    }
    // Popular-passage marks are PUBLIC (everyone sees them) and must land before the
    // signed-in engine caches each block's original HTML — so kick it off once here.
    const popReady = paintPopular();
    supabase.auth.onAuthStateChange(() => refresh());
    refresh();
  }
</script>
