---
/**
 * ShareBar.astro — reader-facing "share this post" row.
 * =============================================================================
 *
 * WHAT THIS IS
 * ------------
 * A small, self-contained row of share controls shown at the end of a blog post.
 * It's the audience-growth counterpart to the subscribe form: the moment a reader
 * finishes, they get a friction-free way to pass the post along.
 *
 * WHY IT WORKS THIS WAY (no OAuth, no auto-posting)
 * -------------------------------------------------
 * Each network button is a plain link to that network's OWN composer, pre-filled
 * with the post title + canonical URL (web intent URLs). Nothing is posted on
 * anyone's behalf and no API credentials are needed — the person reviews the draft
 * in the network's UI and posts it themselves. This is deliberate:
 *   - zero credentials / zero server code / works the instant it ships,
 *   - zero risk of a network flagging automated self-promotion,
 *   - the sharer stays in control of the final wording.
 * (Full API cross-posting — posting automatically from the admin side — would need
 * the author's own OAuth apps per network; that's a separate, later feature.)
 *
 * INPUT
 *   url   — absolute canonical URL of the post (built by the caller from Astro.site).
 *   title — post title (used as the suggested share text).
 *
 * SECURITY / PRIVACY
 *   - Values come from build-time collection data (title) and the site's own
 *     canonical URL, not user input — safe to interpolate into the intent URLs
 *     (still URL-encoded for correctness).
 *   - Every outbound link is target="_blank" rel="noopener noreferrer" so the
 *     opened composer can't reach back into this page (no window.opener), and no
 *     referrer leaks beyond the shared URL the reader chose to share anyway.
 *   - "Copy link" uses the async Clipboard API with a legacy execCommand fallback;
 *     it touches only this post's own URL. The inline handler is CSP-safe under the
 *     existing 'unsafe-inline' script-src (no external hosts, no network calls).
 */
import site from '../data/site.json';
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const wc = (site as any).shareBar || {};

// Pre-encode once. `text` is what networks that take a message (X, Bluesky) show
// as the draft; `u`/`url` carry the canonical link.
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
// X/Bluesky drafts read best as "Title <newline> URL"; the network turns the URL
// into a card. LinkedIn/Reddit/HN take the URL + title as separate params.
const shareText = encodeURIComponent(`${title}\n${url}`);

// Each entry: a label, an accessible name, the composer URL, and an inline SVG
// glyph. Order roughly by where technical readers actually share.
const targets = [
  {
    key: 'x',
    label: 'X',
    href: `https://twitter.com/intent/tweet?text=${shareText}`,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    key: 'linkedin',
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    key: 'reddit',
    label: 'Reddit',
    href: `https://www.reddit.com/submit?url=${u}&title=${t}`,
    path: 'M24 11.779c0-1.459-1.192-2.645-2.657-2.645-.715 0-1.363.286-1.84.746-1.81-1.191-4.259-1.963-6.971-2.06l1.483-4.669 4.016.941-.006.058c0 1.193.975 2.163 2.174 2.163 1.198 0 2.172-.97 2.172-2.163s-.975-2.164-2.172-2.164c-.92 0-1.704.574-2.021 1.379l-4.329-1.015a.379.379 0 0 0-.44.245l-1.638 5.156c-2.768.079-5.268.851-7.106 2.053-.477-.464-1.129-.754-1.849-.754C1.192 9.134 0 10.32 0 11.779c0 .977.535 1.828 1.324 2.283-.037.222-.057.446-.057.673 0 3.426 4.005 6.212 8.933 6.212s8.932-2.786 8.932-6.212c0-.227-.02-.448-.056-.667.795-.454 1.335-1.31 1.335-2.29zM7.201 12.914c0-.836.683-1.518 1.522-1.518.836 0 1.518.682 1.518 1.518s-.682 1.518-1.518 1.518c-.839 0-1.522-.682-1.522-1.518zm9.041 3.79c-.906.905-2.646.978-3.157.978-.51 0-2.25-.073-3.155-.978a.34.34 0 0 1 0-.482.34.34 0 0 1 .482 0c.573.573 1.797.776 2.673.776.877 0 2.101-.203 2.675-.776a.34.34 0 0 1 .482 0 .34.34 0 0 1 0 .482zm-.13-2.272c-.836 0-1.518-.682-1.518-1.518s.682-1.518 1.518-1.518c.839 0 1.522.682 1.522 1.518s-.683 1.518-1.522 1.518z',
  },
  {
    key: 'hn',
    label: 'Hacker News',
    href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}`,
    path: 'M0 24V0h24v24H0zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896h-1.88z',
  },
  {
    key: 'bluesky',
    label: 'Bluesky',
    href: `https://bsky.app/intent/compose?text=${shareText}`,
    path: 'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z',
  },
];
---

<aside class="sharebar" aria-label={wc.regionLabel || 'Share this post'}>
  <script type="application/json" id="shareBar-copy" set:html={JSON.stringify(wc)}></script>
  <span class="sharebar-label">{wc.label || 'Share'}</span>
  <div class="sharebar-links">
    {targets.map((s) => (
      <a
        class="share-btn"
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={(wc.shareOn || 'Share on') + ' ' + s.label}
        title={(wc.shareOn || 'Share on') + ' ' + s.label}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path fill="currentColor" d={s.path} />
        </svg>
      </a>
    ))}
    <button type="button" class="share-btn share-copy" data-share-url={url} aria-label={wc.copyLabel || 'Copy link'} title={wc.copyLabel || 'Copy link'}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <span class="share-copy-label">{wc.copyLabel || 'Copy link'}</span>
    </button>
  </div>
</aside>

<style>
  .sharebar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin: 2.25rem 0 0.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border);
  }
  .sharebar-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .sharebar-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 36px;
    width: 36px;
    padding: 0;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .share-btn:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: var(--surface);
    transform: translateY(-1px);
  }
  .share-btn svg { display: block; }
  /* Copy button carries a text label, so it grows to fit. */
  .share-copy { width: auto; padding: 0 0.7rem; }
  .share-copy-label { font-size: var(--fs-sm); font-weight: 500; }
  .share-copy.is-copied { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
</style>

<script>
  const CM = JSON.parse(document.getElementById('shareBar-copy')?.textContent || '{}');
  // Copy-link handler. Async Clipboard API where available (needs a secure
  // context, which the live site is), with a legacy execCommand fallback. Only
  // ever copies this post's own canonical URL — no external calls, no user data.
  document.querySelectorAll('.share-copy').forEach((el) => {
    const btn = el as HTMLButtonElement;
    const labelEl = btn.querySelector('.share-copy-label');
    const original = labelEl?.textContent ?? (CM.copyLabel || 'Copy link');
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-share-url') || location.href;
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(url);
          ok = true;
        } else {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          ok = document.execCommand('copy');
          document.body.removeChild(ta);
        }
      } catch {
        ok = false;
      }
      if (labelEl) {
        labelEl.textContent = ok ? (CM.copied || 'Copied!') : (CM.copyError || 'Press Ctrl+C');
        btn.classList.toggle('is-copied', ok);
        window.setTimeout(() => {
          labelEl.textContent = original;
          btn.classList.remove('is-copied');
        }, 1600);
      }
    });
  });
</script>
