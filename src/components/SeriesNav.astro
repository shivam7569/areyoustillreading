---
/**
 * SeriesNav.astro — in-post navigation for a multi-part series, field-aware.
 * Rendered by BlogPost.astro from src/lib/series.ts (series context) + src/lib/
 * fields.ts (field context). All styling is global (src/styles/global.css).
 *
 *   placement="top"    → the .seriesbar: a breadcrumb (field › series, the field
 *                        link present only when the series is in a public field)
 *                        over a spine of one tick per part — solid = published,
 *                        hollow = still to come, tall accent tick = you are here.
 *   placement="bottom" → the .pager (previous / next part) and, at the LAST part
 *                        of a series inside a public field, a "Next in the field"
 *                        card pointing to the first part of the next series.
 *
 * Marked data-pagefind-ignore so other parts' titles don't pollute this post's index.
 */
import type { SeriesNavData } from '../lib/series';
import type { FieldNav } from '../lib/fields';
import site from '../data/site.json';

interface Props {
  data: SeriesNavData;
  field?: FieldNav | null;
  related?: { slug: string; title: string }[]; // tag-related reads, for boundary suggestions
  placement?: 'top' | 'bottom';
}
const { data, field = null, related = [], placement = 'top' } = Astro.props;
const href = (slug: string) => `/blog/${slug}/`;
const introHref = href(data.introSlug);
const todoCount = Math.max(0, data.total - data.parts.length);
const wc = (site as any).seriesNav || {};
---
{placement === 'top' && (
  <nav class="seriesbar" aria-label={(wc.crumbAria || 'Series: {title}').replace('{title}', data.title)} data-pagefind-ignore>
    <span class="crumb">
      {field && (
        <Fragment>
          <a class="up" href={`/fields/${field.field.slug}/`}>{field.field.title}</a>
          <svg class="sep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        </Fragment>
      )}
      <a class="sname" href={introHref}>{data.title}</a>
    </span>
    <ol class="spine">
      {data.parts.map((p) => (
        <li><a href={href(p.slug)} class={p.current ? 'here' : undefined} aria-current={p.current ? 'page' : undefined} title={(wc.spinePartTitle || 'Part {order} · {title}').replace('{order}', String(p.order)).replace('{title}', p.title)} aria-label={(wc.spinePartAria || 'Part {order}: {title}').replace('{order}', String(p.order)).replace('{title}', p.title)}></a></li>
      ))}
      {Array.from({ length: todoCount }).map((_, i) => {
        const n = data.parts.length + i + 1;
        const pl = data.planned[i];
        const label = pl ? (wc.plannedNamed || 'Part {n} · {name} (planned)').replace('{n}', String(n)).replace('{name}', pl) : (wc.plannedUnnamed || 'Part {n} · planned').replace('{n}', String(n));
        return <li><a class="todo" href={introHref} title={label} aria-label={label}></a></li>;
      })}
    </ol>
    <span class="count"><b>{data.index}</b>/{data.total}</span>
  </nav>
)}
{placement === 'bottom' && (
  <Fragment>
    <nav class="pager" aria-label={(wc.pagerAria || 'More in {title}').replace('{title}', data.title)} data-pagefind-ignore>
      {data.prev
        ? <a class="prev" href={href(data.prev.slug)}><div class="dir">{(wc.prev?.dir || '← Part {n}').replace('{n}', String(data.index - 1))}</div><div class="t">{data.prev.title}</div></a>
        : related[0]
          ? <a class="prev suggest" href={href(related[0].slug)}><div class="dir">{wc.prev?.suggestDir || 'More to read'}</div><div class="t">{related[0].title}</div></a>
          : <span class="prev off"><div class="dir">{wc.prev?.offDir || 'The beginning'}</div><div class="t">{wc.prev?.offTitle || 'Part one of the series'}</div></span>}
      {data.next
        ? <a class="next" href={href(data.next.slug)}><div class="dir">{(wc.next?.dir || 'Part {n} →').replace('{n}', String(data.index + 1))}</div><div class="t">{data.next.title}</div></a>
        : (field && field.next)
          ? <a class="next field-next" href={field.next.href}><div class="dir">{wc.next?.fieldDir || 'Next in the field →'}</div><div class="t">{field.next.seriesTitle}</div></a>
          : related[0]
            ? <a class="next suggest" href={href(related[0].slug)}><div class="dir">{wc.next?.suggestDir || 'Read next'}</div><div class="t">{related[0].title}</div></a>
            : <a class="next" href={introHref}><div class="dir">{wc.next?.completeDir || 'Series complete'}</div><div class="t">{(wc.next?.completeTitle || 'Back to all {n} parts').replace('{n}', String(data.parts.length))}</div></a>}
    </nav>
  </Fragment>
)}
