---
/**
 * SeriesNav.astro — in-post navigation for a multi-part series, field-aware.
 * Rendered by BlogPost.astro from src/lib/series.ts (series context) + src/lib/
 * fields.ts (field context). All styling is global (src/styles/global.css).
 *
 *   placement="top"    → the .seriesbar: a breadcrumb (field › series, the field
 *                        link present only when the series is in a public field)
 *                        over a spine of one tick per part — solid = published,
 *                        hollow = still to come, tall accent tick = you are here.
 *   placement="bottom" → the .pager (previous / next part) and, at the LAST part
 *                        of a series inside a public field, a "Next in the field"
 *                        card pointing to the first part of the next series.
 *
 * Marked data-pagefind-ignore so other parts' titles don't pollute this post's index.
 */
import type { SeriesNavData } from '../lib/series';
import type { FieldNav } from '../lib/fields';

interface Props {
  data: SeriesNavData;
  field?: FieldNav | null;
  placement?: 'top' | 'bottom';
}
const { data, field = null, placement = 'top' } = Astro.props;
const href = (slug: string) => `/blog/${slug}/`;
const introHref = href(data.introSlug);
const todoCount = Math.max(0, data.total - data.parts.length);
---
{placement === 'top' && (
  <nav class="seriesbar" aria-label={`Series: ${data.title}`} data-pagefind-ignore>
    <span class="crumb">
      {field && (
        <Fragment>
          <a class="up" href={`/fields/${field.field.slug}/`}>{field.field.title}</a>
          <svg class="sep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        </Fragment>
      )}
      <a class="sname" href={introHref}>{data.title}</a>
    </span>
    <ol class="spine">
      {data.parts.map((p) => (
        <li><a href={href(p.slug)} class={p.current ? 'here' : undefined} aria-current={p.current ? 'page' : undefined} title={`Part ${p.order} · ${p.title}`} aria-label={`Part ${p.order}: ${p.title}`}></a></li>
      ))}
      {Array.from({ length: todoCount }).map((_, i) => {
        const n = data.parts.length + i + 1;
        const pl = data.planned[i];
        const label = pl ? `Part ${n} · ${pl} (planned)` : `Part ${n} · planned`;
        return <li><a class="todo" href={introHref} title={label} aria-label={label}></a></li>;
      })}
    </ol>
    <span class="count"><b>{data.index}</b>/{data.total}</span>
  </nav>
)}
{placement === 'bottom' && (
  <Fragment>
    <nav class="pager" aria-label={`More in ${data.title}`} data-pagefind-ignore>
      {data.prev
        ? <a class="prev" href={href(data.prev.slug)}><div class="dir">← Part {data.index - 1}</div><div class="t">{data.prev.title}</div></a>
        : <span class="prev off"><div class="dir">First part</div><div class="t">Nothing before this one</div></span>}
      {data.next
        ? <a class="next" href={href(data.next.slug)}><div class="dir">Part {data.index + 1} →</div><div class="t">{data.next.title}</div></a>
        : data.total > data.parts.length
          ? <span class="next off"><div class="dir">Up to date</div><div class="t">You’re on the latest part — more to come</div></span>
          : <a class="next" href={introHref}><div class="dir">Series complete</div><div class="t">Back to all {data.parts.length} parts</div></a>}
    </nav>
    {field && field.next && !data.next && (
      <a class="contfield" href={field.next.href} data-pagefind-ignore>
        <span>
          <span class="k">Next in the field</span>
          <span class="t">{field.next.seriesTitle}</span>
          <span class="s">{field.next.introTitle} · {field.next.introMins} min</span>
        </span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    )}
  </Fragment>
)}
