---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { title, description, pubDate, updatedDate } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
---

<BaseLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p>
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      <span> &middot; {minutes} min read</span>
      {updatedDate && <span> &middot; updated {fmt(updatedDate)}</span>}
    </p>
    <slot />
  </article>
  <p><a href="/blog">&larr; All posts</a></p>
</BaseLayout>
