---
/**
 * BlogPost.astro — the editorial reader layout for one blog post (Phase 5).
 * =============================================================================
 * Presentation + composition only, rebuilt from the Claude Design "post" template:
 * a reading-progress bar, the article head (backlink, kicker, title, standfirst,
 * byline with avatar), the two-width .wrap/.measure reading column, then the share
 * row, subscribe block, prev/next pager, and the interactive islands.
 *
 * MUST NOT CHANGE (verified against the reconciliation map):
 *   - The body stays wrapped in a SINGLE <article> element (Highlights.astro does
 *     document.querySelector('article') to scope text selection + <mark> placement).
 *     It now carries class="post-body" for the editorial prose styling in global.css.
 *   - Every island is kept and keyed by post.id: Highlights / Notes / Comments /
 *     PaywallGate(slot) / ShareBar / SubscribeForm / PlotlyReader / SeriesNav.
 *   - The gateable branch is decided by the [...slug] route, which passes <PaywallGate>
 *     as the slot instead of <Content>; this layout is agnostic to the slot's content.
 *   - katex.min.css is imported here so math styling ships only on posts.
 *
 * All security-sensitive behaviour (auth, entitlement/paywall gating, Turnstile,
 * RLS reads/writes) lives inside the child islands + their Pages Functions + Supabase
 * RLS. This layout mounts them and passes only post.id.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Highlights from '../components/Highlights.astro';
import Notes from '../components/Notes.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import SeriesNav from '../components/SeriesNav.astro';
import ShareBar from '../components/ShareBar.astro';
import PlotlyReader from '../components/PlotlyReader.astro';
import { getSeriesNav } from '../lib/series';
import { getCollection } from 'astro:content';
import 'katex/dist/katex.min.css';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

// Byline author: the publisher's pen name (baked into frontmatter at publish
// time); legacy posts without an `author` fall back to the site author.
const SITE_AUTHOR = 'Shivam Chaudhary';
const byline = (post.data.author ?? '').trim() || SITE_AUTHOR;

// Human-readable date (stable 'en-US' locale for deterministic build output).
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Reading-time estimate from the raw Markdown source (200 wpm, min 1).
const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));

// Series context (null unless this post is part of a multi-post series).
const series = await getSeriesNav(post);

// Absolute canonical URL for the share links (matches BaseHead's og:url).
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Adjacent posts for the prev/next pager (published only, reverse-chron). Series
// posts use the SeriesNav card for part navigation instead. `allPosts.length` also
// feeds the "browse all" count; the eyebrow labels the essay by its first tag.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const here = allPosts.findIndex((p) => p.id === post.id);
const olderPost = here >= 0 && here < allPosts.length - 1 ? allPosts[here + 1] : null;
const newerPost = here > 0 ? allPosts[here - 1] : null;
const eyebrow = tags[0] ? `${tags[0]} · Field notes` : 'Field notes';
---

<BaseLayout title={title} description={description} image={`/og/${post.id}.png`} wide>
  {/* Reading-progress bar (driven by the script below). */}
  <div class="progress" id="pg"></div>

  {/* Article head — inside the reading column. */}
  <div class="wrap">
    <div class="measure">
      <header class="art-head">
        <a class="backlink" href="/blog"><span class="a">&larr;</span> Back to the blog</a>
        <div class="kicker"><span class="line"></span><span class="eyebrow">{eyebrow}</span></div>
        <h1 class="title">{title}</h1>
        {description && <p class="standfirst">{description}</p>}
        <div class="byline">
          <div class="avatar" aria-hidden="true">a</div>
          <div class="who"><b>{byline}</b> &middot; <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time></div>
          <span class="dot">&mdash;</span>
          <span class="meta-caps">{minutes} min read</span>
          {updatedDate && <span class="meta-caps">&middot; updated {fmt(updatedDate)}</span>}
          {tags.length > 0 && (
            <div class="btags">{tags.map((t) => (<a class="tag" href={`/blog/tags/${t}`}>{t}</a>))}</div>
          )}
        </div>
      </header>
    </div>
  </div>

  {/* Series card (top): the ordered parts list with the current one highlighted. */}
  {series && <div class="wrap"><div class="measure"><SeriesNav data={series} placement="top" /></div></div>}

  {/*
    The compiled Markdown body is injected here. For a normal post that is <Content/>;
    for a `gateable` post the [...slug] route passes <PaywallGate/> instead, which only
    emits preview-safe HTML statically. The single <article> wrapper is load-bearing
    (see header) — never remove/rename/duplicate it. `.post-body` styles the prose.
  */}
  <div class="wrap">
    <article class="post-body">
      <div class="measure">
        <slot />
      </div>
    </article>
  </div>

  {/* Everything after the essay, back inside the reading column. */}
  <div class="wrap">
    <div class="measure">
      <div class="after">
        {series
          ? <SeriesNav data={series} placement="bottom" />
          : (olderPost || newerPost) && (
              <nav class="pager" aria-label="More essays">
                {olderPost
                  ? <a class="prev" href={`/blog/${olderPost.id}`}><div class="dir">&larr; Older</div><div class="t">{olderPost.data.title}</div></a>
                  : <span></span>}
                {newerPost
                  ? <a class="next" href={`/blog/${newerPost.id}`}><div class="dir">Newer &rarr;</div><div class="t">{newerPost.data.title}</div></a>
                  : <span></span>}
              </nav>
            )
        }

        {/* Manual share row (web-intent links + copy; nothing auto-posts). */}
        <ShareBar url={shareUrl} title={title} />

        {/* End-of-post subscribe (self-contained; one instance per page). */}
        <SubscribeForm
          heading="Read the next one first"
          blurb="One considered essay every few weeks on LLM engineering and the systems underneath. No noise — unsubscribe in one click."
        />

        <div class="all-link"><a href="/blog">Browse all {allPosts.length} {allPosts.length === 1 ? 'essay' : 'essays'} &rarr;</a></div>

        {/* Interactive per-post islands (Supabase + RLS; keyed by post.id). */}
        <Highlights postId={post.id} />
        <Notes postId={post.id} />
        <Comments postId={post.id} />
      </div>
    </div>
  </div>

  {/* Hydrates any published Plotly figures (interactive, lazy). No-op if none. */}
  <PlotlyReader />
</BaseLayout>

<style>
  .progress { position: fixed; top: 0; left: 0; height: 2px; width: 0; background: var(--accent); z-index: 60; transition: width 0.1s linear; }
  @media (prefers-reduced-motion: reduce) { .progress { transition: none; } }

  .art-head { padding: clamp(48px, 7vw, 88px) 0 clamp(28px, 4vw, 44px); }
  .backlink { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); display: inline-flex; align-items: center; gap: 8px; margin-bottom: 34px; transition: color 0.2s; }
  .backlink:hover { color: var(--accent); }
  .backlink .a { transition: transform 0.2s; }
  .backlink:hover .a { transform: translateX(-4px); }
  .art-head .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .art-head .kicker .line { height: 1px; width: 44px; background: var(--accent); opacity: 0.6; }
  h1.title { font-family: var(--serif-display); font-weight: 600; font-size: clamp(36px, 6vw, 64px); line-height: 1.04; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .standfirst { font-family: var(--serif-display); font-style: italic; font-size: clamp(20px, 2.5vw, 26px); line-height: 1.5; color: var(--ink-soft); max-width: 54ch; margin: 26px 0 0; }

  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--rule); }
  .avatar { width: 44px; height: 44px; border-radius: 999px; background: radial-gradient(120% 120% at 30% 20%, var(--accent-soft), var(--accent)); display: grid; place-items: center; color: var(--on-accent); font-family: var(--serif-display); font-size: 18px; flex: none; }
  .byline .who { font-family: var(--sans); font-size: 14px; color: var(--ink); }
  .byline .who b { font-weight: 600; }
  .byline .who time { color: inherit; }
  .byline .dot { color: var(--rule); }
  .byline .btags { display: flex; gap: 8px; margin-left: auto; flex-wrap: wrap; }
  .byline .tag { font-family: var(--sans); font-size: 12px; letter-spacing: 0.03em; color: var(--ink-faint); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 11px; transition: border-color 0.2s, color 0.2s; }
  .byline .tag:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 640px) { .byline .btags { margin-left: 0; width: 100%; } }

  .after { padding: clamp(30px, 4vw, 44px) 0 0; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 0 0 clamp(28px, 4vw, 40px); }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } }
  .pager a { border: 1px solid var(--rule); border-radius: 6px; padding: 22px 24px; transition: border-color 0.2s, transform 0.2s, background 0.2s; display: block; }
  .pager a:hover { border-color: var(--accent); transform: translateY(-2px); background: var(--paper-2); }
  .pager .dir { font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 9px; }
  .pager .t { font-family: var(--serif-display); font-weight: 600; font-size: 19px; line-height: 1.25; color: var(--ink); }
  .pager a.next { text-align: right; }

  .all-link { text-align: center; margin: 34px 0 0; }
  .all-link a { font-family: var(--sans); font-size: 14px; color: var(--accent); border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .all-link a:hover { border-color: var(--accent); }
</style>

<script>
  // Reading-progress bar: width = scroll fraction. Passive listener; no-op if absent.
  const pg = document.getElementById('pg');
  if (pg) {
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      pg.style.width = (max > 0 ? ((h.scrollTop || document.body.scrollTop) / max) * 100 : 0) + '%';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
