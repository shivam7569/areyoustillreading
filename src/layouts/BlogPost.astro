---
/**
 * BlogPost.astro — the editorial reader layout for one blog post (Phase 5).
 * =============================================================================
 * Presentation + composition only, rebuilt from the Claude Design "post" template:
 * a reading-progress bar, the article head (backlink, kicker, title, standfirst,
 * byline with avatar), the two-width .wrap/.measure reading column, then the share
 * row, subscribe block, prev/next pager, and the interactive islands.
 *
 * MUST NOT CHANGE (verified against the reconciliation map):
 *   - The body stays wrapped in a SINGLE <article> element (Highlights.astro does
 *     document.querySelector('article') to scope text selection + <mark> placement).
 *     It now carries class="post-body" for the editorial prose styling in global.css.
 *   - Every island is kept and keyed by post.id: Highlights / Notes / Comments /
 *     PaywallGate(slot) / ShareBar / SubscribeForm / PlotlyReader / SeriesNav.
 *   - The gateable branch is decided by the [...slug] route, which passes <PaywallGate>
 *     as the slot instead of <Content>; this layout is agnostic to the slot's content.
 *   - katex.min.css is imported here so math styling ships only on posts.
 *
 * All security-sensitive behaviour (auth, entitlement/paywall gating, Turnstile,
 * RLS reads/writes) lives inside the child islands + their Pages Functions + Supabase
 * RLS. This layout mounts them and passes only post.id.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Highlights from '../components/Highlights.astro';
import Notes from '../components/Notes.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import SeriesNav from '../components/SeriesNav.astro';
import ReaderProgress from '../components/ReaderProgress.astro';
import ShareBar from '../components/ShareBar.astro';
import Feedback from '../components/Feedback.astro';
import PlotlyReader from '../components/PlotlyReader.astro';
import { getSeriesNav } from '../lib/series';
import { getFieldNav } from '../lib/fields';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import 'katex/dist/katex.min.css';

// Post-chrome copy, editable from Studio → Content Management → Blog post.
const c = (site as any).post || {};

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

// Byline author = the account PEN NAME (site.json.post.author), edited in Studio →
// Settings. Read LIVE (not the per-post frontmatter `author`, which is now ignored for
// display) and anchored with data-cms="post.author" below, so changing the pen name
// re-bylines EVERY post — new and old — instantly via the copy overlay, no rebuild.
const byline = c.author || 'Shivam Chaudhary';

// Human-readable date (stable 'en-US' locale for deterministic build output).
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Reading-time estimate from the raw Markdown source (200 wpm, min 1).
const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
const wordCount = words.toLocaleString('en-US');
// Avatar disc shows the author's initial (real, derived from the byline).
const avatarInitial = (byline.trim()[0] || 'a').toLowerCase();

// Series context (null unless this post is part of a multi-post series).
const series = await getSeriesNav(post);
// Field context (null unless the series belongs to a public field) — drives the
// in-post breadcrumb + the "next in the field" card at the end of a series.
const fieldNav = series ? await getFieldNav(post) : null;

// Absolute canonical URL for the share links (matches BaseHead's og:url).
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

// All published posts, newest first. Feeds the "browse all" count below, the head
// eyebrow, and the build-time related-reading picker for NON-series posts (series
// posts navigate by part via <SeriesNav/>, so they never compute relatedness).
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const here = allPosts.findIndex((p) => p.id === post.id);
const eyebrow = tags[0] ? `${tags[0]} · ${c.kicker || 'Field notes'}` : (c.kicker || 'Field notes');

// End-of-post recommendations (NON-series posts only — series uses the SeriesNav
// pager, which already shows prev/next PART by seriesOrder). Rank other published
// STANDALONE essays by shared-tag overlap (more shared tags => more related),
// tie-broken by recency; if nothing shares a tag, top up with the most recent so
// there's always a next step. We exclude series parts from the pool so a bare,
// out-of-context part title never surfaces as a "related" card.
// `here !== -1` also keeps the instant-publish /post-shell donor (sentinel id, not
// in the collection) from baking a block into KV — it renders nothing, exactly as
// the old chronological pager did.
// Computed for BOTH standalone and series posts: standalone posts show these as
// end-of-post cards; series posts hand them to <SeriesNav> so a boundary (first
// part / end of the series) offers a tag-related read instead of a dead end.
const MAX_RELATED = 2;
let related: CollectionEntry<'blog'>[] = [];
if (here !== -1) {
  const currentTags = new Set(tags);
  // The "next in the field" post is already offered by the field card, so keep it out
  // of the tag suggestions (no duplicate forward link at a field boundary).
  const nextInFieldSlug = fieldNav && fieldNav.next ? fieldNav.next.href.replace(/^\/blog\//, '').replace(/\/$/, '') : null;
  // Standalone posts suggest other STANDALONE essays (a bare series part out of context
  // reads badly as a "related" card). A series post, though, uses these only at its own
  // boundaries — so it may suggest posts from OTHER series too, just not its own parts.
  // Base the pool on whether the post BELONGS to a series (post.data.series), not on
  // whether it has multi-part nav — a lone part of a 1-post series (e.g. the last
  // series in a field) still deserves cross-series tag suggestions.
  const candidates = allPosts.filter((p) => p.id !== post.id && p.id !== nextInFieldSlug && (post.data.series ? p.data.series !== post.data.series : !p.data.series));
  related = candidates
    .map((p) => ({ p, shared: (p.data.tags ?? []).filter((t) => currentTags.has(t)).length }))
    .filter((x) => x.shared > 0)
    .sort((a, b) => b.shared - a.shared || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
    .slice(0, MAX_RELATED)
    .map((x) => x.p);
  if (related.length < MAX_RELATED) {
    const have = new Set(related.map((p) => p.id));
    for (const p of candidates) {
      if (related.length >= MAX_RELATED) break;
      if (!have.has(p.id)) { related.push(p); have.add(p.id); }
    }
  }
}
---

<BaseLayout title={title} description={description} image={`/og/${post.id}.png`} wide>
  {/* Reading-progress bar (driven by the script below). */}
  <div class="progress" id="pg"></div>
  {/* Records the signed-in reader's furthest point (powers "Continue" + read-marks). */}
  <ReaderProgress slug={post.id} />

  {/* Article head — inside the reading column. */}
  <div class="wrap">
    <div class="measure">
      <header class="art-head">
        <a class="backlink" href="/blog"><span class="a">&larr;</span> <span data-cms="post.backlink">{c.backlink || 'Back to the blog'}</span></a>
        <div class="kicker"><span class="line"></span><span class="eyebrow">{eyebrow}</span></div>
        <h1 class="title">{title}</h1>
        {description && <p class="standfirst">{description}</p>}
        <div class="byline">
          <div class="avatar" aria-hidden="true" data-cms-initial="post.author">{avatarInitial}</div>
          <div class="who">
            <b data-cms="post.author">{byline}</b>
            <small><time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>{updatedDate && <> &middot; <span data-cms="post.updatedLabel">{c.updatedLabel || 'updated'}</span> {fmt(updatedDate)}</>}</small>
          </div>
          <span class="nums">{wordCount} <span data-cms="post.wordsLabel">{c.wordsLabel || 'words'}</span> &middot; {minutes} <span data-cms="post.minReadLabel">{c.minReadLabel || 'min read'}</span></span>
          {tags.length > 0 && (
            <div class="btags">{tags.map((t) => (<a class="tag" href={`/blog/tags/${t}`}>{t}</a>))}</div>
          )}
        </div>
      </header>
    </div>
  </div>

  {/* Series card (top): the ordered parts list with the current one highlighted. */}
  {series && <div class="wrap"><div class="measure"><SeriesNav data={series} field={fieldNav} placement="top" /></div></div>}

  {/*
    The compiled Markdown body is injected here. For a normal post that is <Content/>;
    for a `gateable` post the [...slug] route passes <PaywallGate/> instead, which only
    emits preview-safe HTML statically. The single <article> wrapper is load-bearing
    (see header) — never remove/rename/duplicate it. `.post-body` styles the prose.
  */}
  <div class="wrap">
    <article class="post-body">
      <div class="measure">
        <slot />
      </div>
    </article>
  </div>

  {/* Everything after the essay, back inside the reading column. */}
  <div class="wrap">
    <div class="measure">
      <div class="after">
        {series
          ? <SeriesNav data={series} field={fieldNav} placement="bottom" related={related.map((r) => ({ slug: r.id, title: r.data.title }))} />
          : related.length > 0 && (
              <nav class="related" aria-label="Related reading">
                <div class="related-head"><span class="line"></span><span class="eyebrow" data-cms="post.relatedHeading">{c.relatedHeading || 'Related reading'}</span></div>
                <div class="related-grid">
                  {related.map((r) => (
                    <a class="rcard" href={`/blog/${r.id}`}>
                      {r.data.tags[0] && <div class="rk">{r.data.tags[0]}</div>}
                      <div class="rt">{r.data.title}</div>
                      <p class="rd">{r.data.description}</p>
                    </a>
                  ))}
                </div>
              </nav>
            )
        }

        {/* "Did it hold?" — anonymous reader-feedback poll (one tap, no account). */}
        <Feedback postId={post.id} />

        {/* Manual share row (web-intent links + copy; nothing auto-posts). */}
        <ShareBar url={shareUrl} title={title} />

        {/* End-of-post subscribe (self-contained; one instance per page). Wrapped so
            the N4 admin-hide can drop the whole block — admins are subscribed already. */}
        <div data-hide-admin>
          <SubscribeForm
            heading={c.newsletter?.heading || 'Read the next one first'}
            blurb={c.newsletter?.blurb || 'One considered essay every few weeks on LLM engineering and the systems underneath. No noise — unsubscribe in one click.'}
            headingKey="post.newsletter.heading"
            blurbKey="post.newsletter.blurb"
          />
        </div>

        <div class="all-link"><a href="/blog"><span data-cms="post.browseAllPrefix">{c.browseAllPrefix || 'Browse all'}</span> {allPosts.length} {allPosts.length === 1 ? (c.essaySingular || 'essay') : (c.essayPlural || 'essays')} &rarr;</a></div>

        {/* Interactive per-post islands (Supabase + RLS; keyed by post.id). */}
        <Highlights postId={post.id} author={byline} title={title} />
        <Notes postId={post.id} />
        <Comments postId={post.id} />
      </div>
    </div>
  </div>

  {/* Hydrates any published Plotly figures (interactive, lazy). No-op if none. */}
  <PlotlyReader />
</BaseLayout>

<style>
  .progress { position: fixed; top: 0; left: 0; height: 2px; width: 0; background: var(--accent); z-index: 60; transition: width 0.1s linear; }
  @media (prefers-reduced-motion: reduce) { .progress { transition: none; } }

  .art-head { padding: clamp(40px, 6vw, 76px) 0 clamp(20px, 3vw, 36px); }
  .backlink { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); display: inline-flex; align-items: center; gap: 8px; margin-bottom: 32px; transition: color 0.2s; }
  .backlink:hover { color: var(--accent); }
  .backlink .a { transition: transform 0.2s; }
  .backlink:hover .a { transform: translateX(-4px); }
  .art-head .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; }
  .art-head .kicker .line { height: 1px; width: 44px; background: var(--accent); opacity: 0.6; }
  h1.title { font-family: var(--serif-display); font-weight: 600; font-size: clamp(34px, 5.6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 0; max-width: 22ch; text-wrap: balance; }
  .standfirst { font-family: var(--serif-display); font-style: italic; font-size: clamp(19px, 2.4vw, 25px); line-height: 1.5; color: var(--ink-soft); max-width: 54ch; margin: 24px 0 0; text-wrap: pretty; }

  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .avatar { width: 42px; height: 42px; border-radius: 999px; background: radial-gradient(120% 120% at 30% 20%, var(--accent-soft), var(--accent)); display: grid; place-items: center; color: var(--on-accent); font-family: var(--serif-display); font-size: 20px; font-weight: 600; line-height: 1; flex: none; user-select: none; }
  .byline .who { font-family: var(--sans); font-size: 14px; color: var(--ink-soft); line-height: 1.4; }
  .byline .who b { color: var(--ink); font-weight: 600; }
  .byline .who small { display: block; font-size: 12px; color: var(--ink-faint); margin-top: 2px; }
  .byline .who time { color: inherit; }
  .byline .nums { font-family: var(--sans); font-size: 12.5px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .byline .btags { display: flex; gap: 8px; margin-left: auto; flex-wrap: wrap; }
  .byline .tag { font-family: var(--sans); font-size: 12px; letter-spacing: 0.03em; color: var(--ink-faint); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 11px; transition: border-color 0.2s, color 0.2s; }
  .byline .tag:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 680px) { .byline .btags { margin-left: 0; width: 100%; } }

  .after { padding: clamp(30px, 4vw, 44px) 0 0; }
  /* End-of-post related reading (non-series posts) — editorial 2-up cards. */
  .related { margin: 0 0 clamp(28px, 4vw, 40px); }
  .related-head { display: flex; align-items: center; gap: 14px; margin: 0 0 18px; }
  .related-head .line { height: 1px; width: 44px; background: var(--accent); opacity: 0.6; }
  .related-head .eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 640px) { .related-grid { grid-template-columns: 1fr; } }
  .rcard { border: 1px solid var(--rule); border-radius: 6px; padding: 22px 24px; transition: border-color 0.2s, transform 0.2s, background 0.2s; display: block; }
  .rcard:hover { border-color: var(--accent); transform: translateY(-2px); background: var(--paper-2); }
  .rcard .rk { font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 9px; }
  .rcard .rt { font-family: var(--serif-display); font-weight: 600; font-size: 19px; line-height: 1.25; color: var(--ink); }
  .rcard .rd { font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .all-link { text-align: center; margin: 34px 0 0; }
  .all-link a { font-family: var(--sans); font-size: 14px; color: var(--accent); border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .all-link a:hover { border-color: var(--accent); }
</style>

<script>
  // Reading-progress bar: width = scroll fraction. Passive listener; no-op if absent.
  const pg = document.getElementById('pg');
  if (pg) {
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      pg.style.width = (max > 0 ? ((h.scrollTop || document.body.scrollTop) / max) * 100 : 0) + '%';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
