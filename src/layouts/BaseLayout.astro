---
/**
 * BaseLayout.astro
 * =============================================================================
 * WHAT THIS FILE IS
 *   The single, top-level page shell for every rendered page on
 *   areyoustillreading.dev. It emits the outer `<!doctype html>` document —
 *   `<html>`/`<head>`/`<body>` — plus the shared site chrome (header with brand
 *   + primary nav, and footer). Page-specific content is projected into the
 *   `<main>` region via the default `<slot />`.
 *
 * SINGLE RESPONSIBILITY
 *   Own the HTML document skeleton and the persistent site-wide chrome. Nothing
 *   page-specific lives here; anything unique to a route is passed in as props
 *   (title/description/image) or rendered through the slot by the calling page.
 *
 * HOW IT FITS THE ARCHITECTURE
 *   This is a static Astro 7 build (SSG) deployed to Cloudflare Pages. TWO
 *   things trigger a (re)build/deploy: (1) a manual `npm run deploy`, which runs
 *   the build then a Wrangler DIRECT UPLOAD of `dist/`; and (2) the in-app
 *   publish pipeline (functions/api/publish.js) committing a Markdown post to
 *   GitHub, after which the Cloudflare Pages GIT INTEGRATION rebuilds the site.
 *   The dynamic behaviour this static shell deliberately omits — auth, payments,
 *   gated content — lives at the edges: Cloudflare Pages Functions, Supabase
 *   (+ Row-Level Security), and Dodo payments (webhook at
 *   functions/api/dodo-webhook.js). This layout runs at BUILD TIME only — the
 *   frontmatter below (the `---` fence) is server/build-side JS that is fully
 *   evaluated during `astro build` and never ships to the browser.
 *   Individual pages (`src/pages/**`) and content collections wrap their output
 *   in `<BaseLayout title=... >...</BaseLayout>`; whatever they nest becomes the
 *   `<slot />` payload. `<head>` composition is delegated wholesale to
 *   `BaseHead.astro` (title/description/OG image/canonical/meta), keeping this
 *   file focused on structure.
 *
 * IMPORTS / DEPENDENCIES (what this file pulls in)
 *   - '../styles/global.css'  Global stylesheet. Importing it here — in the one
 *                             layout every page shares — guarantees the site's
 *                             base styles are bundled into every page exactly
 *                             once, without each page having to import it.
 *   - BaseHead.astro          Builds the entire contents of `<head>` from the
 *                             same title/description/image props forwarded below
 *                             (SEO meta, Open Graph/Twitter tags, canonical URL,
 *                             favicon, astro-og-canvas image, etc.).
 *
 * WHAT DEPENDS ON THIS FILE (consumers)
 *   Effectively every user-facing route: home, /blog (+ post pages), /projects,
 *   /resume, /account, and the payments/paywall pages. They rely on this file
 *   for the document shell and the nav/footer being present and consistent.
 *
 * SECURITY / RLS / GOTCHAS
 *   - This layout is intentionally "dumb chrome": it performs NO auth checks, NO
 *     admin detection (`is_admin()`), NO entitlement/paywall gating, and NO
 *     token/signature verification. All of that lives elsewhere — in Cloudflare
 *     Pages Functions (including the gated-content middleware and the Dodo
 *     payments webhook at functions/api/dodo-webhook.js), Supabase Row-Level
 *     Security, the Supabase JS client on the relevant pages, and components
 *     like PaywallGate. Do NOT be tempted to
 *     add access control here: it is static HTML emitted at build time and is
 *     identical for every visitor, so any gating placed here would be trivially
 *     bypassable and would leak into the shared shell. Treat this file as
 *     containing zero secrets and zero trust decisions.
 *   - The nav is a plain static array (see below); the "Account" link is always
 *     rendered regardless of auth state. Whether a signed-out user can DO
 *     anything on /account is enforced by that page + Supabase RLS, not by
 *     hiding the link here.
 *   - Template rule for this repo: only JSX-style comments are allowed in markup
 *     in the markup (Astro strips them at build). HTML `<!-- -->` comments must
 *     never be added — they would ship to the browser and bloat/leak output.
 */

// Self-hosted Inter (variable) — CSP-safe, bundled by Astro (no external CDN).
import '@fontsource-variable/inter';
// Self-hosted editorial serifs (Charter body + Newsreader display placeholder).
// @font-face only — the tokens that consume these families land with the design
// foundation port; declaring them here is inert until referenced (no font fetch).
import '../styles/fonts.css';
// Bundle the global stylesheet into every page (single shared import point).
import '../styles/global.css';
// Delegate all <head> construction (SEO/OG/canonical/meta) to BaseHead.
import BaseHead from '../components/BaseHead.astro';
// First-party, cookieless analytics beacon (public pages only; see the component).
import Analytics from '../components/Analytics.astro';
import ReadingPaceRepricer from '../components/ReadingPaceRepricer.astro';
// Site-wide chrome copy (brand, nav labels, footer, default SEO description),
// editable from Studio → Content Management. Every use below falls back to the
// original string so the shell never renders blank if a field is missing.
import site from '../data/site.json';
const g = (site as any).global || {};
const gnav = g.nav || {};
const gfoot = g.footer || {};
const brandAccent = g.brand?.accent ?? 'are';
const brandRest = g.brand?.rest ?? 'youstillreading';

/**
 * Props accepted from the wrapping page.
 * - title:       Required. Page/document title, forwarded to BaseHead.
 * - description: Optional. Meta + OG description; defaults below when omitted.
 * - image:       Optional. Explicit OG/social share image; when absent BaseHead
 *                falls back to its own default (e.g. astro-og-canvas output).
 */
interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Full-bleed main for editorial pages that manage their own .wrap width
   *  (home, archive, etc.). Default keeps the 68ch reading column for prose pages. */
  wide?: boolean;
}

// Destructure incoming props. The default description is the site-wide tagline
// used whenever a page does not supply its own, so social/SEO previews are
// never left blank.
const {
  title,
  description = g.seo?.description || 'Notes on LLM engineering, plus the projects behind them.',
  image,
  wide = false,
} = Astro.props;

// Primary navigation, defined as data so the markup can render it with a single
// map (below) instead of hand-writing each <a>. Static and identical for all
// visitors — see the security note above: link visibility is NOT an access
// control; page-level auth + Supabase RLS govern what each route actually does.
// Primary nav (Account renders separately as the editorial pill; About joins
// once its page is built). Data-driven so a link change is one line here.
// The Blog item is a dropdown: its trigger goes to the full archive, and the
// menu also surfaces Series (which otherwise lived only in the footer).
// `key` is the site.json dot-path for that label — the shared address the Studio
// editor writes and the `data-cms` anchor (+ instant copy overlay) reads.
const nav = [
  { href: '/', label: gnav.home || 'Home', key: 'global.nav.home' },
  { href: '/blog', label: gnav.blog || 'Blog', key: 'global.nav.blog', children: [
    { href: '/blog', label: gnav.allPosts || 'All posts', key: 'global.nav.allPosts', desc: gnav.allPostsDesc || 'Everything, newest first', descKey: 'global.nav.allPostsDesc' },
    { href: '/series', label: gnav.series || 'Series', key: 'global.nav.series', desc: gnav.seriesDesc || 'Essays that run in order', descKey: 'global.nav.seriesDesc' },
    { href: '/fields', label: gnav.field || 'Field', key: 'global.nav.field', desc: gnav.fieldDesc || 'Series that belong together', descKey: 'global.nav.fieldDesc' },
  ] },
  { href: '/projects', label: gnav.projects || 'Projects', key: 'global.nav.projects' },
  { href: '/resume', label: gnav.resume || 'Resume', key: 'global.nav.resume' },
  { href: '/about', label: gnav.about || 'About', key: 'global.nav.about' },
];

// Current path, for marking the active nav item (aria-current="page"). Home
// matches exactly; the rest match on prefix so /blog/<post> keeps Blog active.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/'));
// A dropdown group counts as active when its trigger OR any child route is active
// (so the "Blog" trigger stays lit while browsing /series).
const isGroupActive = (item: { href: string; children?: { href: string }[] }) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

{/* Root document. lang="en" set once here so every page inherits it (a11y/SEO). */}
<!doctype html>
<html lang="en">
  <head>
    {/* All SEO/OG/canonical/meta tags come from BaseHead; props forwarded verbatim. */}
    <BaseHead title={title} description={description} image={image} />
    {/* RSS autodiscovery: lets feed readers/browsers find the @astrojs/rss feed at
        /rss.xml. Present on every page because it lives in the shared <head>. */}
    <link rel="alternate" type="application/rss+xml" title="areyoustillreading" href="/rss.xml" />
    {/* Native form controls / scrollbars follow the active theme. */}
    <meta name="color-scheme" content="light dark" />
    {/*
      Theme: set data-theme on <html> BEFORE first paint (no flash) from the saved
      choice, else the OS preference; then bind the header toggle. Public pages only
      (this layout) — the admin dashboard stays OS-driven. is:inline so it runs
      immediately in <head> and isn't deferred/bundled (CSP allows inline scripts).
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var t = null;
        try { t = localStorage.getItem('ays.theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', t);
        // Pre-paint admin flag (N4): a KNOWN admin (cached flag) gets html[data-admin]
        // set BEFORE first paint, so global.css hides the subscribe blocks with no flash.
        // The deferred module below revalidates + un-hides if the account isn't admin.
        try { if (localStorage.getItem('aysr:admin-ok') === '1') root.setAttribute('data-admin', '1'); } catch (e) {}
        function bind() {
          var btn = document.getElementById('tt');
          if (!btn) return;
          btn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
          btn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            btn.setAttribute('aria-pressed', String(next === 'dark'));
            try { localStorage.setItem('ays.theme', next); } catch (e) {}
          });
        }
        if (document.readyState !== 'loading') bind();
        else document.addEventListener('DOMContentLoaded', bind);
      })();
    </script>
  </head>
  <body>
    {/* Persistent editorial header: wordmark (accented "are"), primary nav, the
        Account pill, the admin-only Studio link, and the light/dark toggle. */}
    <header class="site-header">
      <div class="wrap">
        <div class="bar">
          <a href="/" class="wordmark"><span class="are" data-cms="global.brand.accent">{brandAccent}</span><span data-cms="global.brand.rest">{brandRest}</span></a>
          <nav class="nav-primary">
            {/* Data-driven primary links; aria-current marks (and styles) the active section.
                An item with `children` renders as a hover/focus dropdown (Blog → Series).
                Each label carries a data-cms anchor so a Studio copy edit patches it live. */}
            {nav.map((item) => (item.children ? (
              <div class={`nav-group${isGroupActive(item) ? ' is-active' : ''}`}>
                <a href={item.href} class="nav-trigger" aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup="true">
                  <span data-cms={item.key}>{item.label}</span>
                  <svg class="caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </a>
                <div class="nav-menu" role="menu">
                  {item.children.map((c) => (
                    <a href={c.href} role="menuitem" aria-current={isActive(c.href) ? 'page' : undefined}>
                      <span data-cms={c.key}>{c.label}</span>
                      {(c as any).desc && <small data-cms={(c as any).descKey}>{(c as any).desc}</small>}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} data-cms={item.key}>{item.label}</a>
            )))}
            <a href="/account" class="account" aria-current={isActive('/account') ? 'page' : undefined} data-cms="global.nav.account">{gnav.account || 'Account'}</a>
            {/* Studio (admin dashboard) entry — hidden by default; the script below reveals
                it only for a signed-in admin. Link visibility is UX only; /admin and every
                mutation are enforced by the gate + requireAdmin. */}
            <a href="/admin" id="nav-admin" class="nav-studio" hidden>Studio</a>
            {/* Light/dark toggle. The head script sets data-theme + binds this by id. */}
            <button type="button" id="tt" class="theme-toggle" aria-label="Switch light or dark theme" title="Switch light / dark">
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </button>
          </nav>
        </div>
      </div>
    </header>
    {/* Page-specific content is injected here by the wrapping page via the slot.
        `wide` opts out of the constrained reading column so editorial pages can run
        their own full-width .wrap sections. */}
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <script>
      // Reveal the "Studio" nav link only for a signed-in admin. Fast path: if this
      // browser was confirmed admin before, show it instantly from the cached flag.
      // Then, ONLY if a Supabase session actually exists locally, dynamically import the
      // gate to revalidate — so anonymous visitors never load Supabase for this at all.
      const link = document.getElementById('nav-admin');
      if (link) {
        let cached = false, hasSession = false;
        try {
          cached = localStorage.getItem('aysr:admin-ok') === '1';
          if (cached) link.hidden = false; // optimistic instant reveal for a known admin
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith('sb-') && k.includes('auth-token')) { hasSession = true; break; }
          }
        } catch {}
        // Revalidate whenever there's any hint of an account (cache flag OR a Supabase
        // session). checkAdmin() reads the session locally first, so a signed-out visitor
        // resolves without a network call. Purely-anonymous visitors skip the import
        // entirely, so they never load Supabase just to evaluate this link.
        if (cached || hasSession) {
          import('../lib/admin-gate').then(async ({ checkAdmin }) => {
            const r = await checkAdmin();
            link.hidden = r.state !== 'admin';
          }).catch(() => {});
        } else {
          link.hidden = true;
        }
      }
    </script>
    <script>
      // Hide newsletter/subscribe blocks for signed-in ADMINS only (N4). Admins are
      // subscribed by default, so a subscribe CTA is noise for them. Every subscribe
      // SECTION opts in with data-hide-admin, hidden by CSS under html[data-admin="1"].
      // The pre-paint <head> script above already sets that attribute for a KNOWN admin
      // (cached flag) so blocks never paint for them — no flash. Here we only REVALIDATE:
      // import the gate ONLY when there's a hint of an account (cache flag OR a local
      // Supabase session); a purely-anonymous visitor skips the import, so Supabase is
      // never loaded to evaluate this. checkAdmin() is memoized → shares the same
      // is_admin() round-trip as the Studio-link script (no extra network cost).
      {
        const root = document.documentElement;
        let cached = false, hasSession = false;
        try {
          cached = localStorage.getItem('aysr:admin-ok') === '1';
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith('sb-') && k.includes('auth-token')) { hasSession = true; break; }
          }
        } catch {}
        if (cached || hasSession) {
          import('../lib/admin-gate').then(async ({ checkAdmin }) => {
            const r = await checkAdmin();
            if (r.state === 'admin') root.setAttribute('data-admin', '1');
            else root.removeAttribute('data-admin'); // not admin → show the blocks
          }).catch(() => {});
        }
        // Pure anonymous (no cache, no session): no data-admin; blocks stay visible.
      }
    </script>
    <script>
      // Auth-callback consumer. Sign-in (magic-link / OAuth) redirects land on the
      // HOMEPAGE now, so a callback can arrive on any public page. If the URL carries
      // auth params, load the Supabase client (which consumes the session on init),
      // then strip the params from the URL. Runs ONLY when params are actually present,
      // so normal navigations load nothing extra.
      {
        const hasAuth =
          /(?:access_token|refresh_token|provider_token|error_description)=/.test(location.hash) ||
          /[?&](code|token_hash|error)=/.test(location.search);
        if (hasAuth) {
          import('../lib/supabase')
            .then(async ({ supabase }) => {
              try { await supabase.auth.getSession(); } catch {}
              try { history.replaceState(null, '', location.pathname); } catch {}
            })
            .catch(() => {});
        }
      }
    </script>
    {/* Editorial footer: wordmark · nav · social, over a centred copyline. */}
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot">
          <a href="/" class="wordmark"><span class="are" data-cms="global.brand.accent">{brandAccent}</span><span data-cms="global.brand.rest">{brandRest}</span></a>
          <nav>
            <a href="/blog" data-cms="global.nav.blog">{gnav.blog || 'Blog'}</a>
            <a href="/series" data-cms="global.nav.series">{gnav.series || 'Series'}</a>
            <a href="/fields" data-cms="global.nav.field">{gnav.field || 'Field'}</a>
            <a href="/projects" data-cms="global.nav.projects">{gnav.projects || 'Projects'}</a>
            <a href="/resume" data-cms="global.nav.resume">{gnav.resume || 'Resume'}</a>
            <a href="/letter" data-cms="global.footer.letter">{gfoot.letter || 'The letter'}</a>
            <a href="/rss.xml" data-cms="global.footer.rss">{gfoot.rss || 'RSS'}</a>
          </nav>
          <div class="social">
            <a href="/rss.xml" aria-label="RSS feed" title="RSS feed">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h2.6A11.6 11.6 0 0 0 4 8.4V11zm0 4.2a4.8 4.8 0 0 1 4.8 4.8h2.6A7.4 7.4 0 0 0 4 12.6v2.6zM5.7 17.9a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6z"/></svg>
            </a>
          </div>
        </div>
        {/* Copyright year: rendered at BUILD TIME (correct for no-JS + SEO), then reconciled to
            the visitor's actual current year on load — so it stays right even if the site isn't
            rebuilt across a New Year. */}
        <p class="copyline">&copy; <span id="ays-year">{new Date().getFullYear()}</span> <span data-cms="global.brand.accent">{brandAccent}</span><span data-cms="global.brand.rest">{brandRest}</span> &middot; <span data-cms="global.footer.tagline">{gfoot.tagline || 'Written to be finished.'}</span></p>
        <script is:inline>
          (function () { var y = document.getElementById('ays-year'); if (y) y.textContent = new Date().getFullYear(); })();
        </script>
      </div>
    </footer>
    {/* Cookieless first-party analytics beacon — public pages only. */}
    <Analytics />
    {/* Personalises every [data-read-min] reading time to the reader's adopted pace. */}
    <ReadingPaceRepricer />
  </body>
</html>
