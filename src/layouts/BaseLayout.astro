---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Notes on LLM engineering, plus the projects behind them.',
  image,
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  { href: '/account', label: 'Account' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="alternate" type="application/rss+xml" title="areyoustillreading" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">areyoustillreading</a>
      <nav>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} areyoustillreading</p>
    </footer>
  </body>
</html>
