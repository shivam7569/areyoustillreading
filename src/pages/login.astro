---
/**
 * src/pages/login.astro — the public sign-in page (route: /login)
 * ---------------------------------------------------------------
 * Passwordless email OTP (a 6-digit code, verified IN-TAB so no second tab opens) + GitHub OAuth,
 * both handed to Supabase in the browser; on success the visitor lands on `/` (BaseLayout's auth
 * handler finalizes the session anywhere). No server code, no authorization here — RLS + is_admin()
 * do that downstream. Canonical entry point for auth (nav, Comments, onboarding, the Studio all
 * link here). Reskinned to the Claude Design "signin" (two columns: the pitch + the panel); the
 * auth wiring is unchanged, only the markup/styles. Copy is Studio-editable via site.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const c = (site as any).login || {};
const msgs = {
  sending: c.msgSending || 'Sending…',
  codeSent: c.msgCodeSent || 'We emailed you a 6-digit code. Enter it here to finish signing in.',
  verifying: c.msgVerifying || 'Verifying…',
  signedIn: c.msgSignedIn || 'Signed in — taking you in…',
  enterCode: c.msgEnterCode || 'Enter the code from your email.',
  redirecting: c.msgRedirecting || 'Redirecting to GitHub…',
};
---

<BaseLayout title={c.seo?.title || 'Sign in — areyoustillreading'} description={c.seo?.description || 'Sign in to areyoustillreading.'} wide>
  <script type="application/json" id="login-copy" set:html={JSON.stringify(msgs)} />

  <div class="wrap auth">
    <div class="pitch">
      <div class="kicker"><span class="line"></span><span class="eyebrow" data-cms="login.eyebrow">{c.eyebrow || 'Your account'}</span></div>
      <h1 data-cms="login.heading" set:html={c.heading || 'Sign in to pick up <em>where you stopped.</em>'} />
      <p data-cms="login.lede">{c.lede || "There's no password. Put in your email and I'll send a code that signs you in — right here in this tab."}</p>
      <ul class="perks">
        <li>Your reading position, kept across devices</li>
        <li>A library of the essays you've finished</li>
        <li>Your notes and highlights, saved</li>
        <li>The letter, managed in one place</li>
      </ul>
    </div>

    <section class="card panel" id="panel">
      {/* Step 1 — email. #magic-form is the auth-script hook. */}
      <div class="form-state" id="email-step">
        <h2 data-cms="login.panelHeading">{c.panelHeading || 'Sign in'}</h2>
        <p class="sub" data-cms="login.panelSub">{c.panelSub || 'No account yet? Entering your address makes one.'}</p>
        <form id="magic-form">
          <div class="field">
            <label for="li-email">Email address</label>
            <input id="li-email" type="email" name="email" required placeholder={c.emailPlaceholder || 'you@example.com'} autocomplete="email" />
          </div>
          <button class="btn btn-primary" type="submit" data-cms="login.sendCode">{c.sendCode || 'Email me a sign-in code'}</button>
        </form>
        <div class="or" data-cms="login.divider">{c.divider || 'or'}</div>
        <div class="oauth">
          <button id="github-btn" class="btn btn-ghost" type="button" style="justify-content:center">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.3-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.8-2.4 4.7-4.6 4.9.3.3.6.9.6 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/></svg>
            <span data-cms="login.github">{c.github || 'Continue with GitHub'}</span>
          </button>
        </div>
        <p class="fine">Signing in stores your email and your own reading — your position, library, and notes — and nothing else. No tracking, no list sales.</p>
        <p class="fine" style="margin-top:10px">Writing here? <a class="link" href="/admin">Open the Studio</a>.</p>
      </div>

      {/* Step 2 — the emailed code, verified in-tab. #code-form is the auth-script hook. */}
      <div class="sent" id="code-step" hidden>
        <div class="mail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3z"/><path d="m3 7 9 6.5L21 7"/></svg></div>
        <h2>Check your email</h2>
        <p>A 6-digit sign-in code is on its way. Enter it to finish — it works once and expires in fifteen minutes.</p>
        <form id="code-form" class="code-form">
          <div class="field">
            <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="8" placeholder={c.codePlaceholder || '6-digit code'} aria-label="Sign-in code" />
          </div>
          <button class="btn btn-primary" type="submit" data-cms="login.verify">{c.verify || 'Verify & sign in'}</button>
        </form>
        <p class="again">Nothing arrived? <button type="button" id="code-back" class="linkish" data-cms="login.useDifferent">{c.useDifferent || 'Try a different address'}</button></p>
      </div>

      <p id="auth-msg" class="auth-msg" role="status" aria-live="polite"></p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Ported from the Claude Design "signin" template. Build-time DOM only (no runtime injection),
     so scoped styles are fine. Tokens from global.css. */
  .auth { display: grid; grid-template-columns: minmax(0,1fr) 430px; gap: clamp(36px,7vw,88px); align-items: center; padding: clamp(40px,6vw,72px) 0; }
  @media (max-width: 940px) { .auth { grid-template-columns: 1fr; gap: 40px; } }
  .pitch .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
  .pitch .kicker .line { height: 1px; width: 48px; background: var(--accent); opacity: .6; }
  .pitch h1 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(34px,5.2vw,54px); line-height: 1.05; letter-spacing: -.02em; margin: 0 0 22px; max-width: 16ch; }
  .pitch h1 :global(em) { font-style: italic; color: var(--accent); }
  .pitch p { color: var(--ink-soft); font-size: 19px; max-width: 46ch; margin: 0 0 30px; }
  .perks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; max-width: 44ch; }
  .perks li { position: relative; padding-left: 24px; font-size: 17px; color: var(--ink); line-height: 1.5; }
  .perks li::before { content: ""; position: absolute; left: 0; top: .65em; width: 9px; height: 1px; background: var(--accent); }

  .panel { padding: clamp(28px,3.4vw,38px); border: 1px solid var(--rule); border-radius: 8px; background: var(--card); }
  .panel h2 { font-family: var(--serif-display); font-weight: 600; font-size: 26px; margin: 0 0 8px; letter-spacing: -.01em; }
  .panel .sub { font-family: var(--sans); font-size: 14px; color: var(--ink-faint); margin: 0 0 26px; }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-family: var(--sans); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 9px; }
  .field input { width: 100%; box-sizing: border-box; font-family: var(--sans); font-size: 15px; padding: 13px 16px; border-radius: 3px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); }
  .field input::placeholder { color: var(--ink-faint); }
  .field input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .panel .btn { width: 100%; justify-content: center; }
  .or { display: flex; align-items: center; gap: 14px; margin: 24px 0; font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); }
  .or::before, .or::after { content: ""; flex: 1; height: 1px; background: var(--rule); }
  .oauth .btn { border-color: var(--rule); display: inline-flex; align-items: center; gap: 10px; }
  .oauth svg { width: 17px; height: 17px; }
  .fine { font-family: var(--sans); font-size: 12.5px; color: var(--ink-faint); line-height: 1.6; margin: 24px 0 0; padding-top: 20px; border-top: 1px solid var(--rule); }
  .fine:last-of-type { border-top: 0; padding-top: 0; margin-top: 10px; }
  .fine a, .fine .link { color: var(--accent); }

  .sent { text-align: center; }
  .sent .mail { width: 52px; height: 52px; border-radius: 999px; display: grid; place-items: center; margin: 0 auto 20px; background: color-mix(in srgb, var(--accent) 13%, transparent); color: var(--accent); }
  .sent .mail svg { width: 23px; height: 23px; }
  .sent h2 { margin-bottom: 12px; }
  .sent p { color: var(--ink-soft); font-size: 17px; margin: 0 auto 18px; max-width: 40ch; }
  .code-form { max-width: 260px; margin: 0 auto; }
  .code-form .field input { text-align: center; letter-spacing: .3em; font-size: 18px; }
  .again { font-family: var(--sans); font-size: 13.5px; color: var(--ink-faint); margin-top: 20px; }
  .linkish { font: inherit; color: var(--accent); background: none; border: 0; border-bottom: 1px solid transparent; cursor: pointer; padding: 0; }
  .linkish:hover { border-color: var(--accent); }
  .auth-msg { color: var(--ink-faint); min-height: 1.2em; margin: 16px 0 0; font-family: var(--sans); font-size: 13px; text-align: center; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const CM = (() => { try { return JSON.parse(document.getElementById('login-copy')?.textContent || '{}'); } catch { return {}; } })();
  const redirectTo = window.location.origin + '/';
  const msg = document.getElementById('auth-msg')!;
  const form = document.getElementById('magic-form') as HTMLFormElement | null;
  const codeForm = document.getElementById('code-form') as HTMLFormElement | null;
  const emailStep = document.getElementById('email-step')!;
  const codeStep = document.getElementById('code-step')!;
  let pendingEmail = '';

  // Step 1 — email a 6-digit code, then swap to the code step (in-tab, no second tab opens).
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
    msg.textContent = CM.sending || 'Sending…';
    const { error } = await supabase.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo } });
    if (error) { msg.textContent = error.message; return; }
    pendingEmail = email;
    emailStep.hidden = true;
    codeStep.hidden = false;
    msg.textContent = '';
    (codeForm?.querySelector('[name="code"]') as HTMLInputElement | null)?.focus();
  });

  // Step 2 — verify the code and finish in-tab.
  codeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = (codeForm.querySelector('[name="code"]') as HTMLInputElement).value.trim();
    if (!token) { msg.textContent = CM.enterCode || 'Enter the code from your email.'; return; }
    msg.textContent = CM.verifying || 'Verifying…';
    const { error } = await supabase.auth.verifyOtp({ email: pendingEmail, token, type: 'email' });
    if (error) { msg.textContent = error.message; return; }
    msg.textContent = CM.signedIn || 'Signed in — taking you in…';
    window.location.assign('/');
  });

  // "Try a different address" — back to step 1.
  document.getElementById('code-back')?.addEventListener('click', () => {
    codeStep.hidden = true;
    emailStep.hidden = false;
    msg.textContent = '';
    (form?.querySelector('[name="email"]') as HTMLInputElement | null)?.focus();
  });

  // GitHub OAuth.
  document.getElementById('github-btn')?.addEventListener('click', async () => {
    msg.textContent = CM.redirecting || 'Redirecting to GitHub…';
    const { error } = await supabase.auth.signInWithOAuth({ provider: 'github', options: { redirectTo } });
    if (error) msg.textContent = error.message;
  });
</script>
