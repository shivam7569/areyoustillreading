---
/**
 * src/pages/login.astro — the public sign-in page (route: /login)
 * ---------------------------------------------------------------
 * SINGLE RESPONSIBILITY
 *   Render a static sign-in UI and wire two client-side Supabase auth flows:
 *     1. Passwordless email "magic link" (OTP) sign-in.
 *     2. GitHub OAuth sign-in.
 *   Both flows hand the browser off to Supabase; on success the user lands
 *   back on /account (see `redirectTo` below).
 *
 * WHERE IT FITS IN THE ARCHITECTURE
 *   - This is a static Astro page (prerendered at build, deployed to
 *     Cloudflare Pages). There is NO server-side code here: the frontmatter
 *     only imports the layout, and all auth logic runs in the browser via the
 *     Supabase JS client. That is intentional — auth tokens must be minted by
 *     Supabase directly in the user's browser, never proxied through our edge.
 *   - This page only STARTS the handshake; it never sees the returned session.
 *     The magic-link email click (or the GitHub OAuth redirect) both land on
 *     /account with the auth params in the URL, and supabase-js finalizes the
 *     session THERE via its default `autoDetectSessionInUrl: true` (see
 *     src/lib/supabase.ts) — writing the JWT + refresh token to localStorage.
 *     Downstream pages/Functions then read that persisted session and rely on
 *     Supabase Row-Level Security (RLS) + the `is_admin()` SQL function for
 *     authorization. This page performs NO authorization of its own.
 *
 * DEPENDENCIES (imports)
 *   - ../layouts/BaseLayout.astro : shared page shell (head, nav, theming vars
 *     like --bg/--fg/--accent/--border/--muted used by the <style> block).
 *   - ../lib/supabase (client <script> only) : the singleton browser Supabase
 *     client. It carries the public anon key + project URL. NOTE: the anon key
 *     is PUBLIC by design; it is safe to ship because every table is guarded by
 *     RLS. This file must never import service-role keys or server secrets.
 *
 * WHAT DEPENDS ON THIS FILE
 *   - Anything linking to /login (nav "Sign in" links, redirects from gated
 *     content / PaywallGate, /account when logged out). This is the canonical
 *     entry point for authentication.
 *
 * SECURITY ASSUMPTIONS & GOTCHAS
 *   - `redirectTo` is derived from window.location.origin (not a hardcoded
 *     URL) so it works across localhost/preview/prod. HOWEVER, Supabase only
 *     honours redirect URLs that are on the project's allow-list (Auth
 *     settings). This is the guardrail that stops an attacker from crafting a
 *     login link that redirects to an arbitrary origin — keep the allow-list
 *     tight and in sync with deployed origins, or valid logins will silently
 *     fail to redirect.
 *   - No bot protection (Turnstile) is wired into this form. Magic-link abuse
 *     is rate-limited by Supabase/Resend SMTP quotas rather than a CAPTCHA
 *     here; if abuse becomes a problem, Turnstile would be added around the
 *     signInWithOtp call.
 *   - There is no honeypot / entitlement / signature logic in this file — those
 *     live in the payment + gating layer, not in the auth entry point.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

// Copy editable from Studio → Content Management → Sign in. Server-rendered
// strings use {c.x}; the client-side status messages are handed to the script
// below via a JSON <script> it reads at runtime (so those are editable too).
const c = (site as any).login || {};
const msgs = {
  sending: c.msgSending || 'Sending…',
  codeSent: c.msgCodeSent || 'We emailed you a 6-digit code. Enter it here to finish signing in.',
  verifying: c.msgVerifying || 'Verifying…',
  signedIn: c.msgSignedIn || 'Signed in — taking you in…',
  enterCode: c.msgEnterCode || 'Enter the code from your email.',
  redirecting: c.msgRedirecting || 'Redirecting to GitHub…',
};
---

<BaseLayout title={c.seo?.title || 'Sign in — areyoustillreading'} description={c.seo?.description || 'Sign in to areyoustillreading.'}>
  {/* Client-side status strings, editable from Studio; the script below reads these. */}
  <script type="application/json" id="login-copy" set:html={JSON.stringify(msgs)} />
  <h1 data-cms="login.heading">{c.heading || 'Sign in'}</h1>
  <p data-cms="login.lede">{c.lede || 'Sign in to comment, highlight, and keep private notes on posts.'}</p>

  {/* Step 1 — email form. `id="magic-form"` is the hook the client script binds to.
      No `action`/`method`: submission is intercepted in JS (preventDefault) and
      routed through Supabase — this form never POSTs to our server. */}
  <form id="magic-form" class="auth-form">
    {/* `required` + type="email" give a free client-side validity gate before
        we ever call Supabase. aria-label supplies an accessible name since the
        visible label is only the placeholder. */}
    <input type="email" name="email" required placeholder={c.emailPlaceholder || 'you@example.com'} aria-label="Email address" />
    <button type="submit" data-cms="login.sendCode">{c.sendCode || 'Email me a sign-in code'}</button>
  </form>

  {/* Step 2 — code entry. Verifying the emailed code finishes sign-in RIGHT HERE
      in this tab (no link click, so no second tab opens). Hidden until step 1 sends. */}
  <form id="code-form" class="auth-form" hidden>
    <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="8" placeholder={c.codePlaceholder || '6-digit code'} aria-label="Sign-in code" />
    <button type="submit" data-cms="login.verify">{c.verify || 'Verify & sign in'}</button>
    <button type="button" id="code-back" class="linkish" data-cms="login.useDifferent">{c.useDifferent || 'Use a different email'}</button>
  </form>

  <p class="divider" data-cms="login.divider">{c.divider || 'or'}</p>

  {/* type="button" (NOT submit) so this GitHub button lives outside the form
      and never triggers the magic-link submit handler. */}
  <button id="github-btn" class="oauth-btn" type="button" data-cms="login.github">{c.github || 'Sign in with GitHub'}</button>

  {/* Live status region. role="status" + aria-live="polite" announces
      "Sending…" / success / error text to screen readers without stealing
      focus. `min-height` in CSS reserves space so the layout doesn't jump when
      text appears. */}
  <p id="auth-msg" class="auth-msg" role="status" aria-live="polite"></p>
</BaseLayout>

<style>
  .auth-form { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 420px; }
  .auth-form input {
    flex: 1 1 220px;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
  }
  .auth-form button, .oauth-btn {
    padding: 0.55rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .oauth-btn { background: var(--bg); color: var(--fg); }
  .linkish { background: none; border: 0; color: var(--muted); font-weight: 500; cursor: pointer; text-decoration: underline; padding: 0.55rem 0.4rem; flex: 0 0 auto; }
  .linkish:hover { color: var(--fg); }
  .divider { color: var(--muted); max-width: 420px; text-align: center; }
  .auth-msg { color: var(--muted); min-height: 1.2em; }
</style>

<script>
  // This <script> is bundled/hydrated by Astro and runs client-side only.
  // The singleton browser Supabase client (public anon key + project URL).
  import { supabase } from '../lib/supabase';

  // Editable status-message copy, read from the JSON <script id="login-copy"> above.
  const CM = (() => { try { return JSON.parse(document.getElementById('login-copy')?.textContent || '{}'); } catch { return {}; } })();

  // Absolute post-auth landing URL, computed from the current origin so the
  // same build works on localhost, Cloudflare preview deploys, and prod.
  // IMPORTANT: this value must be present on Supabase's redirect allow-list or
  // Supabase will reject the redirect (see security notes in frontmatter).
  // Land on the HOMEPAGE after sign-in (the callback is consumed on any page by
  // BaseLayout's auth handler), so a magic-link click doesn't dump the reader on a
  // bare /account page.
  const redirectTo = window.location.origin + '/';
  const msg = document.getElementById('auth-msg');
  const form = document.getElementById('magic-form');
  const codeForm = document.getElementById('code-form');
  let pendingEmail = '';

  // --- Email OTP flow, SAME-TAB (R10) --------------------------------------
  // Step 1 emails a 6-digit code (the template also carries a link as a fallback);
  // step 2 verifies the code here, so sign-in finishes in THIS tab and never opens
  // a second one. Optional-chained binding: no-op if the markup changed.
  form?.addEventListener('submit', async (e) => {
    // Stop the native form POST/navigation — we handle everything in JS.
    e.preventDefault();
    const email = form.querySelector('[name="email"]').value.trim();
    // Immediate feedback so the user isn't left wondering during the network call.
    msg.textContent = CM.sending || 'Sending…';
    // signInWithOtp emails the code (and a link). Supabase always responds
    // success-shaped here (it does NOT reveal whether the email exists) to avoid
    // account enumeration — so we advance to the code step regardless.
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: redirectTo },
    });
    if (error) { msg.textContent = error.message; return; }
    pendingEmail = email;
    form.hidden = true;
    if (codeForm) codeForm.hidden = false;
    msg.textContent = CM.codeSent || 'We emailed you a 6-digit code. Enter it here to finish signing in.';
    codeForm?.querySelector('[name="code"]')?.focus();
  });

  // Step 2 — verify the emailed code and finish sign-in in-tab.
  codeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = codeForm.querySelector('[name="code"]').value.trim();
    if (!token) { msg.textContent = CM.enterCode || 'Enter the code from your email.'; return; }
    msg.textContent = CM.verifying || 'Verifying…';
    // type 'email' verifies a magic-link/OTP token for an email sign-in.
    const { error } = await supabase.auth.verifyOtp({ email: pendingEmail, token, type: 'email' });
    if (error) { msg.textContent = error.message; return; }
    // Session is now established in THIS tab — continue here, no new tab.
    msg.textContent = CM.signedIn || 'Signed in — taking you in…';
    window.location.assign('/');
  });

  // "Use a different email" — back to step 1.
  document.getElementById('code-back')?.addEventListener('click', () => {
    if (codeForm) codeForm.hidden = true;
    if (form) form.hidden = false;
    msg.textContent = '';
    form?.querySelector('[name="email"]')?.focus();
  });

  // --- GitHub OAuth flow ----------------------------------------------------
  document.getElementById('github-btn')?.addEventListener('click', async () => {
    // On success this call navigates the whole page away to GitHub, so this
    // "Redirecting…" text is the last thing shown before the handoff.
    msg.textContent = CM.redirecting || 'Redirecting to GitHub…';
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'github',
      options: { redirectTo },
    });
    // We only reach this line if the redirect itself failed to start
    // (e.g. misconfigured provider); the happy path has already navigated away.
    if (error) msg.textContent = error.message;
  });
</script>
