<script is:inline>
  (function () {
    var tabs = document.getElementById('cotabs'), list = document.getElementById('coin'), empty = document.getElementById('coempty');
    if (!tabs) return;
    function apply(t) {
      var live = 0;
      [].forEach.call(list.querySelectorAll('li'), function (li) { var on = li.dataset.t === t; li.classList.toggle('cogone', !on); if (on) live++; });
      list.dataset.view = t; empty.style.display = live ? 'none' : '';
    }
    tabs.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      [].forEach.call(tabs.querySelectorAll('button'), function (x) { x.classList.toggle('coon', x === b); });
      apply(b.dataset.t);
    });
    apply('in');
  })();
</script>
