---
/*
 * =============================================================================
 * src/pages/series.astro  ·  ROUTE: "/series"
 * =============================================================================
 * The public index of multi-part series. Each series renders as a data-drawn "silk
 * plate" + parts list via <SeriesPlate>, the same card each field's page uses. The
 * plate + series display model are produced by resolveSeries() (src/lib/series-plate),
 * so /series and /fields/<slug> stay byte-identical. A series that belongs to a public
 * field also shows a subtle "part of the <Field> field" link (getSeriesFieldMap).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import SeriesPlate from '../components/SeriesPlate.astro';
import site from '../data/site.json';
import seriesDefsData from '../data/series.json';
import { getCollection } from 'astro:content';
import { resolveSeries } from '../lib/series-plate.mjs';
import { getSeriesFieldMap } from '../lib/fields';

// Editable copy from Studio → Content Management → Series page.
const c = (site as any).series || {};
// Studio-defined series knobs (title / total / status / planned), keyed by slug.
const seriesDefs = new Map<string, any>(((seriesDefsData as any).series || []).map((d: any) => [d.slug, d]));

// Group published posts by series slug.
const all = await getCollection('blog', ({ data }) => !data.draft && !!data.series);
const bySeries = new Map<string, typeof all>();
for (const p of all) {
  const s = p.data.series as string;
  if (!bySeries.has(s)) bySeries.set(s, []);
  bySeries.get(s)!.push(p);
}

// slug → the public field it belongs to (if any), for the "part of the field" line.
const fieldMap = await getSeriesFieldMap();

const seriesList = [...bySeries.entries()]
  .map(([slug, members]) => resolveSeries(slug, members, seriesDefs.get(slug)))
  .sort((a, b) => (b.latest?.valueOf() ?? 0) - (a.latest?.valueOf() ?? 0));
---

<BaseLayout title={c.seo?.title || 'Series — areyoustillreading'} description={c.seo?.description || 'Multi-part collections — each a single argument split across essays that build on each other.'} wide>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow" data-cms="series.eyebrow">{c.eyebrow || 'Series'}</span></div>
      <h1><span data-cms="series.title">{c.title || 'Some ideas'}</span> <em data-cms="series.titleEm">{c.titleEm || "don't fit in one sitting."}</em></h1>
      <p class="lede" data-cms="series.lede">{c.lede || "Running collections — each one a single argument split across essays that build on each other. Start at part one, or don't; every part stands up alone."}</p>
    </header>

    {seriesList.length > 0 ? seriesList.map((s) => {
      const f = fieldMap.get(s.slug);
      return <SeriesPlate s={s} fieldLine={f ? { href: `/fields/${f.slug}/`, title: f.title } : null} />;
    }) : (
      <p class="empty"><span data-cms="series.empty">{c.empty || 'No multi-part series yet. When essays share a series, they gather here.'}</span> <a class="link" href="/blog" data-cms="series.emptyLink">{c.emptyLink || 'Browse all posts →'}</a></p>
    )}

    <div class="series-foot">
      <div class="sub-inner">
        <SubscribeForm heading={c.newsletter?.heading || 'Get the next part when it lands'} blurb={c.newsletter?.blurb || 'Series instalments go out by email as they publish. No noise — unsubscribe from any email in one click.'} headingKey="series.newsletter.heading" blurbKey="series.newsletter.blurb" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .empty { border-top: 1px solid var(--rule); padding: clamp(40px, 6vw, 70px) 6px; color: var(--ink-faint); font-family: var(--sans); font-size: 16px; }
  .series-foot { padding: clamp(44px, 6vw, 72px) 0 clamp(56px, 8vw, 96px); }
  .sub-inner { max-width: 720px; }
</style>
