---
/*
 * =============================================================================
 * src/pages/series.astro  ·  ROUTE: "/series"
 * =============================================================================
 * Ported from the Claude Design "series" plate (editorial/series.html): each card
 * is a data-drawn "silk plate" — a field of faint accent comb-curves (≈3 per part)
 * that pinch to a waist, with a bold SPINE threading the parts, each part sitting at
 * a height set by its reading time. Nothing is uploaded; the SVG is generated here.
 *
 * DATA-MODEL NOTE: the richer model the design mocks (known total "3 of 5", a status,
 * planned/upcoming parts) is now AUTHOR-DECLARED via optional frontmatter
 * (seriesTotal / seriesStatus / seriesPlanned, set from the editor's publish modal).
 * When those are absent we fall back to the published parts only: real counts/dates,
 * solid nodes, and the soft default status 'in-progress' — we never invent a total or
 * assert 'complete'. Declared future parts add the dashed tail + hollow "to-come" nodes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { bySeriesOrder } from '../lib/series';

// Editable copy from Studio → Content Management → Series page.
const c = (site as any).series || {};

const readMins = (body?: string) => Math.max(1, Math.round((body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));
const prettify = (slug: string) => { const w = slug.replace(/[-_]+/g, ' ').trim(); return w.charAt(0).toUpperCase() + w.slice(1); };
const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

// Group published posts by series slug; order by seriesOrder.
const all = await getCollection('blog', ({ data }) => !data.draft && !!data.series);
const bySeries = new Map<string, typeof all>();
for (const p of all) {
  const s = p.data.series as string;
  if (!bySeries.has(s)) bySeries.set(s, []);
  bySeries.get(s)!.push(p);
}

// ---- Silk-plate generator (matches the Claude Design plate) -----------------
type Pt = [number, number];
// Catmull-Rom → cubic bezier: a smooth curve through the given points.
const smooth = (pts: Pt[]): string => {
  if (pts.length < 2) return '';
  const d = [`M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d.push(`C ${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`);
  }
  return d.join(' ');
};

// The comb: `lines` faint curves that pinch to a waist (top curves bow down, bottom
// bow up), fading in weight + opacity toward the bottom. ≈3 lines per part.
function combLines(parts: number) {
  const lines = Math.max(9, Math.min(3 * parts, 18));
  const out: { d: string; w: number; o: number }[] = [];
  for (let i = 0; i < lines; i++) {
    const t = i / (lines - 1);                 // 0 top … 1 bottom
    const baseY = 26 + t * 168;                // spread down the field
    const amp = (0.5 - t) * 42;                // + at top (bows down), − at bottom (bows up) → waist
    const pts: Pt[] = [];
    for (let x = -10; x <= 310; x += 40) {
      const hx = (x + 10) / 320;               // 0…1 across
      const bow = Math.sin(hx * Math.PI);      // 0…1…0, peak at the waist
      const drift = (hx - 0.5) * 10 * (0.5 - t); // gentle wind so lines aren't mirror-symmetric
      pts.push([x, baseY + amp * bow + drift]);
    }
    out.push({ d: smooth(pts), w: +(1.7 - t * 0.7).toFixed(2), o: +(0.4 - t * 0.22).toFixed(2) });
  }
  return out;
}

// The spine: a node per published part (solid, y set by reading time), plus a node
// per PLANNED-but-unpublished part (hollow ring) when a series declares a total. A
// bold curve threads the published parts; a dashed tail runs on to the unwritten ones.
function spine(mins: number[], total: number) {
  const pub = mins.length;
  const shown = Math.max(pub, Math.min(total || pub, 6)); // cap the plate at 6 nodes
  const xs = shown === 1 ? [150] : Array.from({ length: shown }, (_, i) => 30 + (i * 240) / (shown - 1));
  const lo = Math.min(...mins), hi = Math.max(...mins);
  const ys: number[] = [];
  for (let i = 0; i < shown; i++) {
    if (i < pub) ys.push(hi === lo ? 105 : 140 - ((mins[i] - lo) / (hi - lo)) * 74); // published: read-time height
    else ys.push(ys.length ? ys[ys.length - 1] : 105);                               // future: flat at last height
  }
  const nodes: Pt[] = xs.map((x, i) => [x, ys[i]]);
  return {
    path: smooth(nodes.slice(0, pub)),                                   // solid spine through published
    tail: pub < shown ? smooth(nodes.slice(Math.max(0, pub - 1))) : '',  // dashed tail into the unwritten parts
    solidNodes: nodes.slice(0, pub),
    futureNodes: nodes.slice(pub),
  };
}
const STATUS_LABEL: Record<string, string> = { 'in-progress': c.statusInProgress || 'In progress', complete: c.statusComplete || 'Complete', paused: c.statusPaused || 'Paused' };
const firstOf = <T,>(members: any[], key: string): T | undefined => members.map((p) => p.data[key]).find((v) => v != null && v !== '' && !(Array.isArray(v) && v.length === 0));

const WASH = [
  { x: '16%', y: '10%', o: '13%' }, { x: '82%', y: '16%', o: '11%' },
  { x: '28%', y: '86%', o: '10%' }, { x: '70%', y: '78%', o: '12%' },
  { x: '20%', y: '50%', o: '11%' }, { x: '86%', y: '52%', o: '10%' },
];

const seriesList = [...bySeries.entries()]
  .map(([slug, members]) => {
    members.sort(bySeriesOrder);
    const title = members.map((p) => p.data.seriesTitle).find((t) => t && t.trim())?.trim() || prettify(slug);
    const parts = members.map((p) => ({ id: p.id, title: p.data.title, date: p.data.pubDate, mins: readMins(p.body) }));
    let h = 0; for (let i = 0; i < slug.length; i++) h = (h * 31 + slug.charCodeAt(i)) >>> 0;
    const planned = (firstOf<string[]>(members, 'seriesPlanned') || []).filter((t) => t && t.trim());
    const declaredTotal = firstOf<number>(members, 'seriesTotal');
    const total = Math.max(parts.length, declaredTotal || parts.length, parts.length + planned.length);
    // Status: author-declared (editor field) wins. When left on "auto" we INFER it
    // from the author's own declared total — if they said the series has N parts and
    // all N are published (and nothing is still planned), it's Complete; otherwise
    // In progress. We only claim "complete" off a total the author actually set — no
    // declared total, no fabricated finality (a bare pile of parts stays In progress).
    const allDeclaredPublished = !!declaredTotal && parts.length >= declaredTotal && planned.length === 0;
    const status = firstOf<string>(members, 'seriesStatus') || (allDeclaredPublished ? 'complete' : 'in-progress');
    return {
      slug, title, parts, planned, total, status,
      description: members[0].data.description,
      latest: parts[parts.length - 1].date, first: parts[0].date,
      comb: combLines(total),
      spine: spine(parts.map((p) => p.mins), total),
      wash: WASH[h % WASH.length],
    };
  })
  .sort((a, b) => b.latest.valueOf() - a.latest.valueOf());
---

<BaseLayout title={c.seo?.title || 'Series — areyoustillreading'} description={c.seo?.description || 'Multi-part collections — each a single argument split across essays that build on each other.'} wide>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow" data-cms="series.eyebrow">{c.eyebrow || 'Series'}</span></div>
      <h1><span data-cms="series.title">{c.title || 'Some ideas'}</span> <em data-cms="series.titleEm">{c.titleEm || "don't fit in one sitting."}</em></h1>
      <p class="lede" data-cms="series.lede">{c.lede || "Running collections — each one a single argument split across essays that build on each other. Start at part one, or don't; every part stands up alone."}</p>
    </header>

    {seriesList.length > 0 ? seriesList.map((s) => (
      <article class="series">
        <a class="art" href={`/blog/${s.parts[0].id}`} aria-label={`Start ${s.title}`} style={`--wx:${s.wash.x};--wy:${s.wash.y};--wo:${s.wash.o}`}>
          <svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {s.comb.map((c) => (<path d={c.d} fill="none" stroke="var(--accent)" stroke-width={c.w} opacity={c.o} />))}
            {s.spine.tail && <path d={s.spine.tail} fill="none" stroke="var(--accent)" stroke-width="1.4" opacity="0.3" stroke-dasharray="5 7" stroke-linecap="round" />}
            {s.spine.path && <path d={s.spine.path} fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" />}
            {s.spine.solidNodes.map((p) => (<circle cx={p[0]} cy={p[1]} r="4.8" fill="var(--accent)" />))}
            {s.spine.futureNodes.map((p) => (<circle cx={p[0]} cy={p[1]} r="3.8" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.6" opacity="0.85" />))}
          </svg>
        </a>
        <div>
          <h2><a href={`/blog/${s.parts[0].id}`}>{s.title}</a></h2>
          {s.description && <p class="sum">{s.description}</p>}
          <div class="prog">
            <span class={`badge${s.status !== 'in-progress' ? ' quiet' : ''}`}>{STATUS_LABEL[s.status] || 'In progress'}</span>
            <span class="segs">{Array.from({ length: Math.min(s.total, 8) }).map((_, i) => (<i class={i < s.parts.length ? 'on' : ''}></i>))}</span>
            <span><em>{s.parts.length}{s.total > s.parts.length ? ` of ${s.total}` : ''}</em> <span data-cms="series.publishedLabel">{c.publishedLabel || 'published'}</span> · {fmtMonth(s.first)}{s.first.valueOf() !== s.latest.valueOf() ? ` – ${fmtMonth(s.latest)}` : ''}</span>
          </div>
          <ol class="parts">
            {s.parts.map((part, i) => (
              <li><a href={`/blog/${part.id}`}>
                <span class="n">{i + 1}</span>
                <span class="t">{part.title}</span>
                <span class="lead"></span>
                <span class="m">{fmtMonth(part.date)} · {part.mins} min</span>
              </a></li>
            ))}
            {s.planned.map((title, i) => (
              <li><span class="soon">
                <span class="n">{s.parts.length + i + 1}</span>
                <span class="t">{title}</span>
                <span class="lead"></span>
                <span class="m" data-cms="series.toCome">{c.toCome || 'To come'}</span>
              </span></li>
            ))}
          </ol>
        </div>
      </article>
    )) : (
      <p class="empty"><span data-cms="series.empty">{c.empty || 'No multi-part series yet. When essays share a series, they gather here.'}</span> <a class="link" href="/blog" data-cms="series.emptyLink">{c.emptyLink || 'Browse all posts →'}</a></p>
    )}

    <div class="series-foot">
      <div class="sub-inner">
        <SubscribeForm heading={c.newsletter?.heading || 'Get the next part when it lands'} blurb={c.newsletter?.blurb || 'Series instalments go out by email as they publish. No noise — unsubscribe from any email in one click.'} headingKey="series.newsletter.heading" blurbKey="series.newsletter.blurb" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Ported from editorial/series.html, on our tokens. */
  .series { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(24px, 3.6vw, 48px); padding: clamp(34px, 4.4vw, 56px) 0; border-top: 1px solid var(--rule); }
  @media (max-width: 820px) { .series { grid-template-columns: 1fr; gap: 20px; } }
  /* The silk plate floats (no card): a soft edge mask + a per-series accent wash. */
  .art { position: relative; align-self: start; aspect-ratio: 3 / 2; margin: -4px 0 0 -22px; display: block;
    -webkit-mask-image: radial-gradient(104% 92% at 30% 50%, #000 14%, rgba(0,0,0,.58) 50%, transparent 78%), linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(104% 92% at 30% 50%, #000 14%, rgba(0,0,0,.58) 50%, transparent 78%), linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
    mask-composite: intersect; }
  @media (max-width: 820px) { .art { max-width: 420px; margin-left: -14px; } }
  .art::after { content: ""; position: absolute; inset: -14%; background: radial-gradient(80% 70% at var(--wx, 18%) var(--wy, 8%), color-mix(in srgb, var(--accent) var(--wo, 20%), transparent), transparent 70%); pointer-events: none; }
  .art svg { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; display: block; overflow: visible; }
  .series h2 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(27px, 3.3vw, 37px); line-height: 1.1; letter-spacing: -.015em; margin: 0 0 12px; }
  .series h2 a { color: var(--ink); background-image: linear-gradient(var(--accent), var(--accent)); background-size: 0 1.5px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size .3s; }
  .series:hover h2 a { background-size: 100% 1.5px; }
  .sum { color: var(--ink-soft); margin: 0 0 22px; max-width: 62ch; font-size: 17.5px; }
  .prog { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 26px; font-family: var(--sans); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
  .prog em { font-style: normal; color: var(--ink-soft); }
  .badge { display: inline-flex; font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; background: var(--accent); color: var(--on-accent); padding: 5px 10px; border-radius: 2px; }
  .badge.quiet { background: transparent; border: 1px solid var(--rule); color: var(--ink-faint); }
  .segs { display: flex; gap: 3px; width: 128px; flex: none; }
  .segs i { flex: 1; height: 5px; border-radius: 1px; background: color-mix(in srgb, var(--ink) 32%, transparent); }
  .segs i.on { background: var(--accent); }
  .parts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .parts li { border-bottom: 1px solid var(--rule); }
  .parts a, .parts .soon { display: flex; align-items: baseline; gap: 12px; padding: 11px 2px; transition: padding-left .22s; }
  .parts a:hover { padding-left: 8px; }
  .parts .soon { color: var(--ink-faint); }
  .parts .soon .t { font-style: italic; color: var(--ink-faint); }
  .parts .n { flex: none; width: 20px; font-family: var(--sans); font-size: 11px; letter-spacing: .1em; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .parts .t { flex: 0 1 auto; min-width: 0; font-family: var(--serif-display); font-size: 17.5px; line-height: 1.35; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .parts a:hover .t { color: var(--accent); }
  .parts .lead { flex: 1 1 14px; min-width: 14px; border-bottom: 1px dotted var(--rule); transform: translateY(-5px); }
  .parts .m { flex: none; font-family: var(--sans); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  @media (max-width: 1120px) { .parts .t { white-space: normal; } .parts .lead { display: none; } .parts .m { flex: none; margin-left: auto; padding-left: 16px; } }
  @media (max-width: 560px) { .parts .m { display: none; } }
  .empty { border-top: 1px solid var(--rule); padding: clamp(40px, 6vw, 70px) 6px; color: var(--ink-faint); font-family: var(--sans); font-size: 16px; }
  .series-foot { padding: clamp(44px, 6vw, 72px) 0 clamp(56px, 8vw, 96px); }
  .sub-inner { max-width: 720px; }
</style>
