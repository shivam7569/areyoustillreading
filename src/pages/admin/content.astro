---
/**
 * /admin/content — Studio "Content Management".
 * =============================================================================
 * One home for every editable word on the site. Each public page's copy lives
 * in src/data/site.json (keyed by page); this screen edits it and commits via
 * POST /api/admin/site → Cloudflare rebuild. Public pages import site.json at
 * build time. Adding a page = add an entry to PAGES below + point that page at
 * site.json — no new endpoint or screen.
 *
 * Client-rendered from the build-time seed (works instantly / in the sandbox),
 * then refreshed from the committed copy on admin-ready. Same load/collect/save
 * shape as the resume + projects Studios; component CSS in a .contentstudio
 * <style is:global> (innerHTML-safe).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import site from '../../data/site.json';
---

<AdminLayout title="Content Management — Studio" heading="Content Management" active="content">
  <div class="contentstudio">
    <script type="application/json" id="site-seed" set:html={JSON.stringify(site)} />

    <div class="cm-top">
      <label class="cm-picker">Editing <select id="cm-page" aria-label="Page to edit"></select></label>
      <a class="btn btn-ghost btn-sm cm-view" id="cm-view" href="/projects" target="_blank" rel="noopener">View the page ↗</a>
      <button class="btn btn-primary btn-sm" id="cm-save" type="button">Save changes</button>
      <span class="cm-status" id="cm-status" role="status" aria-live="polite"></span>
    </div>

    <div class="panel">
      <header><h2 id="cm-title">Projects page</h2><span class="hint">Every word on this page · changes go live on save</span></header>
      <div class="pb"><div id="cm-editor"></div></div>
    </div>
  </div>
</AdminLayout>

<style is:global>
  .contentstudio { font-family: var(--sans); }
  .contentstudio .cm-top { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:18px; }
  .contentstudio .cm-picker { display:flex; align-items:center; gap:9px; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-faint); font-weight:600; }
  .contentstudio .cm-picker select { font-family:var(--sans); font-size:13.5px; letter-spacing:normal; text-transform:none; color:var(--ink); background:var(--paper-2); border:1px solid var(--rule); border-radius:4px; padding:8px 30px 8px 11px; cursor:pointer; }
  .contentstudio .cm-picker select:focus { outline:2px solid var(--accent); outline-offset:1px; border-color:transparent; }
  .contentstudio .cm-view { margin-left:auto; }
  .contentstudio .cm-status { font-size:12.5px; color:var(--ink-faint); }
  .contentstudio .cm-status.ok { color:var(--accent); }
  .contentstudio .cm-status.err { color:var(--danger,#c2603f); }
  .contentstudio .ctl + .ctl { margin-top:22px; padding-top:20px; border-top:1px solid var(--rule-soft); }
  .contentstudio .fl { display:block; font-family:var(--sans); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:13px; font-weight:600; }
  .contentstudio .cm-field { display:block; margin-bottom:12px; }
  .contentstudio .cm-field:last-child { margin-bottom:0; }
  .contentstudio .cm-lbl { display:block; font-size:11.5px; color:var(--ink-faint); margin-bottom:5px; }
  .contentstudio .inp { font-family:var(--sans); font-size:13.5px; color:var(--ink); background:var(--paper); border:1px solid var(--rule); border-radius:2px; padding:9px 11px; width:100%; box-sizing:border-box; }
  .contentstudio .inp:focus { outline:2px solid var(--accent); outline-offset:1px; border-color:transparent; }
  .contentstudio textarea.inp { resize:none; overflow:hidden; min-height:70px; font-family:var(--serif-body); line-height:1.55; }
</style>

