  function buildEditor(key) {
    const spec = PAGES[key]; if (!spec) return;
    const data = model[key] || {};
    $('#cm-editor').innerHTML = spec.groups.map((g) =>
      `<div class="ctl"><span class="fl">${esc(g.label)}</span>` +
      g.fields.map((f) => {
        const v = getPath(data, f.path) || '';
        const ctl = f.type === 'area'
          ? `<textarea class="inp cm-f" data-path="${attr(f.path)}" aria-label="${attr(f.label)}">${esc(v)}</textarea>`
          : `<input class="inp cm-f" data-path="${attr(f.path)}" value="${attr(v)}" aria-label="${attr(f.label)}">`;
        return `<label class="cm-field"><span class="cm-lbl">${esc(f.label)}</span>${ctl}</label>`;
      }).join('') +
      `</div>`
    ).join('');
    $('#cm-title').textContent = spec.label;
    $('#cm-view').href = spec.view;
    $$('#cm-editor textarea').forEach(grow);
  }

  function collect(key) {
    const data = model[key] = model[key] || {};
    $$('#cm-editor .cm-f').forEach((el) => setPath(data, el.dataset.path, el.value.trim()));
  }

