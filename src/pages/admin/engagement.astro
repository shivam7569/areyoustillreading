---
/**
 * /admin/engagement — moderate reader interaction in one place.
 * Three streams behind a segmented control:
 *   • Comments   — via the admin-gated /api/admin/comments (comments have no admin
 *                  RLS, so listing-with-author + delete must go through the server).
 *   • Highlights — read/deleted directly with the anon client; the is_admin() RLS
 *                  already grants the owner read-all + delete on highlights.
 *   • Notes      — same model as highlights (private reader notes; admin can see all).
 * Reader↔you discussion threads live on each post (Highlights there supports reply).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Engagement — Studio" heading="Engagement" active="engagement">
  <section>
    <div class="page-head">
      <div>
        <h1>Engagement</h1>
        <p class="sub">Comments, highlights, and notes from your readers.</p>
      </div>
    </div>

    <div class="toolbar" role="tablist">
      <button class="btn seg is-on" data-tab="comments" type="button">Comments</button>
      <button class="btn seg" data-tab="highlights" type="button">Highlights</button>
      <button class="btn seg" data-tab="notes" type="button">Notes</button>
      <span class="grow"></span>
      <button class="btn btn-sm btn-ghost" id="refresh" type="button">↻ Refresh</button>
    </div>

    <div id="eng-host">
      <div class="table-wrap"><div class="card-pad muted">Loading…</div></div>
    </div>
  </section>
</AdminLayout>

<style>
  .seg { background: transparent; }
  .seg.is-on { background: var(--admin-accent-soft); border-color: color-mix(in srgb, var(--accent) 30%, var(--border)); color: var(--accent); }
  .eng-item { display: flex; gap: 1rem; justify-content: space-between; align-items: flex-start; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); }
  .eng-item:last-child { border-bottom: 0; }
  .eng-item .who { font-weight: 600; }
  .eng-item .meta { color: var(--muted); font-size: 0.83rem; margin-top: 0.15rem; }
  .eng-item .body { margin: 0.4rem 0 0; white-space: pre-wrap; }
  .eng-item blockquote { margin: 0.4rem 0 0; padding-left: 0.8rem; border-left: 3px solid var(--admin-accent-soft); color: var(--fg); }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { whenAdmin, adminFetch } from '../../lib/admin-gate';
  import { fmtDate, relTime, esc } from '../../lib/admin-format';

  const host = document.getElementById('eng-host')!;
  let tab = 'comments';
  let armed: string | null = null;
  let armTimer: number | undefined;

  const postLink = (slug: string) => `<a href="/blog/${encodeURIComponent(slug)}" target="_blank" rel="noopener">${esc(slug)}</a>`;
  const delBtn = (id: string) =>
    `<button class="btn btn-sm ${armed === id ? 'btn-danger' : 'btn-ghost'}" data-del="${esc(id)}">${armed === id ? 'Confirm' : 'Delete'}</button>`;

  function loading() { host.innerHTML = '<div class="table-wrap"><div class="card-pad muted">Loading…</div></div>'; }
  function errBox(m: string) { host.innerHTML = `<div class="card card-pad notice err">${esc(m)}</div>`; }
  function emptyBox(emoji: string, title: string, sub: string) {
    host.innerHTML = `<div class="card"><div class="empty"><span class="emoji">${emoji}</span><h3>${esc(title)}</h3><p>${esc(sub)}</p></div></div>`;
  }

  function list(items: string[]) {
    host.innerHTML = `<div class="card">${items.join('')}</div>`;
  }

  async function loadComments() {
    loading();
    try {
      const r = await adminFetch('/api/admin/comments');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      const rows = d.rows || [];
      if (!rows.length) return emptyBox('💬', 'No comments yet', 'Reader comments will show up here.');
      list(rows.map((c: any) => `<div class="eng-item">
          <div>
            <div class="who">${esc(c.author_name || 'Reader')}</div>
            <div class="meta">on ${postLink(c.post_id)} · ${esc(relTime(c.created_at))}</div>
            <p class="body">${esc(c.body)}</p>
          </div>
          <div class="row-actions">${delBtn('comment:' + c.id)}</div>
        </div>`));
    } catch (e: any) { errBox("Couldn't load comments: " + (e.message || e)); }
  }

  async function loadHighlights() {
    loading();
    try {
      const { data, error } = await supabase
        .from('highlights')
        .select('id,post_id,author_name,quote,created_at')
        .order('created_at', { ascending: false })
        .limit(200);
      if (error) throw error;
      const rows = data || [];
      if (!rows.length) return emptyBox('🖍️', 'No highlights yet', 'Passages readers highlight will appear here.');
      list(rows.map((h: any) => `<div class="eng-item">
          <div>
            <div class="who">${esc(h.author_name || 'Reader')}</div>
            <div class="meta">on ${postLink(h.post_id)} · ${esc(relTime(h.created_at))}</div>
            <blockquote>${esc(h.quote)}</blockquote>
          </div>
          <div class="row-actions">${delBtn('highlight:' + h.id)}</div>
        </div>`));
    } catch (e: any) { errBox("Couldn't load highlights: " + (e.message || e)); }
  }

  async function loadNotes() {
    loading();
    try {
      const { data, error } = await supabase
        .from('notes')
        .select('id,post_id,author_name,body,updated_at')
        .order('updated_at', { ascending: false })
        .limit(200);
      if (error) throw error;
      const rows = data || [];
      if (!rows.length) return emptyBox('📝', 'No notes yet', "Readers' private notes will appear here.");
      list(rows.map((n: any) => `<div class="eng-item">
          <div>
            <div class="who">${esc(n.author_name || 'Reader')}</div>
            <div class="meta">on ${postLink(n.post_id)} · ${esc(fmtDate(n.updated_at))}</div>
            <p class="body">${esc(n.body)}</p>
          </div>
          <div class="row-actions">${delBtn('note:' + n.id)}</div>
        </div>`));
    } catch (e: any) { errBox("Couldn't load notes: " + (e.message || e)); }
  }

  function loadTab() {
    armed = null;
    if (tab === 'comments') return loadComments();
    if (tab === 'highlights') return loadHighlights();
    return loadNotes();
  }

  async function doDelete(token: string) {
    const [kind, id] = token.split(/:(.+)/);
    try {
      if (kind === 'comment') {
        const r = await adminFetch(`/api/admin/comments?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'Delete failed');
      } else {
        const table = kind === 'highlight' ? 'highlights' : 'notes';
        const { error } = await supabase.from(table).delete().eq('id', id);
        if (error) throw error;
      }
    } catch (e: any) {
      alert(e.message || 'Delete failed');
    }
    armed = null;
    loadTab();
  }

  host.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-del]') as HTMLElement | null;
    if (!btn) return;
    const token = btn.dataset.del!;
    if (armed === token) {
      doDelete(token);
    } else {
      armed = token;
      loadTab(); // re-render to show "Confirm"
      if (armTimer) clearTimeout(armTimer);
      armTimer = window.setTimeout(() => { armed = null; loadTab(); }, 3500);
    }
  });

  document.querySelectorAll('.seg').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.seg').forEach((x) => x.classList.remove('is-on'));
      b.classList.add('is-on');
      tab = (b as HTMLElement).dataset.tab!;
      loadTab();
    });
  });
  document.getElementById('refresh')!.addEventListener('click', loadTab);

  whenAdmin.then(loadTab);
</script>
