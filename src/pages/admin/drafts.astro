---
/**
 * /admin/drafts — the Drafts manager (Studio design).
 * Lists hidden (draft + scheduled) posts from content.posts via my_posts() as a card
 * grid. Each card shows real per-draft progress read from the editor's own
 * localStorage (word count + length target + last note-to-self, per device — the
 * same store the Write chrome writes), plus the kept actions: continue (edit),
 * early-access email, publish, delete. "Seeds" is a small private idea list
 * (localStorage). No fabricated numbers — cards without local data just show less.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Drafts — Studio" heading="Drafts" active="drafts">
  <section class="stack">
    <div class="dsum" id="dsum">
      <div>Unfinished<b id="d-count">—</b></div>
      <div>In a series<b id="d-series">—</b></div>
      <div>Words written<b id="d-words">—</b></div>
      <div>Longest untouched<b id="d-old">—</b></div>
    </div>
    <div style="font-size:12.5px;color:var(--ink-faint);margin-top:-14px">Nothing here is visible to readers. Drafts below are posts saved with “Save as a draft”; work still open in the editor shows up first.</div>

    <div id="scratch"></div>

    <div id="drafts-host"><div class="muted">Loading drafts…</div></div>

    <div>
      <div class="dhead"><span>Seeds</span><em>ideas — not drafts yet, private to you</em></div>
      <ul class="seeds" id="seeds"></ul>
      <div style="margin-top:10px"><input class="inp" id="seed-input" placeholder="Jot an idea — press Enter" autocomplete="off" style="max-width:440px" /></div>
    </div>
  </section>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';
  import { fmtDate, esc } from '../../lib/admin-format';

  const $ = (id: string) => document.getElementById(id)!;
  let all: any[] = [];
  let armedDelete: string | null = null;
  let armTimer: number | undefined;
  const host = $('drafts-host');

  // Per-draft local progress (written by the Write editor chrome, this device).
  const localWords = (slug: string) => { try { return parseInt(localStorage.getItem('aysr:words:post:' + slug) || '', 10) || 0; } catch { return 0; } };
  const localTarget = (slug: string) => { try { return parseInt(localStorage.getItem('aysr:target:post:' + slug) || '', 10) || 0; } catch { return 0; } };
  const daysSince = (d: string) => { if (!d) return null; const ms = Date.now() - new Date(d).getTime(); return ms > 0 ? Math.floor(ms / 86400000) : 0; };

  function disarm() { armedDelete = null; if (armTimer) clearTimeout(armTimer); }
  host.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null;
    if (!btn) return;
    const act = btn.dataset.act!, slug = btn.dataset.slug!, id = btn.dataset.id;
    // Delete is the only inline action — publishing renders the body, which only the
    // editor can do, so "Open to publish" is a link into /admin/write.
    if (act === 'delete') {
      if (armedDelete === slug) authorDel(id!);
      else { disarm(); armedDelete = slug; loadAuthorDrafts(); armTimer = window.setTimeout(() => { armedDelete = null; loadAuthorDrafts(); }, 3500); }
    }
  });

  // --- Seeds: a private idea list (localStorage, this device) ----------------
  const SEEDS_KEY = 'aysr:seeds';
  const loadSeeds = (): string[] => { try { return JSON.parse(localStorage.getItem(SEEDS_KEY) || '[]'); } catch { return []; } };
  function renderSeeds() {
    const list = loadSeeds();
    $('seeds').innerHTML = list.length
      ? list.map((s, i) => `<li><span class="d"></span>${esc(s)}<button class="w" data-seed="${i}" style="background:none;border:0;cursor:pointer;color:var(--ink-faint)" title="Remove">Remove</button></li>`).join('')
      : '<li class="rempty" style="list-style:none;color:var(--ink-faint);font-style:italic">No seeds yet — jot an idea below.</li>';
  }
  $('seeds').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-seed]') as HTMLElement | null; if (!b) return;
    const list = loadSeeds(); list.splice(parseInt(b.dataset.seed!, 10), 1);
    try { localStorage.setItem(SEEDS_KEY, JSON.stringify(list)); } catch {}
    renderSeeds();
  });
  $('seed-input').addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key !== 'Enter') return; e.preventDefault();
    const v = ($('seed-input') as HTMLInputElement).value.trim(); if (!v) return;
    const list = loadSeeds(); list.push(v);
    try { localStorage.setItem(SEEDS_KEY, JSON.stringify(list)); } catch {}
    ($('seed-input') as HTMLInputElement).value = ''; renderSeeds();
  });

  // The Write editor autosaves a NEW post to ONE scratchpad slot (localStorage + a
  // single Supabase drafts row). It has no title/slug/frontmatter yet, so it is NOT
  // a draft *post* and won't appear in the list below until you Publish → "Save as a
  // draft". Surface it here so in-progress writing shows up where you'd look for it.
  const STARTER = '# New post\n\nStart writing.\n';
  const firstHeading = (md: string) => { const m = String(md || '').match(/^#\s+(.+)$/m); return m ? m[1].trim() : ''; };
  const draftWords = (c: string) => (String(c || '').replace(/```[\s\S]*?```/g, ' ').replace(/[#*_>`\[\]()!-]+/g, ' ').match(/\S+/g) || []).length;
  async function loadScratch() {
    const host = document.getElementById('scratch');
    if (!host) return;
    let rows: any[] = [];
    try {
      const { data: s } = await supabase.auth.getSession();
      const uid = s?.session?.user?.id;
      if (uid) {
        const { data } = await supabase.from('drafts').select('id, content, title, updated_at').eq('user_id', uid).order('updated_at', { ascending: false });
        rows = (data || []).filter((r: any) => { const c = String(r.content || '').trim(); return c && c !== STARTER.trim(); });
      }
    } catch {}
    if (!rows.length) { host.innerHTML = ''; return; }
    const cards = rows.map((r: any) => {
      const title = (r.title && r.title !== 'Untitled draft' ? r.title : firstHeading(r.content)) || 'Untitled draft';
      const words = draftWords(r.content);
      return `<article class="dcard" data-draft="${esc(r.id)}">
        <h3>${esc(title)}</h3>
        <div class="ser">Autosaved to your account · not yet saved as a post</div>
        <div class="dprog"><span>${words.toLocaleString()} words</span><span class="bar"><i style="width:${words ? 35 : 4}%"></i></span><span>in progress</span></div>
        <div class="dfoot"><span>Edited ${esc(fmtDate(r.updated_at))}</span><a class="go" href="/admin/write?draft=${encodeURIComponent(r.id)}">Continue →</a></div>
        <div class="row-actions" style="margin-top:2px"><button class="btn btn-sm btn-ghost" data-del-draft="${esc(r.id)}">Discard</button></div>
      </article>`;
    }).join('');
    host.innerHTML = `<div style="margin-bottom:22px"><div class="dhead"><span>In the editor</span><em>${rows.length} unsaved — publish or “save as a draft” to keep as a post</em></div><div class="dgrid">${cards}</div></div>`;
  }
  // Discard an in-editor draft (its own row). Two-click confirm on the button itself.
  let armedScratch: string | null = null;
  document.getElementById('scratch')!.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('[data-del-draft]') as HTMLElement | null;
    if (!b) return;
    const id = b.dataset.delDraft!;
    if (armedScratch !== id) { armedScratch = id; b.textContent = 'Discard for good?'; (b as HTMLButtonElement).classList.add('btn-danger'); setTimeout(() => { if (armedScratch === id) { armedScratch = null; b.textContent = 'Discard'; b.classList.remove('btn-danger'); } }, 3500); return; }
    try { await supabase.from('drafts').delete().eq('id', id); } catch {}
    try { localStorage.removeItem('aysr:editor-draft:' + id); } catch {}
    armedScratch = null; loadScratch();
  });

  // ——— Drafts come from content.posts via my_posts(). This page used to have a SECOND,
  // file-based view for the owner, reading the git markdown collection — which is now empty,
  // so the owner saw no drafts at all while the sidebar counted them. Its Publish/Early/Delete
  // buttons posted to the file endpoints too, so they could not have acted on a DB post. ———
  function authorCard(p: any): string {
    const armed = armedDelete === p.slug;
    const scheduled = p.status === 'scheduled' && p.publish_at && new Date(p.publish_at).getTime() > Date.now();
    const bits = (p.tags && p.tags.length ? p.tags.slice(0, 4).map((t: string) => '#' + esc(t)).join(' ') : 'Standalone') + (scheduled ? ' · scheduled' : '');
    const words = localWords(p.slug), target = localTarget(p.slug);
    const prog = (words || target)
      ? `<div class="dprog"><span>${words.toLocaleString()}</span><span class="bar"><i style="width:${target ? Math.min(100, Math.round((words / target) * 100)) : (words ? 100 : 0)}%"></i></span><span>${target ? target.toLocaleString() : '—'}</span></div>`
      : '';
    const when = scheduled ? `<div class="dnote"><b>Scheduled</b>Goes live ${esc(new Date(p.publish_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }))} — publishes automatically.</div>` : '';
    return `<article class="dcard" data-slug="${esc(p.slug)}">
        <h3>${esc(p.title)}</h3>
        <div class="ser">${bits}</div>
        ${prog}${when}
        <div class="dfoot"><span>Edited ${esc(fmtDate(p.updated_at || p.pub_date))}</span><a class="go" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Continue →</a></div>
        <div class="row-actions" style="margin-top:2px;display:flex;gap:6px;flex-wrap:wrap">
          <a class="btn btn-sm btn-primary" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Open to publish</a>
          <button class="btn btn-sm ${armed ? 'btn-danger' : 'btn-ghost'}" data-act="delete" data-slug="${esc(p.slug)}" data-id="${esc(p.id)}">${armed ? 'Confirm' : 'Delete'}</button>
        </div>
      </article>`;
  }

  async function loadAuthorDrafts() {
    let posts: any[] = [];
    try { const { data } = await supabase.rpc('my_posts'); posts = data || []; } catch { posts = []; }
    const drafts = posts.filter((p) => p.status === 'draft' || p.status === 'scheduled');
    $('d-count').textContent = String(drafts.filter((p) => p.status === 'draft').length);
    $('d-series').textContent = '—';
    const totalWords = drafts.reduce((s, p) => s + localWords(p.slug), 0);
    $('d-words').textContent = totalWords ? totalWords.toLocaleString() : '—';
    const oldest = drafts.map((p) => daysSince(p.updated_at || p.pub_date)).filter((n): n is number => n != null);
    $('d-old').textContent = oldest.length ? Math.max(...oldest) + ' days' : '—';
    if (!drafts.length) {
      host.innerHTML = '<div class="panel"><div class="pb muted" style="text-align:center;padding:2.4rem 1rem">Everything you’ve written is published. <a href="/admin/write" style="color:var(--accent)">Start something new →</a></div></div>';
      return;
    }
    drafts.sort((a, b) => String(b.updated_at || '').localeCompare(String(a.updated_at || '')));
    host.innerHTML = `<div style="margin-bottom:22px"><div class="dhead"><span>Drafts</span><em>${drafts.length}</em></div><div class="dgrid">${drafts.map(authorCard).join('')}</div></div>`;
  }

  async function authorDel(id: string) {
    const r = await adminFetch(`/api/author/post?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Delete failed');
    disarm(); loadAuthorDrafts();
  }

  onAdminReady(async () => {
    loadAuthorDrafts();
    loadScratch();
  });
  renderSeeds();
</script>
