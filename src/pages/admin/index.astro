---
/**
 * /admin — the dashboard Home / overview (Studio design).
 * At-a-glance tiles (audience · read-depth · revenue · drafts), the drafts "in
 * flight" table, the letter panel, recent posts, and a real completion ("where
 * readers stop") barrow. All data is loaded client-side from admin-gated
 * Functions AFTER the shared gate confirms an admin (whenAdmin) — nothing here
 * trusts the client, and every number is real (no design placeholders).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Home — Studio" heading="Home" active="home">
  <section class="stack">
    <div class="tiles">
      <a class="tile" href="/admin/audience" style="text-decoration:none;color:inherit">
        <div class="l">Subscribers</div><div class="v loading" id="k-subs">—</div><div class="d" id="k-subs-foot">confirmed</div>
      </a>
      <a class="tile" href="/admin/engagement" style="text-decoration:none;color:inherit">
        <div class="l">Read depth</div><div class="v loading" id="k-depth">—</div><div class="d" id="k-depth-foot">how far readers get</div>
      </a>
      <a class="tile" href="/admin/revenue" style="text-decoration:none;color:inherit">
        <div class="l">Revenue</div><div class="v loading" id="k-rev">—</div><div class="d" id="k-rev-foot">to date</div>
      </a>
      <a class="tile" href="/admin/drafts" style="text-decoration:none;color:inherit">
        <div class="l">In draft</div><div class="v loading" id="k-drafts">—</div><div class="d" id="k-drafts-foot">unfinished</div>
      </a>
    </div>

    <div class="cols side3">
      <div class="panel">
        <header><h2>In flight</h2><span class="hint">Drafts — only you can see these</span></header>
        <div class="pb flush" id="inflight"><div class="card-pad muted">Loading…</div></div>
      </div>
      <div class="panel">
        <header><h2>The letter</h2></header>
        <div class="pb">
          <div class="fr"><span>Recipients</span><span class="v" id="l-recip">—</span></div>
          <div class="fr"><span>Pending confirm</span><span class="v" id="l-pending">—</span></div>
          <div class="fr"><span>Delivery</span><span class="v">Resend · one-click unsub</span></div>
          <div style="margin-top:14px;display:flex;gap:9px;flex-wrap:wrap">
            <a class="btn btn-ghost btn-sm" href="/admin/write">Write an issue</a>
            <a class="btn btn-ghost btn-sm" href="/admin/audience">Manage list</a>
          </div>
        </div>
      </div>
    </div>

    <div class="cols two">
      <div class="panel">
        <header><h2>Recent posts</h2><a class="hint" href="/admin/posts" style="color:var(--accent);text-decoration:none">Manage all →</a></header>
        <div class="pb flush" id="recent"><div class="card-pad muted">Loading…</div></div>
      </div>
      <div class="panel">
        <header><h2>Where readers stop</h2><span class="hint">By completion</span></header>
        <div class="pb" id="stops"><div class="muted">Loading…</div></div>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import { whenAdmin, adminFetch } from '../../lib/admin-gate';
  import { fmtNum, fmtMoney, fmtDate, esc } from '../../lib/admin-format';

  const $ = (id: string) => document.getElementById(id);
  function set(id: string, text: string) {
    const el = $(id);
    if (el) { el.textContent = text; el.classList.remove('loading'); }
  }
  let titles: Record<string, string> = {};

  async function loadOverview() {
    try {
      const r = await adminFetch('/api/admin/overview');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      set('k-subs', fmtNum(d.subscribers.confirmed));
      const el = $('k-subs-foot'); if (el) el.textContent = `${fmtNum(d.subscribers.confirmed)} confirmed · ${fmtNum(d.subscribers.pending)} pending`;
      set('k-rev', fmtMoney(d.revenue.grossCents, d.revenue.currency));
      const rf = $('k-rev-foot'); if (rf) rf.textContent = `${fmtNum(d.revenue.sales)} ${d.revenue.sales === 1 ? 'sale' : 'sales'}${d.revenue.estimated ? ' · estimated' : ''}`;
      set('k-drafts', fmtNum(d.posts.drafts));
      const df = $('k-drafts-foot'); if (df) df.textContent = d.posts.paywalled ? `${fmtNum(d.posts.paywalled)} paywalled live` : 'unfinished';
      const lr = $('l-recip'); if (lr) lr.textContent = fmtNum(d.subscribers.confirmed);
      const lp = $('l-pending'); if (lp) lp.textContent = fmtNum(d.subscribers.pending);
    } catch { set('k-subs', '—'); set('k-rev', '—'); set('k-drafts', '—'); }
  }

  async function loadDepth() {
    try {
      const r = await adminFetch('/api/admin/analytics?range=all');
      const d = await r.json();
      if (!r.ok || d.configured === false) { set('k-depth', '—'); $('k-depth-foot')!.textContent = 'analytics not set up'; $('stops')!.innerHTML = '<div class="muted">Read-depth analytics isn’t set up yet.</div>'; return; }
      const pct = (d.totals && d.totals.avgReadPct) || 0;
      set('k-depth', pct + '%');
      $('k-depth-foot')!.textContent = d.totals && d.totals.reads ? `${fmtNum(d.totals.reads)} reads measured` : 'how far readers get';
      const top = (d.topPosts || []).filter((p: any) => typeof p.avgReadPct === 'number').slice(0, 5);
      const host = $('stops')!;
      if (!top.length) { host.innerHTML = '<div class="muted">No completion data yet.</div>'; return; }
      host.innerHTML = top.map((p: any) => `<div class="barrow"><div><div class="nm">${esc(titles[p.slug] || p.slug)}</div><div class="bar"><i style="width:${p.avgReadPct}%"></i></div></div><div class="pc">${p.avgReadPct}%</div></div>`).join('');
    } catch { set('k-depth', '—'); }
  }

  const statusPill = (p: any) => p.draft ? '<span class="pill">Draft</span>' : '<span class="pill live">Live</span>';

  async function loadPosts() {
    try {
      const r = await adminFetch('/api/admin/posts');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      const posts = d.posts || [];
      titles = {}; for (const p of posts) titles[p.slug] = p.title;

      // Recent posts (newest five)
      const recentHost = $('recent')!;
      const recent = posts.slice(0, 5);
      recentHost.innerHTML = recent.length
        ? '<table class="t"><tbody>' + recent.map((p: any) => `<tr>
              <td><a class="ti" href="/admin/write?slug=${encodeURIComponent(p.slug)}" style="text-decoration:none">${esc(p.title)}</a><span class="sub">${esc(fmtDate(p.pubDate))}</span></td>
              <td class="num">${statusPill(p)}${p.paid ? ' <span class="pill">Paid</span>' : ''}</td>
              <td class="num"><a class="btn btn-sm btn-ghost" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Edit</a></td>
            </tr>`).join('') + '</tbody></table>'
        : '<div class="card-pad muted">No posts yet. <a href="/admin/write" style="color:var(--accent)">Write your first →</a></div>';

      // In flight (drafts)
      const flightHost = $('inflight')!;
      const drafts = posts.filter((p: any) => p.draft);
      flightHost.innerHTML = drafts.length
        ? '<table class="t"><tbody>' + drafts.slice(0, 6).map((p: any) => `<tr>
              <td><a class="ti" href="/admin/write?slug=${encodeURIComponent(p.slug)}" style="text-decoration:none">${esc(p.title)}</a><span class="sub">${p.series ? esc(p.series) : 'No series'}</span></td>
              <td class="num" style="color:var(--ink-faint)">${esc(fmtDate(p.pubDate))}</td>
              <td class="num"><a class="btn btn-sm btn-ghost" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Continue →</a></td>
            </tr>`).join('') + '</tbody></table>'
        : '<div class="card-pad muted">Nothing in flight. <a href="/admin/write" style="color:var(--accent)">Start something →</a></div>';
    } catch (e: any) {
      $('recent')!.innerHTML = `<div class="card-pad notice err">Couldn't load posts: ${esc(e.message || e)}</div>`;
    }
  }

  whenAdmin.then(async () => {
    await loadPosts();   // populates titles first (used by loadDepth)
    loadOverview();
    loadDepth();
  });
</script>
