---
/**
 * /admin/series — the Studio's Series (and Field) control room.
 * ---------------------------------------------------------------------------
 * SERIES: one card per series, showing its parts and the plate knobs (planned
 * total, status, upcoming parts) that drive the public /series page. A series is
 * either DEFINED up front via "New series" (→ src/data/series.json) or DERIVED
 * from posts that share a `series` slug (set from the publish sheet, unchanged).
 * "Delete" removes the definition AND unassigns its posts (they become independent).
 *
 * FIELDS (one level above series) live here too, not on a page of their own. A field
 * groups related series; it's defined in src/data/fields.json (→ /api/admin/fields)
 * with a name, a summary, a chosen mark, and its member series. Series are shown
 * grouped under their field, with a "Stands alone" group for the rest; a field of
 * fewer than two public series is marked "Not shown yet" (readers can't see it).
 * "Delete field" only ungroups its series — nothing it holds is ever deleted.
 * The chosen mark is a Projects-style swatch pick from the 10 in src/lib/field-marks.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Series — Studio" heading="Series" active="series">
  <section class="stack">
    <div class="rowhead">
      <div style="color:var(--ink-faint);font-size:12.5px">Plan a collection ahead of writing and manage each series' plate — then gather related series into a <b>field</b>, one level up. A field goes live to readers once it holds two public series.</div>
      <div style="display:flex;gap:10px;align-items:center;flex:none;flex-wrap:wrap">
        <button class="btn btn-sm btn-primary" id="fd-new" type="button">New field</button>
        <button class="btn btn-sm btn-ghost" id="sr-new" type="button">New series</button>
        <a class="btn btn-sm btn-ghost" href="/series/" target="_blank" rel="noopener">Series ↗</a>
        <a class="btn btn-sm btn-ghost" href="/fields/" target="_blank" rel="noopener">Fields ↗</a>
      </div>
    </div>
    <div id="series-host"><div class="muted">Loading…</div></div>
  </section>
</AdminLayout>

<style is:global>
  .series-card .del:hover, .field-head .del:hover { color: #b4453a; }
  .field-head { border-left: 3px solid var(--accent); }
  .field-head header h2 { display: inline-flex; align-items: center; gap: 10px; }
  .notshown { color: var(--ink-faint); }
  .fgrouphead { margin: 30px 0 12px; font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); display: flex; align-items: center; gap: 14px; }
  .fgrouphead::after { content: ""; flex: 1; height: 1px; background: var(--rule); }
  .mkgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 6px; margin-top: 8px; max-width: 440px; }
  .mk { aspect-ratio: 16 / 10; border: 1px solid var(--rule); border-radius: 4px; background: var(--paper-2); cursor: pointer; overflow: hidden; padding: 0; position: relative; transition: border-color .15s; }
  .mk:hover { border-color: var(--ink-faint); }
  .mk.on { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .mk svg { width: 100%; height: 100%; display: block; }
</style>

<script>
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';
  import { esc } from '../../lib/admin-format';
  import { FIELD_MARKS, PREVIEW_S, markSvg } from '../../lib/field-marks.mjs';

  const host = document.getElementById('series-host')!;
  const newSeriesBtn = document.getElementById('sr-new')!;
  const newFieldBtn = document.getElementById('fd-new')!;
  const STATUS = [['', 'Auto'], ['in-progress', 'In progress'], ['complete', 'Complete'], ['paused', 'Paused']];
  const GL = 'font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:8px';
  // Must match functions/api/admin/post.js slugify() so a name maps to the same slug.
  const slugify = (s: string) => String(s).toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const prettify = (slug: string) => { const w = slug.replace(/[-_]+/g, ' ').trim(); return w.charAt(0).toUpperCase() + w.slice(1); };
  const firstOf = (members: any[], key: string) => { for (const m of members) { const v = m[key]; if (v != null && v !== '' && !(Array.isArray(v) && v.length === 0)) return v; } return undefined; };

  let sdefs: any[] = []; // series.json: [{ slug, title, total, status, planned }]
  let posts: any[] = []; // /api/admin/posts catalog
  let fdefs: any[] = []; // fields.json: [{ slug, title, summary, mark, series:[{slug,note}] }]

  async function load() {
    host.innerHTML = '<div class="muted">Loading…</div>';
    const [sres, pres, fres] = await Promise.all([
      adminFetch('/api/admin/series').then((r) => r.json()).catch(() => null),
      adminFetch('/api/admin/posts').then((r) => r.json()).catch(() => null),
      adminFetch('/api/admin/fields').then((r) => r.json()).catch(() => null),
    ]);
    sdefs = sres && sres.content && Array.isArray(sres.content.series) ? sres.content.series : [];
    posts = (pres && pres.posts) || [];
    fdefs = fres && fres.content && Array.isArray(fres.content.fields) ? fres.content.fields : [];
    render();
  }

  const groupsOf = () => { const g: Record<string, any[]> = {}; for (const p of posts) if (p.series) (g[p.series] ||= []).push(p); return g; };
  const publishedCount = (slug: string, g: Record<string, any[]>) => (g[slug] || []).filter((m) => !m.draft).length;
  const fieldOptions = (cur: string) => '<option value=""' + (cur === '' ? ' selected' : '') + '>— Stands alone —</option>' + fdefs.map((f) => `<option value="${esc(f.slug)}"${f.slug === cur ? ' selected' : ''}>${esc(f.title || f.slug)}</option>`).join('');

  function render() {
    const g = groupsOf();
    const allSlugs = [...new Set([...sdefs.map((d) => d.slug), ...Object.keys(g), ...fdefs.flatMap((f) => (f.series || []).map((s: any) => s.slug))])];
    if (!allSlugs.length && !fdefs.length) {
      host.innerHTML = '<div class="panel"><div class="pb muted" style="text-align:center;padding:2.4rem 1rem">Nothing yet. Click <b>New series</b> to plan a collection, or group posts into a series from the publish sheet. Once two related series exist, gather them into a <b>field</b>.</div></div>';
      return;
    }
    const inField = new Set<string>();
    let html = '';
    for (const field of fdefs) {
      html += fieldPanel(field, g);
      for (const ms of (field.series || [])) { inField.add(ms.slug); html += seriesCard(ms.slug, g[ms.slug] || [], field.slug); }
      if (!(field.series || []).length) html += `<div class="panel"><div class="pb muted" style="padding:14px 20px;font-size:13px">No series in this field yet — set a series' <b>Field</b> to &ldquo;${esc(field.title || field.slug)}&rdquo; below.</div></div>`;
    }
    const standalone = allSlugs.filter((s) => !inField.has(s));
    standalone.sort((a, b) => {
      const la = (g[a] || []).reduce((m, p) => (p.pubDate > m ? p.pubDate : m), '');
      const lb = (g[b] || []).reduce((m, p) => (p.pubDate > m ? p.pubDate : m), '');
      if (la && lb) return lb.localeCompare(la);
      if (la || lb) return la ? -1 : 1;
      return a.localeCompare(b);
    });
    if (standalone.length) {
      html += `<div class="fgrouphead">${fdefs.length ? 'Stands alone' : 'Series'}</div>`;
      for (const slug of standalone) html += seriesCard(slug, g[slug] || [], '');
    }
    host.innerHTML = html;
  }

  function fieldPanel(field: any, g: Record<string, any[]>) {
    const members = field.series || [];
    const pub = members.filter((m: any) => publishedCount(m.slug, g) > 0).length;
    const mark = FIELD_MARKS.some((m) => m.id === field.mark) ? field.mark : '01';
    const swatches = FIELD_MARKS.map((m) => `<button type="button" class="mk${m.id === mark ? ' on' : ''}" data-mk="${m.id}" title="${esc(m.name)}" aria-label="${esc(m.name)}">${markSvg(m.id, PREVIEW_S)}</button>`).join('');
    const notShown = pub < 2 ? ` · <span class="notshown">Not shown yet — needs 2 public series to go live</span>` : '';
    return `<div class="panel field-head" data-fslug="${esc(field.slug)}">
      <header><h2>${esc(field.title || field.slug)}</h2><span class="hint">${members.length} series · ${pub} public${notShown}</span></header>
      <div class="pb">
        <div class="cols two" style="gap:24px">
          <div>
            <div class="fr"><span>Name</span><span class="v"><input class="input fd-title" type="text" value="${esc(field.title || '')}" style="width:240px"></span></div>
            <div style="margin-top:12px"><div class="gl" style="${GL}">Summary</div><textarea class="input fd-summary" rows="2" placeholder="One line — what this field is about" style="width:100%;resize:vertical">${esc(field.summary || '')}</textarea></div>
            <div class="fd-actions" style="margin-top:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <button class="btn btn-primary btn-sm fd-save" type="button">Save field</button>
              <button class="btn btn-ghost btn-sm del fd-del" type="button">Delete field</button>
              <span class="muted fd-msg" style="font-size:12.5px"></span>
            </div>
          </div>
          <div>
            <div class="gl" style="${GL}">Mark</div>
            <div class="mkgrid">${swatches}</div>
          </div>
        </div>
      </div>
    </div>`;
  }

  function seriesCard(slug: string, members: any[], inFieldSlug: string) {
    members.sort((a, b) => (a.seriesOrder ?? 1e9) - (b.seriesOrder ?? 1e9) || String(a.pubDate || '').localeCompare(String(b.pubDate || '')));
    const rawDef = sdefs.find((d) => d.slug === slug);
    const hasDef = !!rawDef; const def: any = rawDef || {};
    const title = def.title || firstOf(members, 'seriesTitle') || prettify(slug);
    const total = (hasDef ? (typeof def.total === 'number' ? def.total : '') : (firstOf(members, 'seriesTotal') || ''));
    const status = (hasDef ? (def.status || '') : (firstOf(members, 'seriesStatus') || ''));
    const planned: string[] = (hasDef ? (def.planned || []) : (firstOf(members, 'seriesPlanned') || []));
    const published = members.filter((m: any) => !m.draft).length;
    const partsRows = members.length
      ? members.map((m: any) => `<div class="fr"><span>${m.seriesOrder ? '<b style="color:var(--ink);font-weight:600">' + esc(String(m.seriesOrder)) + '</b> · ' : ''}${esc(m.title)}${m.draft ? ' <span class="pill" style="margin-left:4px">Draft</span>' : ''}</span><a class="v act" href="/admin/write?slug=${encodeURIComponent(m.slug)}">Edit</a></div>`).join('')
      : `<div class="fr"><span class="muted">No parts yet — assign posts to &ldquo;${esc(title)}&rdquo; from the publish sheet (type this exact name).</span></div>`;
    return `<div class="panel series-card" data-slug="${esc(slug)}">
      <header><h2>${esc(title)}</h2><span class="hint">${published} of ${total || members.length} published</span></header>
      <div class="pb">
        <div class="cols two" style="gap:24px">
          <div>
            <div class="gl" style="${GL}">On the plate</div>
            <div class="fr"><span>Field</span><span class="v"><select class="select sr-field" style="width:auto;min-width:170px">${fieldOptions(inFieldSlug)}</select></span></div>
            <div class="fr"><span>Planned total</span><span class="v"><input class="input sr-total" type="number" min="1" placeholder="—" value="${total}" style="width:90px;text-align:right"></span></div>
            <div class="fr"><span>Status</span><span class="v"><select class="select sr-status" style="width:auto;min-width:150px">${STATUS.map(([v, l]) => `<option value="${v}"${v === status ? ' selected' : ''}>${l}</option>`).join('')}</select></span></div>
            <div style="margin-top:12px">
              <div class="gl" style="${GL}">Parts still to come</div>
              <textarea class="input sr-planned" rows="3" placeholder="One title per line — shown greyed on the series page" style="width:100%;resize:vertical">${esc(planned.join('\n'))}</textarea>
            </div>
            <div class="sr-actions" style="margin-top:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <button class="btn btn-primary btn-sm sr-save" type="button">Save</button>
              <button class="btn btn-ghost btn-sm del sr-del" type="button">Delete</button>
              <span class="muted sr-msg" style="font-size:12.5px"></span>
            </div>
          </div>
          <div>
            <div class="gl" style="${GL}">Parts (${members.length})</div>
            ${partsRows}
          </div>
        </div>
      </div>
    </div>`;
  }

  // ---- persistence -----------------------------------------------------------
  async function persistSeries() {
    const r = await adminFetch('/api/admin/series', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ content: { series: sdefs } }) });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) throw new Error(j.error || ('HTTP ' + r.status));
    if (Array.isArray(j.series)) sdefs = j.series;
  }
  async function persistFields() {
    const r = await adminFetch('/api/admin/fields', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ content: { fields: fdefs } }) });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) throw new Error(j.error || ('HTTP ' + r.status));
    if (Array.isArray(j.fields)) fdefs = j.fields;
  }

  // ---- series actions --------------------------------------------------------
  async function saveCard(panel: HTMLElement) {
    const slug = panel.dataset.slug!;
    const title = (sdefs.find((d) => d.slug === slug) || {}).title || firstOf(posts.filter((p) => p.series === slug), 'seriesTitle') || prettify(slug);
    const totalN = parseInt((panel.querySelector('.sr-total') as HTMLInputElement).value, 10);
    const status = (panel.querySelector('.sr-status') as HTMLSelectElement).value;
    const planned = (panel.querySelector('.sr-planned') as HTMLTextAreaElement).value.split('\n').map((s) => s.trim()).filter(Boolean);
    const msg = panel.querySelector('.sr-msg') as HTMLElement;
    const entry = { slug, title, total: Number.isFinite(totalN) && totalN > 0 ? totalN : null, status, planned };
    const i = sdefs.findIndex((d) => d.slug === slug);
    const prev = i >= 0 ? sdefs[i] : null;
    if (i >= 0) sdefs[i] = entry; else sdefs.push(entry);
    msg.textContent = 'Saving…';
    try { await persistSeries(); msg.textContent = 'Saved — live on the next rebuild.'; }
    catch (e: any) {
      // Roll the optimistic mutation back so a later successful save of another card
      // can't silently commit this failed edit (persist POSTs the whole array).
      if (i >= 0) sdefs[i] = prev; else sdefs = sdefs.filter((d) => d !== entry);
      msg.textContent = 'Not saved — ' + (e.message || e);
    }
  }

  const SR_ACTIONS = '<button class="btn btn-primary btn-sm sr-save" type="button">Save</button><button class="btn btn-ghost btn-sm del sr-del" type="button">Delete</button><span class="muted sr-msg" style="font-size:12.5px"></span>';

  function askDelete(panel: HTMLElement) {
    const slug = panel.dataset.slug!;
    const n = posts.filter((p) => p.series === slug).length;
    (panel.querySelector('.sr-actions') as HTMLElement).innerHTML =
      `<span class="muted" style="font-size:12.5px">Delete this series?${n ? ` Its ${n} post${n > 1 ? 's' : ''} stay — just ungrouped.` : ''}</span>` +
      '<button class="btn btn-sm sr-del-yes" type="button" style="background:#b4453a;border-color:#b4453a;color:#fff">Delete</button>' +
      '<button class="btn btn-ghost btn-sm sr-del-no" type="button">Cancel</button>' +
      '<span class="muted sr-msg" style="font-size:12.5px"></span>';
  }

  async function runDelete(panel: HTMLElement) {
    const slug = panel.dataset.slug!;
    const members = posts.filter((p) => p.series === slug);
    const msg = panel.querySelector('.sr-msg') as HTMLElement;
    const yes = panel.querySelector('.sr-del-yes') as HTMLButtonElement;
    if (yes) yes.disabled = true; if (msg) msg.textContent = 'Deleting…';
    try {
      for (const m of members) {
        const r = await adminFetch('/api/admin/post', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: m.slug, series: null }) });
        if (!r.ok) throw new Error('Could not unassign “' + m.title + '” (HTTP ' + r.status + ')');
      }
      sdefs = sdefs.filter((d) => d.slug !== slug);
      const wasInField = fdefs.some((f) => (f.series || []).some((s: any) => s.slug === slug));
      fdefs.forEach((f) => { f.series = (f.series || []).filter((s: any) => s.slug !== slug); });
      await persistSeries();
      if (wasInField) await persistFields();
      await load();
    } catch (e: any) {
      if (msg) msg.textContent = 'Error: ' + (e.message || e);
      if (yes) yes.disabled = false;
    }
  }

  async function moveSeries(slug: string, toField: string, sel: HTMLSelectElement) {
    // Preserve any per-field note the series already carries — there's no note editor,
    // so a hand-authored note must survive a move (including out-and-back to the same field).
    let note: string | undefined;
    for (const f of fdefs) { const m = (f.series || []).find((s: any) => s.slug === slug); if (m && m.note) { note = m.note; break; } }
    fdefs.forEach((f) => { f.series = (f.series || []).filter((s: any) => s.slug !== slug); });
    if (toField) { const f = fdefs.find((x) => x.slug === toField); if (f) { f.series = f.series || []; if (!f.series.some((s: any) => s.slug === slug)) f.series.push(note ? { slug, note } : { slug }); } }
    sel.disabled = true;
    try { await persistFields(); render(); }
    catch (e: any) { sel.disabled = false; await load(); }
  }

  // ---- field actions ---------------------------------------------------------
  async function saveField(panel: HTMLElement) {
    const slug = panel.dataset.fslug!;
    const f = fdefs.find((x) => x.slug === slug); if (!f) return;
    const prev = { title: f.title, summary: f.summary, mark: f.mark };
    f.title = (panel.querySelector('.fd-title') as HTMLInputElement).value.trim() || f.slug;
    f.summary = (panel.querySelector('.fd-summary') as HTMLTextAreaElement).value.trim();
    const on = panel.querySelector('.mk.on') as HTMLElement | null; // the chosen mark, applied on Save
    if (on && on.dataset.mk) f.mark = on.dataset.mk;
    const msg = panel.querySelector('.fd-msg') as HTMLElement;
    msg.textContent = 'Saving…';
    try { await persistFields(); msg.textContent = 'Saved — live on the next rebuild.'; const h2 = panel.querySelector('header h2'); if (h2) h2.textContent = f.title; }
    catch (e: any) { f.title = prev.title; f.summary = prev.summary; f.mark = prev.mark; msg.textContent = 'Not saved — ' + (e.message || e); }
  }

  const FD_ACTIONS = '<button class="btn btn-primary btn-sm fd-save" type="button">Save field</button><button class="btn btn-ghost btn-sm del fd-del" type="button">Delete field</button><span class="muted fd-msg" style="font-size:12.5px"></span>';

  function askDeleteField(panel: HTMLElement) {
    const slug = panel.dataset.fslug!;
    const f = fdefs.find((x) => x.slug === slug);
    const n = f ? (f.series || []).length : 0;
    (panel.querySelector('.fd-actions') as HTMLElement).innerHTML =
      `<span class="muted" style="font-size:12.5px">Delete this field?${n ? ` Its ${n} series stay — just ungrouped.` : ''}</span>` +
      '<button class="btn btn-sm fd-del-yes" type="button" style="background:#b4453a;border-color:#b4453a;color:#fff">Delete</button>' +
      '<button class="btn btn-ghost btn-sm fd-del-no" type="button">Cancel</button>' +
      '<span class="muted fd-msg" style="font-size:12.5px"></span>';
  }

  async function runDeleteField(panel: HTMLElement) {
    const slug = panel.dataset.fslug!;
    const msg = panel.querySelector('.fd-msg') as HTMLElement;
    const yes = panel.querySelector('.fd-del-yes') as HTMLButtonElement;
    if (yes) yes.disabled = true; if (msg) msg.textContent = 'Deleting…';
    fdefs = fdefs.filter((f) => f.slug !== slug);
    try { await persistFields(); render(); }
    catch (e: any) { if (msg) msg.textContent = 'Error: ' + (e.message || e); if (yes) yes.disabled = false; await load(); }
  }

  // ---- inline create cards (no native prompt) --------------------------------
  function openCreate() {
    if (document.getElementById('sr-create')) { (document.getElementById('sr-new-name') as HTMLElement | null)?.focus(); return; }
    const el = document.createElement('div');
    el.className = 'panel'; el.id = 'sr-create';
    el.innerHTML = `<div class="pb" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:18px 20px">
      <input id="sr-new-name" class="input" type="text" placeholder="Name this series…" autocomplete="off" spellcheck="false" style="flex:1 1 260px;min-width:200px;font-size:16px">
      <button class="btn btn-primary btn-sm" id="sr-new-go" type="button">Create</button>
      <button class="btn btn-ghost btn-sm" id="sr-new-x" type="button">Cancel</button>
      <span class="muted" id="sr-new-msg" style="font-size:12.5px;flex-basis:100%"></span>
    </div>`;
    host.prepend(el);
    const input = el.querySelector('#sr-new-name') as HTMLInputElement;
    const msg = el.querySelector('#sr-new-msg') as HTMLElement;
    const create = async () => {
      const name = input.value.trim();
      if (!name) { input.focus(); return; }
      const slug = slugify(name);
      if (!slug) { msg.textContent = 'Please use letters or numbers.'; return; }
      if (sdefs.some((d) => d.slug === slug) || posts.some((p) => p.series === slug)) { msg.textContent = 'A series with that name already exists.'; return; }
      const go = el.querySelector('#sr-new-go') as HTMLButtonElement; go.disabled = true; msg.textContent = 'Creating…';
      sdefs.push({ slug, title: name, total: null, status: '', planned: [] });
      try { await persistSeries(); render(); (host.querySelector(`.series-card[data-slug="${slug}"] .sr-total`) as HTMLElement | null)?.focus(); }
      catch (e: any) { sdefs = sdefs.filter((d) => d.slug !== slug); msg.textContent = 'Could not create: ' + (e.message || e); go.disabled = false; }
    };
    el.querySelector('#sr-new-go')!.addEventListener('click', create);
    el.querySelector('#sr-new-x')!.addEventListener('click', () => el.remove());
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); create(); } else if (e.key === 'Escape') { el.remove(); } });
    input.focus();
  }

  function openCreateField() {
    if (document.getElementById('fd-create')) { (document.getElementById('fd-new-name') as HTMLElement | null)?.focus(); return; }
    const el = document.createElement('div');
    el.className = 'panel'; el.id = 'fd-create';
    el.innerHTML = `<div class="pb" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:18px 20px">
      <input id="fd-new-name" class="input" type="text" placeholder="Name this field…" autocomplete="off" spellcheck="false" style="flex:1 1 260px;min-width:200px;font-size:16px">
      <button class="btn btn-primary btn-sm" id="fd-new-go" type="button">Create</button>
      <button class="btn btn-ghost btn-sm" id="fd-new-x" type="button">Cancel</button>
      <span class="muted" id="fd-new-msg" style="font-size:12.5px;flex-basis:100%">A field stays private until two of its series are public.</span>
    </div>`;
    host.prepend(el);
    const input = el.querySelector('#fd-new-name') as HTMLInputElement;
    const msg = el.querySelector('#fd-new-msg') as HTMLElement;
    const create = async () => {
      const name = input.value.trim();
      if (!name) { input.focus(); return; }
      const slug = slugify(name);
      if (!slug) { msg.textContent = 'Please use letters or numbers.'; return; }
      if (fdefs.some((f) => f.slug === slug)) { msg.textContent = 'A field with that name already exists.'; return; }
      const go = el.querySelector('#fd-new-go') as HTMLButtonElement; go.disabled = true; msg.textContent = 'Creating…';
      fdefs.push({ slug, title: name, summary: '', mark: '01', series: [] });
      try { await persistFields(); render(); (host.querySelector(`.field-head[data-fslug="${slug}"] .fd-summary`) as HTMLElement | null)?.focus(); }
      catch (e: any) { fdefs = fdefs.filter((f) => f.slug !== slug); msg.textContent = 'Could not create: ' + (e.message || e); go.disabled = false; }
    };
    el.querySelector('#fd-new-go')!.addEventListener('click', create);
    el.querySelector('#fd-new-x')!.addEventListener('click', () => el.remove());
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); create(); } else if (e.key === 'Escape') { el.remove(); } });
    input.focus();
  }

  newSeriesBtn.addEventListener('click', openCreate);
  newFieldBtn.addEventListener('click', openCreateField);

  host.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    // field mark swatch
    const mk = t.closest('.mk') as HTMLElement | null;
    if (mk) { const panel = mk.closest('.field-head') as HTMLElement; panel.querySelectorAll('.mk').forEach((b) => b.classList.toggle('on', b === mk)); return; } // visual only; committed by Save
    // field actions
    if (t.closest('.fd-save')) { saveField(t.closest('.panel') as HTMLElement); return; }
    if (t.closest('.fd-del-yes')) { runDeleteField(t.closest('.panel') as HTMLElement); return; }
    if (t.closest('.fd-del-no')) { const a = t.closest('.fd-actions') as HTMLElement; if (a) a.innerHTML = FD_ACTIONS; return; }
    if (t.closest('.fd-del')) { askDeleteField(t.closest('.panel') as HTMLElement); return; }
    // series actions
    if (t.closest('.sr-save')) { saveCard(t.closest('.panel') as HTMLElement); return; }
    if (t.closest('.sr-del-yes')) { runDelete(t.closest('.panel') as HTMLElement); return; }
    if (t.closest('.sr-del-no')) { const a = t.closest('.sr-actions') as HTMLElement; if (a) a.innerHTML = SR_ACTIONS; return; }
    if (t.closest('.sr-del')) { askDelete(t.closest('.panel') as HTMLElement); return; }
  });

  host.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t.classList && t.classList.contains('sr-field')) {
      const panel = t.closest('.series-card') as HTMLElement;
      moveSeries(panel.dataset.slug!, (t as HTMLSelectElement).value, t as HTMLSelectElement);
    }
  });

  onAdminReady(() => load());
</script>
