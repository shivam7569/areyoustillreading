---
/**
 * /admin/series — the Studio's Series (and Field) control room.
 * ===========================================================================
 * Two panes (per editorial/studio-series.html): a rail on the left showing the
 * FIELD → SERIES hierarchy (field headers with their series indented beneath, each
 * series carrying its own mini-spine), and one editor on the right for whichever
 * series or field is selected. Choosing a row is a visual act, not reading names.
 *
 *  • Series editor: planned total, status, the ordered parts list (written posts +
 *    planned titles), the field it belongs to, and a live plate preview.
 *  • Field editor (one level up): summary, its member series, and the generative
 *    mark — a Projects-style swatch pick from the 10 in src/lib/field-marks.mjs.
 *
 * DATA: series.json (knobs) via /api/admin/series, posts via /api/admin/posts,
 * fields.json via /api/admin/fields. The editor works on a DRAFT; nothing touches
 * the shared arrays until Save succeeds, so a failed save can never be committed by
 * the next one. Delete only ungroups — no post or series is ever destroyed with it.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Series — Studio" heading="Series" active="series">
  <section class="stack">
    <div class="swrap" id="swrap">
      <div class="slist">
        <div class="lh">Series<span class="n" id="scount">—</span></div>
        <div id="rail"><div class="muted" style="padding:16px 13px;font-size:12.5px">Loading…</div></div>
        <button class="newrow" type="button" id="newField"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>New field</button>
        <button class="newrow" type="button" id="newSeries"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>New series</button>
      </div>

      <div class="sed" id="sed" hidden>
        <div class="sed-top">
          <input class="nm" id="sname" aria-label="Name">
          <span class="pill" id="spill">—</span>
        </div>

        <!-- SERIES editor -->
        <div class="sed-body" id="mSeries">
          <div>
            <div class="sedsec">
              <span class="fl">How long it runs</span>
              <div class="knob">
                <span class="k">Planned total<small>What the series will be when it's finished. Readers see this as the unlit half of the spine.</small></span>
                <span class="sstep"><button type="button" id="tminus" aria-label="One fewer">−</button><b id="tnum">—</b><button type="button" id="tplus" aria-label="One more">+</button></span>
              </div>
              <div class="knob">
                <span class="k">Status<small id="stathelp">Derived from the parts unless you hold it.</small></span>
                <span class="segctl" id="statseg">
                  <button type="button" data-v="">Auto</button>
                  <button type="button" data-v="paused">Paused</button>
                  <button type="button" data-v="complete">Complete</button>
                </span>
              </div>
            </div>

            <div class="sedsec">
              <div class="parts-h"><span class="fl">Parts</span><span class="c" id="pcount"></span></div>
              <ol class="plist" id="plist"></ol>
              <div class="addrow">
                <input class="inp" id="ptitle" placeholder="Title of a part you haven't written yet" aria-label="Planned part title">
                <button class="gbtn" type="button" id="padd">Add planned part</button>
              </div>
            </div>
          </div>

          <div class="sedside">
            <div class="sedsec">
              <span class="fl">On the series page</span>
              <div class="pv-plate"><svg id="plate" viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true"></svg></div>
              <div class="plate-read" id="pread"></div>
            </div>
            <div class="sedsec">
              <span class="fl">Field</span>
              <select class="sel" id="fieldsel" style="width:100%" aria-label="Field"></select>
              <div class="fh">A field needs two live series before readers see it.</div>
            </div>
          </div>
        </div>

        <!-- FIELD editor -->
        <div class="sed-body" id="mField" hidden>
          <div>
            <div class="sedsec">
              <span class="fl">What the field is</span>
              <textarea class="inp" id="fsum" style="width:100%;box-sizing:border-box;min-height:92px;resize:vertical" placeholder="One or two sentences. It sits under the title on the field page." aria-label="Field summary"></textarea>
            </div>
            <div class="sedsec">
              <span class="fl">Series in this field</span>
              <ol class="plist" id="fseries"></ol>
              <div class="fh" id="fpublic"></div>
            </div>
          </div>
          <div class="sedside">
            <div class="sedsec">
              <span class="fl">Mark</span>
              <div class="marks" id="marks"></div>
              <div class="plate-read" id="mread"></div>
            </div>
          </div>
        </div>

        <div class="savebar">
          <button class="btn btn-primary btn-sm" type="button" id="save">Save changes</button>
          <span class="state" id="state">No changes yet</span>
          <button class="gbtn del" type="button" id="del" style="margin-left:auto">Delete</button>
        </div>
        <div class="delconf" id="delconf">
          <span id="delmsg"></span>
          <button class="gbtn del" type="button" id="delyes" style="margin-left:auto">Delete it</button>
          <button class="gbtn" type="button" id="delno">Keep it</button>
        </div>
      </div>
    </div>
  </section>
</AdminLayout>

<style is:global>
  /* two panes: the collection on the left, one series/field under the knife on the right */
  .swrap { display: grid; grid-template-columns: 288px minmax(0, 1fr); gap: clamp(18px, 2.4vw, 28px); align-items: start; }
  @media (max-width: 1040px) { .swrap { grid-template-columns: 1fr; } }
  .slist { border: 1px solid var(--rule); border-radius: 5px; background: var(--card); overflow: hidden; }
  .slist .lh { display: flex; align-items: center; gap: 9px; padding: 11px 13px; border-bottom: 1px solid var(--rule); font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); }
  .slist .lh .n { margin-left: auto; font-weight: 400; letter-spacing: 0; text-transform: none; font-size: 11.5px; }
  .srow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 10px; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--rule-soft); padding: 12px 13px 12px 22px; cursor: pointer; font: inherit; color: inherit; transition: background .15s; }
  .srow:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .srow.on { background: color-mix(in srgb, var(--accent) 11%, transparent); box-shadow: inset 2px 0 0 var(--accent); }
  .srow .t { font-family: var(--serif-display); font-size: 15.5px; font-weight: 600; letter-spacing: -.01em; line-height: 1.25; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .srow.on .t { color: var(--accent); }
  .srow .mini { grid-column: 1 / -1; display: flex; gap: 3px; margin-top: 3px; flex-wrap: wrap; }
  .srow .mini i { width: 15px; height: 4px; border-radius: 1px; background: color-mix(in srgb, var(--accent) 40%, transparent); display: block; }
  .srow .mini i.todo { background: transparent; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 26%, transparent); }
  .srow .st { font-family: var(--sans); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; align-self: start; padding-top: 3px; }
  .rgrp { display: flex; align-items: center; gap: 8px; width: 100%; background: none; border: 0; border-bottom: 1px solid var(--rule-soft); padding: 11px 13px; cursor: pointer; font: inherit; text-align: left; color: var(--ink-faint); font-family: var(--sans); font-size: 9.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; transition: color .15s, background .15s; }
  .rgrp:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .rgrp.on { color: var(--accent); background: color-mix(in srgb, var(--accent) 11%, transparent); box-shadow: inset 2px 0 0 var(--accent); }
  .rgrp .gm { margin-left: auto; font-weight: 400; letter-spacing: 0; text-transform: none; font-size: 11px; }
  .rgrp.quiet { cursor: default; }
  .rgrp.quiet:hover { color: var(--ink-faint); background: none; }
  .slist .newrow { width: 100%; background: none; border: 0; border-top: 1px solid var(--rule); padding: 12px 13px; text-align: left; font-family: var(--sans); font-size: 12.5px; color: var(--accent); cursor: pointer; display: flex; align-items: center; gap: 8px; }
  .slist .newrow:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .slist .newrow svg { width: 13px; height: 13px; }

  /* the editor */
  .sed { border: 1px solid var(--rule); border-radius: 5px; background: var(--card); overflow: hidden; }
  .sed-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 16px 20px; border-bottom: 1px solid var(--rule); }
  .sed-top .nm { font-family: var(--serif-display); font-size: 23px; font-weight: 600; letter-spacing: -.015em; background: none; border: 0; color: var(--ink); padding: 2px 4px; margin-left: -4px; border-radius: 3px; min-width: 0; flex: 1; }
  .sed-top .nm:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .sed-top .nm:focus { outline: 2px solid var(--accent); outline-offset: 0; background: transparent; }
  .sed-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 0; }
  @media (max-width: 1180px) { .sed-body { grid-template-columns: 1fr; } }
  .sedsec { padding: 20px; border-bottom: 1px solid var(--rule-soft); }
  .sedsec:last-child { border-bottom: 0; }
  .sedsec > .fl { margin-bottom: 12px; }
  .sedside { border-left: 1px solid var(--rule); background: var(--paper-2); }
  @media (max-width: 1180px) { .sedside { border-left: 0; border-top: 1px solid var(--rule); } }

  .fl { display: block; font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); }
  .fh { font-family: var(--sans); font-size: 12px; line-height: 1.55; color: var(--ink-faint); margin-top: 10px; }
  .gbtn { font-family: var(--sans); font-size: 12.5px; font-weight: 500; padding: 8px 13px; border-radius: 3px; border: 1px solid var(--rule); background: var(--card); color: var(--ink-soft); cursor: pointer; transition: border-color .15s, color .15s, background .15s; white-space: nowrap; }
  .gbtn:hover { border-color: var(--ink-faint); color: var(--ink); }
  .gbtn.del:hover { color: #c2603f; border-color: color-mix(in srgb, #c2603f 45%, var(--rule)); }
  .segctl { display: inline-flex; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; background: var(--card); }
  .segctl button { background: none; border: 0; border-left: 1px solid var(--rule); font: inherit; font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); padding: 7px 13px; cursor: pointer; transition: background .15s, color .15s; }
  .segctl button:first-child { border-left: 0; }
  .segctl button:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--ink); }
  .segctl button.on { background: var(--accent); color: var(--on-accent); }

  .knob { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 13px 0; border-bottom: 1px solid var(--rule-soft); }
  .knob:last-of-type { border-bottom: 0; }
  .knob .k { font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
  .knob .k small { display: block; font-size: 11.5px; line-height: 1.5; color: var(--ink-faint); margin-top: 3px; max-width: 44ch; }
  .sstep { display: inline-flex; align-items: center; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; background: var(--card); }
  .sstep button { background: none; border: 0; color: var(--ink-soft); font: inherit; font-size: 15px; line-height: 1; padding: 8px 12px; cursor: pointer; }
  .sstep button:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .sstep b { min-width: 38px; text-align: center; font-family: var(--sans); font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); border-left: 1px solid var(--rule); border-right: 1px solid var(--rule); padding: 8px 0; }

  .parts-h { display: flex; align-items: baseline; gap: 10px; margin-bottom: 11px; }
  .parts-h .fl { margin: 0; }
  .parts-h .c { margin-left: auto; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .plist { list-style: none; margin: 0; padding: 0; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; background: var(--card); }
  .plist li { display: flex; align-items: center; gap: 11px; padding: 11px 13px; border-bottom: 1px solid var(--rule-soft); }
  .plist li:last-child { border-bottom: 0; }
  .plist li:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .plist .n { flex: none; width: 17px; font-family: var(--sans); font-size: 11px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .plist .t { flex: 1; min-width: 0; font-family: var(--serif-display); font-size: 15.5px; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .plist li.plan .t { font-style: italic; color: var(--ink-faint); }
  .plist .badge2 { flex: none; font-family: var(--sans); font-size: 9.5px; letter-spacing: .13em; text-transform: uppercase; color: var(--ink-faint); border: 1px solid var(--rule); border-radius: 2px; padding: 3px 7px; }
  .plist li.live .badge2 { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--rule)); }
  .plist .ed { flex: none; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); }
  .plist .ed:hover { color: var(--accent); }
  .plist .x { flex: none; background: none; border: 0; color: var(--ink-faint); font-size: 15px; line-height: 1; cursor: pointer; padding: 2px 4px; }
  .plist .x:hover { color: #c2603f; }
  .addrow { display: flex; gap: 9px; margin-top: 11px; flex-wrap: wrap; }
  .addrow .inp { flex: 1; min-width: 0; }

  .marks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .marks button { border: 1px solid var(--rule); border-radius: 3px; background: var(--card); padding: 0; cursor: pointer; overflow: hidden; line-height: 0; transition: border-color .15s; }
  .marks button:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); }
  .marks button.on { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .marks svg { width: 100%; height: 52px; display: block; }

  .pv-plate { position: relative; aspect-ratio: 3 / 2; max-width: 340px; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; background: var(--card); }
  .pv-plate svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plate-read { margin-top: 12px; font-family: var(--sans); font-size: 12px; line-height: 1.6; color: var(--ink-faint); }
  .plate-read b { color: var(--accent); font-weight: 600; }

  .savebar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 13px 20px; border-top: 1px solid var(--rule); background: var(--paper-2); }
  .savebar .state { font-family: var(--sans); font-size: 12px; color: var(--ink-faint); }
  .delconf { display: none; align-items: center; gap: 12px; flex-wrap: wrap; padding: 13px 20px; border-top: 1px solid color-mix(in srgb, #c2603f 40%, var(--rule)); background: color-mix(in srgb, #c2603f 7%, var(--paper-2)); font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); }
  .delconf.on { display: flex; }
  .delconf b { color: var(--ink); font-weight: 600; }
</style>

<script>
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';
  import { FIELD_MARKS, PREVIEW_S, markSvg } from '../../lib/field-marks.mjs';

  const el = (id: string) => document.getElementById(id)!;
  const A = 'var(--accent)';
  const slugify = (s: string) => String(s).toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const prettify = (slug: string) => { const w = slug.replace(/[-_]+/g, ' ').trim(); return w.charAt(0).toUpperCase() + w.slice(1); };
  const esc = (s: string) => String(s).replace(/[<&"]/g, (c) => (c === '<' ? '&lt;' : c === '&' ? '&amp;' : '&quot;'));
  const firstOf = (arr: any[], key: string) => { for (const m of arr) { const v = m[key]; if (v != null && v !== '' && !(Array.isArray(v) && v.length === 0)) return v; } return undefined; };
  const fmtMonth = (d: string) => { const t = Date.parse(d); return isNaN(t) ? '' : new Date(t).toLocaleDateString('en-US', { year: 'numeric', month: 'short' }); };

  // ---- raw data (mutated only on a successful save) --------------------------
  let sdefs: any[] = [];   // series.json
  let posts: any[] = [];   // /api/admin/posts
  let fdefs: any[] = [];   // fields.json

  // ---- selection + working draft --------------------------------------------
  let mode: 'series' | 'field' = 'series';
  let curSlug = '';        // selected series slug
  let curFieldSlug = '';   // selected field slug
  let draft: any = null;   // the working copy the editor edits
  let dirty = false;

  async function load(sel?: { series?: string; field?: string }) {
    const [sr, pr, fr] = await Promise.all([
      adminFetch('/api/admin/series').then((r) => r.json()).catch(() => null),
      adminFetch('/api/admin/posts').then((r) => r.json()).catch(() => null),
      adminFetch('/api/admin/fields').then((r) => r.json()).catch(() => null),
    ]);
    sdefs = sr && sr.content && Array.isArray(sr.content.series) ? sr.content.series : [];
    posts = (pr && pr.posts) || [];
    fdefs = fr && fr.content && Array.isArray(fr.content.fields) ? fr.content.fields : [];
    const list = seriesSlugs();
    if (sel && sel.field && fdefs.some((f) => f.slug === sel.field)) loadField(sel.field);
    else if (sel && sel.series && list.includes(sel.series)) loadSeries(sel.series);
    else if (list.length) loadSeries(list[0]);
    else if (fdefs.length) loadField(fdefs[0].slug);
    else { (el('sed') as HTMLElement).hidden = true; renderRail(); }
  }

  const groupsOf = () => { const g: Record<string, any[]> = {}; for (const p of posts) if (p.series) (g[p.series] ||= []).push(p); return g; };
  const seriesSlugs = () => [...new Set([...sdefs.map((d) => d.slug), ...Object.keys(groupsOf()), ...fdefs.flatMap((f) => (f.series || []).map((s: any) => s.slug))])];
  const fieldOf = (slug: string) => { const f = fdefs.find((x) => (x.series || []).some((s: any) => s.slug === slug)); return f ? f.slug : ''; };

  // Build the display model for one series slug (title, total, status, parts, published).
  function seriesModel(slug: string) {
    const g = groupsOf();
    const members = (g[slug] || []).slice().sort((a: any, b: any) => (a.seriesOrder ?? 1e9) - (b.seriesOrder ?? 1e9) || String(a.pubDate || '').localeCompare(String(b.pubDate || '')));
    const def = sdefs.find((d) => d.slug === slug);
    const name = (def && def.title) || firstOf(members, 'seriesTitle') || prettify(slug);
    const planned = ((def && def.planned) || firstOf(members, 'seriesPlanned') || []).filter((t: string) => t && String(t).trim());
    const published = members.filter((m: any) => !m.draft).length;
    let status = (def && def.status) || firstOf(members, 'seriesStatus') || '';
    if (status !== 'paused' && status !== 'complete') status = ''; // '' = auto
    const total = def && typeof def.total === 'number' && def.total > 0 ? def.total : Math.max(members.length + planned.length, 1);
    const written = members.map((m: any) => ({ slug: m.slug, t: m.title, live: !m.draft, m: m.draft ? 'In draft' : fmtMonth(m.pubDate) || 'Live' }));
    return { slug, name, total, status, planned: planned.slice(), written, published, fieldSlug: fieldOf(slug) };
  }

  // ---- left rail -------------------------------------------------------------
  const railStatus = (m: any) => (m.status === 'paused' ? 'Paused' : m.status === 'complete' ? 'Complete' : !m.written.length ? 'Empty' : m.published >= m.total ? 'Complete' : m.published + ' of ' + m.total);
  function railRow(slug: string) {
    const m = seriesModel(slug);
    let ticks = '';
    for (let k = 0; k < Math.min(m.total, 12); k++) ticks += '<i class="' + (k < m.published ? '' : 'todo') + '"></i>';
    const on = mode === 'series' && slug === curSlug ? ' on' : '';
    return `<button class="srow${on}" type="button" data-s="${esc(slug)}"><span class="t">${esc(m.name)}</span><span class="st">${railStatus(m)}</span><span class="mini">${ticks}</span></button>`;
  }
  function renderRail() {
    const inField = new Set<string>();
    let html = '';
    for (const f of fdefs) {
      const members = (f.series || []).map((s: any) => s.slug).filter((s: string) => seriesSlugs().includes(s));
      members.forEach((s: string) => inField.add(s));
      const pub = members.filter((s: string) => seriesModel(s).published > 0).length;
      const on = mode === 'field' && f.slug === curFieldSlug ? ' on' : '';
      html += `<button class="rgrp${on}" type="button" data-f="${esc(f.slug)}">${esc(f.title || f.slug)}<span class="gm">${members.length} series · ${pub >= 2 ? 'live' : 'not public yet'}</span></button>`;
      html += members.map((s: string) => railRow(s)).join('');
    }
    const loose = seriesSlugs().filter((s) => !inField.has(s));
    if (loose.length) {
      html += `<span class="rgrp quiet">${fdefs.length ? 'Stands alone' : 'Series'}<span class="gm">${loose.length}</span></span>`;
      html += loose.map((s) => railRow(s)).join('');
    }
    el('rail').innerHTML = html || '<div class="muted" style="padding:16px 13px;font-size:12.5px">Nothing yet — create a series or field below.</div>';
    el('scount').textContent = String(seriesSlugs().length);
  }

  // ---- series editor ---------------------------------------------------------
  function loadSeries(slug: string) {
    mode = 'series'; curSlug = slug;
    const m = seriesModel(slug);
    draft = { slug, name: m.name, total: m.total, status: m.status, planned: m.planned.slice(), fieldSlug: m.fieldSlug };
    (el('sed') as HTMLElement).hidden = false;
    (el('mSeries') as HTMLElement).hidden = false;
    (el('mField') as HTMLElement).hidden = true;
    (el('sname') as HTMLInputElement).value = draft.name;
    el('del').textContent = 'Delete series';
    el('delconf').classList.remove('on');
    dirty = false; renderSeries();
  }
  function renderSeries() {
    const m = seriesModel(curSlug);              // written parts (live) come from posts
    const total = draft.total;
    const publishedLabel = m.status === 'paused' && draft.status === 'paused' ? 'Paused' : (m.published >= total ? 'Complete' : m.published ? 'In progress' : 'Not started');
    const pill = draft.status === 'paused' ? 'Paused' : draft.status === 'complete' ? 'Complete' : publishedLabel;
    el('spill').textContent = pill;
    (el('spill') as HTMLElement).className = 'pill' + (m.published ? ' live' : '');
    el('tnum').textContent = String(total);
    el('stathelp').textContent = draft.status === ''
      ? (m.written.length ? `Derived from the parts: ${m.published} of ${total} published.` : 'Derived from the parts. With none yet, readers see nothing.')
      : `Held at ${draft.status}, whatever the parts say.`;
    el('statseg').querySelectorAll('button').forEach((b: any) => b.classList.toggle('on', b.dataset.v === draft.status));

    const rows = m.written.map((p: any, i: number) => `<li class="${p.live ? 'live' : 'plan'}"><span class="n">${i + 1}</span><span class="t">${esc(p.t)}</span><span class="badge2">${esc(p.m)}</span><a class="ed" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Edit</a></li>`).join('')
      + draft.planned.map((t: string, i: number) => `<li class="plan"><span class="n">${m.written.length + i + 1}</span><span class="t">${esc(t)}</span><span class="badge2">Planned</span><button class="x" type="button" data-rm="${i}" aria-label="Remove planned part">×</button></li>`).join('');
    el('plist').innerHTML = rows || '<li class="plan"><span class="n">—</span><span class="t">Nothing yet — add a planned part, or write a post into this series from the publish sheet.</span></li>';
    el('pcount').textContent = `${m.published} written · ${draft.planned.length} planned`;

    fillFieldSel();
    drawPlate(m.written.map((p: any) => p.live), total);
    renderRail();
    el('state').textContent = dirty ? 'Unsaved changes' : 'No changes yet';
  }
  function fillFieldSel() {
    const sel = el('fieldsel') as HTMLSelectElement;
    sel.innerHTML = fdefs.map((f) => `<option value="${esc(f.slug)}"${f.slug === draft.fieldSlug ? ' selected' : ''}>${esc(f.title || f.slug)}</option>`).join('') + `<option value=""${draft.fieldSlug ? '' : ' selected'}>— Stands alone —</option>`;
  }
  // A simple comb + spine preview (illustrative — the real plate renders at build).
  function drawPlate(liveArr: boolean[], total: number) {
    const n = Math.max(total, liveArr.length, 1); let out = ''; const cy = 118;
    for (let i = 0; i < n * 3; i++) { const y = 32 + i * (150 / Math.max(1, n * 3)), o = (0.1 + (i % 3) * 0.05).toFixed(2); out += `<path d="M-10 ${(y + 12).toFixed(1)} C 60 ${(y - 6).toFixed(1)} 130 ${(y + 16).toFixed(1)} 200 ${(y - 2).toFixed(1)} S 290 ${(y + 8).toFixed(1)} 310 ${y.toFixed(1)}" fill="none" stroke="${A}" stroke-width="1.3" opacity="${o}"/>`; }
    const pts: [number, number][] = [];
    for (let k = 0; k < n; k++) { const x = n === 1 ? 150 : 26 + k * (248 / (n - 1)), on = liveArr[k], hh = on ? 38 + ((k * 13) % 26) : 18; pts.push([x, cy - hh]); }
    if (pts.length > 1) out += `<path d="${pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ')}" fill="none" stroke="${A}" stroke-width="1.7" opacity=".55"/>`;
    pts.forEach((p, i) => { out += liveArr[i] ? `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="5" fill="${A}"/>` : `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="4.4" fill="var(--card)" stroke="${A}" stroke-width="1.4" opacity=".85"/>`; });
    el('plate').innerHTML = out;
    const pub = liveArr.filter(Boolean).length;
    el('pread').innerHTML = `<b>${pub} of ${total}</b> nodes lit. The comb thickens with the length of the series; a node rises with its part's read time.`;
  }

  // ---- field editor ----------------------------------------------------------
  function loadField(slug: string) {
    mode = 'field'; curFieldSlug = slug;
    const f = fdefs.find((x) => x.slug === slug); if (!f) return;
    draft = { slug, name: f.title || f.slug, summary: f.summary || '', mark: f.mark || '01' };
    (el('sed') as HTMLElement).hidden = false;
    (el('mSeries') as HTMLElement).hidden = true;
    (el('mField') as HTMLElement).hidden = false;
    (el('sname') as HTMLInputElement).value = draft.name;
    (el('fsum') as HTMLTextAreaElement).value = draft.summary;
    el('del').textContent = 'Delete field';
    el('delconf').classList.remove('on');
    dirty = false; renderField();
  }
  function renderField() {
    const members = (fdefs.find((x) => x.slug === curFieldSlug)?.series || []).map((s: any) => s.slug).filter((s: string) => seriesSlugs().includes(s));
    const pub = members.filter((s: string) => seriesModel(s).published > 0).length;
    el('spill').textContent = pub >= 2 ? 'Live' : 'Not shown yet';
    (el('spill') as HTMLElement).className = 'pill' + (pub >= 2 ? ' live' : '');
    el('fseries').innerHTML = members.length
      ? members.map((s: string, k: number) => { const m = seriesModel(s); return `<li class="${m.published ? 'live' : 'plan'}"><span class="n">${k + 1}</span><span class="t">${esc(m.name)}</span><span class="badge2">${railStatus(m)}</span></li>`; }).join('')
      : '<li class="plan"><span class="n">—</span><span class="t">No series yet — set a series\' Field to this one.</span></li>';
    el('fpublic').textContent = pub >= 2 ? `Readers can see this field: ${pub} of its series are public.` : `A field needs two public series before readers see it. This one has ${pub || 'none'}.`;
    el('marks').innerHTML = FIELD_MARKS.map((mk) => `<button type="button" data-m="${mk.id}" class="${mk.id === draft.mark ? 'on' : ''}" title="${esc(mk.name)}" aria-label="${esc(mk.name)}">${markSvg(mk.id, PREVIEW_S)}</button>`).join('');
    const cur = FIELD_MARKS.find((mk) => mk.id === draft.mark) || FIELD_MARKS[0];
    el('mread').innerHTML = `<b>${esc(cur.name)}</b> — drawn from this field's own series and their parts. Nothing to upload.`;
    renderRail();
    el('state').textContent = dirty ? 'Unsaved changes' : 'No changes yet';
  }

  const touch = () => { dirty = true; el('state').textContent = 'Unsaved changes'; };

  // ---- persistence (whole-array PUT; adopt server's sanitized shape) ----------
  async function persistSeries(next: any[]) {
    const r = await adminFetch('/api/admin/series', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ content: { series: next } }) });
    const j = await r.json().catch(() => ({})); if (!r.ok || !j.ok) throw new Error(j.error || 'HTTP ' + r.status);
    sdefs = Array.isArray(j.series) ? j.series : next;
  }
  async function persistFields(next: any[]) {
    const r = await adminFetch('/api/admin/fields', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ content: { fields: next } }) });
    const j = await r.json().catch(() => ({})); if (!r.ok || !j.ok) throw new Error(j.error || 'HTTP ' + r.status);
    fdefs = Array.isArray(j.fields) ? j.fields : next;
  }
  // Move a series slug into `toField` (or out to standalone) — returns a NEW fdefs array.
  function withMove(list: any[], slug: string, toField: string) {
    let note: string | undefined;
    for (const f of list) { const mm = (f.series || []).find((s: any) => s.slug === slug); if (mm && mm.note) { note = mm.note; break; } }
    const out = list.map((f) => ({ ...f, series: (f.series || []).filter((s: any) => s.slug !== slug) }));
    if (toField) { const f = out.find((x) => x.slug === toField); if (f) f.series = [...f.series, note ? { slug, note } : { slug }]; }
    return out;
  }

  async function save() {
    const st = el('state'); st.textContent = 'Saving…';
    try {
      if (mode === 'series') {
        const entry = { slug: draft.slug, title: (draft.name || '').trim() || draft.slug, total: draft.total || null, status: draft.status, planned: draft.planned };
        const i = sdefs.findIndex((d) => d.slug === draft.slug);
        const next = i >= 0 ? sdefs.map((d, k) => (k === i ? entry : d)) : [...sdefs, entry];
        await persistSeries(next);
        if (fieldOf(draft.slug) !== draft.fieldSlug) await persistFields(withMove(fdefs, draft.slug, draft.fieldSlug));
        dirty = false; renderSeries(); st.textContent = 'Saved — live on the next rebuild.';
      } else {
        const next = fdefs.map((f) => (f.slug === draft.slug ? { ...f, title: (draft.name || '').trim() || f.slug, summary: draft.summary, mark: draft.mark } : f));
        await persistFields(next);
        dirty = false; renderField(); st.textContent = 'Saved — live on the next rebuild.';
      }
    } catch (e: any) { st.textContent = 'Not saved — ' + (e.message || e); }
  }

  function askDelete() {
    const msg = el('delmsg');
    if (mode === 'field') {
      const n = (fdefs.find((x) => x.slug === curFieldSlug)?.series || []).length;
      msg.innerHTML = `Delete <b>${esc(draft.name)}</b>? ${n ? `Its ${n} series stay — just ungrouped.` : 'It holds no series yet.'} Nothing it holds is deleted.`;
    } else {
      const n = seriesModel(curSlug).published;
      msg.innerHTML = `Delete <b>${esc(draft.name)}</b>? ${n ? `Its ${n} published post${n > 1 ? 's' : ''} stay — just ungrouped.` : 'It holds no posts yet.'}`;
    }
    el('delconf').classList.add('on');
  }
  async function runDelete() {
    const yes = el('delyes') as HTMLButtonElement; yes.disabled = true;
    try {
      if (mode === 'field') {
        await persistFields(fdefs.filter((f) => f.slug !== curFieldSlug));
        await load({});
      } else {
        const members = posts.filter((p) => p.series === curSlug);
        for (const m of members) {
          const r = await adminFetch('/api/admin/post', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: m.slug, series: null }) });
          if (!r.ok) throw new Error('Could not unassign “' + m.title + '”');
        }
        const wasInField = fieldOf(curSlug);
        await persistSeries(sdefs.filter((d) => d.slug !== curSlug));
        if (wasInField) await persistFields(withMove(fdefs, curSlug, ''));
        await load({});
      }
    } catch (e: any) { el('delmsg').textContent = 'Error — ' + (e.message || e); yes.disabled = false; }
  }

  // ---- events ----------------------------------------------------------------
  onAdminReady(() => load());
  el('rail').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const f = t.closest('.rgrp[data-f]') as HTMLElement | null; if (f) return loadField(f.dataset.f!);
    const s = t.closest('.srow') as HTMLElement | null; if (s) return loadSeries(s.dataset.s!);
  });
  el('newSeries').addEventListener('click', async () => {
    const base = 'untitled-series'; let slug = base, i = 2; const taken = new Set(seriesSlugs());
    while (taken.has(slug)) slug = base + '-' + i++;
    try { await persistSeries([...sdefs, { slug, title: 'Untitled series', total: null, status: '', planned: [] }]); await load({ series: slug }); (el('sname') as HTMLInputElement).select(); } catch (e: any) { el('state').textContent = 'Could not create — ' + (e.message || e); }
  });
  el('newField').addEventListener('click', async () => {
    const base = 'untitled-field'; let slug = base, i = 2; const taken = new Set(fdefs.map((f) => f.slug));
    while (taken.has(slug)) slug = base + '-' + i++;
    try { await persistFields([...fdefs, { slug, title: 'Untitled field', summary: '', mark: '01', series: [] }]); await load({ field: slug }); (el('sname') as HTMLInputElement).select(); } catch (e: any) { el('state').textContent = 'Could not create — ' + (e.message || e); }
  });
  el('sname').addEventListener('input', () => { draft.name = (el('sname') as HTMLInputElement).value; touch(); });
  el('tplus').addEventListener('click', () => { draft.total = Math.min(24, (draft.total || 1) + 1); renderSeries(); touch(); });
  el('tminus').addEventListener('click', () => { draft.total = Math.max(Math.max(1, seriesModel(curSlug).written.length), (draft.total || 1) - 1); renderSeries(); touch(); });
  el('statseg').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button') as HTMLElement | null; if (!b) return; draft.status = b.dataset.v; renderSeries(); touch(); });
  el('padd').addEventListener('click', () => { const inp = el('ptitle') as HTMLInputElement; const v = inp.value.trim(); if (!v) return inp.focus(); draft.planned.push(v); inp.value = ''; if (seriesModel(curSlug).written.length + draft.planned.length > draft.total) draft.total = seriesModel(curSlug).written.length + draft.planned.length; renderSeries(); touch(); });
  el('ptitle').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); el('padd').click(); } });
  el('plist').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-rm]') as HTMLElement | null; if (!b) return; draft.planned.splice(+b.dataset.rm!, 1); renderSeries(); touch(); });
  el('fieldsel').addEventListener('change', () => { draft.fieldSlug = (el('fieldsel') as HTMLSelectElement).value; touch(); });
  el('fsum').addEventListener('input', () => { draft.summary = (el('fsum') as HTMLTextAreaElement).value; touch(); });
  el('marks').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button[data-m]') as HTMLElement | null; if (!b) return; draft.mark = b.dataset.m; renderField(); touch(); });
  el('save').addEventListener('click', save);
  el('del').addEventListener('click', askDelete);
  el('delno').addEventListener('click', () => el('delconf').classList.remove('on'));
  el('delyes').addEventListener('click', runDelete);
</script>
