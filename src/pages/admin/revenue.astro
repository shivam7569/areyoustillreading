---
/**
 * /admin/revenue — sales overview (Studio design).
 * Our monetisation is PAY-WHAT-YOU-WANT one-time unlocks (Dodo, Merchant-of-Record),
 * NOT recurring subscriptions — so the design's MRR / churn / per-reader-monthly /
 * Stripe payouts do NOT apply and are deliberately omitted (never fabricated).
 * Real data only: gross + sales + avg-per-sale + paywalled count, a revenue-by-post
 * barrow, and the by-post sales table. From the admin-gated GET /api/admin/sales
 * (reads the entitlements ledger; revenue is ESTIMATED from post_paywall prices —
 * the ledger doesn't store the amount paid).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Revenue — Studio" heading="Revenue" active="revenue">
  <section class="stack">
    <div class="tiles">
      <div class="tile"><div class="l">Gross revenue</div><div class="v loading" id="r-gross">—</div><div class="d" id="r-gross-foot">to date</div></div>
      <div class="tile"><div class="l">Sales</div><div class="v loading" id="r-sales">—</div><div class="d">unlocks purchased</div></div>
      <div class="tile"><div class="l">Avg per sale</div><div class="v loading" id="r-avg">—</div><div class="d">pay-what-you-want</div></div>
      <div class="tile"><div class="l">Paywalled posts</div><div class="v loading" id="r-paid">—</div><div class="d">currently earning</div></div>
    </div>

    <div class="panel">
      <header><h2>Revenue by post</h2><span class="hint">Attributed to the post a reader unlocked</span></header>
      <div class="pb" id="byrow"><div class="muted">Loading…</div></div>
    </div>

    <div class="panel">
      <header><h2>Sales by post</h2><a class="hint" href="/admin/posts" style="color:var(--accent);text-decoration:none">Manage paywall →</a></header>
      <div class="pb flush" id="bypost"><div class="card-pad muted">Loading…</div></div>
    </div>
  </section>
</AdminLayout>

<script>
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';
  import { fmtNum, fmtMoney, esc } from '../../lib/admin-format';

  const $ = (id: string) => document.getElementById(id)!;
  function setKpi(id: string, text: string) { const el = document.getElementById(id); if (el) { el.textContent = text; el.classList.remove('loading'); } }
  let titles: Record<string, string> = {};
  const title = (slug: string) => titles[slug] || slug;

  async function loadSales() {
    try {
      const r = await adminFetch('/api/admin/sales');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      setKpi('r-gross', fmtMoney(d.totalCents, 'usd'));
      $('r-gross-foot').textContent = d.estimated ? 'estimated from prices' : 'captured at sale';
      setKpi('r-sales', fmtNum(d.count));
      setKpi('r-avg', d.count > 0 ? fmtMoney(Math.round(d.totalCents / d.count), 'usd') : '—');

      const byPost = (d.byPost || []).slice().sort((a: any, b: any) => b.cents - a.cents);
      // Revenue-by-post barrow
      const brow = $('byrow');
      if (!byPost.length) {
        brow.innerHTML = '<div class="muted">No sales yet — when a reader unlocks a post, it earns here.</div>';
      } else {
        const max = Math.max(1, ...byPost.map((b: any) => b.cents));
        brow.innerHTML = byPost.slice(0, 8).map((b: any) => `<div class="barrow"><div><div class="nm">${esc(title(b.post_id))}</div><div class="bar"><i style="width:${Math.max(2, Math.round((b.cents / max) * 100))}%"></i></div></div><div class="pc">${fmtMoney(b.cents, 'usd')}</div></div>`).join('');
      }
      // Sales-by-post table
      const host = $('bypost');
      host.innerHTML = byPost.length
        ? '<table class="t"><thead><tr><th>Post</th><th class="num">Sales</th><th class="num">Revenue</th></tr></thead><tbody>'
          + byPost.map((b: any) => `<tr><td><a class="ti" href="/blog/${encodeURIComponent(b.post_id)}" target="_blank" rel="noopener" style="text-decoration:none">${esc(title(b.post_id))}</a></td><td class="num">${fmtNum(b.count)}</td><td class="num">${fmtMoney(b.cents, 'usd')}</td></tr>`).join('')
          + '</tbody></table>'
        : '<div class="card-pad muted">No sales yet. When a reader unlocks a post, it shows up here.</div>';
    } catch (e: any) {
      $('bypost').innerHTML = `<div class="card-pad notice err">Couldn't load sales: ${esc(e.message || e)}</div>`;
    }
  }

  async function loadPosts() {
    try {
      const r = await adminFetch('/api/admin/posts');
      const d = await r.json();
      if (!r.ok) return;
      const posts = d.posts || [];
      titles = {}; for (const p of posts) titles[p.slug] = p.title;
      setKpi('r-paid', fmtNum(posts.filter((p: any) => p.paid).length));
    } catch { setKpi('r-paid', '0'); }
  }

  onAdminReady(async () => { await loadPosts(); loadSales(); });
</script>
