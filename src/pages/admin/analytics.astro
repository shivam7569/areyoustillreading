---
/**
 * /admin/analytics — first-party traffic dashboard.
 * Reads the admin-gated GET /api/admin/analytics (aggregated from the cookieless
 * analytics_events table) and joins post slugs → titles via /api/admin/posts.
 * Shows KPIs, a daily views chart, top posts by views + read depth, referrers,
 * and in-range conversion (new subscribers, unlocks). No third-party analytics.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Analytics — Studio" heading="Analytics" active="analytics">
  <section class="stack">
    <div class="rowhead">
      <div style="color:var(--ink-faint);font-size:12.5px">Privacy-first — no cookies, all your own data.</div>
      <div class="range" role="tablist" aria-label="Time range">
        <button class="btn btn-sm seg" data-range="7d" type="button">7 days</button>
        <button class="btn btn-sm seg is-on" data-range="30d" type="button">30 days</button>
        <button class="btn btn-sm seg" data-range="90d" type="button">90 days</button>
        <button class="btn btn-sm seg" data-range="all" type="button">All time</button>
      </div>
    </div>

    <div id="setup" class="card card-pad notice" hidden>
      <strong>Analytics isn't set up yet.</strong> Run <code>db/analytics.sql</code> once in the
      Supabase SQL editor, then reload — traffic will start recording immediately.
    </div>

    <div class="tiles">
      <div class="tile"><div class="l">Views</div><div class="v loading" id="k-views">—</div><div class="d" id="k-views-foot">page loads</div></div>
      <div class="tile"><div class="l">Visitors</div><div class="v loading" id="k-visitors">—</div><div class="d">unique sessions</div></div>
      <div class="tile"><div class="l">Avg. read depth</div><div class="v loading" id="k-read">—</div><div class="d" id="k-read-foot">how far people scroll</div></div>
      <div class="tile"><div class="l">New subscribers</div><div class="v loading" id="k-subs">—</div><div class="d">confirmed, in range</div></div>
      <div class="tile"><div class="l">Unlocks</div><div class="v loading" id="k-unlocks">—</div><div class="d">paid, in range</div></div>
    </div>

    <div class="panel">
      <header><h2>Views</h2><span class="hint" id="chart-hint">Over the selected range</span></header>
      <div class="pb"><div id="chart"><div class="muted">Loading…</div></div></div>
    </div>

    <div class="cols two">
      <div class="panel">
        <header><h2>Top posts</h2><span class="hint">Views · read depth</span></header>
        <div class="pb flush" id="posts"><div class="card-pad muted">Loading…</div></div>
      </div>
      <div class="panel">
        <header><h2>Where readers come from</h2></header>
        <div class="pb flush" id="refs"><div class="card-pad muted">Loading…</div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Did it hold?</h2><span class="hint" id="fb-hint">Reader verdict &middot; where they lose it</span></header>
      <div class="pb flush" id="verdicts"><div class="card-pad muted">Loading…</div></div>
    </div>

    <div class="panel">
      <header><h2>Data</h2><span class="hint">Housekeeping — deletes are permanent</span></header>
      <div class="pb" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center">
        <button class="btn btn-sm btn-ghost" id="purge-synthetic" type="button">Clear load-test data</button>
        <button class="btn btn-sm btn-ghost" id="purge-old" type="button">Purge data older than 90 days</button>
        <span class="muted" id="purge-status" style="font-size:0.85rem"></span>
      </div>
    </div>
  </section>
</AdminLayout>

<style>
  /* Only rules that target STATIC template elements live here; dynamically
     injected chart/rows use inline styles (Astro scoping can't reach innerHTML).
     Layout components (.stack/.rowhead/.tiles/.panel/.cols) live in admin.css. */
  .range { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .seg { background: transparent; }
  .seg.is-on { background: var(--admin-accent-soft); border-color: color-mix(in srgb, var(--accent) 30%, var(--border)); color: var(--accent); }
  #chart { min-height: 140px; }
</style>

<script>
  import { onAdminReady, adminFetch, swrFetch } from '../../lib/admin-gate';
  import { fmtNum, esc } from '../../lib/admin-format';

  let range = '30d';
  let titles: Record<string, string> = {};

  const $ = (id: string) => document.getElementById(id)!;

  function fmtDwell(ms: number): string {
    if (!ms || ms < 1000) return '0s';
    const s = Math.round(ms / 1000);
    if (s < 60) return s + 's';
    const m = Math.floor(s / 60);
    return m + 'm ' + (s % 60) + 's';
  }

  function setKpi(id: string, text: string) {
    const el = $(id);
    el.textContent = text;
    el.classList.remove('loading');
  }

  // Inline styles — these nodes are injected via innerHTML, so Astro's scoped
  // <style> below does NOT reach them; only global admin.css classes + inline work.
  const ROW = 'display:flex;align-items:center;gap:0.75rem;padding:0.6rem 1.25rem;border-top:1px solid var(--border)';
  const NAME = 'flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap';
  const NUM = 'flex:0 0 auto;font-variant-numeric:tabular-nums;font-weight:600';

  function renderChart(byDay: { date: string; views: number }[]) {
    const host = $('chart');
    // Fill the window with continuous days (0 where no traffic) for fixed ranges.
    const days = range === '7d' ? 7 : range === '90d' ? 90 : range === '30d' ? 30 : 0;
    let series = byDay;
    if (days) {
      const map = new Map(byDay.map((d) => [d.date, d.views]));
      series = [];
      const today = new Date();
      // days+1 bars: the server window (ts >= now - days*24h) spans the earliest
      // UTC date (today-days) through today, so include that boundary day too —
      // otherwise the bars can't sum to the Views KPI when it has traffic.
      for (let i = days; i >= 0; i--) {
        const d = new Date(today.getTime() - i * 86400000).toISOString().slice(0, 10);
        series.push({ date: d, views: map.get(d) || 0 });
      }
    }
    if (!series.length) { host.innerHTML = '<div class="muted">No views in this range yet.</div>'; return; }
    const max = Math.max(1, ...series.map((d) => d.views));
    const bars = series.map((d) => {
      const h = Math.max(2, Math.round((d.views / max) * 100));
      return `<div title="${d.date}: ${d.views} view${d.views === 1 ? '' : 's'}" style="flex:1 1 0;min-width:2px;height:${h}%;align-self:flex-end;border-radius:3px 3px 0 0;background:color-mix(in srgb, var(--accent) 60%, transparent)"></div>`;
    }).join('');
    const first = series[0].date.slice(5), last = series[series.length - 1].date.slice(5);
    host.innerHTML =
      `<div style="display:flex;align-items:flex-end;gap:3px;height:140px">${bars}</div>` +
      `<div style="display:flex;justify-content:space-between;margin-top:0.4rem;font-size:0.72rem;color:var(--muted)"><span>${first}</span><span>${last}</span></div>`;
  }

  function renderPosts(topPosts: any[]) {
    const host = $('posts');
    if (!topPosts.length) { host.innerHTML = '<div class="card-pad muted">No post views yet.</div>'; return; }
    host.innerHTML = topPosts.map((p) => {
      const title = titles[p.slug] || p.slug;
      const depth = typeof p.avgReadPct === 'number'
        ? `<span style="flex:0 0 92px;display:flex;align-items:center;gap:0.4rem">
             <span style="flex:1 1 auto;height:6px;border-radius:999px;background:var(--border);overflow:hidden"><span style="display:block;height:100%;width:${p.avgReadPct}%;background:var(--accent);border-radius:999px"></span></span>
             <span style="font-size:0.75rem;color:var(--muted);width:2.4em;text-align:right">${p.avgReadPct}%</span>
           </span>`
        : `<span style="flex:0 0 92px;font-size:0.75rem;color:var(--muted);text-align:right">—</span>`;
      return `<div style="${ROW}">
          <span style="${NAME}"><a href="/blog/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener" style="color:var(--fg);text-decoration:none">${esc(title)}</a></span>
          ${depth}
          <span style="${NUM}">${fmtNum(p.views)}</span>
        </div>`;
    }).join('');
  }

  function renderRefs(referrers: any[], direct: number) {
    const host = $('refs');
    const all = referrers.map((r) => `<div style="${ROW}"><span style="${NAME}">${esc(r.host)}</span><span style="${NUM}">${fmtNum(r.count)}</span></div>`);
    if (direct > 0) all.push(`<div style="${ROW}"><span style="${NAME}" class="muted">Direct / none</span><span style="${NUM}">${fmtNum(direct)}</span></div>`);
    host.innerHTML = all.length ? all.join('') : '<div class="card-pad muted">No referrers yet.</div>';
  }

  // --- "Did it hold?" reader verdicts (in sync with the reader poll) ---------
  let lastFeedback: any = null;
  function pctOf(n: number, t: number) { return t ? Math.round((n / t) * 100) : 0; }
  function verdictBar(p: any) {
    const t = p.total || 1;
    const seg = (n: number, color: string) => `<span style="width:${((n / t) * 100).toFixed(1)}%;background:${color}"></span>`;
    return `<span title="${p.held} held · ${p.skimmed} skimmed · ${p.lost} lost" style="flex:0 0 132px;display:flex;height:8px;border-radius:999px;overflow:hidden;background:var(--border)">` +
      seg(p.held, 'var(--accent)') +
      seg(p.skimmed, 'color-mix(in srgb, var(--accent) 42%, transparent)') +
      seg(p.lost, 'color-mix(in srgb, var(--fg) 20%, transparent)') + '</span>';
  }
  function renderVerdicts(d: any) {
    const host = $('verdicts');
    if (d && d.setup) {
      host.innerHTML = '<div class="card-pad muted">Run <code>db/feedback.sql</code> in the Supabase SQL editor once, then reload — reader verdicts will show here.</div>';
      $('fb-hint').textContent = '';
      return;
    }
    const posts = (d && d.posts) || [];
    const T = (d && d.totals) || { held: 0, skimmed: 0, lost: 0, total: 0 };
    $('fb-hint').innerHTML = T.total
      ? `${pctOf(T.held, T.total)}% held &middot; ${pctOf(T.skimmed, T.total)}% skimmed &middot; ${pctOf(T.lost, T.total)}% lost &middot; ${fmtNum(T.total)} answer${T.total === 1 ? '' : 's'}`
      : 'Where readers land';
    if (!posts.length) {
      host.innerHTML = '<div class="card-pad muted">No verdicts yet. When readers answer &ldquo;Did it hold?&rdquo; at the end of a post, it shows here.</div>';
      return;
    }
    host.innerHTML = posts.map((p: any) => {
      const title = titles[p.slug] || p.slug;
      const held = pctOf(p.held, p.total);
      const lostp = (p.lost && p.lostMedian) ? `lost &para;${p.lostMedian}` : '';
      return `<div style="${ROW}">
          <span style="${NAME}"><a href="/blog/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener" style="color:var(--fg);text-decoration:none">${esc(title)}</a></span>
          ${verdictBar(p)}
          <span style="flex:0 0 54px;font-size:0.75rem;color:var(--muted);text-align:right">${held}% held</span>
          <span style="flex:0 0 58px;font-size:0.75rem;color:var(--muted);text-align:right">${lostp}</span>
          <span style="${NUM}">${fmtNum(p.total)}</span>
        </div>`;
    }).join('');
  }
  function loadFeedback() {
    return swrFetch('/api/admin/feedback', (d: any) => { if (d && !d.__error) { lastFeedback = d; renderVerdicts(d); } });
  }

  function loadTitles() {
    return swrFetch('/api/admin/posts', (d: any) => {
      if (d && !d.__error && Array.isArray(d.posts)) {
        titles = {};
        for (const p of d.posts) titles[p.slug] = p.title;
        // If the analytics data already painted (with slugs), relabel with real titles.
        if (lastData && Array.isArray(lastData.topPosts)) renderPosts(lastData.topPosts);
        if (lastFeedback) renderVerdicts(lastFeedback);
      }
    });
  }

  let lastData: any = null; // remembered so a late titles fetch can re-render posts
  function renderAll(d: any) {
    if (d && d.__error) { $('chart').innerHTML = `<div class="notice err">Couldn't load analytics: ${esc(d.error || ('HTTP ' + d.status))}</div>`; return; }
    if (d && d.configured === false) {
      $('setup').hidden = false;
      for (const id of ['k-views', 'k-visitors', 'k-read', 'k-subs', 'k-unlocks']) setKpi(id, '0');
      renderChart([]); renderPosts([]); renderRefs([], 0);
      return;
    }
    lastData = d;
    $('setup').hidden = true;
    const t = d.totals || {};
    setKpi('k-views', fmtNum(t.views || 0));
    setKpi('k-visitors', fmtNum(t.uniqueSessions || 0));
    setKpi('k-read', (t.avgReadPct || 0) + '%');
    $('k-read-foot').textContent = t.reads ? `${fmtNum(t.reads)} reads · ~${fmtDwell(t.avgDwellMs || 0)} on page` : 'how far people scroll';
    $('k-views-foot').textContent = d.truncated ? 'page loads (capped)' : 'page loads';
    setKpi('k-subs', fmtNum((d.conversion && d.conversion.newSubscribers) || 0));
    setKpi('k-unlocks', fmtNum((d.conversion && d.conversion.unlocks) || 0));
    renderChart(d.byDay || []);
    renderPosts(d.topPosts || []);
    renderRefs(d.referrers || [], d.directViews || 0);
  }
  // Stale-while-revalidate: paints the last-seen numbers for this range instantly,
  // then updates from the network — so re-opening Analytics has no lag.
  function load() { return swrFetch(`/api/admin/analytics?range=${encodeURIComponent(range)}`, (d) => renderAll(d)); }

  document.querySelectorAll('.seg').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.seg').forEach((x) => x.classList.remove('is-on'));
      b.classList.add('is-on');
      range = (b as HTMLElement).dataset.range!;
      for (const id of ['k-views', 'k-visitors', 'k-read', 'k-subs', 'k-unlocks']) $(id).classList.add('loading');
      load();
    });
  });

  async function purge(action: string, label: string) {
    if (!confirm(`${label}? This can't be undone.`)) return;
    const st = $('purge-status');
    st.textContent = 'Working…';
    try {
      const r = await adminFetch('/api/admin/analytics', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(action === 'purge-old' ? { action, days: 90 } : { action }),
      });
      const d = await r.json();
      if (!r.ok || !d.ok) throw new Error(d.error || 'Failed');
      st.textContent = `Removed ${fmtNum(d.removed || 0)} row${d.removed === 1 ? '' : 's'}.`;
      load();
    } catch (e: any) {
      st.textContent = 'Error: ' + (e.message || e);
    }
  }
  $('purge-synthetic').addEventListener('click', () => purge('purge-synthetic', 'Delete all load-test rows'));
  $('purge-old').addEventListener('click', () => purge('purge-old', 'Delete analytics older than 90 days'));

  onAdminReady(() => { loadTitles(); load(); loadFeedback(); }); // fire in parallel; SWR paints instantly
</script>
