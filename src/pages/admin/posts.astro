---
/**
 * /admin/posts — the unified Posts manager.
 * Lists every post (drafts included) from the live content collection with
 * filter/sort and per-row actions: edit, view, publish/unpublish, delete. Data
 * comes from the admin-gated GET /api/admin/posts; mutations hit /api/admin/post.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Posts — Studio" heading="Posts" active="posts">
  <section>
    <div class="page-head">
      <div>
        <h1>Posts</h1>
        <p class="sub" id="posts-sub">Everything you've written.</p>
      </div>
      <div class="head-actions">
        <a class="btn btn-primary" href="/admin/write">✍ New post</a>
      </div>
    </div>

    <div class="toolbar">
      <input class="input search" id="q" type="search" placeholder="Search posts…" autocomplete="off" />
      <select class="select" id="filter">
        <option value="all">All posts</option>
        <option value="published">Published</option>
        <option value="draft">Drafts</option>
        <option value="paid">Paywalled</option>
      </select>
      <select class="select" id="sort">
        <option value="new">Newest first</option>
        <option value="old">Oldest first</option>
        <option value="title">By title</option>
      </select>
      <span class="grow"></span>
      <button class="btn btn-sm btn-ghost" id="refresh" type="button">↻ Refresh</button>
    </div>

    <div id="posts-host">
      <div class="table-wrap"><div class="card-pad muted">Loading posts…</div></div>
    </div>
  </section>

  {/* Confirmation layer for emailing a post to subscribers. Emailing the whole
      list is high-stakes and irreversible, so it's gated behind this explicit
      confirm (with the recipient count) rather than a one-click action. */}
  <div id="email-modal" class="em-overlay" hidden>
    <div class="em-card" role="dialog" aria-modal="true" aria-label="Email subscribers">
      <h2 class="em-title">Email subscribers</h2>
      <p class="em-body" id="em-body"></p>
      <div class="em-actions">
        <button class="btn btn-ghost" id="em-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="em-send" type="button">Send email</button>
      </div>
      <p class="em-status" id="em-status"></p>
    </div>
  </div>
</AdminLayout>

<style>
  .em-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 60; padding: 1rem; }
  .em-overlay[hidden] { display: none; }
  .em-card { background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem 1.6rem; max-width: 440px; width: 100%; box-shadow: 0 24px 64px rgba(0,0,0,0.4); }
  .em-title { margin: 0 0 0.5rem; font-size: 1.15rem; letter-spacing: -0.01em; }
  .em-body { margin: 0 0 1.4rem; color: var(--muted); line-height: 1.6; }
  .em-body strong { color: var(--fg); }
  .em-actions { display: flex; justify-content: flex-end; gap: 0.5rem; }
  .em-status { margin: 0.85rem 0 0; font-size: 0.85rem; color: var(--muted); min-height: 1.1em; }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { whenAdmin, adminFetch } from '../../lib/admin-gate';
  import { fmtDate, esc } from '../../lib/admin-format';

  let all: any[] = [];
  let armedDelete: string | null = null;
  let armTimer: number | undefined;
  let confirmedCount: number | null = null; // confirmed subscribers, for the confirm copy
  let emailTarget: any = null;               // the post being emailed via the modal

  const host = document.getElementById('posts-host')!;
  const qEl = document.getElementById('q') as HTMLInputElement;
  const filterEl = document.getElementById('filter') as HTMLSelectElement;
  const sortEl = document.getElementById('sort') as HTMLSelectElement;
  const emModal = document.getElementById('email-modal')!;
  const emBody = document.getElementById('em-body')!;
  const emStatus = document.getElementById('em-status')!;
  const emSend = document.getElementById('em-send') as HTMLButtonElement;

  function view() {
    const q = qEl.value.trim().toLowerCase();
    const filter = filterEl.value;
    const sort = sortEl.value;
    let rows = all.slice();
    if (filter === 'published') rows = rows.filter((p) => !p.draft);
    else if (filter === 'draft') rows = rows.filter((p) => p.draft);
    else if (filter === 'paid') rows = rows.filter((p) => p.paid);
    if (q) rows = rows.filter((p) => (p.title || '').toLowerCase().includes(q) || (p.slug || '').includes(q));
    if (sort === 'title') rows.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
    else if (sort === 'old') rows.sort((a, b) => (a.pubDate || '').localeCompare(b.pubDate || ''));
    else rows.sort((a, b) => (b.pubDate || '').localeCompare(a.pubDate || ''));
    render(rows);
  }

  function stateBadges(p: any) {
    let b = p.draft ? '<span class="badge draft">Draft</span>' : '<span class="badge live">Live</span>';
    if (p.paid) b += ' <span class="badge paid">Paid</span>';
    return b;
  }

  // The paywall cell: a visual on/off switch; the price field appears only when on.
  // Drafts aren't public, so they can't be paywalled.
  function pwCell(p: any) {
    if (p.draft) return '<span class="muted" style="font-size:0.82rem">—</span>';
    const dollars = ((p.priceCents ?? 500) / 100).toFixed(2);
    return `<div class="pw-cell" data-gateable="${p.gateable ? '1' : '0'}">
        <label class="pw-toggle" title="${p.paid ? 'Paywalled' : 'Free'}">
          <input type="checkbox" data-pw ${p.paid ? 'checked' : ''} aria-label="Paywall">
          <span class="track"><span class="knob"></span></span>
        </label>
        <span class="pw-price"${p.paid ? '' : ' hidden'}>$<input class="input pw-price-in" type="number" min="0" step="0.50" value="${dollars}" aria-label="Price"></span>
      </div>`;
  }

  function render(rows: any[]) {
    document.getElementById('posts-sub')!.textContent =
      `${all.length} post${all.length === 1 ? '' : 's'}${rows.length !== all.length ? ` · ${rows.length} shown` : ''}`;
    if (!all.length) {
      host.innerHTML = '<div class="card"><div class="empty"><span class="emoji">✍️</span><h3>No posts yet</h3><p>Start writing — your first post publishes in seconds.</p><a class="btn btn-primary" href="/admin/write">Write your first post</a></div></div>';
      return;
    }
    if (!rows.length) {
      host.innerHTML = '<div class="card"><div class="empty"><span class="emoji">🔍</span><h3>No matches</h3><p>Try a different search or filter.</p></div></div>';
      return;
    }
    host.innerHTML = '<div class="table-wrap"><table class="table"><thead><tr>'
      + '<th>Title</th><th>Status</th><th>Paywall</th><th class="num">Actions</th></tr></thead><tbody>'
      + rows.map((p) => {
        const tags = (p.tags || []).length ? `<span class="t-sub">${(p.tags || []).map((t: string) => '#' + esc(t)).join(' ')}</span>` : '';
        const armed = armedDelete === p.slug;
        const viewBtn = p.draft ? '' : `<a class="btn btn-sm btn-ghost" href="/blog/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener">View</a>`;
        // Email-subscribers action: hidden for drafts (never announce a draft);
        // greyed-out "Emailed" once sent for that post; otherwise a click that
        // opens the confirm layer.
        const emailBtn = p.draft
          ? ''
          : p.emailed
            ? `<button class="btn btn-sm btn-ghost" disabled title="Already emailed${p.emailedAt ? ' · ' + esc(fmtDate(p.emailedAt)) : ''}">✓ Emailed</button>`
            : `<button class="btn btn-sm" data-act="email" data-slug="${esc(p.slug)}">✉ Email</button>`;
        const toggle = p.draft
          ? `<button class="btn btn-sm" data-act="publish" data-slug="${esc(p.slug)}">Publish</button>`
          : `<button class="btn btn-sm btn-ghost" data-act="unpublish" data-slug="${esc(p.slug)}">Unpublish</button>`;
        const del = `<button class="btn btn-sm ${armed ? 'btn-danger' : 'btn-ghost'}" data-act="delete" data-slug="${esc(p.slug)}">${armed ? 'Confirm delete' : 'Delete'}</button>`;
        return `<tr data-slug="${esc(p.slug)}">
            <td>
              <div class="t-title"><a href="/admin/write?slug=${encodeURIComponent(p.slug)}">${esc(p.title)}</a></div>
              <div class="t-sub">${esc(fmtDate(p.pubDate))}${tags ? ' · ' : ''}${tags}</div>
            </td>
            <td>${stateBadges(p)}</td>
            <td>${pwCell(p)}</td>
            <td class="num"><div class="row-actions">
              <a class="btn btn-sm btn-ghost" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Edit</a>
              ${viewBtn}${emailBtn}${toggle}${del}
            </div></td>
          </tr>`;
      }).join('')
      + '</tbody></table></div>';
  }

  async function load() {
    try {
      const r = await adminFetch('/api/admin/posts');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed to load');
      all = d.posts || [];
      view();
    } catch (e: any) {
      host.innerHTML = `<div class="card card-pad notice err">Couldn't load posts: ${esc(e.message || e)}</div>`;
    }
  }

  function disarm() {
    armedDelete = null;
    if (armTimer) clearTimeout(armTimer);
  }

  async function setDraft(slug: string, draft: boolean) {
    const r = await adminFetch('/api/admin/post', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug, draft }),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Action failed');
    await load();
  }

  async function del(slug: string) {
    const r = await adminFetch(`/api/admin/post?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Delete failed');
    disarm();
    await load();
  }

  host.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null;
    if (!btn) return;
    const act = btn.dataset.act!;
    const slug = btn.dataset.slug!;
    if (act === 'publish') setDraft(slug, false);
    else if (act === 'unpublish') setDraft(slug, true);
    else if (act === 'email') openEmail(slug);
    else if (act === 'delete') {
      if (armedDelete === slug) {
        del(slug);
      } else {
        disarm();
        armedDelete = slug;
        view(); // re-render so the button shows "Confirm delete"
        armTimer = window.setTimeout(() => { armedDelete = null; view(); }, 3500);
      }
    }
  });

  async function savePaywall(slug: string, wasGateable: boolean, on: boolean, dollars: number) {
    const price_cents = Math.max(0, Math.round((dollars || 0) * 100));
    // Two layers: frontmatter `gateable` (build-time body split, committed to git) is
    // touched only when the on/off state changes; then the live post_paywall row
    // (is_paid + price). No product id — enable/disable + price is all that's needed here.
    if (on !== wasGateable) {
      const cr = await adminFetch('/api/admin/post', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, gateable: on }),
      });
      if (!cr.ok) { const cj = await cr.json().catch(() => ({})); throw new Error(cj.error || 'Update failed'); }
    }
    const { error } = await supabase.from('post_paywall').upsert(
      { post_id: slug, is_paid: on, price_cents, currency: 'usd', updated_at: new Date().toISOString() },
      { onConflict: 'post_id' },
    );
    if (error) throw error;
  }

  // Paywall toggle / price edits (event-delegated on the table).
  host.addEventListener('change', async (e) => {
    const cell = (e.target as HTMLElement).closest('.pw-cell') as HTMLElement | null;
    if (!cell) return;
    const row = cell.closest('tr') as HTMLElement;
    const slug = row.dataset.slug!;
    const toggle = cell.querySelector('[data-pw]') as HTMLInputElement;
    const priceWrap = cell.querySelector('.pw-price') as HTMLElement;
    const priceIn = cell.querySelector('.pw-price-in') as HTMLInputElement;
    const on = toggle.checked;
    const wasGateable = cell.dataset.gateable === '1';
    const dollars = parseFloat(priceIn.value) || 5;
    priceWrap.hidden = !on;
    toggle.disabled = true;
    priceIn.disabled = true;
    const post = all.find((x) => x.slug === slug);
    try {
      await savePaywall(slug, wasGateable, on, dollars);
      cell.dataset.gateable = on ? '1' : '0';
      if (post) { post.paid = on; post.gateable = on; post.priceCents = Math.round(dollars * 100); }
      const statusTd = row.children[1] as HTMLElement; // reflect the Paid badge
      if (statusTd && post) statusTd.innerHTML = stateBadges(post);
    } catch (err: any) {
      alert(err.message || 'Paywall update failed');
      toggle.checked = !on; // revert
      priceWrap.hidden = !toggle.checked;
    } finally {
      toggle.disabled = false;
      priceIn.disabled = false;
    }
  });

  // --- Email a post to subscribers (confirm layer + send) ------------------
  // Read the confirmed count once so the confirmation can name exactly who'll be
  // reached. Best-effort: on failure we fall back to generic copy and let the
  // server (which re-checks the real list) be the source of truth on send.
  async function loadConfirmedCount() {
    try {
      const r = await adminFetch('/api/admin/subscribers?limit=1');
      const d = await r.json();
      confirmedCount = d && d.counts && typeof d.counts.confirmed === 'number' ? d.counts.confirmed : null;
    } catch {
      confirmedCount = null;
    }
  }

  function openEmail(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    emailTarget = p;
    emStatus.textContent = '';
    emSend.hidden = false;
    emSend.disabled = false;
    if (confirmedCount === 0) {
      emBody.innerHTML = 'You have no confirmed subscribers yet, so there’s no one to email.';
      emSend.disabled = true;
    } else {
      const who = confirmedCount == null
        ? 'your confirmed subscribers'
        : `${confirmedCount} confirmed subscriber${confirmedCount === 1 ? '' : 's'}`;
      emBody.innerHTML = `Send <strong>${esc(p.title)}</strong> to ${who}? They’ll get it in their inbox. This can’t be undone.`;
    }
    emModal.hidden = false;
  }

  function closeEmail() {
    emModal.hidden = true;
    emailTarget = null;
  }

  async function sendEmail() {
    if (!emailTarget) return;
    const p = emailTarget;
    emSend.disabled = true;
    emStatus.textContent = 'Sending…';
    try {
      const r = await adminFetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug: p.slug, title: p.title, description: p.description || '' }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok && (d.skipped === 'already-sent' || d.skipped === 'in-progress' || d.sent > 0)) {
        // Reached, already reached, or a send is mid-flight — grey the action out.
        p.emailed = true;
        p.emailedAt = new Date().toISOString();
        view();
        if (d.failed > 0) {
          emStatus.textContent = `Emailed ${d.sent}, but ${d.failed} couldn’t be delivered.`;
          emSend.hidden = true; // leave the result up; Cancel closes
        } else {
          closeEmail();
        }
      } else if (r.ok && d.ok) {
        emStatus.textContent = d.message || 'No confirmed subscribers to email yet.';
        emSend.disabled = false;
      } else {
        emStatus.textContent = d.error || 'Failed (HTTP ' + r.status + ')';
        emSend.disabled = false;
      }
    } catch (e: any) {
      emStatus.textContent = e.message || 'Something went wrong.';
      emSend.disabled = false;
    }
  }

  document.getElementById('em-cancel')!.addEventListener('click', closeEmail);
  emSend.addEventListener('click', sendEmail);
  emModal.addEventListener('click', (e) => { if (e.target === emModal) closeEmail(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !emModal.hidden) closeEmail(); });

  qEl.addEventListener('input', view);
  filterEl.addEventListener('change', view);
  sortEl.addEventListener('change', view);
  document.getElementById('refresh')!.addEventListener('click', load);

  whenAdmin.then(() => { load(); loadConfirmedCount(); });
</script>
