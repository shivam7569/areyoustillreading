---
/**
 * /admin/posts — the unified Posts manager (Studio "Posts" view).
 * Lists every post (drafts included) from the live content collection as a
 * design-matched analytics table: filter tabs + search, a paywall summary panel,
 * and a row per post showing Status / Access / Published / Reads / Completion /
 * Upgrades / Revenue. The Access chip and a per-row ⋯ menu host every mutation
 * (publish/unpublish, paywall + price, series, email/retry, early access, delete).
 *
 * Data: GET /api/admin/posts (catalog + paywall state), enriched client-side with
 * GET /api/admin/analytics?range=all (Reads/Completion) and GET /api/admin/sales
 * (Upgrades/Revenue). Metrics with no source render "—" — never a fabricated 0.
 * Mutations hit /api/admin/post, /api/admin/broadcast, /api/admin/early, and a
 * direct post_paywall upsert (price). All endpoints independently requireAdmin().
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Posts — Studio" heading="Posts" active="posts">
  <div class="stack">
    {/* Control row: filter tabs (counts filled client-side), search, New post. */}
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <div class="tabs" id="tabs">
        <button class="on" type="button" data-filter="all">All<span class="n" data-ct="all">—</span></button>
        <button type="button" data-filter="published">Published<span class="n" data-ct="published">—</span></button>
        <button type="button" data-filter="draft">Drafts<span class="n" data-ct="draft">—</span></button>
        <button type="button" data-filter="scheduled">Scheduled<span class="n" data-ct="scheduled">—</span></button>
        <button type="button" data-filter="free">Free<span class="n" data-ct="free">—</span></button>
        <button type="button" data-filter="paid">Paywalled<span class="n" data-ct="paid">—</span></button>
      </div>
      <div class="search" style="margin-left:auto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" id="q" placeholder="Search posts" aria-label="Search posts" autocomplete="off" />
      </div>
      <a class="btn btn-primary btn-sm" href="/admin/write">New post</a>
    </div>

    {/* Paywall summary — live counts + real (estimated) upgrades & revenue. */}
    <div class="panel">
      <header><h2>Paywall</h2><span class="hint">Where free readers stop, and what that earns</span></header>
      <div class="pb flush">
        <div class="pwgrid">
          <div><div class="l">Free to read</div><div class="v" id="pw-free">—</div><div class="d">Public, no wall</div></div>
          <div><div class="l">Paywalled</div><div class="v" id="pw-paid">—</div><div class="d">Readers hit the wall</div></div>
          <div><div class="l">Upgrades</div><div class="v" id="pw-upgrades">—</div><div class="d">Unlocks to date</div></div>
          <div><div class="l">Revenue</div><div class="v" id="pw-rev">—</div><div class="d">Estimated · price × unlocks</div></div>
        </div>
      </div>
    </div>

    {/* The posts table. tbody#posts-host is filled by render(). */}
    <div class="panel">
      <div class="pb flush">
        <div class="t-scroll">
          <table class="t">
            <thead><tr>
              <th>Post</th><th>Status</th><th>Access</th>
              <th class="num">Published</th><th class="num">Reads</th><th class="num">Completion</th>
              <th class="num">Upgrades</th><th class="num">Revenue</th><th></th>
            </tr></thead>
            <tbody id="posts-host"><tr><td colspan="9" class="empty-cell">Loading posts…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  {/* Series membership editor (R5): set a post's series name + part, or remove it.
      Writes series/seriesTitle/seriesOrder frontmatter via /api/admin/post. */}
  <div id="series-modal" class="em-overlay" hidden>
    <div class="em-card" role="dialog" aria-modal="true" aria-label="Series membership">
      <h2 class="em-title">Series</h2>
      <p class="em-body" id="sr-body"></p>
      <div class="sr-fields">
        <label class="sr-field"><span>Series name</span><input class="input" id="sr-name" type="text" placeholder="e.g. LLMs from scratch" autocomplete="off" list="sr-name-options" /><datalist id="sr-name-options"></datalist></label>
        <label class="sr-field sr-part"><span>Part</span><input class="input" id="sr-order" type="number" min="1" step="1" placeholder="1" /></label>
      </div>
      <div class="em-actions">
        <button class="btn btn-ghost" id="sr-remove" type="button">Remove from series</button>
        <span class="grow"></span>
        <button class="btn btn-ghost" id="sr-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="sr-save" type="button">Save</button>
      </div>
      <p class="em-status" id="sr-status"></p>
    </div>
  </div>

  {/* Confirmation layer for emailing a post to subscribers. Emailing the whole
      list is high-stakes and irreversible, so it's gated behind this explicit
      confirm (with the recipient count) rather than a one-click action. */}
  <div id="email-modal" class="em-overlay" hidden>
    <div class="em-card" role="dialog" aria-modal="true" aria-label="Email subscribers">
      <h2 class="em-title">Email subscribers</h2>
      <p class="em-body" id="em-body"></p>
      <div class="em-actions">
        <button class="btn btn-ghost" id="em-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="em-send" type="button">Send email</button>
      </div>
      <p class="em-status" id="em-status"></p>
    </div>
  </div>
</AdminLayout>

<style is:global>
  /* is:global because render()/popovers inject DOM at runtime — Astro-scoped rules
     only match statically-rendered elements, so these must not be scoped. This
     stylesheet is only served on /admin/posts, so global here is page-local anyway. */
  .em-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 60; padding: 1rem; }
  .em-overlay[hidden] { display: none; }
  .em-card { background: var(--card); color: var(--fg); border: 1px solid var(--border-strong); border-radius: var(--admin-radius); padding: 1.5rem 1.6rem; max-width: 440px; width: 100%; box-shadow: 0 24px 64px rgba(0,0,0,0.4); }
  .em-title { margin: 0 0 0.5rem; font-size: 1.15rem; letter-spacing: -0.01em; }
  .em-body { margin: 0 0 1.4rem; color: var(--muted); line-height: 1.6; }
  .em-body strong { color: var(--fg); }
  .em-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; }
  .em-actions .grow { flex: 1; }
  .em-status { margin: 0.85rem 0 0; font-size: 0.85rem; color: var(--muted); min-height: 1.1em; }
  .sr-fields { display: flex; gap: 0.75rem; margin: 0 0 1.3rem; }
  .sr-field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1; font-size: 0.8rem; color: var(--muted); }
  .sr-field.sr-part { flex: 0 0 84px; }
  .sr-field .input { width: 100%; }

  /* The 9-column table can exceed the panel on narrow screens; scroll it inside
     the panel (which is overflow:hidden for its rounded corners) rather than clip. */
  .t-scroll { overflow-x: auto; }
  /* Table title as an edit link, kept visually identical to the design's .ti span. */
  table.t a.ti { text-decoration: none; }
  table.t a.ti:hover { text-decoration: underline; }
  table.t .acc { white-space: nowrap; }   /* keep "Paid · $3.00" on one line */
  table.t td.pub-empty { color: var(--ink-faint); }
  .empty-cell { text-align: center; color: var(--ink-faint); padding: 34px 15px !important; }
  .empty-cell a { color: var(--accent); }

  /* Per-row actions trigger (⋯). The design's only inline control is the Access
     chip; the page owns six mutations, so they live behind this menu. */
  .rowmenu { border: 0; background: transparent; color: var(--ink-faint); cursor: pointer; font-size: 19px; line-height: 1; padding: 2px 7px; border-radius: var(--admin-radius-sm); }
  .rowmenu:hover { background: var(--admin-hover); color: var(--ink); }

  /* Floating popovers: the Access editor + the row actions menu (fixed-positioned
     off the trigger in JS, so table overflow never clips them). */
  .acc-pop, .row-menu { min-width: 194px; background: var(--card); border: 1px solid var(--rule); border-radius: var(--admin-radius-sm); box-shadow: 0 16px 44px color-mix(in srgb, var(--ink) 22%, transparent); padding: 6px; }
  .row-menu a, .row-menu button { display: flex; width: 100%; align-items: center; gap: 8px; padding: 8px 10px; border: 0; background: transparent; border-radius: 5px; font: inherit; font-size: 13px; color: var(--ink-soft); cursor: pointer; text-decoration: none; text-align: left; }
  .row-menu a:hover, .row-menu button:hover { background: var(--admin-hover); color: var(--ink); }
  .row-menu button:disabled { opacity: 0.5; cursor: default; }
  .row-menu button.danger, .row-menu button.armed { color: var(--danger); }
  .row-menu hr { border: 0; border-top: 1px solid var(--rule-soft); margin: 5px 4px; }
  .acc-pop .pop-hd { font-size: 10.5px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-faint); padding: 4px 8px 6px; }
  .acc-pop .pop-opt { display: block; width: 100%; text-align: left; padding: 8px 10px; border: 1px solid transparent; border-radius: 6px; background: transparent; font: inherit; font-size: 13px; color: var(--ink-soft); cursor: pointer; }
  .acc-pop .pop-opt:hover { background: var(--admin-hover); }
  .acc-pop .pop-opt.on { border-color: var(--accent); color: var(--ink); }
  .acc-pop .pop-opt small { display: block; font-size: 11px; color: var(--ink-faint); margin-top: 1px; }
  .acc-pop .price-row { display: flex; align-items: center; gap: 6px; padding: 8px; }
  .acc-pop .price-row input { width: 82px; }
  .acc-pop .pop-status { margin: 3px 8px 2px; font-size: 12px; color: var(--ink-faint); min-height: 1em; }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { onAdminReady, adminFetch, swrFetch } from '../../lib/admin-gate';
  import { fmtDate, esc } from '../../lib/admin-format';

  let all: any[] = [];
  let armedDelete: string | null = null;
  let armTimer: number | undefined;
  let confirmedCount: number | null = null; // confirmed subscribers, for the confirm copy
  let emailTarget: any = null;               // the post being emailed via the modal
  let currentFilter = 'all';

  // Per-post analytics/sales, merged by slug after the catalog paints. Any slug
  // absent here renders "—" (never a fabricated 0 — see loadMetrics()).
  let metricsBySlug: Record<string, any> = {};
  let salesTotalCents: number | null = null;
  let upgradesTotal: number | null = null;

  const host = document.getElementById('posts-host')!;   // <tbody>
  const qEl = document.getElementById('q') as HTMLInputElement;
  const tabsEl = document.getElementById('tabs')!;
  const emModal = document.getElementById('email-modal')!;
  const emBody = document.getElementById('em-body')!;
  const emStatus = document.getElementById('em-status')!;
  const emSend = document.getElementById('em-send') as HTMLButtonElement;

  // Series membership editor (R5).
  const srModal = document.getElementById('series-modal')!;
  const srBody = document.getElementById('sr-body')!;
  const srName = document.getElementById('sr-name') as HTMLInputElement;
  const srNameList = document.getElementById('sr-name-options') as HTMLDataListElement;
  const srOrder = document.getElementById('sr-order') as HTMLInputElement;
  const srStatus = document.getElementById('sr-status')!;
  const srSave = document.getElementById('sr-save') as HTMLButtonElement;
  const srRemove = document.getElementById('sr-remove') as HTMLButtonElement;
  let seriesTarget: any = null;

  const chev = '<svg class="cv" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>';
  // Scheduled = a hidden draft with a publishAt still in the future (the cron flips
  // it live at that time). Distinct from a plain draft in the tabs + status pill.
  const isSched = (p: any) => !!(p.draft && p.publishAt && new Date(p.publishAt).getTime() > Date.now());
  const setText = (id: string, v: any) => { const e = document.getElementById(id); if (e) e.textContent = String(v); };

  function paintCounts() {
    const c: Record<string, number> = {
      all: all.length,
      published: all.filter((p) => !p.draft).length,
      draft: all.filter((p) => p.draft && !isSched(p)).length,
      scheduled: all.filter(isSched).length,
      free: all.filter((p) => !p.paid).length,
      paid: all.filter((p) => p.paid).length,
    };
    for (const k in c) { const el = document.querySelector(`[data-ct="${k}"]`); if (el) el.textContent = String(c[k]); }
    setText('pw-free', c.free);
    setText('pw-paid', c.paid);
    if (upgradesTotal != null) setText('pw-upgrades', upgradesTotal.toLocaleString());
    if (salesTotalCents != null) setText('pw-rev', '~$' + Math.round(salesTotalCents / 100).toLocaleString());
  }

  function view() {
    const q = qEl.value.trim().toLowerCase();
    let rows = all.slice();
    const f = currentFilter;
    if (f === 'published') rows = rows.filter((p) => !p.draft);
    else if (f === 'draft') rows = rows.filter((p) => p.draft && !isSched(p));
    else if (f === 'scheduled') rows = rows.filter(isSched);
    else if (f === 'free') rows = rows.filter((p) => !p.paid);
    else if (f === 'paid') rows = rows.filter((p) => p.paid);
    if (q) rows = rows.filter((p) => (p.title || '').toLowerCase().includes(q) || (p.slug || '').includes(q));
    rows.sort((a, b) => (b.pubDate || '').localeCompare(a.pubDate || ''));
    render(rows);
    paintCounts();
  }

  function statusPill(p: any) {
    if (!p.draft) return '<span class="pill live">Live</span>';
    if (isSched(p)) return '<span class="pill sched">Scheduled</span>';
    return '<span class="pill">Draft</span>';
  }

  function accessChip(p: any) {
    if (p.paid) {
      const price = ((p.priceCents ?? 500) / 100).toFixed(2);
      return `<button class="acc paid" data-access="${esc(p.slug)}">Paid · $${price} ${chev}</button>`;
    }
    return `<button class="acc" data-access="${esc(p.slug)}">Free ${chev}</button>`;
  }

  function subline(p: any) {
    if (p.series || p.seriesTitle) {
      const nm = esc(p.seriesTitle || p.series);
      return p.seriesOrder ? `${nm} · part ${p.seriesOrder}` : nm;
    }
    return 'No series';
  }

  function metricCells(p: any) {
    const m = metricsBySlug[p.slug] || {};
    const reads = typeof m.views === 'number' ? m.views.toLocaleString() : '—';
    const comp = typeof m.pct === 'number' ? m.pct + '%' : '—';
    const upg = typeof m.upg === 'number' ? String(m.upg) : '—';
    const rev = typeof m.cents === 'number' ? '~$' + Math.round(m.cents / 100).toLocaleString() : '—';
    return `<td class="num">${reads}</td><td class="num">${comp}</td><td class="num">${upg}</td><td class="num">${rev}</td>`;
  }

  function render(rows: any[]) {
    if (!all.length) {
      host.innerHTML = '<tr><td colspan="9" class="empty-cell">No posts yet. <a href="/admin/write">Write your first →</a></td></tr>';
      return;
    }
    if (!rows.length) {
      host.innerHTML = '<tr><td colspan="9" class="empty-cell">No posts match this filter.</td></tr>';
      return;
    }
    host.innerHTML = rows.map((p) => {
      const pub = !p.draft
        ? `<td class="num">${esc(fmtDate(p.pubDate))}</td>`
        : isSched(p)
          ? `<td class="num">${esc(fmtDate(p.publishAt))}</td>`
          : '<td class="num pub-empty">—</td>';
      return `<tr data-slug="${esc(p.slug)}">
          <td><a class="ti" href="/admin/write?slug=${encodeURIComponent(p.slug)}">${esc(p.title)}</a><span class="sub">${subline(p)}</span></td>
          <td>${statusPill(p)}</td>
          <td>${accessChip(p)}</td>
          ${pub}
          ${metricCells(p)}
          <td class="num"><button class="rowmenu" data-menu="${esc(p.slug)}" aria-label="Actions for ${esc(p.title)}" aria-haspopup="menu">⋯</button></td>
        </tr>`;
    }).join('');
  }

  function load() {
    // Stale-while-revalidate: paints the last-seen catalog instantly, then refreshes.
    return swrFetch('/api/admin/posts', (d: any) => {
      if (d && d.__error) { host.innerHTML = `<tr><td colspan="9" class="empty-cell" style="color:var(--danger)">Couldn't load posts: ${esc(d.error || ('HTTP ' + d.status))}</td></tr>`; return; }
      all = d.posts || [];
      view();          // paint from catalog immediately (metric columns show "—")
      loadMetrics();   // then enrich Reads/Completion/Upgrades/Revenue
    });
  }

  // Merge analytics (Reads/Completion, top-12 by views) + sales (Upgrades/Revenue).
  // NEVER invents a value: a slug missing from either source keeps "—". Revenue is
  // an estimate (entitlements store no per-sale amount) — always prefixed "~".
  async function loadMetrics() {
    const [a, s] = await Promise.all([
      adminFetch('/api/admin/analytics?range=all').then((r) => r.json()).catch(() => null),
      adminFetch('/api/admin/sales').then((r) => r.json()).catch(() => null),
    ]);
    const m: Record<string, any> = {};
    if (a && a.configured && Array.isArray(a.topPosts)) {
      for (const t of a.topPosts) m[t.slug] = { views: t.views, pct: typeof t.avgReadPct === 'number' ? t.avgReadPct : null };
    }
    if (s && Array.isArray(s.byPost)) {
      for (const b of s.byPost) { if (!m[b.post_id]) m[b.post_id] = {}; m[b.post_id].upg = b.count; m[b.post_id].cents = b.cents; }
    }
    metricsBySlug = m;
    salesTotalCents = s && typeof s.totalCents === 'number' ? s.totalCents : null;
    upgradesTotal = a && a.conversion && typeof a.conversion.unlocks === 'number'
      ? a.conversion.unlocks
      : (s && Array.isArray(s.byPost) ? s.byPost.reduce((n: number, b: any) => n + (b.count || 0), 0) : null);
    view(); // repaint with metrics
  }

  function disarm() {
    armedDelete = null;
    if (armTimer) clearTimeout(armTimer);
  }

  async function setDraft(slug: string, draft: boolean) {
    const r = await adminFetch('/api/admin/post', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug, draft }),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Action failed');
    await load();
  }

  async function del(slug: string) {
    const r = await adminFetch(`/api/admin/post?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Delete failed');
    disarm();
    await load();
  }

  async function savePaywall(slug: string, wasGateable: boolean, on: boolean, dollars: number) {
    const price_cents = Math.max(0, Math.round((dollars || 0) * 100));
    // Two layers: frontmatter `gateable` (build-time body split, committed to git) is
    // touched only when the on/off state changes; then the live post_paywall row
    // (is_paid + price). No product id — enable/disable + price is all that's needed here.
    if (on !== wasGateable) {
      const cr = await adminFetch('/api/admin/post', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, gateable: on }),
      });
      if (!cr.ok) { const cj = await cr.json().catch(() => ({})); throw new Error(cj.error || 'Update failed'); }
    }
    const { error } = await supabase.from('post_paywall').upsert(
      { post_id: slug, is_paid: on, price_cents, currency: 'usd', updated_at: new Date().toISOString() },
      { onConflict: 'post_id' },
    );
    if (error) throw error;
  }

  // ---- Floating popover plumbing (one open at a time) ---------------------
  // Fixed-positioned off the trigger so the table's overflow never clips it.
  let floatEl: HTMLElement | null = null;
  let floatTrigger: HTMLElement | null = null;
  function closeFloat() {
    if (!floatEl) return;
    floatEl.remove();
    floatEl = null;
    floatTrigger = null;
    document.removeEventListener('click', onDocClick, true);
    document.removeEventListener('keydown', onFloatKey, true);
    window.removeEventListener('resize', closeFloat);
    document.querySelector('.admin-main')?.removeEventListener('scroll', closeFloat, true);
    window.removeEventListener('scroll', closeFloat, true);
  }
  function onDocClick(e: Event) {
    const t = e.target as Node;
    if (floatEl && !floatEl.contains(t) && floatTrigger && !floatTrigger.contains(t)) closeFloat();
  }
  function onFloatKey(e: KeyboardEvent) { if (e.key === 'Escape') closeFloat(); }
  function openFloat(trigger: HTMLElement, cls: string, htmlStr: string) {
    closeFloat();
    const el = document.createElement('div');
    el.className = cls;
    el.setAttribute('role', 'menu');
    el.style.position = 'fixed';
    el.style.zIndex = '70';
    el.innerHTML = htmlStr;
    document.body.appendChild(el);
    const r = trigger.getBoundingClientRect();
    const w = el.offsetWidth, h = el.offsetHeight;
    let left = Math.min(r.left, window.innerWidth - 8 - w);
    if (left < 8) left = 8;
    let top = r.bottom + 6;
    if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - 6 - h); // flip up if no room
    el.style.left = left + 'px';
    el.style.top = top + 'px';
    floatEl = el;
    floatTrigger = trigger;
    // Defer listener attach so the opening click doesn't immediately close it.
    setTimeout(() => {
      document.addEventListener('click', onDocClick, true);
      document.addEventListener('keydown', onFloatKey, true);
      window.addEventListener('resize', closeFloat);
      window.addEventListener('scroll', closeFloat, true);
    }, 0);
    return el;
  }

  // ---- Access editor popover (Free / Paid + price) ------------------------
  function openAccess(trigger: HTMLElement, slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    const paid = !!p.paid;
    const dollars = ((p.priceCents ?? 500) / 100).toFixed(2);
    const el = openFloat(trigger, 'acc-pop', `
      <div class="pop-hd">Who can read this</div>
      <button type="button" class="pop-opt${paid ? '' : ' on'}" data-opt="free">Free<small>Anyone, no wall</small></button>
      <button type="button" class="pop-opt${paid ? ' on' : ''}" data-opt="paid">Paid<small>Readers pay what they want to unlock</small></button>
      <div class="price-row"${paid ? '' : ' hidden'}><span>$</span><input class="input" type="number" min="0" step="0.50" value="${dollars}" aria-label="Suggested price"><button type="button" class="btn btn-sm btn-primary" data-save>Save</button></div>
      <p class="pop-status" hidden></p>`);
    const opts = el.querySelectorAll('.pop-opt');
    const priceRow = el.querySelector('.price-row') as HTMLElement;
    const status = el.querySelector('.pop-status') as HTMLElement;
    const saveBtn = el.querySelector('[data-save]') as HTMLButtonElement;
    opts.forEach((o) => o.addEventListener('click', () => {
      opts.forEach((x) => x.classList.toggle('on', x === o));
      priceRow.hidden = (o as HTMLElement).dataset.opt !== 'paid';
    }));
    saveBtn.addEventListener('click', async () => {
      const on = (el.querySelector('.pop-opt.on') as HTMLElement | null)?.dataset.opt === 'paid';
      const dollars2 = parseFloat((el.querySelector('.price-row input') as HTMLInputElement).value) || 5;
      const wasGateable = !!p.gateable;
      saveBtn.disabled = true; status.hidden = false; status.textContent = 'Saving…';
      try {
        await savePaywall(slug, wasGateable, on, dollars2);
        p.paid = on; p.gateable = on; p.priceCents = Math.round(dollars2 * 100);
        closeFloat();
        view();
      } catch (err: any) { status.textContent = err.message || 'Failed'; saveBtn.disabled = false; }
    });
  }

  // ---- Per-row actions menu (⋯) -------------------------------------------
  function openMenu(trigger: HTMLElement, slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    const items: string[] = [];
    items.push(`<a href="/admin/write?slug=${encodeURIComponent(p.slug)}">Edit</a>`);
    if (!p.draft) items.push(`<a href="/blog/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener">View live ↗</a>`);
    items.push('<hr>');
    items.push(`<button type="button" data-m="vis">${p.draft ? 'Publish now' : 'Unpublish (hide)'}</button>`);
    items.push(`<button type="button" data-m="series">${p.series ? 'Edit series' : 'Add to series'}</button>`);
    if (!p.draft) {
      if (p.emailed) {
        if (p.emailedFailed > 0) items.push(`<button type="button" data-m="retry">Retry ${p.emailedFailed} failed</button>`);
        else items.push(`<button type="button" disabled title="${p.emailedAt ? 'Emailed · ' + esc(fmtDate(p.emailedAt)) : 'Already emailed'}">✓ Emailed</button>`);
      } else items.push('<button type="button" data-m="email">Email subscribers</button>');
    } else {
      items.push('<button type="button" data-m="early">Email early access</button>');
    }
    items.push('<hr>');
    items.push('<button type="button" class="danger" data-m="delete">Delete</button>');
    const el = openFloat(trigger, 'row-menu', items.join(''));
    el.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-m]') as HTMLElement | null;
      if (!b) return;
      const m = b.dataset.m!;
      if (m === 'delete') {
        if (b.dataset.armed === '1') { closeFloat(); del(slug); return; }
        b.dataset.armed = '1'; b.textContent = 'Confirm delete'; b.classList.add('armed');
        return;
      }
      closeFloat();
      if (m === 'vis') setDraft(slug, !p.draft);
      else if (m === 'series') openSeries(slug);
      else if (m === 'email') openEmail(slug);
      else if (m === 'retry') retryEmail(slug);
      else if (m === 'early') sendEarly(slug);
    });
  }

  // Row-level click delegation: Access chip + ⋯ menu are the only inline controls.
  host.addEventListener('click', (e) => {
    const acc = (e.target as HTMLElement).closest('[data-access]') as HTMLElement | null;
    if (acc) { e.stopPropagation(); openAccess(acc, acc.dataset.access!); return; }
    const menu = (e.target as HTMLElement).closest('[data-menu]') as HTMLElement | null;
    if (menu) { e.stopPropagation(); openMenu(menu, menu.dataset.menu!); return; }
  });

  // --- Email a post to subscribers (confirm layer + send) ------------------
  async function loadConfirmedCount() {
    try {
      const r = await adminFetch('/api/admin/subscribers?limit=1');
      const d = await r.json();
      confirmedCount = d && d.counts && typeof d.counts.confirmed === 'number' ? d.counts.confirmed : null;
    } catch {
      confirmedCount = null;
    }
  }

  function openEmail(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    emailTarget = p;
    emStatus.textContent = '';
    emSend.hidden = false;
    emSend.disabled = false;
    if (confirmedCount === 0) {
      emBody.innerHTML = 'You have no confirmed subscribers yet, so there’s no one to email.';
      emSend.disabled = true;
    } else {
      const who = confirmedCount == null
        ? 'your confirmed subscribers'
        : `${confirmedCount} confirmed subscriber${confirmedCount === 1 ? '' : 's'}`;
      emBody.innerHTML = `Send <strong>${esc(p.title)}</strong> to ${who}? They’ll get it in their inbox. This can’t be undone.`;
    }
    emModal.hidden = false;
  }

  function closeEmail() {
    emModal.hidden = true;
    emailTarget = null;
  }

  async function sendEmail() {
    if (!emailTarget) return;
    const p = emailTarget;
    emSend.disabled = true;
    emStatus.textContent = 'Sending…';
    try {
      const r = await adminFetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug: p.slug, title: p.title, description: p.description || '' }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok && (d.skipped === 'already-sent' || d.skipped === 'in-progress' || d.sent > 0)) {
        p.emailed = true;
        p.emailedAt = new Date().toISOString();
        view();
        if (d.failed > 0) {
          emStatus.textContent = `Emailed ${d.sent}, but ${d.failed} couldn’t be delivered.`;
          emSend.hidden = true;
        } else {
          closeEmail();
        }
      } else if (r.ok && d.ok) {
        emStatus.textContent = d.message || 'No confirmed subscribers to email yet.';
        emSend.disabled = false;
      } else {
        emStatus.textContent = d.error || 'Failed (HTTP ' + r.status + ')';
        emSend.disabled = false;
      }
    } catch (e: any) {
      emStatus.textContent = e.message || 'Something went wrong.';
      emSend.disabled = false;
    }
  }

  async function retryEmail(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    if (!confirm(`Retry sending “${p.title}” to the ${p.emailedFailed} subscriber(s) it couldn't reach?`)) return;
    try {
      const r = await adminFetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, title: p.title, description: p.description || '', retry: true }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok) {
        alert(d.remaining > 0 ? `Retried — ${d.sent} delivered, ${d.remaining} still failing.` : `Retried — all delivered.`);
      } else {
        alert(d.error || 'Retry failed');
      }
    } catch (e: any) {
      alert(e.message || 'Retry failed');
    }
    await load();
  }

  // Early access (drafts only): email confirmed subscribers a private tokenized link
  // to read the hidden draft. The post stays out of the public /blog until published.
  async function sendEarly(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    if (!confirm(`Email confirmed subscribers a private early-access link to “${p.title}”?\n\nThe post stays hidden from the public until you publish it.`)) return;
    try {
      const r = await adminFetch('/api/admin/early', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, title: p.title, description: p.description || '' }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok) {
        alert(d.sent > 0
          ? `Early-access link emailed to ${d.sent} subscriber(s).`
          : (d.message || 'Link created.') + (d.url ? '\n\n' + d.url : ''));
      } else {
        alert(d.error || 'Failed to send early access');
      }
    } catch (e: any) {
      alert(e.message || 'Failed to send early access');
    }
  }

  document.getElementById('em-cancel')!.addEventListener('click', closeEmail);
  emSend.addEventListener('click', sendEmail);
  emModal.addEventListener('click', (e) => { if (e.target === emModal) closeEmail(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !emModal.hidden) closeEmail(); });

  // --- Series membership (add / edit / remove) -----------------------------
  function fillSeriesOptions() {
    const seen = new Set<string>();
    const names: string[] = [];
    for (const p of all) {
      const name = String(p.seriesTitle || p.series || '').trim();
      if (!name) continue;
      const key = String(p.series || name).toLowerCase();
      if (seen.has(key)) continue;
      seen.add(key);
      names.push(name);
    }
    names.sort((a, b) => a.localeCompare(b));
    srNameList.innerHTML = names.map((n) => `<option value="${esc(n)}"></option>`).join('');
  }

  function openSeries(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    seriesTarget = p;
    srBody.innerHTML = `Group <strong>${esc(p.title)}</strong> into a series. Posts that share a series appear together on the Series page, ordered by part.`;
    srName.value = p.seriesTitle || p.series || '';
    srOrder.value = p.seriesOrder ? String(p.seriesOrder) : '';
    srStatus.textContent = '';
    srSave.disabled = false;
    srRemove.disabled = false;
    srRemove.hidden = !p.series;
    fillSeriesOptions();
    srModal.hidden = false;
    srName.focus();
  }
  function closeSeries() {
    srModal.hidden = true;
    seriesTarget = null;
  }
  async function saveSeries(remove: boolean) {
    if (!seriesTarget) return;
    const slug = seriesTarget.slug;
    let payload: any;
    if (remove) {
      payload = { slug, series: null };
    } else {
      const title = srName.value.trim();
      if (!title) { srStatus.textContent = 'Enter a series name, or remove it.'; return; }
      const order = parseInt(srOrder.value, 10);
      payload = { slug, series: { title, order: Number.isFinite(order) && order > 0 ? order : null } };
    }
    srSave.disabled = true;
    srRemove.disabled = true;
    srStatus.textContent = 'Saving…';
    try {
      const r = await adminFetch('/api/admin/post', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || 'Save failed');
      closeSeries();
      await load();
    } catch (e: any) {
      srStatus.textContent = e.message || 'Save failed';
      srSave.disabled = false;
      srRemove.disabled = false;
    }
  }
  document.getElementById('sr-cancel')!.addEventListener('click', closeSeries);
  srSave.addEventListener('click', () => saveSeries(false));
  srRemove.addEventListener('click', () => saveSeries(true));
  srModal.addEventListener('click', (e) => { if (e.target === srModal) closeSeries(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !srModal.hidden) closeSeries(); });

  // Toolbar: search + filter tabs.
  qEl.addEventListener('input', view);
  tabsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-filter]') as HTMLElement | null;
    if (!b) return;
    currentFilter = b.dataset.filter!;
    tabsEl.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    view();
  });

  onAdminReady(() => { load(); loadConfirmedCount(); });
</script>
