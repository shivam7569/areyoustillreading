---
/**
 * /admin/posts — the unified Posts manager.
 * Lists every post (drafts included) from the live content collection with
 * filter/sort and per-row actions: edit, view, publish/unpublish, delete. Data
 * comes from the admin-gated GET /api/admin/posts; mutations hit /api/admin/post.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Posts — Studio" heading="Posts" active="posts">
  <section>
    <div class="page-head">
      <div>
        <h1>Posts</h1>
        <p class="sub" id="posts-sub">Everything you've written.</p>
      </div>
      <div class="head-actions">
        <a class="btn btn-primary" href="/admin/write"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> New post</a>
      </div>
    </div>

    <div class="toolbar">
      <input class="input search" id="q" type="search" placeholder="Search posts…" autocomplete="off" />
      <select class="select" id="filter">
        <option value="all">All posts</option>
        <option value="published">Published</option>
        <option value="draft">Drafts</option>
        <option value="paid">Paywalled</option>
      </select>
      <select class="select" id="sort">
        <option value="new">Newest first</option>
        <option value="old">Oldest first</option>
        <option value="title">By title</option>
      </select>
      <span class="grow"></span>
      <button class="btn btn-sm btn-ghost" id="refresh" type="button">↻ Refresh</button>
    </div>

    <div id="posts-host">
      <div class="table-wrap"><div class="card-pad muted">Loading posts…</div></div>
    </div>
  </section>

  {/* Series membership editor (R5): set a post's series name + part, or remove it.
      Writes series/seriesTitle/seriesOrder frontmatter via /api/admin/post. */}
  <div id="series-modal" class="em-overlay" hidden>
    <div class="em-card" role="dialog" aria-modal="true" aria-label="Series membership">
      <h2 class="em-title">Series</h2>
      <p class="em-body" id="sr-body"></p>
      <div class="sr-fields">
        <label class="sr-field"><span>Series name</span><input class="input" id="sr-name" type="text" placeholder="e.g. LLMs from scratch" autocomplete="off" list="sr-name-options" /><datalist id="sr-name-options"></datalist></label>
        <label class="sr-field sr-part"><span>Part</span><input class="input" id="sr-order" type="number" min="1" step="1" placeholder="1" /></label>
      </div>
      <div class="em-actions">
        <button class="btn btn-ghost" id="sr-remove" type="button">Remove from series</button>
        <span class="grow"></span>
        <button class="btn btn-ghost" id="sr-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="sr-save" type="button">Save</button>
      </div>
      <p class="em-status" id="sr-status"></p>
    </div>
  </div>

  {/* Confirmation layer for emailing a post to subscribers. Emailing the whole
      list is high-stakes and irreversible, so it's gated behind this explicit
      confirm (with the recipient count) rather than a one-click action. */}
  <div id="email-modal" class="em-overlay" hidden>
    <div class="em-card" role="dialog" aria-modal="true" aria-label="Email subscribers">
      <h2 class="em-title">Email subscribers</h2>
      <p class="em-body" id="em-body"></p>
      <div class="em-actions">
        <button class="btn btn-ghost" id="em-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="em-send" type="button">Send email</button>
      </div>
      <p class="em-status" id="em-status"></p>
    </div>
  </div>
</AdminLayout>

<style>
  .em-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 60; padding: 1rem; }
  .em-overlay[hidden] { display: none; }
  .em-card { background: var(--card); color: var(--fg); border: 1px solid var(--border-strong); border-radius: var(--admin-radius); padding: 1.5rem 1.6rem; max-width: 440px; width: 100%; box-shadow: 0 24px 64px rgba(0,0,0,0.4); }
  .em-title { margin: 0 0 0.5rem; font-size: 1.15rem; letter-spacing: -0.01em; }
  .em-body { margin: 0 0 1.4rem; color: var(--muted); line-height: 1.6; }
  .em-body strong { color: var(--fg); }
  .em-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; }
  .em-actions .grow { flex: 1; }
  .em-status { margin: 0.85rem 0 0; font-size: 0.85rem; color: var(--muted); min-height: 1.1em; }
  .sr-fields { display: flex; gap: 0.75rem; margin: 0 0 1.3rem; }
  .sr-field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1; font-size: 0.8rem; color: var(--muted); }
  .sr-field.sr-part { flex: 0 0 84px; }
  .sr-field .input { width: 100%; }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';
  import { fmtDate, esc } from '../../lib/admin-format';

  let all: any[] = [];
  let armedDelete: string | null = null;
  let armTimer: number | undefined;
  let confirmedCount: number | null = null; // confirmed subscribers, for the confirm copy
  let emailTarget: any = null;               // the post being emailed via the modal

  const host = document.getElementById('posts-host')!;
  const qEl = document.getElementById('q') as HTMLInputElement;
  const filterEl = document.getElementById('filter') as HTMLSelectElement;
  const sortEl = document.getElementById('sort') as HTMLSelectElement;
  const emModal = document.getElementById('email-modal')!;
  const emBody = document.getElementById('em-body')!;
  const emStatus = document.getElementById('em-status')!;
  const emSend = document.getElementById('em-send') as HTMLButtonElement;

  // Series membership editor (R5).
  const srModal = document.getElementById('series-modal')!;
  const srBody = document.getElementById('sr-body')!;
  const srName = document.getElementById('sr-name') as HTMLInputElement;
  const srNameList = document.getElementById('sr-name-options') as HTMLDataListElement;
  const srOrder = document.getElementById('sr-order') as HTMLInputElement;
  const srStatus = document.getElementById('sr-status')!;
  const srSave = document.getElementById('sr-save') as HTMLButtonElement;
  const srRemove = document.getElementById('sr-remove') as HTMLButtonElement;
  let seriesTarget: any = null;

  function view() {
    const q = qEl.value.trim().toLowerCase();
    const filter = filterEl.value;
    const sort = sortEl.value;
    let rows = all.slice();
    if (filter === 'published') rows = rows.filter((p) => !p.draft);
    else if (filter === 'draft') rows = rows.filter((p) => p.draft);
    else if (filter === 'paid') rows = rows.filter((p) => p.paid);
    if (q) rows = rows.filter((p) => (p.title || '').toLowerCase().includes(q) || (p.slug || '').includes(q));
    if (sort === 'title') rows.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
    else if (sort === 'old') rows.sort((a, b) => (a.pubDate || '').localeCompare(b.pubDate || ''));
    else rows.sort((a, b) => (b.pubDate || '').localeCompare(a.pubDate || ''));
    render(rows);
  }

  function stateBadges(p: any) {
    let b = p.draft ? '<span class="badge draft">Draft</span>' : '<span class="badge live">Live</span>';
    if (p.paid) b += ' <span class="badge paid">Paid</span>';
    return b;
  }

  // The paywall cell: a visual on/off switch; the price field appears only when on.
  // Drafts aren't public, so they can't be paywalled.
  function pwCell(p: any) {
    if (p.draft) return '<span class="muted" style="font-size:0.82rem">—</span>';
    const dollars = ((p.priceCents ?? 500) / 100).toFixed(2);
    return `<div class="pw-cell" data-gateable="${p.gateable ? '1' : '0'}">
        <label class="pw-toggle" title="${p.paid ? 'Paywalled' : 'Free'}">
          <input type="checkbox" data-pw ${p.paid ? 'checked' : ''} aria-label="Paywall">
          <span class="track"><span class="knob"></span></span>
        </label>
        <span class="pw-price"${p.paid ? '' : ' hidden'}>$<input class="input pw-price-in" type="number" min="0" step="0.50" value="${dollars}" aria-label="Price"></span>
      </div>`;
  }

  // Visibility cell: an explicit Visible/Hidden switch (maps to the draft flag).
  // On = public (draft:false); off = hidden from the public site (draft:true).
  function visCell(p: any) {
    return `<div class="pw-cell" title="${p.draft ? 'Hidden from the public site — flip to show' : 'Visible on the public site — flip to hide'}">
        <label class="pw-toggle">
          <input type="checkbox" data-vis data-slug="${esc(p.slug)}" ${p.draft ? '' : 'checked'} aria-label="Visible to the public">
          <span class="track"><span class="knob"></span></span>
        </label>
        <span style="font-size:0.82rem;color:${p.draft ? 'var(--muted)' : 'var(--fg)'}">${p.draft ? 'Hidden' : 'Visible'}</span>
        ${p.paid ? ' <span class="badge paid">Paid</span>' : ''}
      </div>`;
  }

  function render(rows: any[]) {
    document.getElementById('posts-sub')!.textContent =
      `${all.length} post${all.length === 1 ? '' : 's'}${rows.length !== all.length ? ` · ${rows.length} shown` : ''}`;
    if (!all.length) {
      host.innerHTML = '<div class="card"><div class="empty"><svg class="empty-icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg><h3>No posts yet</h3><p>Start writing — your first post publishes in seconds.</p><a class="btn btn-primary" href="/admin/write">Write your first post</a></div></div>';
      return;
    }
    if (!rows.length) {
      host.innerHTML = '<div class="card"><div class="empty"><span class="emoji">🔍</span><h3>No matches</h3><p>Try a different search or filter.</p></div></div>';
      return;
    }
    host.innerHTML = '<div class="table-wrap"><table class="table"><thead><tr>'
      + '<th>Title</th><th>Visibility</th><th>Paywall</th><th class="num">Actions</th></tr></thead><tbody>'
      + rows.map((p) => {
        const tags = (p.tags || []).length ? `<span class="t-sub">${(p.tags || []).map((t: string) => '#' + esc(t)).join(' ')}</span>` : '';
        // Series indicator (shown in the row subline) so series membership is
        // visible at a glance in the Studio, not just in the publish form.
        const seriesInfo = p.series
          ? `<span style="color:var(--accent);font-weight:600">◆ ${esc(p.seriesTitle || p.series)}${p.seriesOrder ? ' · Part ' + p.seriesOrder : ''}</span>`
          : '';
        const armed = armedDelete === p.slug;
        const viewBtn = p.draft ? '' : `<a class="btn btn-sm btn-ghost" href="/blog/${encodeURIComponent(p.slug)}" target="_blank" rel="noopener">View</a>`;
        // Email-subscribers action: hidden for drafts (never announce a draft);
        // greyed-out "Emailed" once sent for that post; otherwise a click that
        // opens the confirm layer.
        const emailBtn = p.draft
          ? ''
          : p.emailed
            ? (p.emailedFailed > 0
                ? `<button class="btn btn-sm" data-act="retry-email" data-slug="${esc(p.slug)}" title="${p.emailedFailed} delivery failure(s) — resend to just those">↻ Retry ${p.emailedFailed}</button>`
                : `<button class="btn btn-sm btn-ghost" disabled title="Already emailed${p.emailedAt ? ' · ' + esc(fmtDate(p.emailedAt)) : ''}">✓ Emailed</button>`)
            : `<button class="btn btn-sm" data-act="email" data-slug="${esc(p.slug)}">✉ Email</button>`;
        // Early access (drafts only): email confirmed subscribers a private tokenized
        // link to read the hidden draft before it goes public.
        const earlyBtn = p.draft
          ? `<button class="btn btn-sm" data-act="early" data-slug="${esc(p.slug)}" title="Email confirmed subscribers a private early-access link to this draft">◔ Early access</button>`
          : '';
        // Series membership editor (R5): add/update/remove this post's series.
        const seriesBtn = `<button class="btn btn-sm btn-ghost" data-act="series" data-slug="${esc(p.slug)}" title="${p.series ? 'Edit or remove this post’s series' : 'Add this post to a series'}">${p.series ? '◆ Series' : '+ Series'}</button>`;
        const del = `<button class="btn btn-sm ${armed ? 'btn-danger' : 'btn-ghost'}" data-act="delete" data-slug="${esc(p.slug)}">${armed ? 'Confirm delete' : 'Delete'}</button>`;
        return `<tr data-slug="${esc(p.slug)}">
            <td>
              <div class="t-title"><a href="/admin/write?slug=${encodeURIComponent(p.slug)}">${esc(p.title)}</a></div>
              <div class="t-sub">${esc(fmtDate(p.pubDate))}${tags ? ' · ' : ''}${tags}${seriesInfo ? ' · ' + seriesInfo : ''}</div>
            </td>
            <td>${visCell(p)}</td>
            <td>${pwCell(p)}</td>
            <td class="num"><div class="row-actions">
              <a class="btn btn-sm btn-ghost" href="/admin/write?slug=${encodeURIComponent(p.slug)}">Edit</a>
              ${viewBtn}${seriesBtn}${emailBtn}${del}
            </div></td>
          </tr>`;
      }).join('')
      + '</tbody></table></div>';
  }

  async function load() {
    try {
      const r = await adminFetch('/api/admin/posts');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed to load');
      all = d.posts || [];
      view();
    } catch (e: any) {
      host.innerHTML = `<div class="card card-pad notice err">Couldn't load posts: ${esc(e.message || e)}</div>`;
    }
  }

  function disarm() {
    armedDelete = null;
    if (armTimer) clearTimeout(armTimer);
  }

  async function setDraft(slug: string, draft: boolean) {
    const r = await adminFetch('/api/admin/post', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug, draft }),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Action failed');
    await load();
  }

  async function del(slug: string) {
    const r = await adminFetch(`/api/admin/post?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) alert(d.error || 'Delete failed');
    disarm();
    await load();
  }

  host.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null;
    if (!btn) return;
    const act = btn.dataset.act!;
    const slug = btn.dataset.slug!;
    if (act === 'email') openEmail(slug);
    else if (act === 'series') openSeries(slug);
    else if (act === 'retry-email') retryEmail(slug);
    else if (act === 'early') sendEarly(slug);
    else if (act === 'delete') {
      if (armedDelete === slug) {
        del(slug);
      } else {
        disarm();
        armedDelete = slug;
        view(); // re-render so the button shows "Confirm delete"
        armTimer = window.setTimeout(() => { armedDelete = null; view(); }, 3500);
      }
    }
  });

  async function savePaywall(slug: string, wasGateable: boolean, on: boolean, dollars: number) {
    const price_cents = Math.max(0, Math.round((dollars || 0) * 100));
    // Two layers: frontmatter `gateable` (build-time body split, committed to git) is
    // touched only when the on/off state changes; then the live post_paywall row
    // (is_paid + price). No product id — enable/disable + price is all that's needed here.
    if (on !== wasGateable) {
      const cr = await adminFetch('/api/admin/post', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, gateable: on }),
      });
      if (!cr.ok) { const cj = await cr.json().catch(() => ({})); throw new Error(cj.error || 'Update failed'); }
    }
    const { error } = await supabase.from('post_paywall').upsert(
      { post_id: slug, is_paid: on, price_cents, currency: 'usd', updated_at: new Date().toISOString() },
      { onConflict: 'post_id' },
    );
    if (error) throw error;
  }

  // Visibility toggle (Visible/Hidden = the draft flag). Event-delegated. The
  // visibility switch shares the .pw-cell layout class, so both change handlers
  // are scoped by the changed control's data attribute.
  host.addEventListener('change', async (e) => {
    const cb = e.target as HTMLInputElement;
    if (!(cb instanceof HTMLInputElement) || !cb.hasAttribute('data-vis')) return;
    const slug = cb.dataset.slug!;
    const visible = cb.checked; // checked = visible on the public site = draft:false
    cb.disabled = true;
    await setDraft(slug, !visible); // reloads the list (badge/labels re-render from server)
  });

  // Paywall toggle / price edits (event-delegated on the table).
  host.addEventListener('change', async (e) => {
    // Only paywall controls — the visibility switch shares the .pw-cell layout class.
    if (!(e.target as HTMLElement).matches('[data-pw], .pw-price-in')) return;
    const cell = (e.target as HTMLElement).closest('.pw-cell') as HTMLElement | null;
    if (!cell) return;
    const row = cell.closest('tr') as HTMLElement;
    const slug = row.dataset.slug!;
    const toggle = cell.querySelector('[data-pw]') as HTMLInputElement;
    const priceWrap = cell.querySelector('.pw-price') as HTMLElement;
    const priceIn = cell.querySelector('.pw-price-in') as HTMLInputElement;
    const on = toggle.checked;
    const wasGateable = cell.dataset.gateable === '1';
    const dollars = parseFloat(priceIn.value) || 5;
    priceWrap.hidden = !on;
    toggle.disabled = true;
    priceIn.disabled = true;
    const post = all.find((x) => x.slug === slug);
    try {
      await savePaywall(slug, wasGateable, on, dollars);
      cell.dataset.gateable = on ? '1' : '0';
      if (post) { post.paid = on; post.gateable = on; post.priceCents = Math.round(dollars * 100); }
      const statusTd = row.children[1] as HTMLElement; // reflect the Paid badge in the visibility cell
      if (statusTd && post) statusTd.innerHTML = visCell(post);
    } catch (err: any) {
      alert(err.message || 'Paywall update failed');
      toggle.checked = !on; // revert
      priceWrap.hidden = !toggle.checked;
    } finally {
      toggle.disabled = false;
      priceIn.disabled = false;
    }
  });

  // --- Email a post to subscribers (confirm layer + send) ------------------
  // Read the confirmed count once so the confirmation can name exactly who'll be
  // reached. Best-effort: on failure we fall back to generic copy and let the
  // server (which re-checks the real list) be the source of truth on send.
  async function loadConfirmedCount() {
    try {
      const r = await adminFetch('/api/admin/subscribers?limit=1');
      const d = await r.json();
      confirmedCount = d && d.counts && typeof d.counts.confirmed === 'number' ? d.counts.confirmed : null;
    } catch {
      confirmedCount = null;
    }
  }

  function openEmail(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    emailTarget = p;
    emStatus.textContent = '';
    emSend.hidden = false;
    emSend.disabled = false;
    if (confirmedCount === 0) {
      emBody.innerHTML = 'You have no confirmed subscribers yet, so there’s no one to email.';
      emSend.disabled = true;
    } else {
      const who = confirmedCount == null
        ? 'your confirmed subscribers'
        : `${confirmedCount} confirmed subscriber${confirmedCount === 1 ? '' : 's'}`;
      emBody.innerHTML = `Send <strong>${esc(p.title)}</strong> to ${who}? They’ll get it in their inbox. This can’t be undone.`;
    }
    emModal.hidden = false;
  }

  function closeEmail() {
    emModal.hidden = true;
    emailTarget = null;
  }

  async function sendEmail() {
    if (!emailTarget) return;
    const p = emailTarget;
    emSend.disabled = true;
    emStatus.textContent = 'Sending…';
    try {
      const r = await adminFetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug: p.slug, title: p.title, description: p.description || '' }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok && (d.skipped === 'already-sent' || d.skipped === 'in-progress' || d.sent > 0)) {
        // Reached, already reached, or a send is mid-flight — grey the action out.
        p.emailed = true;
        p.emailedAt = new Date().toISOString();
        view();
        if (d.failed > 0) {
          emStatus.textContent = `Emailed ${d.sent}, but ${d.failed} couldn’t be delivered.`;
          emSend.hidden = true; // leave the result up; Cancel closes
        } else {
          closeEmail();
        }
      } else if (r.ok && d.ok) {
        emStatus.textContent = d.message || 'No confirmed subscribers to email yet.';
        emSend.disabled = false;
      } else {
        emStatus.textContent = d.error || 'Failed (HTTP ' + r.status + ')';
        emSend.disabled = false;
      }
    } catch (e: any) {
      emStatus.textContent = e.message || 'Something went wrong.';
      emSend.disabled = false;
    }
  }

  // Retry a broadcast for ONLY the recipients it previously failed to reach.
  async function retryEmail(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    if (!confirm(`Retry sending “${p.title}” to the ${p.emailedFailed} subscriber(s) it couldn't reach?`)) return;
    try {
      const r = await adminFetch('/api/admin/broadcast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, title: p.title, description: p.description || '', retry: true }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok) {
        alert(d.remaining > 0 ? `Retried — ${d.sent} delivered, ${d.remaining} still failing.` : `Retried — all delivered.`);
      } else {
        alert(d.error || 'Retry failed');
      }
    } catch (e: any) {
      alert(e.message || 'Retry failed');
    }
    await load();
  }

  // Early access (drafts only): email confirmed subscribers a private tokenized link
  // to read the hidden draft. The post stays out of the public /blog until published.
  async function sendEarly(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    if (!confirm(`Email confirmed subscribers a private early-access link to “${p.title}”?\n\nThe post stays hidden from the public until you publish it.`)) return;
    try {
      const r = await adminFetch('/api/admin/early', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, title: p.title, description: p.description || '' }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok) {
        alert(d.sent > 0
          ? `Early-access link emailed to ${d.sent} subscriber(s).`
          : (d.message || 'Link created.') + (d.url ? '\n\n' + d.url : ''));
      } else {
        alert(d.error || 'Failed to send early access');
      }
    } catch (e: any) {
      alert(e.message || 'Failed to send early access');
    }
  }

  document.getElementById('em-cancel')!.addEventListener('click', closeEmail);
  emSend.addEventListener('click', sendEmail);
  emModal.addEventListener('click', (e) => { if (e.target === emModal) closeEmail(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !emModal.hidden) closeEmail(); });

  // --- Series membership (add / edit / remove) -----------------------------
  // Distinct existing series names for the #sr-name autocomplete. De-dupe by the
  // series SLUG (the server's grouping key) so each real series shows once; display
  // the author-facing seriesTitle. Rebuilt on every open so it tracks `all`.
  function fillSeriesOptions() {
    const seen = new Set<string>();
    const names: string[] = [];
    for (const p of all) {
      const name = String(p.seriesTitle || p.series || '').trim();
      if (!name) continue;
      const key = String(p.series || name).toLowerCase();
      if (seen.has(key)) continue;
      seen.add(key);
      names.push(name);
    }
    names.sort((a, b) => a.localeCompare(b));
    srNameList.innerHTML = names.map((n) => `<option value="${esc(n)}"></option>`).join('');
  }

  function openSeries(slug: string) {
    const p = all.find((x) => x.slug === slug);
    if (!p) return;
    seriesTarget = p;
    srBody.innerHTML = `Group <strong>${esc(p.title)}</strong> into a series. Posts that share a series appear together on the Series page, ordered by part.`;
    srName.value = p.seriesTitle || p.series || '';
    srOrder.value = p.seriesOrder ? String(p.seriesOrder) : '';
    srStatus.textContent = '';
    srSave.disabled = false;
    srRemove.disabled = false;
    srRemove.hidden = !p.series; // only offer "remove" when it's in one
    fillSeriesOptions(); // populate autocomplete from the freshest `all`
    srModal.hidden = false;
    srName.focus();
  }
  function closeSeries() {
    srModal.hidden = true;
    seriesTarget = null;
  }
  async function saveSeries(remove: boolean) {
    if (!seriesTarget) return;
    const slug = seriesTarget.slug;
    let payload: any;
    if (remove) {
      payload = { slug, series: null };
    } else {
      const title = srName.value.trim();
      if (!title) { srStatus.textContent = 'Enter a series name, or remove it.'; return; }
      const order = parseInt(srOrder.value, 10);
      payload = { slug, series: { title, order: Number.isFinite(order) && order > 0 ? order : null } };
    }
    srSave.disabled = true;
    srRemove.disabled = true;
    srStatus.textContent = 'Saving…';
    try {
      const r = await adminFetch('/api/admin/post', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || 'Save failed');
      closeSeries();
      await load(); // reload so the row subline + button reflect the change
    } catch (e: any) {
      srStatus.textContent = e.message || 'Save failed';
      srSave.disabled = false;
      srRemove.disabled = false;
    }
  }
  document.getElementById('sr-cancel')!.addEventListener('click', closeSeries);
  srSave.addEventListener('click', () => saveSeries(false));
  srRemove.addEventListener('click', () => saveSeries(true));
  srModal.addEventListener('click', (e) => { if (e.target === srModal) closeSeries(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !srModal.hidden) closeSeries(); });

  qEl.addEventListener('input', view);
  filterEl.addEventListener('change', view);
  sortEl.addEventListener('change', view);
  document.getElementById('refresh')!.addEventListener('click', load);

  onAdminReady(() => { load(); loadConfirmedCount(); });
</script>
