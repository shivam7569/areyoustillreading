---
/**
 * /admin/settings — account + studio settings.
 * Deliberately small and honest: real controls only (account/sign-out, quick
 * links), plus a setup note for read-through analytics (Plausible) which needs a
 * one-time script include rather than a fake in-app toggle.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings — Studio" heading="Settings" active="settings">
  <section class="stack" style="max-width:760px">
    <div class="page-head">
      <div>
        <h1>Settings</h1>
        <p class="sub">Your account and studio preferences.</p>
      </div>
    </div>

    <div class="card card-pad">
      <div class="spread">
        <div>
          <strong>Account</strong>
          <p class="muted" id="acct" style="margin:0.25rem 0 0;font-size:0.92rem">…</p>
        </div>
        <button class="btn" id="signout" type="button">Sign out</button>
      </div>
    </div>

    <div class="card card-pad">
      <strong>Analytics</strong>
      <p class="muted" style="margin:0.25rem 0 0.8rem;font-size:0.92rem">
        First-party and cookieless — traffic, read-depth per post, referrers, and subscribe/unlock
        conversion, all your own data (no third-party script, no consent banner). Tip: append
        <code>?noanalytics=1</code> to any page once to stop counting your own visits from that browser.
      </p>
      <a class="btn btn-sm" href="/admin/analytics">Open Analytics →</a>
    </div>

    <div class="card card-pad">
      <strong>Studio</strong>
      <div class="rowflex" style="margin-top:0.7rem">
        <a class="btn btn-sm btn-ghost" href="/" target="_blank" rel="noopener">View site ↗</a>
        <a class="btn btn-sm btn-ghost" href="/blog" target="_blank" rel="noopener">Blog ↗</a>
        <a class="btn btn-sm btn-ghost" href="/rss.xml" target="_blank" rel="noopener">RSS feed ↗</a>
        <a class="btn btn-sm btn-ghost" href="/admin/write">Write a post</a>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { whenAdmin } from '../../lib/admin-gate';

  whenAdmin.then(async () => {
    const { data } = await supabase.auth.getSession();
    const el = document.getElementById('acct');
    if (el) el.textContent = data.session?.user?.email
      ? `Signed in as ${data.session.user.email}`
      : 'Signed in.';
  });

  document.getElementById('signout')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });
</script>
