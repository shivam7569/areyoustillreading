---
/**
 * /admin/settings — account + studio settings (Studio design layout).
 * HONEST BY DESIGN: the design mocks many editable fields (domain, prices, time
 * zone, theme default…) that our app doesn't persist. Rather than show inputs that
 * silently save nothing, each row states the real, current fact — with a pill and a
 * note pointing at where that thing is actually managed (Cloudflare / Resend / Dodo)
 * — plus the genuinely-real controls: account, sign-out, and the studio/analytics
 * links. Persisted editable defaults (paywall position, theme, prices) are a
 * separate net-new settings backend, not faked here.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings — Studio" heading="Settings" active="settings">
  <section class="stack" style="max-width:900px">
    <div class="panel">
      <header><h2>Account</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Signed in as<small id="acct">…</small></div><div class="f"><button class="btn btn-sm" id="signout" type="button">Sign out</button></div></div>
        <div class="setrow"><div class="k">Pen name<small>Your display name — the byline on every post you write. Your page address (your&nbsp;@handle) is set once and stays fixed. Changes go live instantly.</small></div><div class="f" style="gap:0.5rem;flex-wrap:wrap"><input id="pen-input" class="inp" type="text" placeholder="Your name" autocomplete="off" spellcheck="false" style="width:220px" aria-label="Pen name" /><button class="btn btn-sm" id="pen-save" type="button">Save</button><span class="muted" id="pen-status" style="font-size:0.85rem"></span></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Admins</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Who can open the Studio<small>Admins can publish, moderate discussions, and see every reader&rsquo;s private notes. Add someone by the email they sign in with — they must have signed in at least once first. The last admin can&rsquo;t be removed.</small></div><div class="f"></div></div>
        <div id="admins-list"><div class="setrow"><div class="k muted">Loading…</div></div></div>
        <div class="setrow"><div class="k">Add an admin<small id="admin-status">Enter the email address they sign in with.</small></div><div class="f" style="gap:0.5rem;flex-wrap:wrap"><input id="admin-email" class="inp" type="email" placeholder="name@email.com" autocomplete="off" spellcheck="false" style="width:240px" aria-label="New admin email" /><button class="btn btn-sm" id="admin-add" type="button">Add admin</button></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Site</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Domain</div><div class="f"><span class="mono" style="color:var(--ink-soft)">areyoustillreading.dev</span><span class="pill live">Live</span></div></div>
        <div class="setrow"><div class="k">Hosting<small>Deploys on every push to the main branch.</small></div><div class="f"><span style="color:var(--ink-soft)">Cloudflare Pages</span></div></div>
        <div class="setrow"><div class="k">Feeds</div><div class="f"><a class="btn btn-ghost btn-sm" href="/rss.xml" target="_blank" rel="noopener">RSS ↗</a><a class="btn btn-ghost btn-sm" href="/sitemap-index.xml" target="_blank" rel="noopener">Sitemap ↗</a></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Reading &amp; analytics</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Read-through analytics<small>First-party &amp; cookieless — traffic, read depth, referrers, conversion. No third-party script, no consent banner.</small></div><div class="f"><span class="pill live">On</span><a class="btn btn-ghost btn-sm" href="/admin/analytics">Open →</a></div></div>
        <div class="setrow"><div class="k">Don't count your own visits<small>Your own reading shouldn't inflate the numbers. Flag this browser once and it's excluded from analytics for good — until you switch it back. It's remembered per browser (there's no logged-out signal to detect you automatically).</small></div><div class="f"><span class="pill" id="na-pill" hidden>Excluded</span><button class="btn btn-ghost btn-sm" id="na-toggle" type="button">…</button></div></div>
        <div class="setrow"><div class="k">Reading time<small>Estimated from word count. Also sets a post's height on the series plate.</small></div><div class="f"><span class="pill live">Shown</span></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>The letter</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Delivery<small>Transactional email provider.</small></div><div class="f"><span style="color:var(--ink-soft)">Resend</span><span class="pill live">Connected</span></div></div>
        <div class="setrow"><div class="k">Unsubscribe<small>Every email carries a one-click, no-login unsubscribe.</small></div><div class="f"><span class="pill live">One-click</span></div></div>
        <div class="setrow"><div class="k">Send on publish<small>Chosen per post at publish time — opt-in, never automatic.</small></div><div class="f"><a class="btn btn-ghost btn-sm" href="/admin/audience">Manage list →</a></div></div>
        <div class="setrow"><div class="k">Author alerts<small>A private email the moment a reader comments, highlights, saves a note, joins a discussion, or answers &ldquo;Did it hold?&rdquo; — sent straight from the database, so you never miss one.</small></div><div class="f"><span class="pill">Per interaction</span></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Payments</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Processor<small>Merchant-of-Record — handles tax &amp; compliance for you.</small></div><div class="f"><span style="color:var(--ink-soft)">Dodo Payments</span><span class="pill live">Connected</span></div></div>
        <div class="setrow"><div class="k">Model<small>Readers pay what they want to unlock a paywalled post — a one-time unlock, not a subscription.</small></div><div class="f"><span style="color:var(--ink-soft)">Pay-what-you-want</span></div></div>
        <div class="setrow"><div class="k">Earnings</div><div class="f"><a class="btn btn-ghost btn-sm" href="/admin/revenue">Open Revenue →</a></div></div>
      </div>
    </div>

    <div class="panel">
      <header><h2>Studio</h2></header>
      <div class="pb flush">
        <div class="setrow"><div class="k">Theme<small>Use the sun/moon toggle in the top bar — it follows your system until you choose.</small></div><div class="f"><span style="color:var(--ink-faint);font-size:12.5px">Top bar</span></div></div>
        <div class="setrow"><div class="k">Jump back to the site</div><div class="f"><a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener">View site ↗</a><a class="btn btn-ghost btn-sm" href="/blog" target="_blank" rel="noopener">Blog ↗</a></div></div>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { onAdminReady, adminFetch } from '../../lib/admin-gate';

  onAdminReady(async () => {
    const { data } = await supabase.auth.getSession();
    const el = document.getElementById('acct');
    if (el) el.textContent = data.session?.user?.email ? data.session.user.email : 'Signed in';

    // Pen name — the author's display/byline name: content.profiles.pen_name, via set_my_pen_name.
    // It sets the byline on every DB post; it does NOT touch the @handle (that's claimed once at
    // onboarding and permanent). We also mirror it into the legacy site.json byline
    // (data-cms="post.author") so the OLD file posts keep the same name during the transition —
    // that mirror goes away once the file path is retired.
    const penInput = document.getElementById('pen-input') as HTMLInputElement | null;
    const penSave = document.getElementById('pen-save');
    const penStatus = document.getElementById('pen-status');
    let siteContent: any = null;
    if (penInput && penSave && penStatus) {
      try {
        const { data: prof } = await supabase.rpc('my_profile');
        const row = Array.isArray(prof) ? prof[0] : prof;
        try { const r = await adminFetch('/api/admin/site'); const d = await r.json(); if (r.ok && d && d.content) siteContent = d.content; } catch {}
        // The DB pen name is the source of truth; fall back to the legacy file byline if unset.
        penInput.value = (row && row.pen_name) || (siteContent && siteContent.post && siteContent.post.author) || '';
      } catch { penStatus.textContent = 'Could not load.'; }
      penSave.addEventListener('click', async () => {
        const name = penInput.value.trim();
        if (!name) { penStatus.textContent = 'Enter a name.'; return; }
        penStatus.textContent = 'Saving…';
        try {
          // 1) THE store: content.profiles.pen_name + regenerate the @handle from it.
          const { data: rows, error } = await supabase.rpc('set_my_pen_name', { p_pen_name: name });
          if (error) throw error;
          const handle = Array.isArray(rows) ? (rows[0] && rows[0].handle) : (rows && rows.handle);
          // 2) Legacy mirror: keep the old file posts' byline in sync (dropped when files retire).
          if (siteContent) {
            siteContent.post = siteContent.post || {};
            siteContent.post.author = name;
            try { await adminFetch('/api/admin/site', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ content: siteContent }) }); } catch {}
          }
          penStatus.textContent = handle ? ('Saved — your page is @' + handle) : 'Saved — live now.';
        } catch (e: any) { penStatus.textContent = 'Save failed: ' + (e?.message || e); }
      });
    }

    // Admins — add/remove Studio access by email. Backed by /api/admin/admins
    // (requireAdmin + service-role SQL helpers in db/admins-manage.sql). The server
    // resolves email↔user via auth.users and refuses to remove the last admin.
    const adminsList = document.getElementById('admins-list');
    const adminEmail = document.getElementById('admin-email') as HTMLInputElement | null;
    const adminAdd = document.getElementById('admin-add') as HTMLButtonElement | null;
    const adminStatus = document.getElementById('admin-status');
    if (adminsList && adminEmail && adminAdd && adminStatus) {
      const fmtDate = (iso: string) => { const d = new Date(iso); return isNaN(d.valueOf()) ? '' : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }); };

      const renderAdmins = (data: any) => {
        adminsList.textContent = '';
        if (data && data.setup) {
          const row = document.createElement('div'); row.className = 'setrow';
          const k = document.createElement('div'); k.className = 'k muted';
          k.textContent = 'Run db/admins-manage.sql in Supabase to enable admin management.';
          row.appendChild(k); adminsList.appendChild(row);
          return;
        }
        const admins = (data && data.admins) || [];
        if (!admins.length) {
          const row = document.createElement('div'); row.className = 'setrow';
          const k = document.createElement('div'); k.className = 'k muted'; k.textContent = 'No admins yet.';
          row.appendChild(k); adminsList.appendChild(row);
          return;
        }
        const sole = admins.length === 1;
        for (const a of admins) {
          const row = document.createElement('div'); row.className = 'setrow';
          const k = document.createElement('div'); k.className = 'k';
          k.textContent = a.email || a.userId;
          const small = document.createElement('small');
          small.textContent = (a.createdAt ? `Admin since ${fmtDate(a.createdAt)}` : 'Admin') + (a.self ? ' · You' : '');
          k.appendChild(small);
          const f = document.createElement('div'); f.className = 'f';
          if (sole) {
            // Only admin — the server refuses to remove the last one, so don't offer a
            // button whose confirm would promise access loss it can't deliver.
            const hint = document.createElement('span'); hint.className = 'muted'; hint.style.fontSize = '0.8rem';
            hint.textContent = 'Only admin'; f.appendChild(hint);
          } else {
            const rm = document.createElement('button');
            rm.className = 'btn btn-ghost btn-sm'; rm.type = 'button';
            rm.textContent = 'Remove'; rm.setAttribute('data-remove', a.email || '');
            if (a.self) rm.setAttribute('data-self', '1');
            f.appendChild(rm);
          }
          row.append(k, f); adminsList.appendChild(row);
        }
      };

      const showListMsg = (msg: string) => {
        adminsList.textContent = '';
        const row = document.createElement('div'); row.className = 'setrow';
        const k = document.createElement('div'); k.className = 'k muted'; k.textContent = msg;
        row.appendChild(k); adminsList.appendChild(row);
      };
      const loadAdmins = async () => {
        try {
          const r = await adminFetch('/api/admin/admins');
          const d = await r.json().catch(() => ({}));
          if (!r.ok) { adminStatus.textContent = d.error || `Could not load (${r.status}).`; showListMsg('Couldn’t load admins.'); return; }
          renderAdmins(d);
        } catch { adminStatus.textContent = 'Could not load admins.'; showListMsg('Couldn’t load admins.'); }
      };

      adminAdd.addEventListener('click', async () => {
        const email = adminEmail.value.trim();
        if (!email) { adminStatus.textContent = 'Enter an email address.'; adminEmail.focus(); return; }
        adminAdd.disabled = true; adminStatus.textContent = 'Adding…';
        try {
          const r = await adminFetch('/api/admin/admins', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.ok) { adminEmail.value = ''; adminStatus.textContent = d.message || 'Added.'; if (Array.isArray(d.admins)) renderAdmins(d); else loadAdmins(); }
          else { adminStatus.textContent = d.error || d.message || `Failed (${r.status}).`; }
        } catch { adminStatus.textContent = 'Add failed — try again.'; }
        finally { adminAdd.disabled = false; }
      });
      adminEmail.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); adminAdd.click(); } });

      adminsList.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('[data-remove]') as HTMLButtonElement | null;
        if (!btn) return;
        const email = btn.getAttribute('data-remove') || '';
        const self = btn.hasAttribute('data-self');
        const ok = confirm(self
          ? `Remove yourself (${email}) as an admin? You'll lose Studio access immediately.`
          : `Remove ${email} as an admin?`);
        if (!ok) return;
        btn.disabled = true; adminStatus.textContent = 'Removing…';
        try {
          const r = await adminFetch('/api/admin/admins', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.ok) {
            adminStatus.textContent = d.message || 'Removed.';
            if (self) { window.location.href = '/'; return; } // demoted self → leave the Studio
            if (Array.isArray(d.admins)) renderAdmins(d); else loadAdmins();
          } else { adminStatus.textContent = d.error || `Failed (${r.status}).`; btn.disabled = false; }
        } catch { adminStatus.textContent = 'Remove failed — try again.'; btn.disabled = false; }
      });

      loadAdmins();
    }
  });
  document.getElementById('signout')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  // "Don't count your own visits" — a real, one-click, per-browser toggle. Sets the
  // same localStorage flag the ?noanalytics=1 URL sets (Settings is same-origin), so
  // the analytics beacon skips this browser from now on. No navigation, no URL trick.
  const NA_KEY = 'aysr:no-analytics';
  const naToggle = document.getElementById('na-toggle')!;
  const naPill = document.getElementById('na-pill')!;
  function paintNa() {
    let on = false;
    try { on = localStorage.getItem(NA_KEY) === '1'; } catch {}
    naPill.hidden = !on;
    naToggle.textContent = on ? 'Start counting again' : 'Exclude this browser';
  }
  naToggle.addEventListener('click', () => {
    try {
      if (localStorage.getItem(NA_KEY) === '1') localStorage.removeItem(NA_KEY);
      else localStorage.setItem(NA_KEY, '1');
    } catch {}
    paintNa();
  });
  paintNa();
</script>
