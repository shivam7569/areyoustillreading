---
/**
 * /admin/audience — the email audience.
 * Status counts (confirmed / pending / unsubscribed) + a searchable, filterable
 * list. Read-only in v1. Data from the admin-gated GET /api/admin/subscribers,
 * which never exposes the confirm/unsubscribe tokens.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Audience — Studio" heading="Audience" active="audience">
  <section>
    <div class="page-head">
      <div>
        <h1>Audience</h1>
        <p class="sub">The people who asked to hear from you.</p>
      </div>
    </div>

    <div class="kpi-grid">
      <div class="kpi card"><p class="kpi-label">Confirmed</p><div class="kpi-value loading" id="a-confirmed">—</div><div class="kpi-foot">opted in &amp; verified</div></div>
      <div class="kpi card"><p class="kpi-label">Pending</p><div class="kpi-value loading" id="a-pending">—</div><div class="kpi-foot">awaiting confirmation</div></div>
      <div class="kpi card"><p class="kpi-label">Unsubscribed</p><div class="kpi-value loading" id="a-unsub">—</div><div class="kpi-foot">opted out</div></div>
      <div class="kpi card"><p class="kpi-label">Total</p><div class="kpi-value loading" id="a-total">—</div><div class="kpi-foot">all-time signups</div></div>
    </div>

    <div class="card card-pad" style="margin-bottom:1.25rem">
      <strong>Send a digest</strong>
      <p class="muted" style="margin:0.25rem 0 0.8rem;font-size:0.92rem">Email a roundup of your recent posts to all confirmed subscribers. Each email includes a one-click unsubscribe.</p>
      <div style="display:flex;flex-direction:column;gap:0.6rem;max-width:520px">
        <textarea class="input" id="digest-intro" rows="2" placeholder="Optional intro line — e.g. “A few things I wrote this month…”"></textarea>
        <div style="display:flex;gap:0.7rem;align-items:center;flex-wrap:wrap">
          <label class="muted" style="font-size:0.9rem">Include latest
            <select class="select" id="digest-count"><option>3</option><option selected>5</option><option>8</option></select>
            posts
          </label>
          <button class="btn btn-primary btn-sm" id="digest-send" type="button">Send digest</button>
          <span class="muted" id="digest-status" style="font-size:0.85rem"></span>
        </div>
      </div>
    </div>

    <div class="toolbar">
      <input class="input search" id="q" type="search" placeholder="Search email…" autocomplete="off" />
      <select class="select" id="filter">
        <option value="confirmed">Confirmed</option>
        <option value="pending">Pending</option>
        <option value="unsubscribed">Unsubscribed</option>
        <option value="">Everyone</option>
      </select>
      <span class="grow"></span>
      <button class="btn btn-sm btn-ghost" id="refresh" type="button">↻ Refresh</button>
    </div>

    <div id="subs-host">
      <div class="table-wrap"><div class="card-pad muted">Loading…</div></div>
    </div>
  </section>
</AdminLayout>

<script>
  import { whenAdmin, adminFetch } from '../../lib/admin-gate';
  import { fmtNum, fmtDate, esc } from '../../lib/admin-format';

  const host = document.getElementById('subs-host')!;
  const qEl = document.getElementById('q') as HTMLInputElement;
  const filterEl = document.getElementById('filter') as HTMLSelectElement;
  let searchTimer: number | undefined;

  function setKpi(id: string, n: number) {
    const el = document.getElementById(id);
    if (el) { el.textContent = fmtNum(n); el.classList.remove('loading'); }
  }

  const statusBadge = (s: string) =>
    s === 'confirmed' ? '<span class="badge confirmed">Confirmed</span>'
    : s === 'pending' ? '<span class="badge pending">Pending</span>'
    : '<span class="badge unsub">Unsubscribed</span>';

  function renderRows(rows: any[]) {
    if (!rows.length) {
      host.innerHTML = '<div class="card"><div class="empty"><span class="emoji">📭</span><h3>No subscribers here</h3><p>Nobody matches this view yet.</p></div></div>';
      return;
    }
    host.innerHTML = '<div class="table-wrap"><table class="table"><thead><tr>'
      + '<th>Email</th><th>Status</th><th>Joined</th><th>Confirmed</th></tr></thead><tbody>'
      + rows.map((s) => `<tr>
          <td class="t-title mono">${esc(s.email)}</td>
          <td>${statusBadge(s.status)}</td>
          <td class="nowrap">${esc(fmtDate(s.created_at))}</td>
          <td class="nowrap muted">${s.confirmed_at ? esc(fmtDate(s.confirmed_at)) : '—'}</td>
        </tr>`).join('')
      + '</tbody></table></div>';
  }

  async function loadCounts() {
    try {
      const r = await adminFetch('/api/admin/subscribers?limit=1');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      setKpi('a-confirmed', d.counts.confirmed);
      setKpi('a-pending', d.counts.pending);
      setKpi('a-unsub', d.counts.unsubscribed);
      setKpi('a-total', d.counts.total);
    } catch {
      for (const id of ['a-confirmed', 'a-pending', 'a-unsub', 'a-total']) setKpi(id, 0);
    }
  }

  async function loadRows() {
    host.innerHTML = '<div class="table-wrap"><div class="card-pad muted">Loading…</div></div>';
    const params = new URLSearchParams();
    if (filterEl.value) params.set('status', filterEl.value);
    if (qEl.value.trim()) params.set('q', qEl.value.trim());
    params.set('limit', '200');
    try {
      const r = await adminFetch(`/api/admin/subscribers?${params.toString()}`);
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed');
      renderRows(d.rows || []);
    } catch (e: any) {
      host.innerHTML = `<div class="card card-pad notice err">Couldn't load subscribers: ${esc(e.message || e)}</div>`;
    }
  }

  filterEl.addEventListener('change', loadRows);
  qEl.addEventListener('input', () => {
    if (searchTimer) clearTimeout(searchTimer);
    searchTimer = window.setTimeout(loadRows, 300);
  });
  document.getElementById('refresh')!.addEventListener('click', () => { loadCounts(); loadRows(); });

  // --- Send a digest of recent posts to confirmed subscribers --------------
  async function sendDigest(force = false) {
    const st = document.getElementById('digest-status')!;
    const btn = document.getElementById('digest-send') as HTMLButtonElement;
    const intro = (document.getElementById('digest-intro') as HTMLTextAreaElement).value.trim();
    const count = parseInt((document.getElementById('digest-count') as HTMLSelectElement).value, 10) || 5;
    if (!force && !confirm(`Email a digest of your latest ${count} posts to all confirmed subscribers?`)) return;
    btn.disabled = true;
    st.textContent = 'Sending…';
    try {
      const r = await adminFetch('/api/admin/digest', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ count, intro, force }),
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.ok) {
        st.textContent = d.sent > 0 ? `Sent to ${fmtNum(d.sent)} subscriber${d.sent === 1 ? '' : 's'}.` : (d.message || 'Nothing to send.');
      } else if (d.recentlySent) {
        if (confirm('A digest was already sent within the last hour. Send another anyway?')) { btn.disabled = false; return sendDigest(true); }
        st.textContent = 'Cancelled.';
      } else {
        st.textContent = d.error || ('Failed (HTTP ' + r.status + ')');
      }
    } catch (e: any) {
      st.textContent = 'Error: ' + (e.message || e);
    } finally {
      btn.disabled = false;
    }
  }
  document.getElementById('digest-send')!.addEventListener('click', () => sendDigest(false));

  whenAdmin.then(() => { loadCounts(); loadRows(); });
</script>
