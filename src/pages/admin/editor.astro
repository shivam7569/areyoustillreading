---
/*
 * /admin/editor — the admin-only writing surface (Phase 4).
 *
 * Client-gated: the page is statically served, but its script checks the
 * Supabase session + is_admin() and only mounts the editor for the owner. This
 * is UX gating only — the real protection is server-side at *publish* time (the
 * GitHub-commit Function will re-verify is_admin before writing anything).
 *
 * Editor: Milkdown "Crepe" — a Medium-style WYSIWYG that is Markdown-native, so
 * what you write serializes straight to the Markdown files the site builds from
 * (Option B). Live inline rendering: math (latex feature), highlighted code
 * (code-mirror), images, slash menu (block-edit), floating toolbar. Mermaid is
 * added in a later increment via Milkdown's diagram plugin.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Editor — admin" description="Admin editor.">
  <p id="admin-gate" class="muted">Checking access…</p>

  <div id="editor-wrap" hidden>
    <div class="editor-bar">
      <strong>Draft</strong>
      <span id="editor-status" class="muted"></span>
      <button id="new-draft" type="button">New</button>
      <button id="get-md" type="button">Preview Markdown</button>
      <button id="publish-btn" type="button">Publish…</button>
    </div>
    <div id="publish-panel" hidden>
      <label>Slug <input id="pub-slug" type="text" placeholder="my-post-slug" /></label>
      <label>Title <input id="pub-title" type="text" placeholder="Post title" /></label>
      <label>Description <input id="pub-desc" type="text" placeholder="Short summary (SEO / cards)" /></label>
      <label>Tags <input id="pub-tags" type="text" placeholder="comma, separated" /></label>
      <label class="pub-inline"><input id="pub-draft" type="checkbox" /> Draft (hidden from listings)</label>
      <label>Publish key <input id="pub-secret" type="password" placeholder="PUBLISH_SECRET" /></label>
      <div><button id="pub-go" type="button">Publish now</button> <span id="pub-status" class="muted"></span></div>
    </div>
    <div id="milkdown"></div>
    <pre id="md-out" hidden></pre>
  </div>
</BaseLayout>

<style>
  .muted { color: var(--muted); }
  .editor-bar {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: 0.5rem 0; margin-bottom: 0.5rem; border-bottom: 1px solid var(--border);
  }
  .editor-bar button {
    padding: 0.4rem 0.9rem; border: 1px solid var(--border); border-radius: 6px;
    background: var(--accent); color: #fff; font-weight: 600; cursor: pointer;
  }
  #milkdown {
    border: 1px solid var(--border); border-radius: 10px; min-height: 60vh;
    background: var(--bg);
  }
  #md-out {
    margin-top: 1rem; padding: 1rem; border: 1px solid var(--border);
    border-radius: 8px; background: var(--code-bg); overflow-x: auto; white-space: pre-wrap;
  }
  #publish-panel {
    border: 1px solid var(--border); border-radius: 10px; padding: 0.75rem 1rem;
    margin-bottom: 0.75rem; display: grid; gap: 0.5rem; max-width: 34rem;
  }
  #publish-panel label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.85em; }
  #publish-panel label.pub-inline { flex-direction: row; align-items: center; gap: 0.45rem; }
  #publish-panel input[type="text"], #publish-panel input[type="password"] {
    padding: 0.35rem 0.5rem; border: 1px solid var(--border); border-radius: 6px;
    background: var(--bg); color: inherit;
  }
</style>

<!-- Global (unscoped) styles: the code-block preview DOM is created by Milkdown at
     runtime, so Astro's scoped styles never reach it — target these classes globally. -->
<style is:global>
  .d2-preview { display: flex; justify-content: center; padding: 1rem; overflow-x: auto; }
  .d2-preview svg { max-width: 100%; height: auto; }
  .d2-error {
    padding: 1rem; color: #e5484d; white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .plotly-cell { margin: 0.25rem 0 1rem; max-width: 100%; overflow-x: hidden; }
  .plotly-holder { width: 100%; height: 380px; }
  .py-running { padding: 0.5rem 0.8rem; opacity: 0.6; font-size: 0.85em; }
  .py-output {
    margin: 0; padding: 0.6rem 0.8rem; white-space: pre-wrap; overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85em;
    background: var(--code-bg); border-radius: 6px;
  }
  .plotly-error {
    padding: 0.75rem; margin: 0; color: #e5484d; white-space: pre-wrap;
    overflow-x: auto; font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .plotly-controls {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    padding: 0.4rem 0.6rem; font-size: 0.85em;
  }
  .plotly-controls .pc-label { font-weight: 600; opacity: 0.85; }
  .plotly-controls label { display: inline-flex; align-items: center; gap: 0.25rem; opacity: 0.85; }
  .plotly-controls input {
    width: 3.5rem; padding: 0.15rem 0.3rem; border: 1px solid var(--border);
    border-radius: 4px; background: var(--bg); color: inherit;
  }
  /* !important: the Milkdown/Crepe editor theme otherwise overrides editor buttons
     to a transparent background, making this one invisible (white text on white). */
  .plotly-controls button {
    padding: 0.3rem 0.85rem !important; border: 0 !important; border-radius: 6px !important;
    background: var(--accent) !important; color: #fff !important; opacity: 1 !important;
    font-weight: 600 !important; font-size: 0.85em !important; cursor: pointer !important;
  }
  .plotly-controls button:disabled { opacity: 0.55 !important; cursor: default !important; }
  .plotly-controls .pc-status { opacity: 0.75; }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { Crepe } from '@milkdown/crepe';
  import { languages } from '@codemirror/language-data';
  import { closeBrackets, closeBracketsKeymap } from '@codemirror/autocomplete';
  import { keymap } from '@codemirror/view';
  import { $prose } from '@milkdown/kit/utils';
  import { Plugin, PluginKey, TextSelection } from '@milkdown/kit/prose/state';
  import { Decoration, DecorationSet } from '@milkdown/kit/prose/view';
  import { renderPlotlyFigure, loadPlotlyJs, makeRotatingGif } from '../../lib/plotly';
  import '@milkdown/crepe/theme/common/style.css';
  import '@milkdown/crepe/theme/nord.css';

  // Auto-pair brackets AND quotes across the whole editor (blog-wide, prose side).
  // Typing an opener inserts its closer with the cursor between (e.g. '(|)'); typing
  // a closer/quote that's already next "types over" it; Backspace on an empty pair
  // deletes both. Code blocks get the same behavior via CodeMirror's closeBrackets.
  // NOTE: backtick is deliberately NOT paired here — it collides with Markdown's own
  // inline-code and fenced-code-block (```) shortcuts, which Milkdown handles natively.
  const PAIRS = { '(': ')', '[': ']', '{': '}', '"': '"', "'": "'" };
  const CLOSERS = new Set([')', ']', '}']);
  const QUOTES = new Set(['"', "'"]);

  const bracketPairing = $prose(() => new Plugin({
    props: {
      handleTextInput(view, from, to, text) {
        const { state } = view;
        const closing = PAIRS[text];
        if (closing) {
          if (QUOTES.has(text) && from === to) {
            // Type over an existing identical quote instead of nesting a new pair.
            if (state.doc.textBetween(from, from + 1) === text) {
              view.dispatch(state.tr.setSelection(TextSelection.create(state.doc, from + 1)));
              return true;
            }
            // Don't auto-pair a quote right after a word char (contractions: don't, it's).
            const before = from > 0 ? state.doc.textBetween(from - 1, from) : '';
            if (/\w/.test(before)) return false;
          }
          const tr = state.tr;
          if (from !== to) {
            // Wrap the current selection in the pair, keeping it selected.
            const inner = state.doc.textBetween(from, to);
            tr.insertText(text + inner + closing, from, to);
            tr.setSelection(TextSelection.create(tr.doc, from + 1, from + 1 + inner.length));
          } else {
            tr.insertText(text + closing, from, to);
            tr.setSelection(TextSelection.create(tr.doc, from + 1));
          }
          view.dispatch(tr);
          return true;
        }
        // Type over a bracket closer that's already the next character.
        if (CLOSERS.has(text) && from === to && state.doc.textBetween(from, from + 1) === text) {
          view.dispatch(state.tr.setSelection(TextSelection.create(state.doc, from + 1)));
          return true;
        }
        return false;
      },
      handleKeyDown(view, event) {
        if (event.key !== 'Backspace') return false;
        const { state } = view;
        const sel = state.selection;
        if (!sel.empty || sel.from === 0) return false;
        const before = state.doc.textBetween(sel.from - 1, sel.from);
        const after = state.doc.textBetween(sel.from, sel.from + 1);
        // Cursor sits between an empty pair -> delete both sides.
        if (PAIRS[before] && PAIRS[before] === after) {
          view.dispatch(state.tr.delete(sel.from - 1, sel.from + 1));
          return true;
        }
        return false;
      },
    },
  }));

  // Lazy-load D2 (@terrastruct/d2, WASM) only when a ```d2 diagram is first
  // previewed, then reuse the one instance. Kept out of the initial editor bundle
  // via import(). The published site renders the same fences at build time
  // (plugins/rehype-d2), so editor preview and live output match.
  let d2Promise = null;
  function loadD2() {
    if (!d2Promise) d2Promise = import('@terrastruct/d2').then(({ D2 }) => new D2());
    return d2Promise;
  }
  async function renderD2(code) {
    const d2 = await loadD2();
    const res = await d2.compile(code, { pad: 20, noXMLTag: true });
    return await d2.render(res.diagram, res.renderOptions);
  }
  function diagramEl(svg) {
    const el = document.createElement('div');
    el.className = 'd2-preview';
    el.innerHTML = svg;
    return el;
  }
  function errorEl(err) {
    const el = document.createElement('div');
    el.className = 'd2-error';
    el.textContent = 'D2 error: ' + (err && err.message ? err.message : String(err));
    return el;
  }

  // --- Interactive Python plot cells (Plotly) ---------------------------------
  // Each ```python block gets a live, interactive plot rendered right below it —
  // a notebook-style cell. The author's plotly.py runs client-side via Pyodide
  // (lib/plotly) and plotly.js renders the figure, so 3D plots rotate/zoom right
  // in the editor. The panel is a ProseMirror WIDGET decoration (non-editable,
  // outside Crepe's sanitizer) so interactivity survives. Panels are keyed by the
  // python block's index, so a panel (and its plot) persists while you edit —
  // only its contents re-render, debounced.
  const plotlyKey = new PluginKey('plotly-cells');

  const plotlyCells = $prose(() => {
    const panels = new Map(); // key -> panel DOM
    const timers = new Map(); // panel -> debounce timer id
    let plotlyJs = null;

    function render(panel, code) {
      if (panel.__code === code) return;
      panel.__code = code;
      clearTimeout(timers.get(panel));
      if (!code) { panel.replaceChildren(); panel.__ran = false; return; }
      // Show "Running…" only before a cell's FIRST result; later edits keep the last
      // output visible until the new one is ready (no flicker/spam while typing).
      if (!panel.__ran) {
        const s = document.createElement('div');
        s.className = 'py-running';
        s.textContent = 'Running…';
        panel.replaceChildren(s);
      }
      timers.set(panel, setTimeout(async () => {
        let res;
        try {
          res = await renderPlotlyFigure(code);
        } catch (e) {
          res = { error: 'Could not run: ' + (e && e.message ? e.message : String(e)) };
        }
        if (panel.__code !== code) return; // superseded by a newer edit
        panel.__ran = true;
        const { figure, stdout, error } = res;
        if (error) {
          const pre = document.createElement('pre');
          pre.className = 'plotly-error';
          pre.textContent = error;
          panel.replaceChildren(pre);
        } else if (figure) {
          // Plotting cell -> interactive plot.
          if (!plotlyJs) plotlyJs = await loadPlotlyJs();
          let holder = panel.querySelector('.plotly-holder');
          if (!holder) {
            holder = document.createElement('div');
            holder.className = 'plotly-holder';
            panel.replaceChildren(holder);
          }
          // Fit the plot to the editor column: drop any hard-coded width/height the
          // figure set (e.g. width=800) so it can't overflow; autosize to the holder.
          const layout = { ...(figure.layout || {}) };
          delete layout.width;
          delete layout.height;
          layout.autosize = true;
          await plotlyJs.react(holder, figure.data || [], layout, { responsive: true, displaylogo: false });
          requestAnimationFrame(() => { try { plotlyJs.Plots.resize(holder); } catch {} });
          updateControls(panel, holder, figure);
        } else {
          // Non-plotting cell -> a notebook-style output block showing stdout. If the
          // cell printed nothing, show nothing (no clutter).
          const out = (stdout || '').replace(/\s+$/, '');
          if (out) {
            const pre = document.createElement('pre');
            pre.className = 'py-output';
            pre.textContent = out;
            panel.replaceChildren(pre);
          } else {
            panel.replaceChildren();
          }
        }
      }, 700));
    }

    // For 3D figures, offer a rotating-GIF export below the plot (author sets the
    // frame count and fps). 2D figures get no controls.
    function updateControls(panel, holder, figure) {
      const types = (figure.data || []).map((t) => t && t.type).filter(Boolean);
      const is3d = !!(figure.layout && figure.layout.scene) ||
        types.some((t) => /3d$/.test(t) || ['surface', 'mesh3d', 'cone', 'streamtube', 'volume', 'isosurface'].includes(t));
      let bar = panel.querySelector('.plotly-controls');
      if (!is3d) { if (bar) bar.remove(); return; }
      if (bar) return; // already present
      bar = document.createElement('div');
      bar.className = 'plotly-controls';
      bar.innerHTML =
        '<span class="pc-label">Rotating GIF</span>' +
        '<label>frames <input type="number" class="pc-frames" value="36" min="4" max="180"></label>' +
        '<label>fps <input type="number" class="pc-fps" value="15" min="1" max="60"></label>' +
        '<button type="button" class="pc-gif">Download GIF</button>' +
        '<span class="pc-status"></span>';
      const btn = bar.querySelector('.pc-gif');
      const status = bar.querySelector('.pc-status');
      btn.addEventListener('click', async () => {
        const frames = Math.max(4, Math.min(180, parseInt(bar.querySelector('.pc-frames').value, 10) || 36));
        const fps = Math.max(1, Math.min(60, parseInt(bar.querySelector('.pc-fps').value, 10) || 15));
        btn.disabled = true;
        status.textContent = 'Rendering… 0%';
        try {
          const blob = await makeRotatingGif(holder, {
            frames, fps,
            onProgress: (p) => { status.textContent = 'Rendering… ' + Math.round(p * 100) + '%'; },
          });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'plot.gif';
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          status.textContent = 'Saved · ' + Math.round(blob.size / 1024) + ' KB';
        } catch (e) {
          status.textContent = 'Failed: ' + (e && e.message ? e.message : String(e));
        } finally {
          btn.disabled = false;
        }
      });
      panel.appendChild(bar);
    }

    function build(state) {
      const decos = [];
      const used = new Set();
      let i = 0;
      state.doc.descendants((node, pos) => {
        if (node.type.name !== 'code_block') return;
        const lang = (node.attrs.language || '').toLowerCase();
        if (lang !== 'python' && lang !== 'py') return;
        const key = 'py-' + i++;
        used.add(key);
        let panel = panels.get(key);
        if (!panel) {
          panel = document.createElement('div');
          panel.className = 'plotly-cell';
          panels.set(key, panel);
        }
        render(panel, node.textContent.trim());
        decos.push(Decoration.widget(pos + node.nodeSize, panel, {
          key, side: 1, ignoreSelection: true, stopEvent: () => true,
        }));
      });
      // Drop panels whose block was removed.
      for (const [k, p] of panels) {
        if (!used.has(k)) {
          clearTimeout(timers.get(p));
          timers.delete(p);
          if (plotlyJs) { try { plotlyJs.purge(p.querySelector('.plotly-holder')); } catch {} }
          panels.delete(k);
        }
      }
      return DecorationSet.create(state.doc, decos);
    }

    return new Plugin({
      key: plotlyKey,
      state: {
        init: (_, state) => build(state),
        apply: (tr, old, _o, newState) => (tr.docChanged ? build(newState) : old),
      },
      props: { decorations(state) { return plotlyKey.getState(state); } },
    });
  });

  const gate = document.getElementById('admin-gate');
  const wrap = document.getElementById('editor-wrap');
  const statusEl = document.getElementById('editor-status');

  async function init() {
    // TEMP (dev): the editor is intentionally UNGATED so it can be built and tested
    // from a general user's POV without an admin login. BEFORE LAUNCH, restore the
    // gate here — require a session AND is_admin:
    //   const { data } = await supabase.auth.getSession();
    //   if (!data.session) { gate.innerHTML = 'Please <a href="/login">sign in</a> to write.'; return; }
    //   const { data: a } = await supabase.rpc('is_admin');
    //   if (a !== true) { gate.textContent = 'Admins only.'; return; }
    gate.hidden = true;
    wrap.hidden = false;

    // Draft persistence (dev): autosave the Markdown to localStorage so work survives
    // reloads. TODO: migrate to per-user Supabase drafts once the editor is re-gated.
    const DRAFT_KEY = 'aysr:editor-draft';
    let savedDraft = null;
    try { savedDraft = localStorage.getItem(DRAFT_KEY); } catch {}

    const crepe = new Crepe({
      root: document.getElementById('milkdown'),
      defaultValue: savedDraft != null ? savedDraft : '# New post\n\nStart writing.\n',
      featureConfigs: {
        // Language-aware code blocks: hand the CodeMirror feature the full
        // language set (from @codemirror/language-data) so a block tagged ts /
        // python / rust / etc. loads that grammar and highlights accordingly,
        // with a language picker in the block. Matches the build-time Shiki output.
        [Crepe.Feature.CodeMirror]: {
          languages,
          // Auto-close brackets/quotes: typing '(' inserts '()' with the cursor
          // between (i.e. '(|)'), and Backspace on the empty pair removes BOTH.
          extensions: [closeBrackets(), keymap.of(closeBracketsKeymap)],
          // Live diagrams: for a ```d2 block, render it client-side (D2 WASM) into
          // the block's preview panel (a toggle appears in the block's toolbar).
          // undefined return = async; applyPreview() swaps in the SVG when ready.
          // Any other language returns null -> no preview toggle, no overhead. On
          // publish the same ```d2 fence is rendered at build time by
          // plugins/rehype-d2, so editor preview and live site stay identical.
          renderPreview: (language, content, applyPreview) => {
            const lang = (language || '').toLowerCase();
            const code = content.trim();
            if (!code) return null;
            if (lang === 'd2') {
              renderD2(code)
                .then((svg) => applyPreview(diagramEl(svg)))
                .catch((err) => applyPreview(errorEl(err)));
              return undefined;
            }
            // Python plots are handled by the interactive Plotly panel plugin
            // (rendered below the block), not by this sanitized preview.
            return null;
          },
          previewLabel: 'Diagram',
        },
      },
    });
    let saveTimer = null;
    crepe.on((api) => {
      api.markdownUpdated((_ctx, md) => {
        statusEl.textContent = 'Saving…';
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          try { localStorage.setItem(DRAFT_KEY, md); statusEl.textContent = 'Saved'; }
          catch { statusEl.textContent = 'Save failed'; }
        }, 800);
      });
    });

    crepe.editor.use(bracketPairing);
    crepe.editor.use(plotlyCells);
    await crepe.create();
    if (savedDraft != null) statusEl.textContent = 'Draft restored';

    // "New" clears the saved draft and starts a fresh post (two-click confirm so an
    // accidental click can't nuke your work).
    let armNew = false;
    const newBtn = document.getElementById('new-draft');
    newBtn.addEventListener('click', () => {
      if (!armNew) {
        armNew = true;
        newBtn.textContent = 'Confirm New?';
        setTimeout(() => { armNew = false; newBtn.textContent = 'New'; }, 3000);
        return;
      }
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      location.reload();
    });

    // "Preview Markdown" shows the serialized Markdown (temporary debug view — this
    // is what Publish will commit to GitHub in the next increment).
    const out = document.getElementById('md-out');
    document.getElementById('get-md').addEventListener('click', () => {
      out.hidden = false;
      out.textContent = crepe.getMarkdown();
    });

    // --- Publish: assemble frontmatter + body, POST to /api/publish, which commits
    // the .md file to GitHub → Cloudflare Git-integration rebuilds the site. -------
    const $ = (id) => document.getElementById(id);
    const pubPanel = $('publish-panel');
    const slugify = (s) => s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
    const firstHeading = (md) => { const m = md.match(/^#\s+(.+)$/m); return m ? m[1].trim() : ''; };
    const yaml = (v) => JSON.stringify(String(v == null ? '' : v)); // JSON-style scalar is valid YAML

    $('publish-btn').addEventListener('click', () => {
      const opening = pubPanel.hidden;
      pubPanel.hidden = !opening;
      if (opening) {
        const title = firstHeading(crepe.getMarkdown());
        if (!$('pub-title').value) $('pub-title').value = title;
        if (!$('pub-slug').value) $('pub-slug').value = slugify(title);
      }
    });

    $('pub-go').addEventListener('click', async () => {
      const status = $('pub-status');
      const slug = slugify($('pub-slug').value || '');
      const title = $('pub-title').value.trim();
      const description = $('pub-desc').value.trim();
      const tags = $('pub-tags').value.split(',').map((t) => t.trim()).filter(Boolean);
      const draft = $('pub-draft').checked;
      const secret = $('pub-secret').value;
      if (!slug) return void (status.textContent = 'Slug required.');
      if (!title) return void (status.textContent = 'Title required.');
      if (!description) return void (status.textContent = 'Description required.');
      if (!secret) return void (status.textContent = 'Publish key required.');

      // Title lives in frontmatter (the layout renders it as the <h1>), so drop a
      // leading "# Title" from the body to avoid a duplicate heading.
      const body = crepe.getMarkdown().replace(/^#\s+.+\n+/, '');
      const today = new Date().toISOString().slice(0, 10);
      const frontmatter = [
        '---',
        `title: ${yaml(title)}`,
        `description: ${yaml(description)}`,
        `pubDate: ${yaml(today)}`,
        `tags: [${tags.map(yaml).join(', ')}]`,
        `draft: ${draft}`,
        '---',
        '',
      ].join('\n');

      status.textContent = 'Publishing…';
      $('pub-go').disabled = true;
      try {
        const res = await fetch('/api/publish', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, content: frontmatter + body, secret }),
        });
        const j = await res.json().catch(() => ({}));
        if (res.ok && j.ok) {
          status.innerHTML = (j.updated ? 'Updated' : 'Published') + ' — committed to <code>' + j.branch +
            '</code>. Site will rebuild. <a href="/blog/' + slug + '/" target="_blank" rel="noopener">View when live →</a>';
        } else {
          status.textContent = 'Failed: ' + (j.error || ('HTTP ' + res.status)) + (j.detail ? ' — ' + j.detail : '');
        }
      } catch (e) {
        status.textContent = 'Error: ' + (e && e.message ? e.message : String(e));
      } finally {
        $('pub-go').disabled = false;
      }
    });
  }

  init();
</script>
