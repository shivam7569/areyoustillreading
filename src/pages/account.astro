---
/*
 * FILE: src/pages/account.astro  ·  ROUTE: /account
 * =============================================================================
 * The editorial account area (Phase 5), adapted from the Claude Design "account"
 * template to THIS site's real model: there is no subscription plan — monetization
 * is per-post pay-what-you-want unlocks (Dodo → `entitlements`) + a single
 * newsletter. So the design's layout is kept (sticky sidebar + panels) but wired to:
 *   - the Supabase session (identity),
 *   - `entitlements` (RLS reads-own) → "Your library" of unlocked essays,
 *   - is_admin() → a "Studio" panel/link (admins only),
 *   - the newsletter (SubscribeForm),
 * and the signed-out state is an inline sign-in card (magic-link + GitHub). Also the
 * post-auth landing target (Supabase consumes the URL session here).
 *
 * STATIC SSG: the frontmatter runs at build time only (it just bakes a slug→title
 * map for the library). ALL behaviour is client-side under RLS. Client-shown state
 * is display-only and grants zero authority — every real action is server-enforced.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

// Copy editable from Studio → Content Management → Account. Server-rendered
// strings use {c.x}; the library-row + status strings the client script builds
// are handed over via a JSON <script id="account-copy"> it reads at runtime.
const c = (site as any).account || {};
const so = c.signedOut || {};
const si = c.signedIn || {};
const accountCopy = { msg: c.msg || {}, lib: c.lib || {}, libraryHeading: si.libraryHeading || 'Your library' };
const esc = (s = '') => String(s).replace(/[&<>]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[ch] as string));
const libEmptyHtml = esc(si.libraryEmpty || "You haven't unlocked any paid essays yet — most of the writing here is free. {browse}")
  .replace('{browse}', `<a class="link" href="/blog">${esc(si.libraryEmptyLink || 'Browse the archive →')}</a>`);

// Build-time slug → {title, mins} map so the client can label entitlement rows
// (posts are static Markdown, not DB rows). Baked into a JSON script below.
const readMins = (body?: string) => Math.max(1, Math.round((body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));
const postsMeta: Record<string, { title: string; mins: number }> = {};
for (const p of await getCollection('blog', ({ data }) => !data.draft)) {
  postsMeta[p.id] = { title: p.data.title, mins: readMins(p.body) };
}
---

<BaseLayout title={c.seo?.title || 'Your account — areyoustillreading'} description={c.seo?.description || 'Your account.'} wide>
  {/* Client-side status + library-row copy, read by the account script. */}
  <script type="application/json" id="account-copy" set:html={JSON.stringify(accountCopy)} />
  <div class="wrap">
    {/* Loading state — replaced the moment the Supabase session resolves. */}
    <div id="acct-checking" class="acct-checking"><p data-cms="account.checking">{c.checking || 'Checking your session…'}</p></div>

    {/* ---------- SIGNED OUT: inline sign-in ---------- */}
    <section id="acct-signedout" class="signin" hidden>
      <header class="page-head">
        <div class="kicker"><span class="line"></span><span class="eyebrow" data-cms="account.signedOut.eyebrow">{so.eyebrow || 'Account'}</span></div>
        <h1><span data-cms="account.signedOut.title">{so.title || 'Sign in to'}</span> <em data-cms="account.signedOut.titleEm">{so.titleEm || 'your account.'}</em></h1>
        <p class="lede" data-cms="account.signedOut.lede">{so.lede || "One tap and you're in — for reading unlocked essays, saving highlights and notes, and managing the letter."}</p>
      </header>
      <div class="card signin-card">
        <button class="btn btn-primary" id="si-github" type="button" data-cms="account.signedOut.github">{so.github || 'Continue with GitHub'}</button>
        <div class="or" data-cms="account.signedOut.or">{so.or || 'or'}</div>
        <form class="si-magic" id="si-magic">
          <input id="si-email" type="email" placeholder={so.emailPlaceholder || 'you@example.com'} aria-label="Email address" required />
          <button class="btn btn-ghost" type="submit" data-cms="account.signedOut.sendCode">{so.sendCode || 'Email me a code'}</button>
        </form>
        {/* Code step — verifying here finishes sign-in in THIS tab (no new tab). */}
        <form class="si-magic" id="si-code" hidden>
          <input id="si-token" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="8" placeholder={so.codePlaceholder || '6-digit code'} aria-label="Sign-in code" />
          <button class="btn btn-ghost" type="submit" data-cms="account.signedOut.verify">{so.verify || 'Verify & sign in'}</button>
          <button class="btn btn-ghost" id="si-back" type="button" data-cms="account.signedOut.useDifferent">{so.useDifferent || 'Use a different email'}</button>
        </form>
        <p class="si-status" id="si-status" role="status" aria-live="polite"></p>
      </div>
    </section>

    {/* ---------- SIGNED IN: the account ---------- */}
    <div id="acct-signedin" class="acct" hidden>
      <aside class="side">
        <div class="who">
          <div class="avatar" id="ac-initial" aria-hidden="true">·</div>
          <div class="who-main">
            <div class="nm-row">
              <span class="nm" id="ac-name" data-cms="account.signedIn.defaultName">{si.defaultName || 'Reader'}</span>
              <button class="nm-edit" id="ac-edit" type="button" title={si.editTooltip || 'Set your pen name'} aria-label={si.editTooltip || 'Set your pen name'}>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </button>
            </div>
            <form class="nm-form" id="ac-nm-form" hidden>
              <input id="ac-nm-input" type="text" maxlength="60" placeholder={si.penPlaceholder || 'Your pen name'} aria-label="Pen name" />
              <button class="btn btn-sm btn-primary" type="submit" data-cms="account.signedIn.save">{si.save || 'Save'}</button>
              <button class="nm-cancel" id="ac-nm-cancel" type="button" data-cms="account.signedIn.cancel">{si.cancel || 'Cancel'}</button>
            </form>
            <div class="em" id="ac-email"></div>
          </div>
        </div>
        <nav>
          <a href="#library" data-cms="account.signedIn.navLibrary">{si.navLibrary || 'Your library'}</a>
          <a href="#letter" data-hide-admin data-cms="account.signedIn.navLetter">{si.navLetter || 'The letter'}</a>
          <a href="#studio" id="ac-studio-nav" hidden data-cms="account.signedIn.navStudio">{si.navStudio || 'Studio'}</a>
        </nav>
        <div class="out"><a href="#" id="ac-signout" data-cms="account.signedIn.signOut">{si.signOut || 'Sign out'}</a></div>
      </aside>

      <div>
        <header class="acct-head">
          <div class="kicker"><span class="line"></span><span class="eyebrow" data-cms="account.signedIn.eyebrow">{si.eyebrow || 'Your account'}</span></div>
          <h1 data-cms="account.signedIn.heading">{si.heading || "Everything you've unlocked"}</h1>
        </header>

        <section class="panel" id="library">
          <h2 id="lib-heading" data-cms="account.signedIn.libraryHeading">{si.libraryHeading || 'Your library'}</h2>
          <div class="lib" id="lib-list"></div>
          <p class="lib-empty" id="lib-empty" hidden set:html={libEmptyHtml}></p>
        </section>

        <section class="panel" id="studio" hidden>
          <h2 data-cms="account.signedIn.studioHeading">{si.studioHeading || 'Studio'}</h2>
          <a class="card studio-card" href="/admin">
            <div>
              <div class="sc-t" data-cms="account.signedIn.studioCardTitle">{si.studioCardTitle || 'Open the Studio'}</div>
              <div class="sc-s" data-cms="account.signedIn.studioCardSub">{si.studioCardSub || 'Write and publish, manage posts, the audience, analytics and revenue.'}</div>
            </div>
            <span class="sc-go" data-cms="account.signedIn.studioCardCta">{si.studioCardCta || 'Enter →'}</span>
          </a>
        </section>

        <section class="panel" id="letter" data-hide-admin>
          <h2 data-cms="account.signedIn.letterHeading">{si.letterHeading || 'The letter'}</h2>
          <SubscribeForm
            heading={si.newsletter?.heading || 'Get the next essay by email'}
            blurb={si.newsletter?.blurb || 'New essays on LLM engineering and the systems underneath. No noise — and you can unsubscribe from any email in one click.'}
          />
        </section>
      </div>
    </div>
  </div>

  <script type="application/json" id="posts-meta" set:html={JSON.stringify(postsMeta)}></script>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const checking = document.getElementById('acct-checking')!;
  const signedout = document.getElementById('acct-signedout')!;
  const signedin = document.getElementById('acct-signedin')!;
  const postsMeta: Record<string, { title: string; mins: number }> =
    JSON.parse(document.getElementById('posts-meta')?.textContent || '{}');

  // Editable copy (status messages + library-row strings) from the JSON <script> above.
  const AC: any = (() => { try { return JSON.parse(document.getElementById('account-copy')?.textContent || '{}'); } catch { return {}; } })();
  const ACM = AC.msg || {};
  const ACL = AC.lib || {};

  const show = (el) => {
    for (const v of [checking, signedout, signedin]) v.hidden = v !== el;
  };
  const fmt = (iso) => {
    const d = new Date(iso);
    return isNaN(d.valueOf()) ? '' : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  };

  // Render guard. onAuthStateChange fires SIGNED_IN on every load/refocus, so render()
  // can run repeatedly. `seq` ensures only the LATEST run writes to the DOM (kills the
  // duplicated library rows + the content-length flicker); `lastUid` skips re-renders
  // when the signed-in user hasn't actually changed.
  let seq = 0;
  let lastUid = '␀';

  // Build the "Your library" rows from the reader's entitlements (RLS reads-own).
  async function loadLibrary(my) {
    const list = document.getElementById('lib-list');
    const empty = document.getElementById('lib-empty');
    const heading = document.getElementById('lib-heading');
    let rows = [];
    try {
      const { data } = await supabase
        .from('entitlements')
        .select('post_id, created_at')
        .order('created_at', { ascending: false });
      rows = data || [];
    } catch { rows = []; }
    if (my !== seq) return; // superseded by a newer render — do not touch the DOM
    list.textContent = '';
    if (!rows.length) {
      empty.hidden = false;
      heading.textContent = AC.libraryHeading || 'Your library';
      return;
    }
    empty.hidden = true;
    heading.textContent = `${AC.libraryHeading || 'Your library'} — ${rows.length} ${rows.length === 1 ? (ACL.essaySingular || 'essay') : (ACL.essayPlural || 'essays')}`;
    for (const r of rows) {
      const meta = postsMeta[r.post_id];
      const a = document.createElement('a');
      a.className = 'lib-row';
      a.href = `/blog/${r.post_id}`;
      const t = document.createElement('span');
      t.className = 't';
      t.textContent = meta ? meta.title : r.post_id; // textContent = XSS-safe
      const small = document.createElement('small');
      small.textContent = `${ACL.unlockedPrefix || 'Unlocked'} ${fmt(r.created_at)}${meta ? ` · ${meta.mins} ${ACL.minLabel || 'min'}` : ''}`;
      t.appendChild(small);
      const st = document.createElement('span');
      st.className = 'st';
      st.textContent = ACL.owned || 'Owned';
      const go = document.createElement('span');
      go.className = 'go';
      go.textContent = ACL.readAgain || 'Read again →';
      a.append(t, st, go);
      list.appendChild(a);
    }
  }

  const currentName = (user) => {
    const email = user.email ?? '';
    return user.user_metadata?.name || user.user_metadata?.full_name || user.user_metadata?.user_name || (email ? email.split('@')[0] : 'Reader');
  };

  async function render() {
    const my = ++seq;
    const { data } = await supabase.auth.getSession();
    if (my !== seq) return;
    const user = data.session?.user || null;
    lastUid = user ? user.id : '';
    if (!user) { show(signedout); return; }

    const name = currentName(user);
    document.getElementById('ac-email').textContent = user.email ?? '';
    document.getElementById('ac-name').textContent = name;
    document.getElementById('ac-initial').textContent = (name || 'r').trim().charAt(0) || 'r';
    show(signedin);

    loadLibrary(my);

    // Admins get the Studio panel + sidebar link.
    try {
      const { data: isAdmin } = await supabase.rpc('is_admin');
      if (my === seq && isAdmin === true) {
        document.getElementById('studio').hidden = false;
        document.getElementById('ac-studio-nav').hidden = false;
      }
    } catch { /* not admin / RPC unavailable — leave hidden */ }
  }

  // Auth actions. Redirect to HOME after sign-in — the callback is consumed on any
  // page by BaseLayout's auth handler — so a magic link lands on the homepage, signed
  // in, rather than on a bare /account page.
  const origin = window.location.origin;
  document.getElementById('si-github')?.addEventListener('click', async () => {
    const s = document.getElementById('si-status');
    if (s) s.textContent = ACM.redirecting || 'Redirecting to GitHub…';
    await supabase.auth.signInWithOAuth({ provider: 'github', options: { redirectTo: origin + '/' } });
  });
  // Email OTP, SAME-TAB (R10): send a 6-digit code, then verify it here so sign-in
  // completes in this tab instead of opening a new one from the emailed link.
  let siPendingEmail = '';
  const siMagic = document.getElementById('si-magic');
  const siCode = document.getElementById('si-code');
  siMagic?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('si-email').value.trim();
    const s = document.getElementById('si-status');
    if (!email) return;
    if (s) s.textContent = ACM.sending || 'Sending…';
    const { error } = await supabase.auth.signInWithOtp({ email, options: { emailRedirectTo: origin + '/' } });
    if (error) { if (s) s.textContent = error.message; return; }
    siPendingEmail = email;
    if (siMagic) siMagic.hidden = true;
    if (siCode) siCode.hidden = false;
    if (s) s.textContent = ACM.codeSent || 'We emailed you a 6-digit code. Enter it here to finish signing in.';
    document.getElementById('si-token')?.focus();
  });
  siCode?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = document.getElementById('si-token').value.trim();
    const s = document.getElementById('si-status');
    if (!token) { if (s) s.textContent = ACM.enterCode || 'Enter the code from your email.'; return; }
    if (s) s.textContent = ACM.verifying || 'Verifying…';
    const { error } = await supabase.auth.verifyOtp({ email: siPendingEmail, token, type: 'email' });
    if (error) { if (s) s.textContent = error.message; return; }
    // Signed in right here — the render guard below will swap to the account view.
    if (s) s.textContent = ACM.signedIn || 'Signed in.';
  });
  document.getElementById('si-back')?.addEventListener('click', () => {
    const s = document.getElementById('si-status');
    if (siCode) siCode.hidden = true;
    if (siMagic) siMagic.hidden = false;
    if (s) s.textContent = '';
    document.getElementById('si-email')?.focus();
  });

  document.getElementById('ac-signout')?.addEventListener('click', async (e) => {
    e.preventDefault();
    await supabase.auth.signOut();
    render();
  });

  // Pen name — a subtle inline edit that persists to the user's Supabase display name.
  const nameRow = document.querySelector('.nm-row');
  const nmForm = document.getElementById('ac-nm-form');
  const nmInput = document.getElementById('ac-nm-input');
  const closeNameEdit = () => { nmForm.hidden = true; nameRow.hidden = false; };
  document.getElementById('ac-edit')?.addEventListener('click', () => {
    nmInput.value = document.getElementById('ac-name').textContent || '';
    nmForm.hidden = false;
    nameRow.hidden = true;
    nmInput.focus();
    nmInput.select();
  });
  document.getElementById('ac-nm-cancel')?.addEventListener('click', closeNameEdit);
  nmForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = nmInput.value.trim();
    if (!val) { closeNameEdit(); return; }
    document.getElementById('ac-name').textContent = val;
    document.getElementById('ac-initial').textContent = val.charAt(0);
    closeNameEdit();
    try { await supabase.auth.updateUser({ data: { name: val } }); } catch {}
  });

  // Re-render only on REAL auth changes (skip the repeated same-user SIGNED_IN noise).
  supabase.auth.onAuthStateChange((_e, session) => {
    const uid = session?.user?.id || '';
    if (uid === lastUid) return;
    render();
  });
  render();
</script>

<style>
  .acct-checking { padding: clamp(60px, 12vw, 140px) 0; color: var(--ink-faint); font-family: var(--sans); }

  /* ---- signed-out sign-in ---- */
  .signin { padding-bottom: clamp(56px, 8vw, 96px); }
  .signin .page-head h1 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(36px, 6vw, 60px); line-height: 1.04; letter-spacing: -0.02em; margin: 0; }
  .signin .page-head h1 em { font-style: italic; color: var(--accent); }
  .signin-card { max-width: 420px; padding: clamp(26px, 4vw, 36px); margin-top: clamp(24px, 3vw, 36px); }
  .signin-card .btn-primary { width: 100%; justify-content: center; }
  .signin-card .or { text-align: center; margin: 16px 0; font-family: var(--sans); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .si-magic { display: flex; gap: 10px; flex-wrap: wrap; }
  .si-magic input { flex: 1; min-width: 200px; font-family: var(--sans); font-size: 15px; padding: 13px 16px; border-radius: 2px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); }
  .si-magic input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .si-status { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); margin: 14px 0 0; }

  /* ---- signed-in account ---- */
  .acct { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 96px); align-items: start; }
  @media (max-width: 900px) { .acct { grid-template-columns: 1fr; gap: 32px; } }
  .side { position: sticky; top: 96px; }
  @media (max-width: 900px) { .side { position: static; } }
  .who { display: flex; align-items: center; gap: 14px; padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid var(--rule); }
  .who .avatar { width: 46px; height: 46px; border-radius: 999px; background: radial-gradient(120% 120% at 30% 20%, var(--accent-soft), var(--accent)); display: grid; place-items: center; color: var(--on-accent); font-family: var(--serif-display); font-size: 19px; text-transform: lowercase; flex: none; }
  .who-main { min-width: 0; }
  .who .nm { font-family: var(--serif-display); font-size: 19px; line-height: 1.2; }
  .who .em { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); margin-top: 3px; word-break: break-all; }
  /* Subtle pen-name edit. */
  .nm-row { display: flex; align-items: center; gap: 8px; }
  .nm-edit { border: 0; background: transparent; color: var(--ink-faint); cursor: pointer; padding: 3px; border-radius: 4px; display: grid; place-items: center; opacity: 0; transition: color 0.2s, background 0.2s, opacity 0.2s; }
  .who:hover .nm-edit, .nm-edit:focus-visible { opacity: 1; }
  .nm-edit:hover { color: var(--accent); background: var(--paper-2); }
  .nm-form { display: flex; gap: 6px; align-items: center; margin: 2px 0; flex-wrap: wrap; }
  .nm-form input { flex: 1; min-width: 120px; font-family: var(--sans); font-size: 14px; padding: 6px 10px; border-radius: 3px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); }
  .nm-form input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .nm-cancel { border: 0; background: transparent; color: var(--ink-faint); font-family: var(--sans); font-size: 12px; cursor: pointer; }
  .nm-cancel:hover { color: var(--accent); }
  .side nav { display: flex; flex-direction: column; gap: 2px; font-family: var(--sans); font-size: 14.5px; }
  .side nav a { padding: 9px 12px; border-radius: 3px; color: var(--ink-soft); transition: background 0.2s, color 0.2s; }
  .side nav a:hover { background: var(--paper-2); color: var(--ink); }
  .side .out { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--rule); font-family: var(--sans); font-size: 13.5px; }
  .side .out a { color: var(--ink-faint); transition: color 0.2s; }
  .side .out a:hover { color: var(--accent); }

  .acct-head { padding: 0 0 clamp(24px, 3vw, 34px); }
  .acct-head .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .acct-head .kicker .line { height: 1px; width: 48px; background: var(--accent); opacity: 0.6; }
  .acct-head h1 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(32px, 4.6vw, 48px); line-height: 1.06; letter-spacing: -0.02em; margin: 0; }

  .panel { margin-bottom: clamp(28px, 4vw, 44px); scroll-margin-top: 84px; }
  .panel > h2 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 16px; font-weight: 600; }

  .lib { border-top: 1px solid var(--rule); }
  /* The library rows are created in JS (from entitlements), so Astro's scoped
     styles (data-astro-cid) would NOT reach them — these MUST be :global. */
  :global(.lib-row) { display: grid; grid-template-columns: minmax(0, 1fr) 120px 130px; gap: 20px; align-items: center; padding: 18px 6px; border-bottom: 1px solid var(--rule); transition: background 0.22s; }
  :global(.lib-row:hover) { background: var(--paper-2); }
  @media (max-width: 760px) { :global(.lib-row) { grid-template-columns: 1fr; gap: 8px; } }
  :global(.lib-row .t) { font-family: var(--serif-display); font-size: 19px; line-height: 1.25; color: var(--ink); }
  :global(.lib-row .t small) { display: block; font-family: var(--sans); font-size: 12.5px; color: var(--ink-faint); margin-top: 5px; letter-spacing: 0.02em; }
  :global(.lib-row .st) { font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  :global(.lib-row .go) { font-family: var(--sans); font-size: 14px; color: var(--ink-soft); text-align: right; }
  @media (max-width: 760px) { :global(.lib-row .go) { text-align: left; } }
  :global(.lib-row:hover .go) { color: var(--accent); }
  .lib-empty { color: var(--ink-faint); font-family: var(--sans); font-size: 15px; padding: 8px 0; }

  .studio-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: clamp(22px, 2.6vw, 28px); }
  .studio-card .sc-t { font-family: var(--serif-display); font-size: 21px; color: var(--ink); }
  .studio-card .sc-s { font-family: var(--sans); font-size: 14px; color: var(--ink-soft); margin-top: 5px; max-width: 46ch; }
  .studio-card .sc-go { font-family: var(--sans); font-size: 14px; color: var(--accent); white-space: nowrap; }
  .studio-card:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--rule)); }
</style>
