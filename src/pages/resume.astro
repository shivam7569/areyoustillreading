---
// =============================================================================
// FILE: src/pages/resume.astro   ·   ROUTE: /resume  (static, prerendered)
// -----------------------------------------------------------------------------
// The public resume / CV in the Phase-5 EDITORIAL skin, matching the Claude
// Design "the cut" layout. It is now DATA-DRIVEN: all content + display settings
// live in src/data/resume.json and are edited from the Studio (/admin/resume);
// this page just renders that data at build time. No client JS beyond the
// optional print trigger.
//
// HONEST CONTENT: resume.json is seeded verbatim from the real CV (real email,
// real bullets with **metric** emphasis). Editing content = edit resume.json
// (by hand or via the Studio, which commits it) — never hard-code here.
//
// WHAT THE SETTINGS DO
//   - sections[]        order + show/hide of each block (header + experience are
//                       locked on). Rendered in array order.
//   - figCols/skills.cols/pubs.cols   column counts (CSS vars --fig/--skill/--pub-cols)
//   - skills.style      'chips' | 'list'
//   - experience.layout 'rail' (dates in a left column) | 'inline' (dates above)
//   - experience.density 'full' | 'tight' (first two bullets)
//   - download.mode     'print' → a window.print() button (uses the @media print
//                       styles below); 'file' (+pdfName) → a real /resume.pdf link.
//
// The print <style is:global> hides global chrome + resets :root tokens with
// !important so Ctrl+P (and the print-mode button) produce a clean CV in BOTH
// themes — see the note on that block.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/resume.json';

const { header, figs, figCols, summary, experience, skills, pubs, education, sections, download } = data;
const closeText = data.close;

// show/order derived from the sections array (header is always on).
const order = sections.map((s) => s.key);
const shown = Object.fromEntries(sections.map((s) => [s.key, s.show !== false]));

// Role line: first phrase in accent italic, the rest ·-separated (design).
const roleParts = header.role.split('·').map((s) => s.trim()).filter(Boolean);
// The mailto used by the closing "Get in touch" button.
const emailHref = (header.contacts.find((c) => c.href?.startsWith('mailto:')) || {}).href || '#';

// Split a bullet on **bold** markers into ordered segments (real <b>, scoped + escaped).
const mark = (s) => s.split(/\*\*(.+?)\*\*/g).map((t, i) => ({ t, b: i % 2 === 1 }));

const visibleRoles = experience.roles.filter((r) => r.show !== false);
const roleBullets = (r) => (experience.density === 'tight' ? r.bullets.slice(0, 2) : r.bullets);

// Download affordance: a real file link only when a PDF has been uploaded AND
// file mode is selected; otherwise print the page.
const pdfReady = download.mode === 'file' && !!download.pdfName;
---

<BaseLayout
  title={`Resume — ${header.name}`}
  description="Senior Data Scientist — production LLM/Agentic AI, ML/DL, causal inference, and computer vision."
  wide
>
  <div class="wrap">
    {order.map((key) => (
      <>
        {key === 'header' && (
          <header class="cv-head">
            <div>
              <div class="kicker">
                <span class="line"></span>
                <span class="eyebrow">Curriculum vitae</span>
              </div>
              <h1>{header.name}</h1>
              <p class="role"><b>{roleParts[0]}</b>{roleParts.slice(1).map((p) => (<><span aria-hidden="true">·</span>{p}</>))}</p>
              <div class="facts">
                {header.contacts.map((c) => (<a href={c.href}>{c.label}</a>))}
              </div>
            </div>
            {pdfReady ? (
              <a class="btn btn-ghost dl" href="/resume.pdf" download>Download PDF
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
              </a>
            ) : (
              <button class="btn btn-ghost dl" type="button" onclick="window.print()">Download PDF
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
              </button>
            )}
          </header>
        )}

        {key === 'figs' && shown.figs && (
          <div class="figs" style={`--fig-cols:${figCols}`}>
            {figs.map((f) => (<div class="fig"><b>{f.n}</b><span>{f.l}</span></div>))}
          </div>
        )}

        {key === 'summary' && shown.summary && (
          <div class="cv-summary"><p>{summary}</p></div>
        )}

        {key === 'experience' && shown.experience && (
          <section class="sect exp" data-layout={experience.layout}>
            <h2>Experience</h2>
            {visibleRoles.map((job) => (
              <article class="job">
                <div class="when">
                  {job.dates}
                  <span class="place">{job.company}</span>
                  {job.where && <span class="where">{job.where}</span>}
                </div>
                <div>
                  <h3>{job.title}</h3>
                  <ul>
                    {roleBullets(job).map((p) => (
                      <li>{mark(p).map((seg) => (seg.b ? <b>{seg.t}</b> : seg.t))}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </section>
        )}

        {key === 'skills' && shown.skills && (
          <section class="sect">
            <h2>What I work with</h2>
            <div class="skills" style={`--skill-cols:${skills.cols}`}>
              {skills.groups.map((s) => (
                <div>
                  <h3>{s.group}</h3>
                  {skills.style === 'list' ? (
                    <ul class="skill-list">{s.items.split(', ').map((i) => <li>{i}</li>)}</ul>
                  ) : (
                    <div class="chips">{s.items.split(', ').map((i) => <span>{i}</span>)}</div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        {key === 'pubs' && shown.pubs && (
          <section class="sect">
            <h2>Publications &amp; patents</h2>
            <div class="pubs" style={`--pub-cols:${pubs.cols}`}>
              {pubs.items.map((p) => (
                <div class="pub"><span class="k">{p.kicker}</span><p>{p.body}</p></div>
              ))}
            </div>
          </section>
        )}

        {key === 'education' && shown.education && (
          <section class="sect">
            <h2>Education</h2>
            <div class="edu">
              <span class="t">{education.degree}<small>{education.school}</small></span>
              <span class="y">{education.dates}</span>
            </div>
          </section>
        )}

        {key === 'close' && shown.close && (
          <div class="cv-close">
            <span>{closeText}</span>
            <div class="close-actions">
              <a class="btn btn-ghost btn-sm" href={emailHref}>Get in touch</a>
              <a class="btn btn-primary btn-sm proj-cta" href="/projects">See selected projects <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </div>
        )}
      </>
    ))}
  </div>
</BaseLayout>

<style>
  .cv-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:end;padding:clamp(44px,6vw,80px) 0 clamp(22px,3vw,32px)}
  @media(max-width:820px){.cv-head{grid-template-columns:1fr;align-items:start;gap:22px}}
  .cv-head .kicker{display:flex;align-items:center;gap:14px;margin-bottom:20px}
  .cv-head .kicker .line{height:1px;width:48px;background:var(--accent);opacity:.6}
  .cv-head h1{font-family:var(--serif-display);font-weight:600;font-size:clamp(38px,6.4vw,66px);line-height:1.02;letter-spacing:-.025em;margin:0 0 14px}
  .role{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;font-family:var(--serif-display);font-size:clamp(17px,2.1vw,21px);color:var(--ink-soft);margin:0 0 20px}
  .role b{font-weight:600;font-style:italic;color:var(--accent)}
  .role span{color:var(--ink-faint)}
  .facts{display:flex;flex-wrap:wrap;gap:8px 20px;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
  .facts a{color:var(--ink-soft);border-bottom:1px solid var(--rule);transition:color .2s,border-color .2s}
  .facts a:hover{color:var(--accent);border-color:var(--accent)}

  /* the numbers a hiring manager scans for, pulled out of the bullets */
  .figs{display:grid;grid-template-columns:repeat(var(--fig-cols,4),minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:5px;overflow:hidden;margin-bottom:clamp(26px,3.6vw,40px)}
  @media(max-width:820px){.figs{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .fig{background:var(--card);padding:18px 20px}
  .fig b{display:block;font-family:var(--serif-display);font-weight:600;font-size:clamp(24px,3vw,31px);letter-spacing:-.015em;color:var(--accent);line-height:1.05;font-variant-numeric:tabular-nums}
  .fig span{display:block;font-family:var(--sans);font-size:12px;line-height:1.45;color:var(--ink-faint);margin-top:7px}

  .cv-summary{padding:0 0 clamp(28px,4vw,42px);border-bottom:1px solid var(--rule)}
  .cv-summary p{max-width:64ch;color:var(--ink-soft);font-size:18.5px;line-height:1.65;margin:0;text-wrap:pretty}

  .sect{padding:clamp(36px,4.6vw,56px) 0 0}
  .sect > h2{font-family:var(--sans);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 28px;font-weight:600;display:flex;align-items:center;gap:14px}
  .sect > h2::after{content:"";flex:1;height:1px;background:var(--rule)}

  .job{display:grid;grid-template-columns:186px minmax(0,1fr);gap:clamp(18px,3vw,44px);padding:0 0 30px;margin-bottom:30px;border-bottom:1px solid var(--rule)}
  .job:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}
  @media(max-width:820px){.job{grid-template-columns:1fr;gap:10px}}
  /* inline layout: dates sit above the title in a single column */
  .exp[data-layout="inline"] .job{grid-template-columns:1fr;gap:8px}
  .exp[data-layout="inline"] .when{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;padding-top:0}
  .exp[data-layout="inline"] .when .place{display:inline;margin-top:0}
  .exp[data-layout="inline"] .when .where{display:inline;margin-top:0}
  .job .when{font-family:var(--sans);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);padding-top:6px;font-variant-numeric:tabular-nums}
  .job .when .place{display:block;margin-top:8px;font-family:var(--serif-display);font-size:16.5px;line-height:1.3;letter-spacing:0;text-transform:none;color:var(--ink)}
  .job .when .where{display:block;margin-top:4px;font-size:11.5px;letter-spacing:.06em;text-transform:none;color:var(--ink-faint)}
  .job h3{font-family:var(--serif-display);font-weight:600;font-size:24px;line-height:1.2;margin:0 0 14px;letter-spacing:-.01em}
  .job ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:13px;max-width:64ch}
  .job li{position:relative;padding-left:22px;color:var(--ink);font-size:17px;line-height:1.6;text-wrap:pretty}
  .job li::before{content:"";position:absolute;left:0;top:.72em;width:9px;height:1px;background:var(--accent)}
  .job li b{font-weight:600;color:var(--accent)}

  .skills{display:grid;grid-template-columns:repeat(var(--skill-cols,4),minmax(0,1fr));gap:clamp(20px,3vw,36px)}
  @media(max-width:960px){.skills{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}}
  @media(max-width:520px){.skills{grid-template-columns:1fr}}
  .skills h3{font-family:var(--sans);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 14px;font-weight:600}
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .chips span{font-family:var(--sans);font-size:13px;color:var(--ink-soft);border:1px solid var(--rule);border-radius:2px;padding:5px 10px;background:var(--card)}
  .skill-list{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:7px;font-family:var(--sans);font-size:14px;color:var(--ink-soft)}

  .pubs{display:grid;grid-template-columns:repeat(var(--pub-cols,2),minmax(0,1fr));gap:clamp(18px,2.6vw,26px)}
  @media(max-width:820px){.pubs{grid-template-columns:1fr}}
  .pub{border:1px solid var(--rule);border-radius:5px;background:var(--card);padding:20px 22px}
  .pub .k{font-family:var(--sans);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:600;display:block;margin-bottom:9px}
  .pub p{margin:0;font-size:16.5px;line-height:1.6;color:var(--ink-soft);text-wrap:pretty}

  .edu{display:flex;justify-content:space-between;gap:20px;padding:16px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);flex-wrap:wrap}
  .edu .t{font-family:var(--serif-display);font-size:19px;font-weight:600}
  .edu .t small{display:block;font-family:var(--sans);font-size:13.5px;font-weight:400;color:var(--ink-faint);margin-top:5px}
  .edu .y{font-family:var(--sans);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);white-space:nowrap;padding-top:6px}

  .cv-close{margin-top:clamp(38px,5vw,60px);padding-top:28px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:18px 28px;flex-wrap:wrap;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
  .close-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  /* Projects is the emphasised CTA — filled accent + a forward arrow that nudges on
     hover. It sits last (nothing to its right) so the arrow can't read as pointing
     at the adjacent button. */
  .proj-cta .arrow{display:inline-block;margin-left:3px;transition:transform .2s var(--ease)}
  .proj-cta:hover .arrow{transform:translateX(3px)}
</style>

{/* Print styles live GLOBAL: they hide BaseLayout-owned chrome and reset :root
   tokens to ink-on-white. !important on the custom properties beats the always-
   present :root[data-theme] selectors, so Ctrl+P (and the print-mode Download
   button) print a clean CV in BOTH themes. Printing a CV should print a CV. */}
<style is:global>
  @media print {
    @page { margin: 14mm }
    .site-header, .site-footer, .theme-toggle, .dl, .close-actions .btn { display: none !important }
    :root {
      --paper:#fff !important; --card:#fff !important; --ink:#111 !important;
      --ink-soft:#333 !important; --ink-faint:#555 !important;
      --rule:#c9c9c9 !important; --rule-soft:#e2e2e2 !important; --accent:#5e3560 !important;
    }
    body { background:#fff }
    .wrap { max-width:none; padding:0 }
    .cv-head { padding:0 0 14px }
    .cv-head h1 { font-size:32pt }
    .role { font-size:12pt; margin-bottom:10px }
    .figs { break-inside:avoid }
    .sect { padding-top:20px }
    .job, .pub, .edu { break-inside:avoid }
    .job li { font-size:10.5pt; line-height:1.45 }
    .cv-summary p { font-size:11pt }
  }
</style>
