---
// =============================================================================
// FILE: src/pages/resume.astro
// ROUTE: /resume  (static HTML, prerendered at build time)
// -----------------------------------------------------------------------------
// WHAT THIS IS
//   The public resume / CV page for Shivam Chaudhary, in the Phase-5 EDITORIAL
//   skin (warm paper + ink, plum/bronze accent, serif display). It is a plain,
//   fully static Astro page: all content lives in the frontmatter arrays below
//   and is rendered once at `npm run build`, then shipped to Cloudflare Pages as
//   flat HTML. There is no client-side JavaScript, no data fetching, and no
//   interactivity beyond ordinary anchor links.
//
// SINGLE RESPONSIBILITY
//   Present the author's experience, skills, publications, and education, plus
//   two outbound actions: contact links and a PDF download. Nothing else.
//
// HOW IT FITS THE ARCHITECTURE
//   - This is one of the "flat" marketing/portfolio pages. Unlike the blog,
//     /gated, auth, or payment routes, it touches NONE of the dynamic backend:
//     no Cloudflare Pages Functions, no Supabase / PostgREST, no RLS, no Resend,
//     no Turnstile, no Dodo Payments, no Supabase auth client. If you are here
//     hunting for a security bug, there is no server logic, no token check, no
//     entitlement gate, and no user input on this page — it cannot leak data
//     because it never reads any.
//   - It composes the shared <BaseLayout>, which supplies the <html>/<head>,
//     global styles, nav/footer, SEO/OG tags, etc. This page passes `wide` so it
//     manages its own .wrap width (editorial full-bleed), and only provides the
//     <title>, <description>, and the main body content.
//
// DEPENDENCIES (imports / relies on)
//   - ../layouts/BaseLayout.astro  — page shell (head, nav, footer). BaseLayout
//     imports the site-wide src/styles/global.css, which defines the editorial
//     utility classes reused below (.wrap .eyebrow .btn .btn-ghost .btn-primary
//     .btn-sm) and the design tokens the scoped <style> consumes (--paper/--ink/
//     --rule/--accent/--serif-display/--sans). Change colours THERE, not here.
//   - /resume.pdf  — a STATIC asset served from the `public/` directory (the
//     "Download PDF" link). It is not generated by this page; if the PDF is
//     stale, update the file in public/, not this component. A broken/missing
//     public/resume.pdf yields a 404 on click — nothing here validates it.
//
// WHAT DEPENDS ON THIS
//   - The site nav / any internal link pointing at `/resume`.
//   - SEO/sitemap: @astrojs/sitemap will include this route automatically.
//   - The <title>/<description> props feed OG image + meta generation via
//     BaseLayout; changing them changes the page's search/social preview.
//
// SECURITY / GOTCHAS
//   - The mailto: and profile links are hardcoded and public by design (this is
//     a resume). No PII beyond what the author intends to publish appears here.
//   - Content is authored as trusted literals below and rendered through JSX
//     expressions, so Astro HTML-escapes it — there is no `set:html` and no
//     user-supplied/untrusted input, so no XSS surface.
//   - Editing content = edit the arrays below; the template is generic and
//     should rarely need to change.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';

// ---------------------------------------------------------------------------
// CONTENT MODEL
// The page is data-driven: each section maps over one of these plain arrays.
// Keeping copy as structured data (rather than inline markup) means adding a
// job / skill / publication is a one-line data edit, and the visual template
// stays untouched. Order in each array === render order on the page.
// ---------------------------------------------------------------------------

// Work history, newest-first. Each entry: { role, company, dates, points[] }.
// `dates` is a free-form display string (not parsed), so any human-readable
// range works. `points` are the bullet lines rendered under the entry.
const experience = [
  {
    role: 'Sr. Data Scientist',
    company: 'Aviso AI',
    dates: "May '25 – Present",
    points: [
      'Architected a multi-agent LLM system processing 100K+ deals daily across 15 enterprise clients, replacing rule-based logic with insight generation from CRM and engagement data, governed by evaluation and safety guardrails.',
      'Replaced correlation-based explainability with a causal-inference backbone (Double Machine Learning, Causal Forests) to surface actionable recommendations — driving a ~12% increase in sales-rep engagement.',
      'Built and scaled the LLM engineering function: defined the technical hiring bar and grew the team from 1 to 5 engineers for end-to-end development and production deployment.',
    ],
  },
  {
    role: 'Sr. Computer Vision Engineer',
    company: 'Bosch Global Software Technologies',
    dates: "Aug '22 – Apr '25",
    points: [
      'Published a research paper and filed a patent on enhancing foundation models (EVA-02), leveraging 90%+ unlabeled Bosch data to boost performance by ~5%; collaborated with Bosch Romania to further improve EVA by ~4.31% via cluster analysis and hypothesis testing on DINOv2 embeddings.',
      'Built a Vision Assignment Marketplace, training SWin, DeiT, and DeTr with ~6.72% average performance deviation; designed a ConvNeXt segmentation pipeline on fisheye images (~57% F1).',
      'Deployed an object detector and motion analyzer on a Jetson Nano edge test-bed at ~30 FPS; refactored legacy code for newer vision-transformer architectures, improving adaptability/efficiency by 14%.',
    ],
  },
  {
    role: 'Data Scientist II',
    company: 'HiLabs Inc.',
    dates: "Oct '20 – Jul '22",
    points: [
      'Engineered a multi-million-dollar data pipeline moving anomalies from large-scale SQL/RDBMS sources to HBase and Solr for ticket-based remediation, improving Data Quality Index from ~78 to ~86; projected to prevent $200M+ in annual losses for a leading U.S. health insurer.',
      'Deployed an enterprise-grade OCR solution (NLP + custom algorithms) on contracts after GAN-based image enhancement, generating $100K+ in business value.',
    ],
  },
  {
    role: 'Machine Learning Engineer Intern',
    company: 'GMO Research (Japan)',
    dates: "Jan '20 – Mar '20",
    points: [
      'Forecast 6-hour survey response likelihood with time-aware Random Forests, Decision Trees, and DNNs; addressed class imbalance via SMOTE and custom metrics, achieving 91% efficacy on responsive marketing panels.',
    ],
  },
];

// Skills, grouped by category. `items` is a pre-joined display string; the
// editorial layout splits it on ", " into one line per skill inside a column.
const skills = [
  { group: 'Languages & Libraries', items: 'Python, SQL, Scala, Pandas, NumPy, Scikit-Learn' },
  { group: 'Big Data & MLOps', items: 'Spark, Hadoop, HBase, Solr, AWS, Docker, Git, CI/CD, GPU/HPC' },
  { group: 'ML / DL / LLM', items: 'PyTorch, TensorFlow, Transformers, LangChain, LangGraph, RAG, Agentic AI, MCP' },
  { group: 'Models & Paradigms', items: 'Time-Series Forecasting, Recommendation, Causal Inference, Anomaly Detection, Computer Vision' },
];

// Publications & patents, as flat display strings (no links/DOIs modeled). Each
// is split on the first ": " into a lead label + detail for the line-item view.
const publications = [
  'Patent (co-authored): dimensionality-reduction techniques to detect and localize failure regions in segmentation outputs from foundation models, improving interpretability and reliability.',
  'Research: a two-stage fine-tuning approach improving foundation-model segmentation performance by 5%+ mIoU using unlabeled data (semi-supervised learning).',
];

// Split "Label: detail" once so the line-item can show the label as the title
// and the detail as its subtitle, without altering any of the source text.
const splitPub = (p: string) => {
  const i = p.indexOf(': ');
  return i === -1 ? { label: p, detail: '' } : { label: p.slice(0, i), detail: p.slice(i + 2) };
};
---

{/*
  BaseLayout supplies the full page chrome (head/meta/OG, nav, footer, global
  CSS). `wide` opts out of the reading column so this page runs its own .wrap.
  `title` and `description` flow into SEO + social-preview generation, so treat
  them as user-facing metadata, not just a browser-tab label.
*/}
<BaseLayout
  title="Resume — Shivam Chaudhary"
  description="Senior Data Scientist — production LLM/Agentic AI, ML/DL, causal inference, and computer vision."
  wide
>
  <div class="wrap">
    {/* CV masthead: name, italic role line, contact facts, and a ghost PDF link. */}
    <header class="cv-head">
      <div>
        <div class="kicker" style="display:flex;align-items:center;gap:14px;margin-bottom:22px">
          <span style="height:1px;width:48px;background:var(--accent);opacity:.6"></span>
          <span class="eyebrow">Curriculum vitae</span>
        </div>
        <h1>Shivam Chaudhary</h1>
        <p class="role">Senior Data Scientist · Production LLM &amp; Agentic AI · Causal Inference · Computer Vision</p>
        <div class="facts">
          <a href="mailto:shivam.iitmandi@gmail.com">shivam.iitmandi@gmail.com</a>
          <a href="https://github.com/shivam7569">github.com/shivam7569</a>
          <a href="https://www.linkedin.com/in/shivam7569/">linkedin.com/in/shivam7569</a>
        </div>
      </div>
      {/* The `download` attribute hints the browser to save rather than navigate;
          /resume.pdf is a static file in public/ (see file header) — this page
          does not generate or verify it. */}
      <a class="btn btn-ghost" href="/resume.pdf" download>Download PDF
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
      </a>
    </header>

    <div class="cv-summary">
      <p>
        Senior Data Scientist with 6+ years applying scientific methods to high-stakes business
        problems, building production-grade ML/DL and end-to-end LLM/Agentic AI systems at scale.
        Hands-on across time-series forecasting, causal inference, recommendation, and large-scale
        data, with a product-oriented mindset and a habit of turning research into real-world impact.
      </p>
    </div>

    {/* One .job per role, in array order (newest-first). Nested map renders each
        bullet. No `key` needed — Astro renders this once at build time, it is not
        a hydrated/reconciled client component. */}
    <section class="sect">
      <h2>Experience</h2>
      {experience.map((job) => (
        <article class="job">
          <div class="when">{job.dates}<span class="place">{job.company}</span></div>
          <div>
            <h3>{job.role}</h3>
            <ul>
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>

    {/* Skills: each group is a column; its pre-joined string splits into rows. */}
    <section class="sect">
      <h2>What I work with</h2>
      <div class="cols">
        {skills.map((s) => (
          <div>
            <h4>{s.group}</h4>
            <ul>
              {s.items.split(', ').map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {/* Two-up: publications/patents on the left, education on the right. */}
    <section class="sect">
      <div class="two">
        <div>
          <h2 style="font-family:var(--sans);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 22px;font-weight:600">Publications &amp; Patents</h2>
          {publications.map((p) => {
            const { label, detail } = splitPub(p);
            return (
              <div class="line-item">
                <span class="t">{label}{detail && <small>{detail}</small>}</span>
              </div>
            );
          })}
        </div>
        <div>
          <h2 style="font-family:var(--sans);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 22px;font-weight:600">Education</h2>
          <div class="line-item">
            <span class="t">B.Tech, Mechanical Engineering<small>Indian Institute of Technology, Mandi · Minor in Intelligent Systems</small></span>
            <span class="y">Aug '16 – Jul '20</span>
          </div>
        </div>
      </div>
    </section>

    {/* Closing row: a plain note plus the primary contact action (real mailto). */}
    <div class="cv-close">
      <span>References available on request. Email is the fastest way to reach me.</span>
      <a class="btn btn-primary btn-sm" href="mailto:shivam.iitmandi@gmail.com">Get in touch</a>
    </div>
  </div>
</BaseLayout>

{/*
  Astro scopes this <style> to this component only (class names are hashed at
  build), so these rules cannot leak into other pages. The design tokens
  (--paper/--ink/--ink-soft/--ink-faint/--rule/--accent/--serif-display/--sans)
  are global custom properties defined in src/styles/global.css (reachable here
  because BaseLayout imports that stylesheet). This file only consumes them, and
  their values differ between light and dark mode. Class rules below are the
  page-specific editorial pieces (.cv-head/.cv-summary/.sect/.job/.cols/.two/
  .line-item/.cv-close) copied from the Phase-5 template; the shared utilities
  (.wrap/.eyebrow/.btn/.btn-ghost/.btn-primary/.btn-sm) live in global.css.
*/}
<style>
  .cv-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:end;padding:clamp(48px,7vw,88px) 0 clamp(24px,3vw,36px)}
  @media(max-width:760px){.cv-head{grid-template-columns:1fr;align-items:start}}
  .cv-head h1{font-family:var(--serif-display);font-weight:600;font-size:clamp(38px,6vw,62px);line-height:1.03;letter-spacing:-.02em;margin:0 0 14px}
  .cv-head .role{font-family:var(--serif-display);font-style:italic;font-size:clamp(19px,2.4vw,24px);color:var(--accent);margin:0 0 18px}
  .cv-head .facts{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
  .cv-head .facts a{color:var(--ink-soft);border-bottom:1px solid var(--rule);transition:color .2s,border-color .2s}
  .cv-head .facts a:hover{color:var(--accent);border-color:var(--accent)}
  .cv-summary{padding:0 0 clamp(30px,4vw,44px);border-bottom:1px solid var(--rule)}
  .cv-summary p{max-width:62ch;color:var(--ink-soft);font-size:19px;margin:0}
  .sect{padding:clamp(40px,5vw,60px) 0 0}
  .sect > h2{font-family:var(--sans);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 28px;font-weight:600}
  .job{display:grid;grid-template-columns:200px minmax(0,1fr);gap:clamp(18px,3vw,44px);padding:0 0 34px;margin-bottom:34px;border-bottom:1px solid var(--rule)}
  .job:last-child{border-bottom:0}
  @media(max-width:760px){.job{grid-template-columns:1fr;gap:10px}}
  .job .when{font-family:var(--sans);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);padding-top:7px}
  .job .when .place{display:block;margin-top:8px;font-family:var(--serif-display);font-style:italic;font-size:16px;letter-spacing:0;text-transform:none;color:var(--ink-soft)}
  .job h3{font-family:var(--serif-display);font-weight:600;font-size:25px;line-height:1.2;margin:0 0 12px;letter-spacing:-.01em}
  .job > div > p{margin:0 0 16px;color:var(--ink-soft);max-width:60ch}
  .job ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;max-width:62ch}
  .job li{position:relative;padding-left:22px;color:var(--ink);font-size:17.5px;line-height:1.6}
  .job li::before{content:"";position:absolute;left:0;top:.72em;width:8px;height:1px;background:var(--accent)}
  .job li b{font-weight:600}
  .cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(24px,4vw,48px)}
  @media(max-width:760px){.cols{grid-template-columns:1fr;gap:28px}}
  .cols h4{font-family:var(--serif-display);font-weight:600;font-size:19px;margin:0 0 14px}
  .cols ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;font-family:var(--sans);font-size:14.5px;color:var(--ink-soft)}
  .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(24px,4vw,48px)}
  @media(max-width:760px){.two{grid-template-columns:1fr;gap:30px}}
  .line-item{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid var(--rule)}
  .line-item:first-child{border-top:1px solid var(--rule)}
  .line-item .t{font-size:17px}
  .line-item .t small{display:block;font-family:var(--sans);font-size:13px;color:var(--ink-faint);margin-top:4px}
  .line-item .y{font-family:var(--sans);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);white-space:nowrap;padding-top:4px}
  .cv-close{margin-top:clamp(44px,6vw,72px);padding-top:30px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
</style>
