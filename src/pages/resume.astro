---
// =============================================================================
// FILE: src/pages/resume.astro
// ROUTE: /resume  (static HTML, prerendered at build time)
// -----------------------------------------------------------------------------
// WHAT THIS IS
//   The public resume / CV page for Shivam Chaudhary, in the Phase-5 EDITORIAL
//   skin (warm paper + ink, plum/bronze accent, serif display), built to match
//   the Claude Design "Resume — the cut" layout: a masthead, a four-figure metric
//   strip (the numbers a hiring manager scans for), a summary, a ruled Experience
//   list, skill chips, publication cards, an education row, and a closing band.
//   Fully static Astro: all copy lives in the frontmatter arrays below and is
//   rendered once at `npm run build`. No client JS, no data fetching.
//
// CONTENT IS HONEST
//   Every figure/date/claim comes from the real CV (see the arrays below). The
//   contact email is the author's real address, NOT the design mock's
//   placeholder. Bold emphasis inside bullets is authored with **markers** and
//   rendered as real <b> template markup (so Astro scopes + escapes it) — see
//   `mark()`.
//
// PDF: the "Download PDF" button serves the curated static /resume.pdf from
//   public/ (one click, no print dialog). The @media print block (in the global
//   <style> at the bottom) additionally makes Ctrl+P produce a clean CV straight
//   from this page — so the page prints well even though the button downloads.
//
// SECURITY / GOTCHAS
//   - mailto: + profile links are hardcoded and public by design (this is a CV).
//   - No user input, no set:html; all copy is trusted literals escaped by Astro.
//   - Design tokens (--paper/--ink/--rule/--accent/--serif-display/--sans) are
//     global (defined in src/styles/global.css, imported by BaseLayout). Change
//     COLOURS there, not here. Shared utilities used below: .wrap .eyebrow .btn
//     .btn-ghost .btn-primary .btn-sm.
//   - The print block hides the GLOBAL chrome (.site-header/.site-footer/
//     .theme-toggle), so it must live in a `<style is:global>` — a scoped rule
//     would be rewritten to this page's data-attr and never match those
//     BaseLayout-owned elements.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';

// ---------------------------------------------------------------------------
// CONTENT MODEL — the page is data-driven; each section maps one array.
// ---------------------------------------------------------------------------

// The figures buried in the bullets, surfaced for the ten-second scan. Honest —
// each is drawn from an Experience bullet below. { n: the number, l: the label }.
const figs = [
  { n: '100K+', l: 'Deals processed daily by a multi-agent LLM system' },
  { n: '~12%', l: 'Lift in sales-rep engagement from causal recommendations' },
  { n: '1 → 5', l: 'Grew the LLM engineering function from scratch' },
  { n: '$200M+', l: 'Annual losses projected prevented for a U.S. health insurer' },
];

// Work history, newest-first. Each: { role, company, where?, dates, points[] }.
// `where` is an optional second line under the company (e.g. an internship note).
// `points` use **double-asterisks** around the key figures the design bolds; the
// `mark()` helper turns them into <b> segments at render time.
const experience = [
  {
    role: 'Sr. Data Scientist',
    company: 'Aviso AI',
    dates: "May '25 — Present",
    points: [
      'Architected a multi-agent LLM system processing **100K+ deals daily** across 15 enterprise clients, replacing rule-based logic with insight generation from CRM and engagement data, governed by evaluation and safety guardrails.',
      'Replaced correlation-based explainability with a causal-inference backbone (Double Machine Learning, Causal Forests) to surface actionable recommendations — driving a **~12% increase** in sales-rep engagement.',
      'Built and scaled the LLM engineering function: defined the technical hiring bar and grew the team **from 1 to 5** engineers for end-to-end development and production deployment.',
    ],
  },
  {
    role: 'Sr. Computer Vision Engineer',
    company: 'Bosch Global Software Technologies',
    dates: "Aug '22 — Apr '25",
    points: [
      'Published a research paper and filed a patent on enhancing foundation models (EVA-02), leveraging **90%+ unlabeled** Bosch data to boost performance by ~5%; collaborated with Bosch Romania to further improve EVA by **~4.31%** via cluster analysis and hypothesis testing on DINOv2 embeddings.',
      'Built a Vision Assignment Marketplace, training SWin, DeiT, and DeTr with ~6.72% average performance deviation; designed a ConvNeXt segmentation pipeline on fisheye images (**~57% F1**).',
      'Deployed an object detector and motion analyzer on a Jetson Nano edge test-bed at **~30 FPS**; refactored legacy code for newer vision-transformer architectures, improving adaptability/efficiency by 14%.',
    ],
  },
  {
    role: 'Data Scientist II',
    company: 'HiLabs Inc.',
    dates: "Oct '20 — Jul '22",
    points: [
      'Engineered a multi-million-dollar data pipeline moving anomalies from large-scale SQL/RDBMS sources to HBase and Solr for ticket-based remediation, improving Data Quality Index from ~78 to **~86**; projected to prevent **$200M+** in annual losses for a leading U.S. health insurer.',
      'Deployed an enterprise-grade OCR solution (NLP + custom algorithms) on contracts after GAN-based image enhancement, generating **$100K+** in business value.',
    ],
  },
  {
    role: 'Machine Learning Engineer Intern',
    company: 'GMO Research',
    where: 'Japan · internship',
    dates: "Jan '20 — Mar '20",
    points: [
      'Forecast 6-hour survey response likelihood with time-aware Random Forests, Decision Trees, and DNNs; addressed class imbalance via SMOTE and custom metrics, achieving **91% efficacy** on responsive marketing panels.',
    ],
  },
];

// Skills, grouped. `items` is a comma-joined string split into chips at render.
const skills = [
  { group: 'Languages & libraries', items: 'Python, SQL, Scala, Pandas, NumPy, Scikit-Learn' },
  { group: 'Big data & MLOps', items: 'Spark, Hadoop, HBase, Solr, AWS, Docker, Git, CI/CD, GPU/HPC' },
  { group: 'ML / DL / LLM', items: 'PyTorch, TensorFlow, Transformers, LangChain, LangGraph, RAG, Agentic AI, MCP' },
  { group: 'Models & paradigms', items: 'Time-Series Forecasting, Recommendation, Causal Inference, Anomaly Detection, Computer Vision' },
];

// Publications & patents as design cards: a kicker label + the body detail.
const pubs = [
  {
    kicker: 'Patent · co-authored',
    body: 'Dimensionality-reduction techniques to detect and localize failure regions in segmentation outputs from foundation models, improving interpretability and reliability.',
  },
  {
    kicker: 'Research',
    body: 'A two-stage fine-tuning approach improving foundation-model segmentation performance by 5%+ mIoU using unlabeled data — semi-supervised learning.',
  },
];

// Split a bullet on **bold** markers into ordered segments. String.split with a
// capturing group yields [plain, bold, plain, bold, …]; odd indices are the
// captured (bold) parts. Rendered as real <b> so scoping + escaping both apply.
const mark = (s: string) => s.split(/\*\*(.+?)\*\*/g).map((t, i) => ({ t, b: i % 2 === 1 }));
---

{/*
  BaseLayout supplies head/meta/OG, nav, footer, and global CSS. `wide` opts out
  of the reading column so this page runs its own .wrap. title/description feed
  SEO + social-preview generation.
*/}
<BaseLayout
  title="Resume — Shivam Chaudhary"
  description="Senior Data Scientist — production LLM/Agentic AI, ML/DL, causal inference, and computer vision."
  wide
>
  <div class="wrap">
    {/* CV masthead: eyebrow, name, italic-accent role line, contact facts, PDF. */}
    <header class="cv-head">
      <div>
        <div class="kicker">
          <span class="line"></span>
          <span class="eyebrow">Curriculum vitae</span>
        </div>
        <h1>Shivam Chaudhary</h1>
        <p class="role"><b>Senior Data Scientist</b><span aria-hidden="true">·</span>Production LLM &amp; Agentic AI<span aria-hidden="true">·</span>Causal Inference<span aria-hidden="true">·</span>Computer Vision</p>
        <div class="facts">
          <a href="mailto:shivam.iitmandi@gmail.com">shivam.iitmandi@gmail.com</a>
          <a href="https://github.com/shivam7569">github.com/shivam7569</a>
          <a href="https://www.linkedin.com/in/shivam7569/">linkedin.com/in/shivam7569</a>
        </div>
      </div>
      {/* Real, curated PDF from public/ — one click, no dialog. `dl` marks it for
          the print block to hide. Test pins this href="/resume.pdf". */}
      <a class="btn btn-ghost dl" href="/resume.pdf" download>Download PDF
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
      </a>
    </header>

    {/* The figures buried in the bullets, surfaced for the ten-second scan. */}
    <div class="figs">
      {figs.map((f) => (
        <div class="fig"><b>{f.n}</b><span>{f.l}</span></div>
      ))}
    </div>

    <div class="cv-summary">
      <p>
        Senior Data Scientist with 6+ years applying scientific methods to high-stakes business
        problems, building production-grade ML/DL and end-to-end LLM/Agentic AI systems at scale.
        Hands-on across time-series forecasting, causal inference, recommendation, and large-scale
        data, with a product-oriented mindset and a habit of turning research into real-world impact.
      </p>
    </div>

    {/* One .job per role, newest-first. Nested map renders each bullet; mark()
        splits **…** into bold segments (real <b>, scoped + escaped). */}
    <section class="sect">
      <h2>Experience</h2>
      {experience.map((job) => (
        <article class="job">
          <div class="when">
            {job.dates}
            <span class="place">{job.company}</span>
            {job.where && <span class="where">{job.where}</span>}
          </div>
          <div>
            <h3>{job.role}</h3>
            <ul>
              {job.points.map((p) => (
                <li>{mark(p).map((seg) => (seg.b ? <b>{seg.t}</b> : seg.t))}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </section>

    {/* Skills: four columns, each a set of chips. */}
    <section class="sect">
      <h2>What I work with</h2>
      <div class="skills">
        {skills.map((s) => (
          <div>
            <h3>{s.group}</h3>
            <div class="chips">
              {s.items.split(', ').map((item) => <span>{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Publications & patents as bordered cards. */}
    <section class="sect">
      <h2>Publications &amp; patents</h2>
      <div class="pubs">
        {pubs.map((p) => (
          <div class="pub">
            <span class="k">{p.kicker}</span>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Education — a single ruled row. */}
    <section class="sect">
      <h2>Education</h2>
      <div class="edu">
        <span class="t">B.Tech, Mechanical Engineering<small>Indian Institute of Technology, Mandi · Minor in Intelligent Systems</small></span>
        <span class="y">Aug '16 — Jul '20</span>
      </div>
    </section>

    {/* Closing band: a plain note, a subtle redirect to /projects, and the
        primary contact action (real mailto). */}
    <div class="cv-close">
      <span>References available on request. Email is the fastest way to reach me.</span>
      <div class="close-actions">
        <a class="proj-link" href="/projects">See selected projects <span aria-hidden="true">→</span></a>
        <a class="btn btn-primary btn-sm" href="mailto:shivam.iitmandi@gmail.com">Get in touch</a>
      </div>
    </div>
  </div>
</BaseLayout>

{/*
  Page-specific editorial pieces, scoped to this component (class names hashed at
  build). Design tokens are global custom properties from global.css; this file
  only consumes them, and their values differ light/dark. Shared utilities
  (.wrap/.eyebrow/.btn/.btn-*) live in global.css.
*/}
<style>
  .cv-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:end;padding:clamp(44px,6vw,80px) 0 clamp(22px,3vw,32px)}
  @media(max-width:820px){.cv-head{grid-template-columns:1fr;align-items:start;gap:22px}}
  .cv-head .kicker{display:flex;align-items:center;gap:14px;margin-bottom:20px}
  .cv-head .kicker .line{height:1px;width:48px;background:var(--accent);opacity:.6}
  .cv-head h1{font-family:var(--serif-display);font-weight:600;font-size:clamp(38px,6.4vw,66px);line-height:1.02;letter-spacing:-.025em;margin:0 0 14px}
  .role{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;font-family:var(--serif-display);font-size:clamp(17px,2.1vw,21px);color:var(--ink-soft);margin:0 0 20px}
  .role b{font-weight:600;font-style:italic;color:var(--accent)}
  .role span{color:var(--ink-faint)}
  .facts{display:flex;flex-wrap:wrap;gap:8px 20px;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
  .facts a{color:var(--ink-soft);border-bottom:1px solid var(--rule);transition:color .2s,border-color .2s}
  .facts a:hover{color:var(--accent);border-color:var(--accent)}

  /* the numbers a hiring manager scans for, pulled out of the bullets */
  .figs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:5px;overflow:hidden;margin-bottom:clamp(26px,3.6vw,40px)}
  @media(max-width:820px){.figs{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .fig{background:var(--card);padding:18px 20px}
  .fig b{display:block;font-family:var(--serif-display);font-weight:600;font-size:clamp(24px,3vw,31px);letter-spacing:-.015em;color:var(--accent);line-height:1.05;font-variant-numeric:tabular-nums}
  .fig span{display:block;font-family:var(--sans);font-size:12px;line-height:1.45;color:var(--ink-faint);margin-top:7px}

  .cv-summary{padding:0 0 clamp(28px,4vw,42px);border-bottom:1px solid var(--rule)}
  .cv-summary p{max-width:64ch;color:var(--ink-soft);font-size:18.5px;line-height:1.65;margin:0;text-wrap:pretty}

  .sect{padding:clamp(36px,4.6vw,56px) 0 0}
  .sect > h2{font-family:var(--sans);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin:0 0 28px;font-weight:600;display:flex;align-items:center;gap:14px}
  .sect > h2::after{content:"";flex:1;height:1px;background:var(--rule)}

  .job{display:grid;grid-template-columns:186px minmax(0,1fr);gap:clamp(18px,3vw,44px);padding:0 0 30px;margin-bottom:30px;border-bottom:1px solid var(--rule)}
  .job:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}
  @media(max-width:820px){.job{grid-template-columns:1fr;gap:10px}}
  .job .when{font-family:var(--sans);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);padding-top:6px;font-variant-numeric:tabular-nums}
  .job .when .place{display:block;margin-top:8px;font-family:var(--serif-display);font-size:16.5px;line-height:1.3;letter-spacing:0;text-transform:none;color:var(--ink)}
  .job .when .where{display:block;margin-top:4px;font-size:11.5px;letter-spacing:.06em;text-transform:none;color:var(--ink-faint)}
  .job h3{font-family:var(--serif-display);font-weight:600;font-size:24px;line-height:1.2;margin:0 0 14px;letter-spacing:-.01em}
  .job ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:13px;max-width:64ch}
  .job li{position:relative;padding-left:22px;color:var(--ink);font-size:17px;line-height:1.6;text-wrap:pretty}
  .job li::before{content:"";position:absolute;left:0;top:.72em;width:9px;height:1px;background:var(--accent)}
  .job li b{font-weight:600;color:var(--accent)}

  .skills{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(20px,3vw,36px)}
  @media(max-width:960px){.skills{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}}
  @media(max-width:520px){.skills{grid-template-columns:1fr}}
  .skills h3{font-family:var(--sans);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 14px;font-weight:600}
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .chips span{font-family:var(--sans);font-size:13px;color:var(--ink-soft);border:1px solid var(--rule);border-radius:2px;padding:5px 10px;background:var(--card)}

  .pubs{display:grid;grid-template-columns:1fr 1fr;gap:clamp(18px,2.6vw,26px)}
  @media(max-width:820px){.pubs{grid-template-columns:1fr}}
  .pub{border:1px solid var(--rule);border-radius:5px;background:var(--card);padding:20px 22px}
  .pub .k{font-family:var(--sans);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:600;display:block;margin-bottom:9px}
  .pub p{margin:0;font-size:16.5px;line-height:1.6;color:var(--ink-soft);text-wrap:pretty}

  .edu{display:flex;justify-content:space-between;gap:20px;padding:16px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);flex-wrap:wrap}
  .edu .t{font-family:var(--serif-display);font-size:19px;font-weight:600}
  .edu .t small{display:block;font-family:var(--sans);font-size:13.5px;font-weight:400;color:var(--ink-faint);margin-top:5px}
  .edu .y{font-family:var(--sans);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);white-space:nowrap;padding-top:6px}

  .cv-close{margin-top:clamp(38px,5vw,60px);padding-top:28px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;font-family:var(--sans);font-size:14px;color:var(--ink-faint)}
  .close-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
  /* a quiet, editorial redirect to the work behind the numbers */
  .proj-link{font-family:var(--sans);font-size:14px;color:var(--ink-soft);display:inline-flex;align-items:center;gap:7px;transition:color .2s}
  .proj-link span{transition:transform .2s}
  .proj-link:hover{color:var(--accent)}
  .proj-link:hover span{transform:translateX(4px)}
</style>

{/*
  Print styles live GLOBAL: they hide BaseLayout-owned chrome (.site-header/
  .site-footer/.theme-toggle) and reset :root tokens to ink-on-white, which a
  scoped rule (rewritten to this page's data-attr) could never reach. The other
  selectors are page-unique class names, so global scoping is safe. Printing a CV
  should produce a CV, not a website.
*/}
<style is:global>
  @media print {
    @page { margin: 14mm }
    .site-header, .site-footer, .theme-toggle, .dl, .proj-link, .cv-close .btn { display: none !important }
    /* BaseLayout always stamps data-theme on <html>, so global.css's
       :root[data-theme="dark|light"] (0,2,0) outranks a plain :root (0,1,0).
       !important on the custom properties wins regardless of specificity, so the
       ink-on-white print palette actually applies in BOTH themes. */
    :root {
      --paper:#fff !important; --card:#fff !important; --ink:#111 !important;
      --ink-soft:#333 !important; --ink-faint:#555 !important;
      --rule:#c9c9c9 !important; --rule-soft:#e2e2e2 !important; --accent:#5e3560 !important;
    }
    body { background:#fff }
    .wrap { max-width:none; padding:0 }
    .cv-head { padding:0 0 14px }
    .cv-head h1 { font-size:32pt }
    .role { font-size:12pt; margin-bottom:10px }
    .figs { break-inside:avoid }
    .sect { padding-top:20px }
    .job, .pub, .edu { break-inside:avoid }
    .job li { font-size:10.5pt; line-height:1.45 }
    .cv-summary p { font-size:11pt }
  }
</style>
