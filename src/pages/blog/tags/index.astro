---
/*
 * /blog/tags — the subjects index: every topic across all published essays, by post count
 * (Claude Design vocabulary). DB-driven from public.topic_tags(), hydrated client-side so a
 * newly-used subject appears without a rebuild. Replaces the old file-collection tag index.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Subjects — areyoustillreading" description="Browse every essay by subject." wide>
  <div class="wrap">
    <header class="page-head tp-ix-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow">Subjects</span></div>
      <h1>Every essay, <em>by subject.</em></h1>
      <p class="lede">The tags that run through the writing here — pick one to see everything published on it, across every author.</p>
    </header>

    <div id="tp-ix"><p class="feedlede" style="padding:26px 0">Loading subjects…</p></div>
  </div>
</BaseLayout>

<style is:global>
  .tp-ix-head { padding: clamp(48px,7vw,96px) 0 0; }
  .tp-ix-head .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .tp-ix-head .kicker .line { height: 1px; width: 48px; background: var(--accent); opacity: .6; }
  .tp-ix-head h1 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(34px,5vw,58px); line-height: 1.04; letter-spacing: -.022em; margin: 0 0 .4em; }
  .tp-ix-head h1 em { font-style: italic; color: var(--accent); }
  .tp-ix-head .lede { font-size: clamp(17px,2.1vw,21px); line-height: 1.6; color: var(--ink-soft); max-width: 58ch; margin: 0; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; padding: clamp(32px,4.5vw,56px) 0 clamp(52px,7vw,88px); }
  .tp-cell { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border: 1px solid var(--rule); border-radius: 6px; background: var(--card); padding: 17px 19px; transition: border-color .2s, transform .2s; }
  .tp-cell:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); transform: translateY(-2px); }
  .tp-cell .t { font-family: var(--serif-display); font-weight: 600; font-size: 20px; letter-spacing: -.01em; color: var(--ink); }
  .tp-cell:hover .t { color: var(--accent); }
  .tp-cell .t .h { color: var(--accent); font-style: italic; }
  .tp-cell .n { font-family: var(--sans); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>

<script>
  import { supabase } from '../../../lib/supabase';
  import { esc } from '../../../lib/feed-render';
  const host = document.getElementById('tp-ix')!;
  (async () => {
    let tags: any[] = [];
    try { const { data } = await supabase.rpc('topic_tags'); tags = data || []; }
    catch { host.innerHTML = '<p class="feedlede" style="padding:26px 0">Couldn’t load subjects.</p>'; return; }
    if (!tags.length) { host.innerHTML = '<p class="feedlede" style="padding:26px 0">No subjects yet.</p>'; return; }
    host.innerHTML = `<div class="tp-grid">${tags.map((t) =>
      `<a class="tp-cell" href="/blog/tags/${encodeURIComponent(t.tag)}"><span class="t"><span class="h">#</span>${esc(t.tag)}</span><span class="n">${t.n} ${t.n === 1 ? 'essay' : 'essays'}</span></a>`
    ).join('')}</div>`;
  })();
</script>
