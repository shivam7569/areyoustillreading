---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags — areyoustillreading" description="Browse posts by tag.">
  <p><a href="/blog">&larr; All posts</a></p>
  <h1>Tags</h1>
  <ul class="post-list">
    {tags.map(([tag, count]) => (
      <li><a href={`/blog/tags/${tag}`}>#{tag}</a> <span class="count">({count})</span></li>
    ))}
  </ul>
</BaseLayout>
