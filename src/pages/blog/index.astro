---
/*
 * =============================================================================
 * src/pages/blog/index.astro  ·  ROUTE: "/blog"  (the archive / essay index)
 * =============================================================================
 * The editorial archive (Phase 5), rebuilt from the Claude Design "blog" template:
 * a page head, a filter bar (in-page search + tag chips), essays grouped by year
 * as `.post` rows, an empty state, and the newsletter block. Static SSG.
 *
 * SEARCH: the design filters the RENDERED list in-page by title/summary/tag text
 * (see the script). This intentionally replaces the previous Pagefind modal — it
 * is the design's UX; Pagefind full-text search is no longer mounted here.
 *
 * INSTANT-PUBLISH OVERLAY: functions/blog/_middleware.js injects a just-published
 * post into this page before the git rebuild lands. It targets the stable
 * <div id="ays-instant"></div> anchor below — keep the two in lockstep.
 *
 * GUARD: `!data.draft` is the only publication gate (static site). JSX comments only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import site from '../../data/site.json';
import { getCollection } from 'astro:content';

// Blog-index copy, editable from Studio → Content Management → Blog index.
// The lede + filter empty-state carry one inline link each: a {series}/{reset}
// token is filled with the anchor here (text escaped; content is trusted).
const c = (site as any).blogIndex || {};
const esc = (s = '') => String(s).replace(/[&<>]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[ch] as string));
const ledeHtml = esc(c.lede || 'The complete archive — everything published here on LLM engineering and the systems underneath. Filter by subject or search the titles; for multi-part reads, see the {series}.')
  .replace('{series}', `<a class="link" href="/series">${esc(c.ledeSeriesLabel || 'series')}</a>`);
const emptyFilterHtml = esc(c.emptyFilter || 'Nothing matches that. Try a broader subject, or {reset}.')
  .replace('{reset}', `<a class="link" href="#" data-reset>${esc(c.emptyResetLabel || 'clear the filters')}</a>`);
const essaySingular = c.essaySingular || 'essay';
const essayPlural = c.essayPlural || 'essays';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group by year (newest year first), reverse-chron within each.
const groups = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getUTCFullYear();
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const years = [...groups.keys()].sort((a, b) => b - a);

// Filter chips: the most-used tags (plus "All").
const tagCount = new Map<string, number>();
posts.forEach((p) => (p.data.tags ?? []).forEach((t) => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([t]) => t);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const readMins = (body?: string) => Math.max(1, Math.round((body?.split(/\s+/).filter(Boolean).length ?? 0) / 200));

// Continuous 01, 02 … index across the whole archive (matches the design).
let n = 0;
---

<BaseLayout title={c.seo?.title || 'Blog — areyoustillreading'} description={c.seo?.description || 'Every essay on LLM engineering and the systems underneath, grouped by year.'} wide>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow">{c.eyebrow || 'The blog'}</span></div>
      <h1>{c.title || 'Every essay,'} <em>{c.titleEm || 'in the order it arrived.'}</em></h1>
      <p class="lede" set:html={ledeHtml}></p>
    </header>

    {posts.length > 0 ? (
      <Fragment>
        <div class="filters">
          <label class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
            <input type="search" id="q" placeholder={c.searchPlaceholder || 'Search titles and summaries'} aria-label="Search essays" />
          </label>
          <span class="count" id="count" data-shown={c.shownLabel || 'shown'}>{posts.length} {c.shownLabel || 'shown'}</span>
          <div class="chips" id="chips">
            <button class="chip" data-tag="all" aria-pressed="true" type="button">{c.allChip || 'All'}</button>
            {topTags.map((t) => (<button class="chip" data-tag={t} aria-pressed="false" type="button">{t}</button>))}
          </div>
        </div>

        {/* Instant-publish injection anchor — keep in lockstep with functions/blog/_middleware.js. */}
        <div id="ays-instant"></div>

        {years.map((year) => (
          <Fragment>
            <div class="yr" data-year={year}><h2>{year}</h2><span class="n">{groups.get(year)!.length} {groups.get(year)!.length === 1 ? essaySingular : essayPlural}</span><span class="rule"></span></div>
            <div class="post-list" data-year={year}>
              {groups.get(year)!.map((post) => {
                n += 1;
                const idx = String(n).padStart(2, '0');
                const dataTags = (post.data.tags ?? []).join(' ');
                return (
                  <article class="post" data-tags={dataTags}>
                    <div class="idx">{idx}</div>
                    <div>
                      {post.data.series && (
                        <a class="series-flag" href="/series">
                          <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M12 2 15 9l7 .5-5.4 4.5L18.5 21 12 17l-6.5 4 1.9-7L2 9.5 9 9z"/></svg>
                          {post.data.seriesTitle ?? post.data.series}{post.data.seriesOrder ? ` · Part ${post.data.seriesOrder}` : ''}
                        </a>
                      )}
                      <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                      <p>{post.data.description}</p>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="tags">{post.data.tags.slice(0, 3).map((t) => (<span class="tag">{t}</span>))}</div>
                      )}
                    </div>
                    <div class="aside">
                      <span class="date">{fmt(post.data.pubDate)}</span>
                      <span class="rt">{readMins(post.body)} min</span>
                    </div>
                  </article>
                );
              })}
            </div>
          </Fragment>
        ))}

        <p class="empty" id="empty" set:html={emptyFilterHtml}></p>
      </Fragment>
    ) : (
      <p class="empty on" style="border:0">{c.emptyArchive || 'No essays yet — the first one is on its way.'}</p>
    )}

    <div class="archive-foot" data-hide-admin>
      <div class="sub-inner">
        <SubscribeForm
          heading={c.newsletter?.heading || 'Read the next one first'}
          blurb={c.newsletter?.blurb || 'New essays on LLM engineering and the systems underneath, straight to your inbox. No noise — unsubscribe in one click.'}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 22px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin-bottom: 8px; }
  .search { position: relative; flex: 1; min-width: 240px; max-width: 340px; }
  .search input { width: 100%; font-family: var(--sans); font-size: 14px; padding: 10px 14px 10px 38px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); }
  .search input::placeholder { color: var(--ink-faint); }
  .search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--ink-faint); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
  .chip { font-family: var(--sans); font-size: 12.5px; letter-spacing: 0.02em; color: var(--ink-soft); border: 1px solid var(--rule); background: transparent; border-radius: 999px; padding: 6px 14px; cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s; }
  .chip:hover { border-color: var(--ink-faint); color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .yr { display: flex; align-items: baseline; gap: 16px; padding: 44px 0 14px; }
  .yr h2 { font-family: var(--serif-display); font-weight: 600; font-size: 28px; margin: 0; letter-spacing: -0.01em; }
  .yr .n { font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); }
  .yr .rule { flex: 1; height: 1px; background: var(--rule); }
  .post-list { border-top: 1px solid var(--rule); }
  /* Series membership flag on an archive row (R8). */
  .series-flag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 9px; transition: opacity 0.2s; }
  .series-flag svg { opacity: 0.85; }
  .series-flag:hover { opacity: 0.72; }
  .post.is-hidden { display: none; }
  .yr.is-hidden, .post-list.is-hidden { display: none; }
  .empty { padding: 60px 8px; text-align: center; color: var(--ink-faint); font-family: var(--sans); font-size: 15px; display: none; }
  .empty.on { display: block; }
  .count { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); white-space: nowrap; }
  .archive-foot { padding: 56px 0 clamp(56px, 8vw, 96px); }
  .sub-inner { max-width: 720px; }
</style>

<script>
  // In-page filter: search (title/summary/tag text) AND a single active tag chip.
  // Hides non-matching posts, empties year groups with nothing visible, updates the
  // count, and shows an empty state. Overlay-injected posts are in the DOM at load,
  // so they participate automatically.
  (function () {
    const q = document.getElementById('q') as HTMLInputElement | null;
    const chips = document.getElementById('chips');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    if (!q || !chips || !count || !empty) return;
    let tag = 'all';
    const apply = () => {
      const term = (q.value || '').trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll('.post').forEach((el) => {
        const p = el as HTMLElement;
        const tags = ' ' + (p.getAttribute('data-tags') || '') + ' ';
        const okTag = tag === 'all' || tags.toLowerCase().indexOf(' ' + tag.toLowerCase() + ' ') > -1;
        const okTerm = !term || (p.textContent || '').toLowerCase().indexOf(term) > -1;
        const on = okTag && okTerm;
        p.classList.toggle('is-hidden', !on);
        if (on) shown++;
      });
      document.querySelectorAll('.post-list').forEach((listEl) => {
        const list = listEl as HTMLElement;
        const any = Array.from(list.querySelectorAll('.post')).some((p) => !p.classList.contains('is-hidden'));
        list.classList.toggle('is-hidden', !any);
        const head = document.querySelector('.yr[data-year="' + list.getAttribute('data-year') + '"]');
        if (head) head.classList.toggle('is-hidden', !any);
      });
      count.textContent = shown + ' ' + (count.getAttribute('data-shown') || 'shown');
      empty.classList.toggle('on', shown === 0);
    };
    q.addEventListener('input', apply);
    chips.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
      if (!b) return;
      tag = b.getAttribute('data-tag') || 'all';
      chips.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', c === b ? 'true' : 'false'));
      apply();
    });
    empty.querySelector('[data-reset]')?.addEventListener('click', (e) => {
      e.preventDefault();
      q.value = '';
      tag = 'all';
      chips.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', c.getAttribute('data-tag') === 'all' ? 'true' : 'false'));
      apply();
    });
    apply();
  })();
</script>
