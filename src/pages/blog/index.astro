---
/**
 * ============================================================================
 * FILE: src/pages/blog/index.astro
 * ROUTE: /blog  (static HTML, generated at build time)
 * ----------------------------------------------------------------------------
 * WHAT THIS IS
 *   The blog *index* / listing page. It renders a reverse-chronological list
 *   of all published blog posts, plus a client-side search box (Pagefind).
 *   Individual posts are rendered by a separate dynamic route
 *   (src/pages/blog/[...slug].astro); THIS file only produces the index.
 *   Tag pages (src/pages/blog/tags/*) are yet another route, also not here.
 *
 * SINGLE RESPONSIBILITY
 *   Query the `blog` content collection at build time, filter out drafts,
 *   sort newest-first, and emit a static <ul> of title/date/description links.
 *   No runtime logic ships for the list itself — it is fully static HTML.
 *
 * HOW IT FITS THE ARCHITECTURE
 *   - Astro 7 static build (astro ^7.1.3). This page has NO server/Pages-
 *     Function component; it is pre-rendered to /blog/index.html.
 *   - TWO deploy paths put that HTML on Cloudflare Pages:
 *       (a) manual — `npm run deploy` = `astro build && pagefind …` then
 *           `wrangler pages deploy dist` (direct upload); and
 *       (b) the normal content path — the admin editor's publish flow
 *           (functions/api/publish.js) commits the post's Markdown to GitHub,
 *           and Cloudflare Pages' Git integration rebuilds + redeploys.
 *     Either way this index is regenerated from the collection at build time.
 *   - Content comes from Astro's content collections (`astro:content`). The
 *     `blog` collection + its Zod schema (title/description/pubDate/draft/…)
 *     are defined in `src/content.config.ts`.
 *   - Layout/chrome (head, nav, OG tags, theme) is delegated to BaseLayout.
 *   - Search is powered by Pagefind, which indexes the built site as a
 *     POST-BUILD step. The /pagefind/* assets referenced below do NOT exist in
 *     the dev source tree — they are produced by the Pagefind CLI after
 *     `astro build`, so search only works against a real build (not `astro dev`).
 *
 * DEPENDS ON (imports / external contracts)
 *   - ../../layouts/BaseLayout.astro   → page shell (title/description props).
 *   - astro:content getCollection      → build-time content query.
 *   - The `blog` collection schema      → relies on `data.draft` (boolean),
 *     `data.pubDate` (Date), `data.title`, `data.description` existing.
 *   - /pagefind/pagefind-ui.{js,css}    → generated by Pagefind post-build.
 *
 * DEPENDED ON BY
 *   - Nav links / RSS / sitemap point users here as the blog entry point.
 *   - Nothing imports this module; it is a leaf page route.
 *
 * SECURITY / SAFETY NOTES
 *   - This page has NO auth, NO tokens, NO entitlement/paywall gating. It is
 *     intentionally public. Paywalled/gated content lives behind the /gated
 *     route + Pages-Function middleware, NOT here. Do not add secrets here.
 *   - `draft` filtering (below) is the ONLY visibility gate. A post with
 *     draft:false is fully public the moment it is built + deployed. There is
 *     no per-post access check on the index — if a post should stay hidden,
 *     keep draft:true or omit it from the collection entirely.
 *   - `post.data.description` and `title` are interpolated as JSX text nodes
 *     (see template), so Astro escapes them — no XSS from post front-matter.
 *   - GOTCHA: The two <script is:inline> blocks below are deliberately inlined
 *     (not bundled/hashed) because they call the external, post-build Pagefind
 *     globals. If a strict CSP is added later, these inline scripts will need a
 *     nonce/hash or they will be blocked and search will silently break.
 * ============================================================================
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getSeriesLookup } from '../../lib/series';

// Build-time query of the `blog` collection.
//   - Filter callback `!data.draft` excludes any post flagged draft:true so
//     work-in-progress never reaches the public index (the sole visibility
//     gate for this page — see security note above).
//   - `.sort()` orders newest-first by publish date. `.valueOf()` coerces the
//     Date to a millisecond timestamp so `b - a` gives descending order.
//   - Runs once at build time; the result is baked into static HTML.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// Per-post series label (only for posts in a multi-post series), so the listing
// shows which entries belong to a series and where they sit. See src/lib/series.ts.
const seriesLookup = await getSeriesLookup();
---

{/* BaseLayout provides <head>, nav, theme, and OG/meta tags. `title` and
    `description` feed the <title> tag and social/meta description. */}
<BaseLayout title="Blog — areyoustillreading" description="Writing on LLM engineering.">
  <h1>Blog</h1>
  <p class="lede">Writing on LLM engineering, systems, and the projects behind them.</p>

  {/* --- Pagefind client-side search --------------------------------------
      Pagefind indexes the built HTML AFTER `astro build` and drops its UI
      bundle + index under /pagefind/. These asset paths therefore resolve
      only on a real build/deploy, not in `astro dev` (search box stays empty
      in dev — expected, not a bug).
      The stylesheet + UI script are loaded as-is; `#search` is the mount. */}
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div id="search" class="search"></div>
  {/* is:inline keeps these scripts verbatim (not bundled/hashed) so they can
      reference the external Pagefind globals. See CSP gotcha in frontmatter. */}
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    /* Instantiate the Pagefind UI once the DOM is ready. The `window.PagefindUI`
       guard prevents a crash if the post-build bundle is missing (e.g. dev, or
       a build where Pagefind did not run) — search degrades gracefully instead
       of throwing. showSubResults surfaces in-page heading matches. */
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: '#search', showSubResults: true });
      }
    });
  </script>

  {/* Static, build-time-rendered list of published posts (newest first).
      Iterates the pre-sorted, draft-filtered `posts` array from frontmatter. */}
  <ul class="post-list">
    {posts.map((post) => {
      const s = seriesLookup[post.id];
      return (
        <li>
          {/* `post.id` is the collection entry id (slug/path); it forms the
              canonical URL of the post's own page. Title is escaped JSX text. */}
          <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
          {/* Series label: shows which series this post belongs to (and its part),
              linking to the intro/index — so series are visible from the listing.
              Only rendered for posts in a multi-post series. */}
          {s && (
            <a class="series-label" href={`/blog/${s.introSlug}`}>
              {s.title} · {s.isIntro ? `${s.total}-part series` : `Part ${s.part} of ${s.total}`}
            </a>
          )}
          {/* Machine-readable ISO timestamp in the datetime attribute (for
              crawlers/feeds); human-friendly localized date as the visible text. */}
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          <p>{post.data.description}</p>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .series-label {
    display: block;
    width: fit-content;
    margin: 0.15rem 0 0.1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent);
    text-decoration: none;
  }
  .series-label::before { content: '◆ '; opacity: 0.7; }
  .series-label:hover { text-decoration: underline; }
</style>
