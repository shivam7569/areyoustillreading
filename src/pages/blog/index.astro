---
/*
 * =============================================================================
 * src/pages/blog/index.astro  ·  ROUTE: "/blog"  (the "Everyone" multi-author feed)
 * =============================================================================
 * Phase 2 build to the Claude Design "explore.html" (Everyone): every author's
 * published work in one stream, read LIVE from the content.* tables via the public
 * read RPCs (public.list_feed_posts + public.feed_retention) over the anon client.
 * Author identity is a monogram, consecutive posts by one author collapse into a
 * single spine, each row carries its reading-shape curve (retention as a shape, not
 * a score), and its field + series crumb. Tags are a real subject filter (token
 * match, not substring); there are no aggregate totals.
 *
 * DEFERRED (each its own slice): the "Ways in" band, the fields shelf, the "Where
 * you left off" strip, and clickable field/series/post permalinks (crumb is text
 * until those pages ship).
 * =============================================================================
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Everyone — areyoustillreading" description="Every author's published work, in one feed — read live from the database." wide>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow">Everyone</span></div>
      <h1>Every author, <em>one feed.</em></h1>
      <p class="lede">Nothing is ranked, promoted or trending. Work arrives in order, read live from the database — start something rather than scroll past it.</p>
    </header>

    <!-- Where you left off: the signed-in reader's own in-progress pieces (public.
         my_reading_continues). Hidden for anonymous readers and when nothing is mid-read. -->
    <section class="rez" id="rez" hidden>
      <div class="slab"><span class="eyebrow">Where you left off</span><span class="line"></span><button class="drop" type="button" id="rezclear">Clear</button></div>
      <div class="rezgrid" id="rezgrid"></div>
    </section>

    <!-- Fields shelf: the map. Client-rendered from public.list_public_fields, each tile a
         generative plate. Hidden until at least one field is public (>=2 series). -->
    <section class="fieldsec" id="fieldshelf" hidden>
      <div class="slab"><span class="eyebrow">Fields</span><span class="line"></span><a class="more-link" href="/fields">All fields →</a></div>
      <div class="shelf" id="shelf"></div>
    </section>

    <!-- Ways in: three routes chosen by how pieces READ (public.ways_in), each on a
         reading shape, not a score. Hidden until three exemplars exist. -->
    <section class="waysec" id="waysin" hidden>
      <div class="slab"><span class="eyebrow">Ways in</span><span class="line"></span><span class="more-link">Chosen by how they read, not when they arrived</span></div>
      <div class="wgrid" id="wgrid"></div>
    </section>

    <div class="filters">
      <label class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
        <input type="search" id="q" placeholder="Search titles, authors, subjects" aria-label="Search the stream" />
      </label>
      <span class="count" id="count"></span>
      <span class="sortwrap"><span>Sort</span><select id="sort" aria-label="Sort the stream"><option value="new">Newest first</option><option value="held">Best held</option><option value="short">Shortest read</option></select></span>
    </div>

    <div id="stream" aria-live="polite"></div>
    <p class="empty" id="empty">Nothing matches that. Try a broader subject, or <a class="link" href="#" data-reset>clear the filters</a>.</p>

    <div class="legend">
      <svg viewBox="0 0 50 16" aria-hidden="true"><path d="M0 2 C 11 3 21 8 31 9 S 44 11 50 12" fill="none" stroke="var(--accent)" stroke-width="1.4"></path><circle cx="25" cy="7.5" r="2.2" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.2"></circle></svg>
      <span>Every piece carries the shape of its own reading — how many readers were still there, start to finish. The notch is where it loses most of them. No scores, no ranking.</span>
    </div>

    <div class="more"><button class="btn btn-ghost" type="button" id="morebtn" hidden>Keep going back</button></div>

    <div class="feed-foot">
      <section class="subscribe">
        <span class="eyebrow">The letter</span>
        <h3>One from every field, once a week</h3>
        <p>A single email of pieces that held their readers to the end. No digests of digests, no engagement bait.</p>
      </section>
    </div>
  </div>

  <!-- Fast, themed reading-shape tooltip (positioned by JS over the hovered curve). -->
  <div class="shape-tip" id="shapeTip" role="tooltip" aria-hidden="true"></div>
</BaseLayout>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .search { position: relative; flex: 1; min-width: 210px; max-width: 300px; }
  .search input { width: 100%; font-family: var(--sans); font-size: 14px; padding: 10px 14px 10px 38px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); }
  .search input::placeholder { color: var(--ink-faint); }
  .search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--ink-faint); }
  .sortwrap { display: flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin-left: auto; }
  .sortwrap select { font-family: var(--sans); font-size: 13px; letter-spacing: 0; text-transform: none; color: var(--ink); background: transparent; border: 1px solid var(--rule); border-radius: 999px; padding: 8px 12px; cursor: pointer; }
  .count { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); white-space: nowrap; display: none; }
  .count.on { display: inline; }
  .empty { padding: 56px 8px; text-align: center; font-family: var(--sans); font-size: 15px; color: var(--ink-faint); display: none; }
  .empty.on { display: block; }
  .legend { display: flex; align-items: center; gap: 11px; padding: 22px 0 0; font-family: var(--sans); font-size: 11.5px; line-height: 1.5; color: var(--ink-faint); }
  .legend svg { width: 50px; height: 16px; overflow: visible; flex: none; }
  .more { padding: 26px 0 0; display: flex; }
  .feed-foot { padding: clamp(40px, 5.5vw, 68px) 0 clamp(56px, 8vw, 96px); }

  /* The reading-shape tooltip — themed to the site (paper card, hairline rule, accent whisker). */
  .shape-tip { position: fixed; z-index: 80; pointer-events: none; max-width: 236px; padding: 8px 11px 8px 12px;
    font-family: var(--sans); font-size: 12px; line-height: 1.42; letter-spacing: .004em; color: var(--ink-soft);
    background: var(--card); border: 1px solid var(--rule); border-left: 2px solid var(--accent); border-radius: 6px;
    box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--ink) 42%, transparent), 0 1px 2px color-mix(in srgb, var(--ink) 8%, transparent);
    opacity: 0; transform: translateY(3px); transition: opacity .12s ease, transform .12s ease; text-wrap: pretty; }
  .shape-tip.on { opacity: 1; transform: translateY(0); }
  .shape-tip::after { content: ""; position: absolute; left: var(--tip-arrow, 50%); top: 100%; transform: translateX(-50%) rotate(45deg);
    width: 7px; height: 7px; background: var(--card); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin-top: -4px; }
  .shape-tip.below::after { top: auto; bottom: 100%; margin-top: 0; margin-bottom: -4px; transform: translateX(-50%) rotate(225deg); }
</style>

<!-- Rows are created by client JS (no Astro scope attribute) → style them globally,
     contained under #stream so nothing leaks to other pages. -->
<style is:global>
  #stream .grp { display: flex; align-items: baseline; gap: 16px; padding: 36px 0 10px; }
  #stream .grp h2 { font-family: var(--serif-display); font-weight: 600; font-size: 22px; margin: 0; letter-spacing: -.01em; }
  #stream .grp .rule { flex: 1; height: 1px; background: var(--rule); }
  /* The hover fill (global `.post:hover { background: var(--paper-2) }`) is wanted here, so give
     it breathing room + rounded corners: 14px horizontal padding with a matching negative margin
     keeps the row content aligned with the section while the fill extends 14px past it — so the
     round monogram sits INSIDE the fill instead of tangent to its sharp edge. */
  #stream .post { position: relative; display: grid; grid-template-columns: 36px auto minmax(0, 1fr) auto; column-gap: clamp(12px, 1.6vw, 16px); padding: 22px 14px; margin: 0 -14px; border-radius: 10px; align-items: start; transition: background .18s ease; }
  #stream .post .rail { grid-column: 1; align-self: start; width: 36px; }
  #stream .mono { width: 36px; height: 36px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper-2); display: grid; place-items: center; margin: 0 auto; position: relative; z-index: 1; font-family: var(--serif-display); font-size: 13px; font-weight: 600; color: var(--ink-soft); letter-spacing: .03em; transition: border-color .2s, color .2s; }
  #stream .post:hover .mono { border-color: var(--accent); color: var(--accent); }
  #stream .post.cont .mono { display: none; }
  /* One continuous spine per author run: real line elements with OVERLAPPING offsets
     (padding is 22px, so -24 overlaps ~2px each side — no sub-pixel breaks). The run
     never crosses a month header because collapse() resets per group. */
  /* The spine is anchored to .post (full-height, zero gap between rows), not the rail —
     so it never depends on grid-cell height. Offsets are from .post's box (22px padding);
     consecutive rows touch, so cont segments overlap 4px → continuous. */
  #stream .post .spine { position: absolute; left: 32px; transform: translateX(-50%); width: 1px; background: var(--rule-soft); display: none; }
  #stream .post.runstart .spine { display: block; top: 62px; bottom: -4px; }
  #stream .post.cont .spine { display: block; top: -4px; bottom: -4px; }
  #stream .post.cont.runend .spine { bottom: auto; height: 34px; }
  #stream .post .bead { position: absolute; left: 32px; top: 30px; width: 6px; height: 6px; margin-left: -3px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 55%, transparent); display: none; transition: background .2s, transform .2s; }
  #stream .post.cont .bead { display: block; }
  #stream .post.cont:hover .bead { background: var(--accent); transform: scale(1.3); }
  #stream .picon { grid-column: 2; align-self: start; position: relative; width: 108px; height: 108px; border: 1px solid var(--rule-soft); border-radius: 3px; background: var(--paper-2); overflow: hidden; transition: border-color .25s; }
  #stream .ptext { grid-column: 3; min-width: 0; }
  #stream .picon::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 110% at 22% 14%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 68%); }
  #stream .post:hover .picon { border-color: color-mix(in srgb, var(--accent) 32%, var(--rule)); }
  #stream .byline { display: flex; align-items: baseline; gap: 9px; margin: 0 0 7px; font-family: var(--sans); font-size: 12.5px; flex-wrap: wrap; }
  #stream .byline .nm { font-family: var(--serif-display); font-size: 15px; font-weight: 600; letter-spacing: -.01em; color: var(--ink); }
  #stream .byline .hd { color: var(--ink-faint); }
  #stream .byline .co { color: var(--ink-faint); }
  #stream .post.cont .byline { display: none; }
  #stream .post h3 { font-family: var(--serif-display); font-weight: 600; font-size: clamp(18px, 2vw, 21px); line-height: 1.28; letter-spacing: -.01em; margin: 0; color: var(--ink); text-wrap: pretty; }
  #stream .post.lead h3 { font-size: clamp(23px, 3vw, 30px); }
  #stream .post p.sum { margin: 8px 0 0; font-family: var(--sans); font-size: 14px; line-height: 1.5; color: var(--ink-soft); max-width: 60ch; }
  #stream .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  #stream button.tag { font-family: var(--sans); font-size: 12px; letter-spacing: .03em; color: var(--ink-faint); border: 1px solid var(--rule); background: transparent; border-radius: 999px; padding: 4px 11px; cursor: pointer; transition: border-color .2s, color .2s; }
  #stream button.tag:hover { border-color: var(--accent); color: var(--accent); }
  #stream button.tag.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  /* a piece inside a series says so — its field above, the series line and where it sits below */
  #stream .pcrumb { display: block; margin-top: 18px; padding-top: 14px; font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); }
  #stream .pcrumb .fd { display: block; margin-bottom: 9px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  #stream .pcrumb .cr { display: flex; align-items: baseline; gap: 13px; flex-wrap: wrap; }
  #stream .pcrumb .cr .snm { font-family: var(--serif-display); font-size: 15px; letter-spacing: -.005em; color: var(--ink-soft); }
  #stream .pcrumb .pt { display: inline-flex; align-items: center; gap: 8px; }
  #stream .pcrumb .pt .n { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; }
  #stream .pcrumb .ticks { display: flex; align-items: center; gap: 2px; }
  #stream .pcrumb .ticks i { width: 11px; height: 3px; border-radius: 1px; background: color-mix(in srgb, var(--accent) 60%, transparent); }
  #stream .pcrumb .ticks i.todo { background: color-mix(in srgb, var(--ink) 16%, transparent); }
  #stream .pcrumb .ticks i.here { background: var(--accent); height: 6px; }
  #stream .aside { grid-column: 4; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; margin-top: 2px; text-align: right; font-family: var(--sans); font-size: 12px; color: var(--ink-faint); white-space: nowrap; }
  .curve { display: block; overflow: hidden; cursor: default; }
  #stream .aside .curve { width: 86px; height: 28px; margin-top: 6px; }
  .curve path.fill { fill: color-mix(in srgb, var(--accent) 12%, transparent); }
  .curve path.line { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; }
  .curve line.base { stroke: var(--rule); stroke-width: 1; }
  .curve circle.cliff { fill: var(--paper); stroke: var(--accent); stroke-width: 1.3; }
  #stream .post.is-hidden, #stream .grp.is-hidden, #stream .post-list.is-hidden { display: none; }

  /* ——— where you left off ——— the reader's resume strip (cards JS-created) */
  #rez { padding: 6px 0 clamp(30px, 4vw, 44px); }
  #rez .slab { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  #rez .slab .eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-faint); }
  #rez .slab .line { height: 1px; flex: 1; background: var(--rule); }
  #rez .slab .drop { font-family: var(--sans); font-size: 12px; color: var(--ink-faint); background: none; border: 0; cursor: pointer; padding: 0; }
  #rez .slab .drop:hover { color: var(--accent); }
  #rez .rezgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  #rez .rzc { display: block; border: 1px solid var(--rule); border-radius: 4px; background: var(--card); padding: 13px 15px 11px; transition: border-color .2s, transform .2s; }
  #rez .rzc:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); transform: translateY(-1px); }
  #rez .rzc .top { display: flex; align-items: flex-start; gap: 10px; min-width: 0; }
  #rez .rzc .mono { width: 26px; height: 26px; flex: none; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper-2); display: grid; place-items: center; font-family: var(--serif-display); font-size: 10.5px; font-weight: 600; color: var(--ink-soft); letter-spacing: .03em; }
  #rez .rzc h3 { font-family: var(--serif-display); font-weight: 600; font-size: 15.5px; line-height: 1.28; letter-spacing: -.01em; margin: 1px 0 0; color: var(--ink); min-width: 0; text-wrap: pretty; }
  #rez .rzc:hover h3 { color: var(--accent); }
  #rez .rzc .bar { display: flex; gap: 2px; margin: 11px 0 8px; }
  #rez .rzc .bar i { flex: 1; height: 3px; border-radius: 1px; background: color-mix(in srgb, var(--accent) 60%, transparent); }
  #rez .rzc .bar i.todo { background: color-mix(in srgb, var(--ink) 14%, transparent); }
  #rez .rzc .st { font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); display: flex; gap: 7px; align-items: baseline; }
  #rez .rzc .st em { font-style: normal; color: var(--accent); font-variant-numeric: tabular-nums; }
  #rez .rzc .st .sep { color: var(--rule); }
  @media (max-width: 900px) { #rez .rezgrid { grid-template-columns: 1fr; } }

  /* ——— the fields shelf (the map) ——— tiles are JS-created, so styled globally under #fieldshelf */
  #fieldshelf { padding: clamp(24px, 3.4vw, 40px) 0 clamp(30px, 4vw, 48px); }
  #fieldshelf .slab { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  #fieldshelf .slab .eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-faint); }
  #fieldshelf .slab .line { height: 1px; flex: 1; background: var(--rule); }
  #fieldshelf .slab .more-link { font-family: var(--sans); font-size: 12px; color: var(--ink-faint); white-space: nowrap; text-decoration: none; transition: color .2s; }
  #fieldshelf .slab .more-link:hover { color: var(--accent); }
  /* Fields shelf: two columns (2×2 for the four fields), one column on mobile. Never more. */
  #fieldshelf .shelf { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 2px 2px 6px; }
  #fieldshelf .ftile { position: relative; display: block; height: 172px; border: 1px solid var(--rule); border-radius: 5px; overflow: hidden; background: var(--paper-2); transition: border-color .2s, transform .2s; }
  #fieldshelf .ftile:hover { border-color: color-mix(in srgb, var(--accent) 60%, var(--rule)); transform: translateY(-2px); }
  #fieldshelf .ftile .plate { position: absolute; inset: 0; }
  #fieldshelf .ftile .plate::after { content: ""; position: absolute; inset: 0; background: radial-gradient(105% 95% at var(--wx, 20%) var(--wy, 12%), color-mix(in srgb, var(--accent) var(--wo, 13%), transparent), transparent 66%); }
  #fieldshelf .ftile .plate svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  #fieldshelf .ftile .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 34px 15px 13px; background: linear-gradient(transparent, color-mix(in srgb, var(--paper-2) 88%, transparent) 46%, var(--paper-2)); }
  #fieldshelf .ftile h3 { font-family: var(--serif-display); font-weight: 600; font-size: 18.5px; line-height: 1.2; letter-spacing: -.015em; margin: 0; color: var(--ink); text-wrap: pretty; }
  #fieldshelf .ftile:hover h3 { color: var(--accent); }
  #fieldshelf .ftile .fm { display: block; margin-top: 6px; font-family: var(--sans); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  @media (max-width: 560px) { #fieldshelf .shelf { grid-template-columns: 1fr; } }

  /* ——— ways in ——— three routes by reading shape (cards + a mini curve each) */
  #waysin { padding: 0 0 clamp(34px, 4.4vw, 50px); }
  #waysin .slab { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  #waysin .slab .eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-faint); }
  #waysin .slab .line { height: 1px; flex: 1; background: var(--rule); }
  #waysin .slab .more-link { font-family: var(--sans); font-size: 12px; color: var(--ink-faint); white-space: nowrap; }
  #waysin .wgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  #waysin .way { display: block; border: 1px solid var(--rule); border-radius: 5px; background: var(--card); padding: 16px 18px 15px; transition: border-color .2s, transform .2s; }
  #waysin .way:hover { border-color: color-mix(in srgb, var(--accent) 58%, var(--rule)); transform: translateY(-2px); }
  #waysin .way .wk { display: flex; align-items: center; gap: 11px; margin-bottom: 13px; }
  #waysin .way .wk b { font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); }
  #waysin .way .wk .curve { margin: 0 0 0 auto; width: 58px; height: 19px; }
  #waysin .way h3 { font-family: var(--serif-display); font-weight: 600; font-size: 18.5px; line-height: 1.26; letter-spacing: -.01em; margin: 0 0 7px; color: var(--ink); text-wrap: pretty; }
  #waysin .way:hover h3 { color: var(--accent); }
  #waysin .way .wm { font-family: var(--sans); font-size: 11.5px; color: var(--ink-faint); }
  #waysin .way p { margin: 11px 0 0; padding-top: 11px; border-top: 1px solid var(--rule-soft); font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }
  @media (max-width: 820px) { #waysin .wgrid { grid-template-columns: 1fr; } }

  @media (max-width: 620px) {
    #stream .post { grid-template-columns: auto minmax(0, 1fr); }
    #stream .post .rail { grid-column: 1; grid-row: 1 / span 2; align-self: start; }
    #stream .post.cont .mono { display: grid; opacity: .4; width: 30px; height: 30px; }
    #stream .post.cont .byline { display: flex; }
    #stream .post .spine, #stream .post .bead { display: none !important; }
    #stream .picon { display: none; }
    #stream .ptext { grid-column: 2; grid-row: 1; }
    #stream .aside { grid-column: 2; grid-row: 2; flex-direction: row; align-items: baseline; text-align: left; margin-top: 8px; }
    #stream .aside .curve { margin-top: 0; margin-left: auto; }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { initFieldPlates } from '../../lib/field-plates.js';

  const stream = document.getElementById('stream')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const sortSel = document.getElementById('sort') as HTMLSelectElement;
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const moreBtn = document.getElementById('morebtn') as HTMLButtonElement;

  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const initials = (name: string) => {
    const w = String(name || '').trim().split(/\s+/).filter(Boolean);
    return ((w.length >= 2 ? w[0][0] + w[1][0] : (w[0] || '?').slice(0, 2)) || '?').toUpperCase();
  };
  const monthKey = (d: Date) => d.getUTCFullYear() * 12 + d.getUTCMonth();
  const monthLabel = (d: Date) => {
    const now = new Date();
    if (d.getUTCFullYear() === now.getUTCFullYear() && d.getUTCMonth() === now.getUTCMonth()) return 'This month';
    const m = d.toLocaleDateString('en-US', { month: 'long' });
    return d.getUTCFullYear() === now.getUTCFullYear() ? m : `${m} ${d.getUTCFullYear()}`;
  };
  const fmtDate = (s: string) => { const t = Date.parse(s); return isNaN(t) ? '' : new Date(t).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }); };

  let rows: any[] = [];
  let before: string | null = null;
  const PAGE = 25;

  function byline(p: any) {
    if (p.author_count > 1 && Array.isArray(p.author_names)) {
      const names = p.author_names.filter(Boolean);
      const head = `<span class="nm">${esc(names[0])}</span>`;
      const rest = names.length === 2 ? `<span class="co">& ${esc(names[1])}</span>` : `<span class="co">& ${names.length - 1} others</span>`;
      return head + rest;
    }
    return `<span class="nm">${esc(p.primary_name)}</span>`;
  }

  // The reading shape: readers-remaining at each decile → a retention curve (a shape,
  // not a score). The steepest drop gets a "cliff" dot. Empty when there's no data yet.
  const retention = new Map<string, number[]>();
  const clamp = (n: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, n));
  // Stable per-slug seed → each post draws a fixed but varied tooltip line (feed feels human).
  const hashSeed = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return Math.abs(h); };
  const pick = <T,>(arr: T[], seed: number) => arr[seed % arr.length];

  // Pools of on-brand tooltip lines — a per-post seed picks one, so the feed reads varied, not
  // templated. Tier by where the curve ends; a notch clause (with {x}) appends on a sharp drop.
  const SHAPE_LINES = {
    hold: [
      'Nearly everyone who started stayed to the end',
      'The piece held its line to the bottom',
      'Few slipped away before the final paragraph',
      'Readers followed this one clean through',
      'It carried them right to the last line',
      'Attention never wavered, first word to last',
      'Almost no one set it down early',
    ],
    core: [
      'A loyal few stayed the course; the rest slipped away',
      'Held its true readers, lost the skimmers',
      'The committed stayed on while the curious wandered off partway',
      'Kept a devoted handful, let the crowd go',
      'Thinned early to a faithful core that finished it',
      'Only the invested made it to the last line',
      'Not for everyone, and the right ones knew it',
    ],
    loses: [
      'Readers drifted off well before the last line',
      'Halfway in, the room began to thin',
      'Held a crowd early, then quietly emptied out',
      'Few readers reached the closing thought',
      'Attention slipped its grip partway through',
      'Most closed the tab long before the end',
      'A slow leak from the first turn onward',
    ],
    // Position-focused (the "where"), worded to avoid echoing the tier lines' verbs.
    notch: [
      ', with the sharp fall just past {x}%',
      ', the steep drop landing near {x}%',
      ' — the break lands around {x}%',
      ' — a clean cliff at {x}%',
      '; most who left did so near {x}%',
      '; the floor gives way around {x}%',
    ],
  };

  // One short, engaging line for the hover tooltip — what the shape says about the reading,
  // never a number as a score. {x} is a position along the piece, not a retention figure.
  function shapeText(samples: number[], seed: number) {
    const finish = samples[samples.length - 1] ?? 0;
    let ni = -1, md = 0;
    for (let i = 1; i < samples.length; i++) { const drop = samples[i - 1] - samples[i]; if (drop > md) { md = drop; ni = i; } }
    const bucket = finish >= 70 ? 'hold' : finish >= 45 ? 'core' : 'loses';
    const tier = pick(SHAPE_LINES[bucket], seed);
    // a notch (a sharp shed of readers) only belongs where the piece actually lost the room
    const notch = bucket !== 'hold' && md >= 14 && ni > 0 ? pick(SHAPE_LINES.notch, (seed >> 4) + 1).replace('{x}', String(ni * 10)) : '';
    return `${tier}${notch}`;
  }

  // Smooth curve through the decile points (Catmull-Rom → cubic bézier), clamped inside the
  // box so the line can never leave the graph however sharp the drop.
  function curveSvg(samples: number[] | undefined, seed = 0) {
    if (!samples || !samples.length) return '';
    const W = 86, top = 3.5, bot = 22.5;
    const y = (s: number) => top + (100 - clamp(s, 0, 100)) / 100 * (bot - top);
    const P = samples.map((s, i) => [+((i / (samples.length - 1)) * W).toFixed(1), +y(s).toFixed(1)]);
    const cy = (v: number) => +clamp(v, 1.5, 25).toFixed(1); // keep control points in-box too
    let d = `M${P[0][0]} ${P[0][1]}`;
    for (let i = 0; i < P.length - 1; i++) {
      const p0 = P[i - 1] || P[0], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] || P[P.length - 1];
      const c1x = +(p1[0] + (p2[0] - p0[0]) / 6).toFixed(1), c1y = cy(p1[1] + (p2[1] - p0[1]) / 6);
      const c2x = +(p2[0] - (p3[0] - p1[0]) / 6).toFixed(1), c2y = cy(p2[1] - (p3[1] - p1[1]) / 6);
      d += ` C${c1x} ${c1y} ${c2x} ${c2y} ${p2[0]} ${p2[1]}`;
    }
    let ni = -1, md = 0;
    for (let i = 1; i < P.length; i++) { const dd = P[i][1] - P[i - 1][1]; if (dd > md) { md = dd; ni = i; } }
    // Skip a cliff dot within 3px of either edge — overflow:hidden would clip it in half.
    const cliff = md > 3 && ni > 0 && P[ni][0] >= 3 && P[ni][0] <= 83 ? `<circle class="cliff" cx="${P[ni][0]}" cy="${P[ni][1]}" r="2.4"></circle>` : '';
    const label = esc(shapeText(samples, seed));
    // xMinYMid pins x=0 to the box's left edge at every size — never let the line drift out of frame.
    // Message rides on data-shape (read by the custom fast tooltip), not a slow native <title>.
    return `<svg class="curve" viewBox="0 0 86 28" preserveAspectRatio="xMinYMid meet" role="img" aria-label="${label}" data-shape="${label}"><path class="fill" d="${d} L86 28 L0 28 Z"></path><path class="line" d="${d}"></path><line class="base" x1="0" y1="27" x2="86" y2="27"></line>${cliff}</svg>`;
  }

  // Field above, series line below (name · part · progress ticks). Rendered as styled text,
  // not links, until the field/series pages ship — so nothing here is a dead end.
  function crumb(p: any) {
    if (!p.series_title && !p.field_title) return '';
    const field = p.field_title ? `<span class="fd">${esc(p.field_title)}</span>` : '';
    if (!p.series_title) return `<p class="pcrumb">${field}</p>`;
    let ticks = '';
    if (p.series_total && p.series_total > 0) {
      for (let k = 1; k <= p.series_total; k++) ticks += `<i class="${k === p.series_part ? 'here' : k < (p.series_part || 0) ? '' : 'todo'}"></i>`;
    }
    const pt = p.series_part != null
      ? `<span class="pt"><span class="n">Part ${esc(p.series_part)}${p.series_total ? ` of ${esc(p.series_total)}` : ''}</span>${ticks ? `<span class="ticks">${ticks}</span>` : ''}</span>`
      : '';
    return `<p class="pcrumb">${field}<span class="cr"><span class="snm">${esc(p.series_title)}</span>${pt}</span></p>`;
  }

  function rowEl(p: any) {
    const el = document.createElement('article');
    el.className = 'post';
    el.dataset.author = p.primary_handle || '';
    el.dataset.text = `${p.title} ${p.primary_name} ${(p.author_names || []).join(' ')} ${(p.tags || []).join(' ')} ${p.description || ''}`.toLowerCase();
    el.dataset.tags = (p.tags || []).join(' ');
    el.dataset.rt = String(p.reading_min || 1);
    const tags = (p.tags || []).slice(0, 4).map((t: string) => `<button class="tag" type="button" data-tag="${esc(t)}">${esc(t)}</button>`).join('');
    el.innerHTML =
      `<div class="rail"><span class="mono">${esc(initials(p.primary_name))}</span></div>` +
      `<span class="spine"></span><span class="bead"></span>` +
      `<span class="picon" aria-hidden="true"></span>` +
      `<div class="ptext">` +
        `<p class="byline">${byline(p)}</p>` +
        `<h3>${esc(p.title)}</h3>` +
        (p.description ? `<p class="sum">${esc(p.description)}</p>` : '') +
        (tags ? `<div class="tags">${tags}</div>` : '') +
        crumb(p) +
      `</div>` +
      `<div class="aside"><span class="dt">${esc(fmtDate(p.pub_date))}</span><span class="rt">${esc(p.reading_min || 1)} min</span>${curveSvg(retention.get(p.slug), hashSeed(p.slug))}</div>`;
    return el;
  }

  // "Best held" reads off the retention tail (readers still there at the end); −1 sinks posts
  // with no shape yet to the bottom.
  const heldScore = (p: any) => { const s = retention.get(p.slug); return s && s.length ? s[s.length - 1] : -1; };

  // Month groups stay in chronological order (newest first); the sort only reorders WITHIN a
  // group, so a "shortest"/"best held" sort never scrambles the timeline into nonsense.
  function render() {
    const mode = sortSel.value;
    stream.innerHTML = '';
    const groups = new Map<number, any[]>();
    for (const p of rows) { const k = monthKey(new Date(p.pub_date)); if (!groups.has(k)) groups.set(k, []); groups.get(k)!.push(p); }
    for (const k of [...groups.keys()].sort((a, b) => b - a)) {
      const arr = groups.get(k)!.slice();
      if (mode === 'short') arr.sort((a, b) => (a.reading_min || 99) - (b.reading_min || 99));
      else if (mode === 'held') arr.sort((a, b) => heldScore(b) - heldScore(a));
      const head = document.createElement('div'); head.className = 'grp'; head.dataset.grp = String(k);
      head.innerHTML = `<h2>${esc(monthLabel(new Date(arr[0].pub_date)))}</h2><span class="rule"></span>`;
      stream.appendChild(head);
      const wrap = document.createElement('div'); wrap.className = 'post-list'; wrap.dataset.grp = String(k);
      for (const p of arr) wrap.appendChild(rowEl(p));
      stream.appendChild(wrap);
    }
    apply();
  }

  // Consecutive posts by one author collapse into a single spine — computed PER month
  // group so a run never crosses a header (recomputed after every filter/sort).
  function collapse() {
    stream.querySelectorAll('.post').forEach((p) => p.classList.remove('runstart', 'runend', 'cont', 'lead'));
    stream.querySelectorAll('.post-list').forEach((list) => {
      let prev: string | null = null, run: HTMLElement[] = [];
      const close = () => { if (run.length > 1) { run[0].classList.add('runstart'); run[run.length - 1].classList.add('runend'); } run = []; };
      (list.querySelectorAll('.post') as NodeListOf<HTMLElement>).forEach((p) => {
        if (p.classList.contains('is-hidden')) return;
        const same = p.dataset.author === prev;
        p.classList.toggle('cont', same);
        if (!same) close();
        run.push(p); prev = p.dataset.author!;
      });
      close();
      const f = list.querySelector('.post:not(.is-hidden)'); if (f) f.classList.add('lead');
    });
  }

  // A subject (tag) click is a real subject filter, not a substring search: it token-matches
  // the post's tags, so "RAG" is never satisfied by the word "fragmentation". Typed text still
  // searches the whole row. Either narrows the count and mirrors the active subject on its chip.
  let subject: string | null = null;
  function apply() {
    const term = (q.value || '').trim().toLowerCase();
    const subj = subject ? subject.toLowerCase() : null;
    const filtered = !!term || !!subj;
    let shown = 0;
    stream.querySelectorAll('.post').forEach((el) => {
      const d = el as HTMLElement;
      const okSubj = !subj || (' ' + (d.dataset.tags || '').toLowerCase() + ' ').indexOf(' ' + subj + ' ') > -1;
      const okTerm = !term || d.dataset.text!.indexOf(term) > -1;
      const on = okSubj && okTerm;
      el.classList.toggle('is-hidden', !on);
      if (on) shown++;
    });
    stream.querySelectorAll('.post-list').forEach((l) => {
      const any = [...l.querySelectorAll('.post')].some((p) => !p.classList.contains('is-hidden'));
      l.classList.toggle('is-hidden', !any);
      const head = stream.querySelector(`.grp[data-grp="${(l as HTMLElement).dataset.grp}"]`);
      if (head) head.classList.toggle('is-hidden', !any);
    });
    collapse();
    count.classList.toggle('on', filtered);
    count.textContent = filtered ? (shown === 1 ? 'One match' : `${shown} matches`) : '';
    empty.classList.toggle('on', shown === 0);
    stream.querySelectorAll('button.tag').forEach((b) => b.classList.toggle('on', !!subj && ((b as HTMLElement).dataset.tag || '').toLowerCase() === subj));
    moreBtn.hidden = filtered || before === null;
  }

  async function load() {
    moreBtn.disabled = true;
    const { data, error } = await supabase.rpc('list_feed_posts', { p_limit: PAGE, p_before: before });
    if (error) { empty.textContent = 'Could not load the feed: ' + error.message; empty.classList.add('on'); return; }
    const got = data || [];
    rows = rows.concat(got);
    before = got.length === PAGE ? got[got.length - 1].pub_date : null;
    // Pull the reading shapes for this page's posts (best-effort; the feed renders without them).
    const slugs = got.map((p: any) => p.slug).filter((s: string) => !retention.has(s));
    if (slugs.length) {
      const { data: ret } = await supabase.rpc('feed_retention', { p_slugs: slugs });
      (ret || []).forEach((r: any) => { if (r.samples) retention.set(r.slug, r.samples); });
    }
    render();
    moreBtn.disabled = false;
  }

  // A tag sets the subject (and mirrors it in the search field); clicking the active one clears it.
  stream.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('button.tag') as HTMLElement | null;
    if (!t) return;
    const v = t.dataset.tag || '';
    if (subject && subject.toLowerCase() === v.toLowerCase()) { subject = null; q.value = ''; }
    else { subject = v; q.value = v; }
    apply();
  });
  q.addEventListener('input', () => { subject = null; apply(); });
  sortSel.addEventListener('change', render);
  moreBtn.addEventListener('click', load);
  empty.querySelector('[data-reset]')?.addEventListener('click', (e) => { e.preventDefault(); q.value = ''; subject = null; sortSel.value = 'new'; render(); });

  // The fields shelf (the map). Independent of the stream; stays hidden if no field is public yet.
  async function loadFields() {
    const { data, error } = await supabase.rpc('list_public_fields', { p_limit: 4 });
    if (error || !data || !data.length) return;
    const shelf = document.getElementById('shelf')!;
    const washes = [[20, 12, 13], [78, 80, 11], [50, 20, 12], [30, 72, 12]];
    shelf.innerHTML = data.map((f: any, i: number) => {
      const w = washes[i % washes.length];
      const meta = `${f.series_count} series · ${f.published_posts} of ${f.total_posts} published`;
      return `<div class="ftile"><span class="plate" data-field-plate="${esc(f.plate_spec || '')}" style="--wx:${w[0]}%;--wy:${w[1]}%;--wo:${w[2]}%"></span>`
        + `<span class="cap"><h3>${esc(f.title)}</h3><span class="fm">${esc(meta)}</span></span></div>`;
    }).join('');
    initFieldPlates(shelf);
    (document.getElementById('fieldshelf') as HTMLElement).hidden = false;
  }

  // Ways in: three routes into the archive, chosen by reading shape (public.ways_in).
  const WAYS: Record<string, { label: string; copy: string }> = {
    holds: { label: 'Holds to the end', copy: 'Almost nobody puts this one down. Start here if you want proof the place is worth your time.' },
    hard:  { label: 'Hard, worth it',  copy: 'Loses many readers in the opening and rewards the ones who stay. Bring coffee.' },
    quick: { label: 'A quick read',    copy: 'Short, complete, and finished by nearly everyone who opens it. Read it on a break.' },
  };
  async function loadWays() {
    const { data, error } = await supabase.rpc('ways_in');
    if (error || !data || data.length < 3) return;   // only show when all three routes exist
    const byRoute: Record<string, any> = Object.fromEntries(data.map((d: any) => [d.route, d]));
    const grid = document.getElementById('wgrid')!;
    grid.innerHTML = ['holds', 'hard', 'quick'].filter((r) => byRoute[r]).map((r) => {
      const d = byRoute[r], w = WAYS[r];
      return `<div class="way"><span class="wk"><b>${esc(w.label)}</b>${curveSvg(d.samples, hashSeed(d.slug))}</span>`
        + `<h3>${esc(d.title)}</h3><span class="wm">${esc(d.author_name)} · ${esc(d.reading_min || 1)} min</span>`
        + `<p>${esc(w.copy)}</p></div>`;
    }).join('');
    (document.getElementById('waysin') as HTMLElement).hidden = false;
  }

  // Where you left off: the reader's own in-progress pieces (public.my_reading_continues).
  // Non-link cards for now — the whole feed's post permalinks land with a later slice.
  async function loadContinue() {
    const { data, error } = await supabase.rpc('my_reading_continues', { p_limit: 3 });
    if (error || !data || !data.length) return;   // anonymous or nothing mid-read → stay hidden
    const grid = document.getElementById('rezgrid')!;
    grid.innerHTML = data.map((r: any) => {
      const TICKS = 15, filled = Math.max(1, Math.min(TICKS, Math.round((r.pct / 100) * TICKS)));
      let bar = ''; for (let i = 1; i <= TICKS; i++) bar += `<i class="${i <= filled ? '' : 'todo'}"></i>`;
      const minLeft = Math.max(1, Math.round((r.reading_min || 1) * (1 - (r.pct || 0) / 100)));
      return `<div class="rzc"><div class="top"><span class="mono">${esc(initials(r.author_name))}</span><h3>${esc(r.title)}</h3></div>`
        + `<div class="bar">${bar}</div>`
        + `<div class="st"><span><em>${r.pct}%</em> read</span><span class="sep">·</span><span><em>${minLeft} min</em> left</span></div></div>`;
    }).join('');
    (document.getElementById('rez') as HTMLElement).hidden = false;
  }
  document.getElementById('rezclear')?.addEventListener('click', () => { (document.getElementById('rez') as HTMLElement).hidden = true; });

  // Reading-shape tooltip — a fast, themed hover box. The native <title> is too slow (~700ms)
  // for readers to discover; this shows in 90ms and is styled to the site.
  const tip = document.getElementById('shapeTip')!;
  let tipTimer = 0;
  function placeTip(curve: Element) {
    const msg = curve.getAttribute('data-shape'); if (!msg) return;
    tip.textContent = msg;
    const cr = curve.getBoundingClientRect(), tr = tip.getBoundingClientRect();
    let left = cr.left + cr.width / 2 - tr.width / 2;
    left = Math.max(8, Math.min(window.innerWidth - tr.width - 8, left));
    const above = cr.top - tr.height - 10, below = above < 8;
    tip.classList.toggle('below', below);
    tip.style.left = `${Math.round(left)}px`;
    tip.style.top = `${Math.round(below ? cr.bottom + 10 : above)}px`;
    tip.style.setProperty('--tip-arrow', `${Math.round(cr.left + cr.width / 2 - left)}px`);
    tip.classList.add('on'); tip.setAttribute('aria-hidden', 'false');
  }
  function hideTip() { clearTimeout(tipTimer); tip.classList.remove('on'); tip.setAttribute('aria-hidden', 'true'); }
  document.addEventListener('mouseover', (e) => {
    const c = (e.target as HTMLElement).closest?.('.curve'); if (!c) return;
    clearTimeout(tipTimer); tipTimer = window.setTimeout(() => placeTip(c), 90);
  });
  document.addEventListener('mouseout', (e) => {
    const c = (e.target as HTMLElement).closest?.('.curve'); if (!c) return;
    if (e.relatedTarget && c.contains(e.relatedTarget as Node)) return;  // still inside the same curve
    hideTip();
  });
  window.addEventListener('scroll', hideTip, { passive: true });

  load();
  loadContinue();
  loadFields();
  loadWays();
</script>
