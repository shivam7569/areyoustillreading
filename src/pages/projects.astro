---
/*
 * ============================================================================
 * FILE: src/pages/projects.astro
 * ROUTE: /projects  (Astro file-based routing — this file's path IS the URL)
 * ============================================================================
 *
 * WHAT THIS IS
 *   The static "Projects" portfolio page, Phase-5 EDITORIAL skin. It renders a
 *   hard-coded list of featured projects as a responsive card grid, plus a
 *   trailing "More on GitHub" note. That's the whole job.
 *
 * SINGLE RESPONSIBILITY
 *   Present a curated, author-maintained list of portfolio projects. Nothing
 *   more. This page is 100% static content: it fetches nothing at runtime,
 *   reads no database, requires no auth, and ships zero client-side JS of its
 *   own. It is fully rendered to HTML at build time.
 *
 * DESIGN
 *   Editorial reskin only — no behavior change. Header/footer/nav/theme come
 *   from BaseLayout; the shared editorial utility classes (.wrap .page-head
 *   .eyebrow .meta-caps .sec-head .card .ph .tag .tags) live in global.css.
 *   Only the page-specific classes (.grid .proj .status .note) are scoped
 *   below, copied verbatim from the editorial template.
 *
 * DEPENDENCIES (what it imports)
 *   - ../layouts/BaseLayout.astro : the shared site shell. Owns <html>, <head>
 *     (meta/OG/canonical), global CSS variables + editorial utilities,
 *     header/nav, footer, and Pagefind indexing. `wide` opts this page out of
 *     the constrained reading column so the editorial grid can breathe.
 *
 * SECURITY / GOTCHAS
 *   - No secrets, no tokens, no entitlement checks — there is no data source to
 *     protect. `href` values are author-controlled constants, so the bare
 *     <a href={p.href}> is safe. Keep this page static.
 * ============================================================================
 */

// The shared page shell. Owns <head>, nav, footer, and the editorial tokens
// (--paper/--ink/--rule/--accent/--serif-*) this page's <style> consumes.
import BaseLayout from '../layouts/BaseLayout.astro';

// Shape of a single portfolio entry. Compile-time only (TS interface erased at
// build); exists to keep the hand-authored `projects` array below honest.
interface Project {
  name: string;        // Card heading.
  description: string; // One-paragraph blurb rendered as the card body.
  href: string;        // Primary outbound URL (author-set).
  tags: string[];      // Short pill labels (tech/keywords).
  status: string;      // Editorial status pill (e.g. "Maintained").
  meta: string;        // Small-caps meta shown next to the status pill.
  shot: string;        // Mono label naming the screenshot placeholder.
}

// The curated, hand-maintained source of truth for this page. Static array
// (not a CMS/DB query): the list is tiny, author-owned, and rarely changes, so
// build-time constants keep the page fully static. To feature a new project,
// add an object here — that is the ONLY edit required.
const projects: Project[] = [
  {
    name: 'Deep-Learning Architectures from Scratch',
    description:
      'Open-source PyTorch library implementing 25+ computer-vision architectures — CNNs (ResNet, ConvNeXt), Vision Transformers (DeiT, Swin), and segmentation networks — reimplemented from their original papers. Modular, packaged codebase with unit tests, GitHub Actions CI/CD, config-driven training, experiment logging, and hosted docs.',
    href: 'https://shivam7569.github.io/cv/',
    tags: ['pytorch', 'computer-vision', 'open-source'],
    status: 'Maintained',
    meta: 'Open source',
    shot: 'Screenshot — architecture library docs',
  },
];

const GITHUB = 'https://github.com/shivam7569';
---

{/*
  BaseLayout wraps this page in the site shell. `title` becomes the <title>/OG
  title and `description` the meta/OG description. `wide` gives the editorial
  grid a full-bleed main. Everything below is projected into the layout's slot.
*/}
<BaseLayout title="Projects — areyoustillreading" description="Selected engineering and research projects by Shivam Chaudhary." wide>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker"><span class="line"></span><span class="eyebrow">Things I built</span></div>
      <h1>Work that <em>earned its writing.</em></h1>
      <p class="lede">Selected engineering and research work — the kind of project I couldn't write about honestly until I'd built it first.</p>
    </header>

    <div class="grid">
      {/* One .proj card per curated project. Keyless map is fine: static SSG, no hydration. */}
      {projects.map((p) => (
        <article class="card proj">
          <div class="ph"><span>{p.shot}</span></div>
          <div class="body">
            <div class="top"><span class="status">{p.status}</span><span class="meta-caps">{p.meta}</span></div>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="tags">
              {p.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="links">
              <a href={GITHUB}><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.3-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.8-2.4 4.7-4.6 4.9.3.3.6.9.6 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/></svg>Repository</a>
              <a href={p.href}>Documentation →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Closing note carries the "More on GitHub" catch-all from the pre-skin page. */}
    <div class="note">
      <span>Everything here is open source — MIT unless the repository says otherwise.</span>
      <span>More on GitHub <a href={GITHUB}>github.com/shivam7569 →</a></span>
    </div>
  </div>
</BaseLayout>

{/*
  Page-specific classes only (copied verbatim from the editorial template). The
  shared editorial utilities (.wrap .page-head .eyebrow .meta-caps .card .ph
  .tag .tags) live in global.css. Colors come from the editorial tokens
  (--paper/--ink/--rule/--accent/--serif-*) defined globally.
*/}
<style>
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,32px)}
  @media(max-width:860px){.grid{grid-template-columns:1fr}}
  .proj{overflow:hidden;display:flex;flex-direction:column;transition:transform .22s,border-color .22s}
  .proj:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 40%,var(--rule))}
  .proj .ph{min-height:200px}
  .proj .body{padding:clamp(22px,2.6vw,30px);display:flex;flex-direction:column;flex:1}
  .proj .top{display:flex;align-items:center;gap:12px;margin-bottom:14px}
  .status{font-family:var(--sans);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;border-radius:2px;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
  .status.quiet{background:transparent;border:1px solid var(--rule);color:var(--ink-faint)}
  .proj h3{font-family:var(--serif-display);font-weight:600;font-size:26px;letter-spacing:-.01em;margin:0 0 12px;line-height:1.15}
  .proj p{color:var(--ink-soft);margin:0 0 20px;font-size:17px}
  .proj .tags{margin-bottom:22px}
  .proj .links{display:flex;flex-wrap:wrap;gap:18px;margin-top:auto;padding-top:18px;border-top:1px solid var(--rule);font-family:var(--sans);font-size:14px}
  .proj .links a{color:var(--accent);display:inline-flex;align-items:center;gap:7px;border-bottom:1px solid transparent;transition:border-color .2s}
  .proj .links a:hover{border-color:var(--accent)}
  .proj .links svg{width:14px;height:14px}
  .note{margin-top:clamp(44px,6vw,72px);padding:26px 0 0;border-top:1px solid var(--rule);font-family:var(--sans);font-size:14px;color:var(--ink-faint);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .note a{color:var(--accent)}
</style>
