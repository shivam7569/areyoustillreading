---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  description: string;
  href: string;
  tags: string[];
}

const projects: Project[] = [
  {
    name: 'Deep-Learning Architectures from Scratch',
    description:
      'Open-source PyTorch library implementing 25+ computer-vision architectures — CNNs (ResNet, ConvNeXt), Vision Transformers (DeiT, Swin), and segmentation networks — reimplemented from their original papers. Modular, packaged codebase with unit tests, GitHub Actions CI/CD, config-driven training, experiment logging, and hosted docs.',
    href: 'https://github.com/shivam7569',
    tags: ['pytorch', 'computer-vision', 'open-source'],
  },
];
---

<BaseLayout title="Projects — areyoustillreading" description="Selected engineering and research projects by Shivam Chaudhary.">
  <h1>Projects</h1>

  <ul class="project-grid">
    {projects.map((p) => (
      <li class="card">
        <h2 class="card-title"><a href={p.href}>{p.name}</a></h2>
        <p class="card-desc">{p.description}</p>
        <ul class="tags">
          {p.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </li>
    ))}
    <li class="card">
      <h2 class="card-title"><a href="https://github.com/shivam7569">More on GitHub &rarr;</a></h2>
      <p class="card-desc">Additional experiments and open-source work.</p>
    </li>
  </ul>
</BaseLayout>

<style>
  .project-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .card-title { margin: 0; font-size: 1.15rem; }
  .card-title a { color: inherit; }
  .card-title a:hover { color: var(--accent); }
  .card-desc { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .tags { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
</style>
