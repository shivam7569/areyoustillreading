---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  description: string;
  href: string;
  tags: string[];
}

const projects: Project[] = [
  {
    name: 'Context Ledger',
    description:
      'A small library for tracking token budgets across multi-turn LLM conversations, with pruning strategies you can swap at runtime.',
    href: '#',
    tags: ['typescript', 'llm', 'tooling'],
  },
  {
    name: 'Retrieval Playground',
    description:
      'An interactive sandbox for comparing chunking and reranking strategies against your own documents, side by side.',
    href: '#',
    tags: ['rag', 'evaluation', 'astro'],
  },
  {
    name: 'Prompt Diff',
    description:
      'A CLI that diffs two prompt versions and reports how model outputs shift across a fixed suite of test cases.',
    href: '#',
    tags: ['cli', 'testing', 'python'],
  },
];
---

<BaseLayout title="Projects — areyoustillreading">
  <h1>Projects</h1>
  <p class="note">
    These are placeholder projects for now &mdash; real write-ups and links are on the way.
  </p>

  <ul class="project-grid">
    {
      projects.map((p) => (
        <li class="card">
          <h2 class="card-title">
            <a href={p.href}>{p.name}</a>
          </h2>
          <p class="card-desc">{p.description}</p>
          <ul class="tags">
            {p.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .note {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .project-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .card-title {
    margin: 0;
    font-size: 1.2rem;
  }

  .card-title a {
    color: inherit;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
</style>
